---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { resolveHref } from '../utils/media';

import ImageLightbox from '../components/ImageLightbox.astro';
import PerformanceDiagnosticHUD from '../components/PerformanceDiagnosticHUD.astro';
import ProjectTransitionOverlay from '../components/ProjectTransitionOverlay.astro';

interface Props {
  title?: string;
  description?: string;
  showSpine?: boolean;
}
const {
  title = "Naveen Shaji George — Robotics and Automation Engineer",
  description = "Robotics engineer specializing in autonomous systems, 3D LiDAR perception, ROS 2 Humble, custom vehicle ECUs, isolated CAN bus networks, and vehicle-level hardware-software integration.",
  showSpine = true
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Naveen Shaji George" />
    <meta name="theme-color" content="#F7F5F0" />

    <link rel="icon" type="image/svg+xml" href={resolveHref('/favicon.svg')} />
    <link rel="icon" href={resolveHref('/favicon.ico')} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site || 'https://buddytex.github.io').href} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site || 'https://buddytex.github.io').href} />
    <meta property="og:image" content={new URL(resolveHref('/images/naveen-portrait.png'), Astro.site || 'https://buddytex.github.io').href} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(resolveHref('/images/naveen-portrait.png'), Astro.site || 'https://buddytex.github.io').href} />

    <title>{title}</title>
    <ClientRouter />
  </head>

  <body>
    <!-- Skip link for accessibility -->
    <a href="#mainContent" class="skip-link">Skip to main content</a>

    <!-- Top edge scroll progress indicator -->
    <div id="scrollBar" aria-hidden="true"></div>

    <!-- Persistent Visual Anchor: Engineering Datum Spine (Desktop) -->
    {showSpine && (
      <aside class="datum-spine-wrap" aria-label="Section Navigation Spine">
      <div class="datum-spine-track" aria-hidden="true">
        <div class="datum-spine-fill" id="datumSpineFill"></div>
      </div>
      <nav class="datum-waypoints" aria-label="Section Milestones">
        <a href={resolveHref('/#hero')} class="datum-node active" data-section="hero" aria-label="01 // Hero">
          <span class="datum-pip"></span>
          <div class="datum-text-block">
            <span class="datum-tag mono">01</span>
            <span class="datum-label mono">HERO</span>
          </div>
        </a>
        <a href={resolveHref('/#roles')} class="datum-node" data-section="roles" aria-label="02 // Roles">
          <span class="datum-pip"></span>
          <div class="datum-text-block">
            <span class="datum-tag mono">02</span>
            <span class="datum-label mono">ROLES</span>
          </div>
        </a>
        <a href={resolveHref('/#work')} class="datum-node" data-section="work" aria-label="03 // Projects">
          <span class="datum-pip"></span>
          <div class="datum-text-block">
            <span class="datum-tag mono">03</span>
            <span class="datum-label mono">PROJECTS</span>
          </div>
        </a>
        <a href={resolveHref('/#experience')} class="datum-node" data-section="experience" aria-label="04 // Experience">
          <span class="datum-pip"></span>
          <div class="datum-text-block">
            <span class="datum-tag mono">04</span>
            <span class="datum-label mono">EXP</span>
          </div>
        </a>
        <a href={resolveHref('/#focus')} class="datum-node" data-section="focus" aria-label="05 // Engineering Focus">
          <span class="datum-pip"></span>
          <div class="datum-text-block">
            <span class="datum-tag mono">05</span>
            <span class="datum-label mono">FOCUS</span>
          </div>
        </a>
        <a href={resolveHref('/#skills')} class="datum-node" data-section="skills" aria-label="06 // Skills">
          <span class="datum-pip"></span>
          <div class="datum-text-block">
            <span class="datum-tag mono">06</span>
            <span class="datum-label mono">SKILLS</span>
          </div>
        </a>
        <a href={resolveHref('/#hardware')} class="datum-node" data-section="hardware" aria-label="07 // PCB Lab">
          <span class="datum-pip"></span>
          <div class="datum-text-block">
            <span class="datum-tag mono">07</span>
            <span class="datum-label mono">PCB LAB</span>
          </div>
        </a>
        <a href={resolveHref('/#beyond')} class="datum-node" data-section="beyond" aria-label="08 // Beyond the Build">
          <span class="datum-pip"></span>
          <div class="datum-text-block">
            <span class="datum-tag mono">08</span>
            <span class="datum-label mono">BEYOND</span>
          </div>
        </a>
        <a href={resolveHref('/#contact')} class="datum-node" data-section="contact" aria-label="09 // Contact">
          <span class="datum-pip"></span>
          <div class="datum-text-block">
            <span class="datum-tag mono">09</span>
            <span class="datum-label mono">CONTACT</span>
          </div>
        </a>
      </nav>
    </aside>
    )}

    <slot />

    <!-- Global Image Lightbox Modal for Uncropped Technical Evidence Inspection -->
    <ImageLightbox />
    <PerformanceDiagnosticHUD />
    <ProjectTransitionOverlay />

    <script>
      import {
        initScrollTracker,
        initSmoothScroll,
        initCustomCursor,
        initMagneticButtons,
        initScrollRevealSystem,
      } from '../animations';

      let trackerCleanup: (() => void) | undefined;
      let cursorCleanup: (() => void) | null | undefined;
      let scrollRevealCleanup: (() => void) | null | undefined;

      function setupPageMotion() {
        if (trackerCleanup) {
          trackerCleanup();
          trackerCleanup = undefined;
        }
        if (cursorCleanup) {
          cursorCleanup();
          cursorCleanup = undefined;
        }
        if (scrollRevealCleanup) {
          scrollRevealCleanup();
          scrollRevealCleanup = undefined;
        }

        // Initialize desktop inertia scroll
        initSmoothScroll();

        // Initialize desktop-only precision cursor
        cursorCleanup = initCustomCursor();

        // Initialize restrained magnetic CTAs
        initMagneticButtons();

        // Initialize Anime.js 4.5.x universal reveals with replay-on-return
        scrollRevealCleanup = initScrollRevealSystem();

        // Initialize datum spine tracker
        trackerCleanup = initScrollTracker();
      }

      document.addEventListener('astro:page-load', setupPageMotion);
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupPageMotion);
      } else {
        setupPageMotion();
      }

      // Top scroll bar progress (RAF throttled with cached height)
      let scrollBarEl: HTMLElement | null = null;
      let scrollTicking = false;
      let cachedMaxScroll = 0;

      function updateMaxScroll() {
        cachedMaxScroll = document.documentElement.scrollHeight - window.innerHeight;
      }
      window.addEventListener('resize', updateMaxScroll, { passive: true });

      window.addEventListener('scroll', () => {
        if (!scrollTicking) {
          scrollTicking = true;
          requestAnimationFrame(() => {
            if (!scrollBarEl) scrollBarEl = document.getElementById('scrollBar');
            if (scrollBarEl) {
              if (cachedMaxScroll <= 0) updateMaxScroll();
              const progress = cachedMaxScroll > 0 ? Math.min(1, Math.max(0, window.scrollY / cachedMaxScroll)) : 0;
              scrollBarEl.style.transform = `scaleX(${progress})`;
            }
            scrollTicking = false;
          });
        }
      }, { passive: true });
    </script>
  </body>
</html>

<style is:global>
  #scrollBar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--accent-primary);
    transform-origin: 0%;
    transform: scaleX(0);
    z-index: 9999;
    box-shadow: 0 0 8px var(--accent-glow);
  }

  /* Universal section anchor offset for sticky nav */
  section[id] {
    scroll-margin-top: calc(var(--nav-height) + 1.5rem);
  }

  /* ==========================================================
     ENGINEERING DATUM SPINE — PERSISTENT VISUAL ANCHOR
     ========================================================== */
  .datum-spine-wrap {
    position: fixed;
    left: clamp(1rem, 2.2vw, 2.8rem);
    top: 50%;
    transform: translateY(-50%);
    z-index: 40;
    display: flex;
    align-items: center;
    pointer-events: auto;
  }

  .datum-spine-track {
    position: absolute;
    left: 2.5px;
    top: 8px;
    bottom: 8px;
    width: 1px;
    background: rgba(20, 24, 34, 0.08);
  }

  .datum-spine-fill {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--color-gold);
    box-shadow: 0 0 6px var(--accent-glow);
    transform-origin: top;
    transform: scaleY(0);
    transition: transform 0.1s linear;
  }

  .datum-waypoints {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    position: relative;
    z-index: 2;
  }

  .datum-node {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    text-decoration: none;
    cursor: pointer;
    padding: 2px 0;
  }

  .datum-pip {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-paper);
    border: 1.5px solid var(--text-dim);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    flex-shrink: 0;
    margin-top: 3px;
  }

  .datum-text-block {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .datum-tag {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--text-dim);
    transition: color 0.2s ease;
    line-height: 1;
    letter-spacing: 0.04em;
  }

  .datum-label {
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    font-weight: 600;
    color: var(--text-dim);
    line-height: 1;
    display: none;
  }

  .datum-node.active .datum-pip {
    background: var(--color-gold);
    border-color: var(--color-gold);
    box-shadow: 0 0 8px rgba(184, 146, 74, 0.7);
    transform: scale(1.15);
  }

  .datum-node.active .datum-tag {
    color: var(--color-ink);
    font-weight: 800;
  }

  .datum-node.active .datum-label {
    display: block;
    color: var(--text-muted);
  }

  .datum-node:hover .datum-tag {
    color: var(--color-ink);
  }

  .datum-node:hover .datum-pip {
    border-color: var(--color-gold);
  }

  /* Responsive: hide below 1100px */
  @media (max-width: 1100px) {
    .datum-spine-wrap {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .datum-spine-fill {
      transition: none;
    }
  }

  /* Reduced motion for portal intro is handled in RobotPortalIntro component */
</style>