---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Naveen Shaji George — Robotics Engineer",
  description = "Robotics engineer specializing in autonomous systems, 3D LiDAR perception, ROS 2, custom embedded ECUs, and vehicle-level hardware-software integration."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Naveen Shaji George" />
    <meta name="theme-color" content="#F8F8F5" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <title>{title}</title>
  </head>

  <body>
    <!-- Scroll progress bar -->
    <div id="scrollBar" aria-hidden="true"></div>

    <!-- Interactive grid canvas — full page, behind everything -->
    <canvas id="gridCanvas" aria-hidden="true"></canvas>

    <slot />

    <script>
      // ============================================================
      // SCROLL PROGRESS
      // ============================================================
      window.addEventListener('scroll', () => {
        const bar = document.getElementById('scrollBar');
        if (!bar) return;
        const max = document.documentElement.scrollHeight - window.innerHeight;
        bar.style.transform = `scaleX(${max > 0 ? window.scrollY / max : 0})`;
      }, { passive: true });

      // ============================================================
      // SCROLL REVEAL
      // ============================================================
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!prefersReduced) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          });
        }, { threshold: 0.07, rootMargin: '0px 0px -32px 0px' });

        document.querySelectorAll('.reveal, .reveal-left, .stagger-children').forEach((el) => io.observe(el));
      } else {
        document.querySelectorAll('.reveal, .reveal-left, .stagger-children').forEach((el) => {
          el.classList.add('is-visible');
        });
      }

      // ============================================================
      // INTERACTIVE GRID — light dot grid with mouse parallax
      // ============================================================
      const canvas = document.getElementById('gridCanvas') as HTMLCanvasElement;
      if (canvas) {
        const ctx = canvas.getContext('2d');
        if (ctx) {
          const GRID = 52;
          const mouse = { x: -9999, y: -9999, tx: -9999, ty: -9999 };
          let w = 0, h = 0;

          function resize() {
            w = window.innerWidth;
            h = window.innerHeight;
            const dpr = Math.min(window.devicePixelRatio || 1, 2);
            canvas.width = w * dpr;
            canvas.height = h * dpr;
            ctx!.scale(dpr, dpr);
          }

          window.addEventListener('resize', resize);
          resize();

          if (!prefersReduced) {
            window.addEventListener('mousemove', (e) => {
              mouse.tx = e.clientX;
              mouse.ty = e.clientY;
            }, { passive: true });
            window.addEventListener('mouseleave', () => {
              mouse.tx = -9999;
              mouse.ty = -9999;
            });
          }

          function draw() {
            if (ctx) {
              ctx.clearRect(0, 0, w, h);

              // Smooth interpolation
              mouse.x += (mouse.tx - mouse.x) * 0.07;
              mouse.y += (mouse.ty - mouse.y) * 0.07;

              const cols = Math.ceil(w / GRID) + 2;
              const rows = Math.ceil(h / GRID) + 2;

              for (let r = 0; r <= rows; r++) {
                for (let c = 0; c <= cols; c++) {
                  const bx = c * GRID;
                  const by = r * GRID;
                  let x = bx;
                  let y = by;

                  // Subtle parallax push toward cursor
                  if (!prefersReduced && mouse.x > -500) {
                    const dx = bx - mouse.x;
                    const dy = by - mouse.y;
                    const dist = Math.sqrt(dx * dx + dy * dy);
                    const radius = 200;
                    if (dist < radius) {
                      const t = 1 - dist / radius;
                      const force = t * t * 5;
                      const angle = Math.atan2(dy, dx);
                      x += Math.cos(angle) * force;
                      y += Math.sin(angle) * force;
                    }
                  }

                  // Draw dot
                  ctx.beginPath();
                  ctx.arc(x, y, 0.75, 0, Math.PI * 2);
                  ctx.fillStyle = 'rgba(0,0,0,0.09)';
                  ctx.fill();
                }
              }
            }

            requestAnimationFrame(draw);
          }

          draw();
        }
      }
    </script>
  </body>
</html>

<style is:global>
  canvas#gridCanvas {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 0;
  }

  #scrollBar {
    position: fixed;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: var(--cyan);
    transform-origin: 0%;
    transform: scaleX(0);
    z-index: 9999;
  }
</style>
