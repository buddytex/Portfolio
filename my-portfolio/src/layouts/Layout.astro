---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Naveen Shaji George | Robotics & Autonomous Systems Engineer",
  description = "Robotics Engineer specializing in autonomous systems, 3D LiDAR perception, custom vehicle ECUs, isolated CAN bus networks, and ROS 2 software integration. AIR 7 and AIR 11 aBAJA team leader."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Naveen Shaji George" />
    <meta name="theme-color" content="#0B0D0F" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <title>{title}</title>
    <script is:inline src="/scripts/motion.js"></script>
  </head>

  <body>
    <!-- Subtle Scroll Progress Indicator -->
    <div id="scrollProgressBar" aria-hidden="true"></div>

    <!-- Subtle Interactive Spatial Background Grid Canvas -->
    <canvas id="interactiveGridCanvas" class="interactive-grid-canvas" aria-hidden="true"></canvas>

    <slot />

    <!-- Interactive Grid & Motion.dev Script -->
    <script>
      // ==========================================================
      // 1. SUBTLE INTERACTIVE BACKGROUND GRID WITH CURSOR DEFLECTION
      // ==========================================================
      const gridCanvas = document.getElementById('interactiveGridCanvas') as HTMLCanvasElement;
      if (gridCanvas) {
        const ctx = gridCanvas.getContext('2d');
        if (ctx) {
          let w = 0;
          let h = 0;
          const gridSize = 64;
          const mouse = { x: -9999, y: -9999, targetX: -9999, targetY: -9999 };

          function resizeGrid() {
            w = window.innerWidth;
            h = window.innerHeight;
            const dpr = Math.min(window.devicePixelRatio || 1, 2);
            gridCanvas.width = w * dpr;
            gridCanvas.height = h * dpr;
            ctx!.scale(dpr, dpr);
          }

          window.addEventListener('resize', resizeGrid);
          resizeGrid();

          window.addEventListener('mousemove', (e) => {
            mouse.targetX = e.clientX;
            mouse.targetY = e.clientY;
          }, { passive: true });

          window.addEventListener('mouseleave', () => {
            mouse.targetX = -9999;
            mouse.targetY = -9999;
          });

          let animId = 0;
          const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

          function renderGrid() {
            ctx!.clearRect(0, 0, w, h);

            // Smooth mouse interpolation
            mouse.x += (mouse.targetX - mouse.x) * 0.08;
            mouse.y += (mouse.targetY - mouse.y) * 0.08;

            ctx!.lineWidth = 1;
            const cols = Math.ceil(w / gridSize) + 1;
            const rows = Math.ceil(h / gridSize) + 1;

            ctx!.strokeStyle = 'rgba(255, 255, 255, 0.022)';

            // Draw horizontal lines
            for (let r = 0; r <= rows; r++) {
              const yBase = r * gridSize;
              ctx!.beginPath();

              for (let c = 0; c <= cols; c++) {
                const xBase = c * gridSize;
                let x = xBase;
                let y = yBase;

                if (!prefersReduced && mouse.x > -500) {
                  const d = Math.hypot(xBase - mouse.x, yBase - mouse.y);
                  if (d < 220) {
                    const factor = Math.pow(1 - d / 220, 2) * 9;
                    const ang = Math.atan2(yBase - mouse.y, xBase - mouse.x);
                    x += Math.cos(ang) * factor;
                    y += Math.sin(ang) * factor;
                  }
                }

                if (c === 0) ctx!.moveTo(x, y);
                else ctx!.lineTo(x, y);
              }
              ctx!.stroke();
            }

            // Draw vertical lines
            for (let c = 0; c <= cols; c++) {
              const xBase = c * gridSize;
              ctx!.beginPath();

              for (let r = 0; r <= rows; r++) {
                const yBase = r * gridSize;
                let x = xBase;
                let y = yBase;

                if (!prefersReduced && mouse.x > -500) {
                  const d = Math.hypot(xBase - mouse.x, yBase - mouse.y);
                  if (d < 220) {
                    const factor = Math.pow(1 - d / 220, 2) * 9;
                    const ang = Math.atan2(yBase - mouse.y, xBase - mouse.x);
                    x += Math.cos(ang) * factor;
                    y += Math.sin(ang) * factor;
                  }
                }

                if (r === 0) ctx!.moveTo(x, y);
                else ctx!.lineTo(x, y);
              }
              ctx!.stroke();
            }

            animId = requestAnimationFrame(renderGrid);
          }

          if (!prefersReduced) {
            renderGrid();
          } else {
            renderGrid();
            cancelAnimationFrame(animId);
          }
        }
      }

      // ==========================================================
      // 2. SCROLL PROGRESS INDICATOR
      // ==========================================================
      const Motion = (window as any).Motion;
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (Motion && Motion.scroll && Motion.animate && !prefersReducedMotion) {
        try {
          Motion.scroll(
            Motion.animate('#scrollProgressBar', { scaleX: [0, 1] }, { ease: 'linear' })
          );
        } catch {
          window.addEventListener('scroll', () => {
            const bar = document.getElementById('scrollProgressBar');
            if (bar) {
              const max = document.documentElement.scrollHeight - window.innerHeight;
              const p = max > 0 ? window.scrollY / max : 0;
              bar.style.transform = `scaleX(${p})`;
            }
          }, { passive: true });
        }
      } else {
        window.addEventListener('scroll', () => {
          const bar = document.getElementById('scrollProgressBar');
          if (bar) {
            const max = document.documentElement.scrollHeight - window.innerHeight;
            const p = max > 0 ? window.scrollY / max : 0;
            bar.style.transform = `scaleX(${p})`;
          }
        }, { passive: true });
      }
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';

  #scrollProgressBar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--cyan);
    transform-origin: 0%;
    transform: scaleX(0);
    z-index: 9999;
    box-shadow: 0 0 10px var(--cyan-glow);
  }
</style>
