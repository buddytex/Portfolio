---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Naveen Shaji George — Robotics & Autonomous Systems Engineer",
  description = "Robotics engineer specializing in autonomous systems, 3D LiDAR perception, ROS 2 Humble, custom vehicle ECUs, isolated CAN bus networks, and vehicle-level hardware-software integration."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Naveen Shaji George" />
    <meta name="theme-color" content="#080909" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <title>{title}</title>
  </head>

  <body>
    <!-- Skip link for accessibility -->
    <a href="#mainContent" class="skip-link">Skip to main content</a>

    <!-- Top edge scroll progress indicator -->
    <div id="scrollBar" aria-hidden="true"></div>

    <!-- Persistent Visual Anchor: Engineering Datum Spine (Desktop) -->
    <aside class="datum-spine-wrap" aria-label="Section Navigation Spine">
      <div class="datum-spine-track" aria-hidden="true">
        <div class="datum-spine-fill" id="datumSpineFill"></div>
      </div>
      <nav class="datum-waypoints" aria-label="Section Milestones">
        <a href="/#hero" class="datum-node active" data-section="hero" aria-label="00 // Origin (Hero)">
          <span class="datum-pip"></span>
          <span class="datum-tag mono">00</span>
          <span class="datum-label mono">ORIGIN</span>
        </a>
        <a href="/#work" class="datum-node" data-section="work" aria-label="01 // Projects">
          <span class="datum-pip"></span>
          <span class="datum-tag mono">01</span>
          <span class="datum-label mono">PROJECTS</span>
        </a>
        <a href="/#skills" class="datum-node" data-section="skills" aria-label="02 // Skills & Evidence">
          <span class="datum-pip"></span>
          <span class="datum-tag mono">02</span>
          <span class="datum-label mono">EVIDENCE</span>
        </a>
        <a href="/#about" class="datum-node" data-section="about" aria-label="03 // Engineering Chronology">
          <span class="datum-pip"></span>
          <span class="datum-tag mono">03</span>
          <span class="datum-label mono">CHRONOLOGY</span>
        </a>
        <a href="/#contact" class="datum-node" data-section="contact" aria-label="04 // Direct Dispatch">
          <span class="datum-pip"></span>
          <span class="datum-tag mono">04</span>
          <span class="datum-label mono">DISPATCH</span>
        </a>
      </nav>
    </aside>

    <slot />

    <script>
      import { initScrollTracker, initScrollReveal } from '../lib/motion';
      import { initSectionTransitions } from '../lib/animations/sectionTransitions';

      // Initialize scroll systems
      initScrollTracker();
      initScrollReveal();
      
      // Initialize section transitions
      let sectionTransitionsCleanup: (() => void) | null = null;
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
          const cleanup = initSectionTransitions();
          if (cleanup) sectionTransitionsCleanup = cleanup;
        });
      } else {
        const cleanup = initSectionTransitions();
        if (cleanup) sectionTransitionsCleanup = cleanup;
      }
      
      // Cleanup on page unload
      window.addEventListener('beforeunload', () => {
        if (sectionTransitionsCleanup) sectionTransitionsCleanup();
      });

      // Top scroll bar progress
      window.addEventListener('scroll', () => {
        const bar = document.getElementById('scrollBar');
        if (!bar) return;
        const max = document.documentElement.scrollHeight - window.innerHeight;
        bar.style.transform = `scaleX(${max > 0 ? window.scrollY / max : 0})`;
      }, { passive: true });

      // Smooth scroll for anchor links
      (document.querySelectorAll('a[href^="#"], a[href^="/#"]') as NodeListOf<HTMLAnchorElement>).forEach((anchor) => {
        anchor.addEventListener('click', (e: MouseEvent) => {
          const rawHref = anchor.getAttribute('href');
          if (!rawHref) return;
          const hashIdx = rawHref.indexOf('#');
          if (hashIdx === -1) return;
          const targetId = rawHref.substring(hashIdx);

          if (window.location.pathname === '/' || window.location.pathname === '') {
            const target = document.querySelector(targetId) as HTMLElement | null;
            if (target) {
              e.preventDefault();
              history.pushState(null, '', targetId);
              target.scrollIntoView({ behavior: 'smooth' });
              target.setAttribute('tabindex', '-1');
              target.focus({ preventScroll: true });
            }
          }
        });
      });
    </script>
  </body>
</html>

<style is:global>
  #scrollBar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--cyan);
    transform-origin: 0%;
    transform: scaleX(0);
    z-index: 9999;
    box-shadow: 0 0 8px var(--cyan-glow);
  }

  /* Universal section anchor offset for sticky nav */
  section[id] {
    scroll-margin-top: calc(var(--nav-height) + 1.5rem);
  }

  /* ==========================================================
     ENGINEERING DATUM SPINE — PERSISTENT VISUAL ANCHOR
     ========================================================== */
  .datum-spine-wrap {
    position: fixed;
    left: clamp(1rem, 2.2vw, 2.8rem);
    top: 50%;
    transform: translateY(-50%);
    z-index: 40;
    display: flex;
    align-items: center;
    pointer-events: auto;
  }

  .datum-spine-track {
    position: absolute;
    left: 4.5px;
    top: 12px;
    bottom: 12px;
    width: 1px;
    background: rgba(255, 255, 255, 0.08);
  }

  .datum-spine-fill {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--cyan);
    box-shadow: 0 0 6px var(--cyan-glow);
    transform-origin: top;
    transform: scaleY(0);
    transition: transform 0.1s linear;
  }

  .datum-waypoints {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    position: relative;
    z-index: 2;
  }

  .datum-node {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--text-dim);
    transition: color 0.2s ease;
    cursor: pointer;
    padding: 2px 0;
  }

  .datum-pip {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #111415;
    border: 1.5px solid rgba(255, 255, 255, 0.2);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    flex-shrink: 0;
  }

  .datum-tag {
    font-size: 0.65rem;
    color: var(--text-dim);
    transition: color 0.2s ease;
    letter-spacing: 0.04em;
  }

  .datum-label {
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    opacity: 0;
    transform: translateX(-4px);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
    white-space: nowrap;
    color: var(--text-secondary);
  }

  .datum-node:hover .datum-label,
  .datum-node.active .datum-label {
    opacity: 1;
    transform: translateX(0);
  }

  .datum-node:hover {
    color: var(--text-primary);
  }

  .datum-node:hover .datum-pip {
    border-color: var(--cyan);
    background: var(--cyan-light);
  }

  .datum-node.active .datum-pip {
    background: var(--cyan);
    border-color: var(--cyan);
    box-shadow: 0 0 10px var(--cyan-glow);
    transform: scale(1.15);
  }

  .datum-node.active .datum-tag,
  .datum-node.active .datum-label {
    color: var(--text-primary);
    font-weight: 600;
  }

  /* Hide on screens narrower than 1440px to avoid competing with content */
  @media (max-width: 1440px) {
    .datum-spine-wrap {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .datum-spine-fill {
      transition: none;
    }
  }

  /* Reduced motion for portal intro is handled in RobotPortalIntro component */
</style>