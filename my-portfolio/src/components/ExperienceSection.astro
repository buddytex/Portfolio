---
// ExperienceSection Component — Professional & Clinical Internship Experience
// Strictly separated from personal engineering projects to preserve technical integrity.
import { experiences } from '../data/experience';
import { resolveMediaUrl } from '../utils/media';
const primaryExp = experiences[0];
---

<section id="experience" class="section experience-section" aria-labelledby="experienceSectionHeading">
  <div class="container-wide">
    <!-- Section Header -->
    <div class="section-header">
      <div class="header-kicker mono">[ 04 // PROFESSIONAL EXPERIENCE ]</div>
      <h2 id="experienceSectionHeading" class="section-title">
        Clinical &amp; Industrial <span class="accent">Engineering Experience</span>
      </h2>
      <p class="section-lead">
        Professional clinical immersion and technical observation. Grounding theoretical robotics in real-world operating environments and medical-grade safety standards.
      </p>
    </div>

    <!-- Experience Card Stage -->
    {primaryExp && (
      <article class="experience-card scroll-reveal-node" data-reveal="experience">
        <div class="exp-grid">
          <!-- Left Column: Visual Media & Operating Theatre Artifacts -->
          <div class="exp-media-column">
            <div class="exp-video-wrap">
              <video
                src={resolveMediaUrl(primaryExp.videoPath)}
                autoplay
                loop
                muted
                playsinline
                class="exp-video"
                poster={resolveMediaUrl(primaryExp.imagePath)}
                title="CMR Versius Surgeon Console Teleoperation Hand Controllers"
              ></video>
              <div class="exp-video-overlay mono">
                <span class="video-pip">●</span>
                <span>CMR VERSIUS SURGEON CONSOLE TELEOPERATION</span>
              </div>
            </div>

            <!-- Supporting Clinical Photos Grid -->
            <div class="exp-photo-duo">
              <div
                class="exp-photo-item"
                data-lightbox={resolveMediaUrl(primaryExp.secondaryImage)}
                data-title="Sterile Operating Suite Immersion"
                data-badge="CLINICAL ENVIRONMENT"
                data-caption="Naveen Shaji George in sterile surgical scrubs, cap, and mask inside the live operating suite at Muthoot Hospitals."
              >
                <img
                  src={resolveMediaUrl(primaryExp.secondaryImage)}
                  alt="Operating Suite Immersion"
                  class="exp-photo img-expandable"
                  loading="lazy"
                />
                <span class="photo-tag mono">CLINICAL SUITE</span>
              </div>

              <div
                class="exp-photo-item"
                data-lightbox={resolveMediaUrl(primaryExp.imagePath)}
                data-title="CMR Versius Modular Robotic Arms"
                data-badge="ROBOT HARDWARE"
                data-caption="Modular bedside robotic arm units configured with articulated laparoscopic surgical instruments."
              >
                <img
                  src={resolveMediaUrl(primaryExp.imagePath)}
                  alt="CMR Versius Bedside Robotic Arms"
                  class="exp-photo img-expandable"
                  loading="lazy"
                />
                <span class="photo-tag mono">BEDSIDE ARMS</span>
              </div>
            </div>
          </div>

          <!-- Right Column: Institutional Verification & Technical Breakdown -->
          <div class="exp-content-column">
            <!-- Header Badge & Organization -->
            <div class="exp-header-block">
              <div class="exp-meta-row">
                <span class="exp-type-badge mono">{primaryExp.badge}</span>
                <span class="exp-period mono">{primaryExp.period}</span>
              </div>
              <h3 class="exp-role-title">{primaryExp.role}</h3>
              <div class="exp-org mono">
                <span class="org-name">{primaryExp.organization}</span>
                <span class="org-sep">·</span>
                <span class="org-loc">{primaryExp.location}</span>
              </div>
            </div>

            <p class="exp-summary">{primaryExp.summary}</p>

            <!-- Section 1: Systems Observed & Exposed To -->
            <div class="exp-block">
              <h4 class="block-title mono">
                <span class="block-glyph">■</span>
                <span>SYSTEMS &amp; HARDWARE EXPOSURE</span>
              </h4>
              <ul class="exp-list">
                {primaryExp.systemsExposed.map((item) => (
                  <li class="exp-list-item">
                    <span class="list-bullet mono">▸</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Section 2: Clinical Activities & Procedures Observed -->
            <div class="exp-block">
              <h4 class="block-title mono">
                <span class="block-glyph">■</span>
                <span>CLINICAL ACTIVITIES &amp; WORKFLOWS OBSERVED</span>
              </h4>
              <ul class="exp-list">
                {primaryExp.observedActivities.map((item) => (
                  <li class="exp-list-item">
                    <span class="list-bullet mono">▸</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Section 3: Engineering Insights Applied to Autonomous Projects -->
            <div class="exp-block block-applied">
              <h4 class="block-title mono text-gold">
                <span class="block-glyph">⚡</span>
                <span>TRANSFERABLE INSIGHTS APPLIED TO ROBOTICS PROJECTS</span>
              </h4>
              <ul class="exp-list">
                {primaryExp.appliedLearnings.map((item) => (
                  <li class="exp-list-item">
                    <span class="list-bullet mono text-gold">▸</span>
                    <span class="text-applied">{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </article>
    )}
  </div>
</section>

<style>
  .experience-section {
    background: transparent;
    padding-top: var(--section-pad);
    padding-bottom: var(--space-16);
    position: relative;
    border-bottom: 1px solid var(--border-subtle);
  }

  .experience-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-card);
    overflow: hidden;
    box-shadow: var(--shadow-resting);
    margin-top: var(--space-10);
  }

  .exp-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 0;
  }

  /* Left Column: Media */
  .exp-media-column {
    background: #0E1117;
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    border-right: 1px solid var(--border-subtle);
  }

  .exp-video-wrap {
    position: relative;
    border-radius: var(--r-md);
    overflow: hidden;
    background: #000;
    aspect-ratio: 16 / 10;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .exp-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .exp-video-overlay {
    position: absolute;
    bottom: 8px;
    left: 10px;
    right: 10px;
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.62rem;
    color: #F8FAFC;
    background: rgba(14, 17, 23, 0.85);
    backdrop-filter: blur(6px);
    padding: 4px 8px;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    letter-spacing: 0.04em;
    font-weight: 600;
  }

  .video-pip {
    color: #EF4444;
    font-size: 0.55rem;
    animation: video-pip-pulse 1.8s infinite;
  }

  @keyframes video-pip-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  .exp-photo-duo {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .exp-photo-item {
    position: relative;
    border-radius: var(--r-sm);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border: 1px solid rgba(255, 255, 255, 0.08);
    cursor: pointer;
  }

  .exp-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-norm) var(--ease-out);
  }

  .exp-photo-item:hover .exp-photo {
    transform: scale(1.04);
  }

  .photo-tag {
    position: absolute;
    bottom: 6px;
    left: 6px;
    font-size: 0.58rem;
    color: #E2E8F0;
    background: rgba(0, 0, 0, 0.75);
    padding: 2px 6px;
    border-radius: 3px;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  /* Right Column: Content */
  .exp-content-column {
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .exp-header-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
  }

  .exp-meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .exp-type-badge {
    font-size: 0.65rem;
    color: var(--color-gold);
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .exp-period {
    font-size: 0.72rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .exp-role-title {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.25;
  }

  .exp-org {
    display: flex;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .org-name {
    font-weight: 600;
    color: var(--text-secondary);
  }

  .exp-summary {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .exp-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .block-title {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.06em;
  }

  .block-glyph {
    font-size: 0.55rem;
    color: var(--color-gold);
  }

  .exp-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .exp-list-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .list-bullet {
    color: var(--text-dim);
    font-size: 0.7rem;
    margin-top: 1px;
    flex-shrink: 0;
  }

  .block-applied {
    background: rgba(184, 146, 74, 0.05);
    border: 1px solid rgba(184, 146, 74, 0.2);
    border-radius: var(--r-sm);
    padding: var(--space-4);
  }

  .text-gold {
    color: var(--color-gold);
  }

  .text-applied {
    color: var(--text-primary);
    font-weight: 500;
  }

  @media (max-width: 1024px) {
    .exp-grid {
      grid-template-columns: 1fr;
    }

    .exp-media-column {
      border-right: none;
      border-bottom: 1px solid var(--border-subtle);
    }
  }
</style>

<script>
  function setupExperienceVideo() {
    const video = document.querySelector<HTMLVideoElement>('.experience-section .exp-video');
    if (!video) return;

    video.muted = true;

    // Viewport-aware autoplay and pause: saves CPU/GPU when offscreen
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        });
      }, { rootMargin: '100px 0px 100px 0px', threshold: 0.1 });

      observer.observe(video);
    } else {
      video.play().catch(() => {});
    }
  }

  document.addEventListener('DOMContentLoaded', setupExperienceVideo);
  document.addEventListener('astro:page-load', setupExperienceVideo);
</script>
