---
// CircuitBoard Component — High-Precision Deterministic PCB Architecture
// Engineered exclusively for the Hero Section:
// - 100% deterministic layout (NO Math.random)
// - Purposeful routing: frames typography, bridges CTA to 3D hardware core
// - Clear hierarchy: 10% hero highways, 20% secondary buses, 70% subtle hairlines
// - Generous negative space preserving typographic legibility
// - Contained strictly to Hero section (no leaking across rest of site)
// - High-DPR canvas rendering, interactive cursor proximity, traveling gold pulses
---

<canvas id="circuitBoardCanvas" aria-hidden="true"></canvas>

<script>
  import { registerCircuitVisibility, type CircuitController } from '../animations';

  let currentCircuitController: CircuitController | null = null;
  let circuitLoopId: number | null = null;
  let isCircuitVisible = true;

  function initHeroPCB() {
    if (currentCircuitController) {
      currentCircuitController.destroy();
      currentCircuitController = null;
    }
    if (circuitLoopId) {
      cancelAnimationFrame(circuitLoopId);
      circuitLoopId = null;
    }

    const canvas = document.getElementById('circuitBoardCanvas') as HTMLCanvasElement;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const heroSection = document.getElementById('hero');
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let W = 0;
    let H = 0;
    let DPR = 1;

    interface NodeDef {
      u: number; // 0..1 normalized X
      v: number; // 0..1 normalized Y
      shape: 'glow_via' | 'via' | 'pad' | 'ic' | 'dot';
      size: number;
      label?: string;
    }

    interface TraceDef {
      tier: 'highway' | 'medium' | 'hairline';
      points: [number, number][]; // array of [u, v]
      hasPulse?: boolean;
    }

    interface MarkerDef {
      u: number;
      v: number;
      type: 'cross' | 'dot_matrix' | 'label';
      text?: string;
    }

    // -----------------------------------------------------------
    // DETERMINISTIC PCB TOPOLOGY ARCHITECTURE
