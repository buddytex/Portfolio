      },
      // Channel 4: Highway C (Left Edge Industrial Bus -> Ground Plane) - Slow Heavy Rail
      {
        traceIdx: 2,
        reverse: false,
        speed: 185,
        length: 64,
        dist: 0,
        pause: 0.10,
        pauseMin: 0.65,
        pauseMax: 1.25,
        coreColor: '#FFE8A3',
