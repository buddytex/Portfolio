        coreWidth: 2.8,
        sparkRadius: 2.4,
      },
      // Channel 7: Secondary Route 10 (Bottom Finger 3 -> Into 3D Core)
      {
        traceIdx: 10,
        reverse: false,
        speed: 300,
        length: 44,
        dist: 0,
        pause: 0.50,
        pauseMin: 0.45,
        pauseMax: 0.95,
        coreColor: '#FFFDF0',
        glowColor: 'rgba(230, 190, 100, 0.85)',
        coreWidth: 2.8,
        sparkRadius: 2.6,
      },
    ];

    // Mouse coordinates relative to Hero canvas
    const mouse = { x: -9999, y: -9999, active: false };

    // Offscreen caching for static PCB elements (hairlines, base copper, markers, default vias)
    let staticCanvas: HTMLCanvasElement | null = null;
    let staticCtx: CanvasRenderingContext2D | null = null;

    function renderStaticLayers() {
      if (!staticCanvas) {
        staticCanvas = document.createElement('canvas');
      }
      staticCanvas.width = Math.floor(W * DPR);
      staticCanvas.height = Math.floor(H * DPR);
      staticCtx = staticCanvas.getContext('2d');
      if (!staticCtx) return;
      staticCtx.setTransform(DPR, 0, 0, DPR, 0, 0);
      staticCtx.clearRect(0, 0, W, H);
      staticCtx.lineCap = 'round';
      staticCtx.lineJoin = 'round';

      // 1. Subtle Hairlines
      rawTraces.forEach((trace) => {
        if (trace.tier !== 'hairline') return;
        const pts = trace.points.map(([u, v]) => ({ x: u * W, y: v * H }));
        staticCtx!.beginPath();
        staticCtx!.moveTo(pts[0].x, pts[0].y);
        for (let i = 1; i < pts.length; i++) {
          staticCtx!.lineTo(pts[i].x, pts[i].y);
        }
        staticCtx!.strokeStyle = '#D8BE8A';
        staticCtx!.globalAlpha = 0.18;
        staticCtx!.lineWidth = 0.85;
        staticCtx!.stroke();
      });

      // 2. Base Medium Traces
      rawTraces.forEach((trace) => {
        if (trace.tier !== 'medium') return;
        const pts = trace.points.map(([u, v]) => ({ x: u * W, y: v * H }));
        staticCtx!.beginPath();
        staticCtx!.moveTo(pts[0].x, pts[0].y);
        for (let i = 1; i < pts.length; i++) {
          staticCtx!.lineTo(pts[i].x, pts[i].y);
        }
        staticCtx!.strokeStyle = '#C5A059';
        staticCtx!.globalAlpha = 0.38;
        staticCtx!.lineWidth = 1.35;
        staticCtx!.stroke();
      });

      // 3. Base Highway Traces
      rawTraces.forEach((trace) => {
        if (trace.tier !== 'highway') return;
        const pts = trace.points.map(([u, v]) => ({ x: u * W, y: v * H }));
        staticCtx!.beginPath();
        staticCtx!.moveTo(pts[0].x, pts[0].y);
        for (let i = 1; i < pts.length; i++) {
          staticCtx!.lineTo(pts[i].x, pts[i].y);
        }
        staticCtx!.strokeStyle = '#B8924A';
        staticCtx!.globalAlpha = 0.78;
        staticCtx!.lineWidth = 2.4;
        staticCtx!.stroke();
      });

      // 4. Technical Markers
      rawMarkers.forEach((m) => {
        const x = m.u * W;
        const y = m.v * H;
        staticCtx!.globalAlpha = 0.35;

        if (m.type === 'cross') {
          staticCtx!.strokeStyle = '#B8924A';
          staticCtx!.lineWidth = 1.0;
          staticCtx!.beginPath();
          staticCtx!.moveTo(x - 5, y);
          staticCtx!.lineTo(x + 5, y);
          staticCtx!.moveTo(x, y - 5);
          staticCtx!.lineTo(x, y + 5);
          staticCtx!.stroke();
        } else if (m.type === 'dot_matrix') {
          staticCtx!.fillStyle = '#C5A059';
          for (let dx = -1; dx <= 1; dx++) {
            for (let dy = -1; dy <= 1; dy++) {
              staticCtx!.beginPath();
              staticCtx!.arc(x + dx * 5, y + dy * 5, 0.9, 0, Math.PI * 2);
              staticCtx!.fill();
            }
          }
        }
      });

      // 5. Base PCB Nodes
      rawNodes.forEach((node) => {
        const x = node.u * W;
        const y = node.v * H;

        if (node.shape === 'glow_via') {
          const haloRad = staticCtx!.createRadialGradient(x, y, 1, x, y, node.size * 3.8);
          haloRad.addColorStop(0, 'rgba(230, 186, 92, 0.55)');
          haloRad.addColorStop(0.5, 'rgba(230, 186, 92, 0.20)');
          haloRad.addColorStop(1, 'rgba(230, 186, 92, 0)');
          staticCtx!.fillStyle = haloRad;
          staticCtx!.globalAlpha = 0.85;
          staticCtx!.beginPath();
          staticCtx!.arc(x, y, node.size * 3.8, 0, Math.PI * 2);
          staticCtx!.fill();

          staticCtx!.beginPath();
          staticCtx!.arc(x, y, node.size, 0, Math.PI * 2);
          staticCtx!.fillStyle = '#B8924A';
          staticCtx!.globalAlpha = 0.95;
          staticCtx!.fill();

          staticCtx!.beginPath();
          staticCtx!.arc(x, y, node.size * 0.38, 0, Math.PI * 2);
          staticCtx!.fillStyle = '#222834';
          staticCtx!.fill();
        } else if (node.shape === 'via') {
          staticCtx!.beginPath();
          staticCtx!.arc(x, y, node.size, 0, Math.PI * 2);
          staticCtx!.fillStyle = '#C5A059';
          staticCtx!.globalAlpha = 0.70;
          staticCtx!.fill();

          staticCtx!.beginPath();
          staticCtx!.arc(x, y, node.size * 0.45, 0, Math.PI * 2);
          staticCtx!.fillStyle = '#F7F5F0';
          staticCtx!.fill();
        } else if (node.shape === 'ic') {
          const s = node.size;
          staticCtx!.fillStyle = 'rgba(28, 33, 44, 0.85)';
          staticCtx!.globalAlpha = 0.85;
          staticCtx!.fillRect(x - s / 2, y - s / 2, s, s);

          staticCtx!.strokeStyle = '#B8924A';
          staticCtx!.lineWidth = 1;
          staticCtx!.strokeRect(x - s / 2, y - s / 2, s, s);

          staticCtx!.fillStyle = '#E5C678';
          const pins = 3;
          for (let p = 0; p < pins; p++) {
            const py = y - s / 2 + (s / (pins + 1)) * (p + 1);
            staticCtx!.fillRect(x - s / 2 - 3, py - 1, 3, 2);
            staticCtx!.fillRect(x + s / 2, py - 1, 3, 2);
          }
        }
      });
      staticCtx.globalAlpha = 1.0;
    }

    function resize() {
      // Size canvas to Hero parent container (NOT entire window!)
      const parent = canvas.parentElement || heroSection || document.body;
      W = parent.clientWidth;
      H = parent.clientHeight;
      DPR = Math.min(window.devicePixelRatio || 1, 1.75);

      canvas.width = Math.floor(W * DPR);
      canvas.height = Math.floor(H * DPR);
      canvas.style.width = `${W}px`;
      canvas.style.height = `${H}px`;
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);

      renderStaticLayers();

      // Pre-stagger initial distance along each trace so pulses do not start simultaneously
      const INITIAL_OFFSETS = [0.15, 0.55, 0.35, 0.75, 0.20, 0.60, 0.40, 0.85];
      PULSE_CHANNELS.forEach((p, idx) => {
        const trace = rawTraces[p.traceIdx];
        if (trace) {
          const pts = trace.points.map(([u, v]) => ({ x: u * W, y: v * H }));
          const { total } = getTraceLengths(pts);
          p.dist = (INITIAL_OFFSETS[idx % INITIAL_OFFSETS.length] || 0.2) * total;
          p.pause = 0;
        }
      });

      drawFrame(performance.now(), 0.016);
    }

    // Expose circuit controls for coordinated cinematic intro animations
    (window as any).__HERO_CIRCUIT_CONTROLS__ = {
      triggerSignalBurst: () => {
        PULSE_CHANNELS.forEach((p, idx) => {
          p.pause = 0;
          p.dist = idx * 30;
        });
      },
    };

    // Helper: compute total length of polyline
    function getTraceLengths(points: { x: number; y: number }[]): { total: number; segs: number[] } {
      let total = 0;
      const segs: number[] = [];
      for (let i = 0; i < points.length - 1; i++) {
        const d = Math.hypot(points[i + 1].x - points[i].x, points[i + 1].y - points[i].y);
        segs.push(d);
        total += d;
      }
      return { total, segs };
    }

    // Helper: interpolate point along polyline
    function getPointAtDistance(
      points: { x: number; y: number }[],
      targetDist: number,
      segs: number[]
    ): { x: number; y: number } {
      let accum = 0;
      for (let i = 0; i < segs.length; i++) {
        const segLen = segs[i];
        if (accum + segLen >= targetDist) {
          const ratio = (targetDist - accum) / (segLen || 1);
          return {
            x: points[i].x + (points[i + 1].x - points[i].x) * ratio,
            y: points[i].y + (points[i + 1].y - points[i].y) * ratio,
          };
        }
        accum += segLen;
      }
      return points[points.length - 1];
    }

    let lastTime = performance.now();

    function drawFrame(now: number, dt: number) {
      ctx.clearRect(0, 0, W, H);

      // Fast-path: Draw cached static PCB topology in 1 single GPU blit
      if (staticCanvas) {
        ctx.save();
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.drawImage(staticCanvas, 0, 0);
        ctx.restore();
      }

      // If mouse is active near Hero, draw dynamic proximity glow overlay
      if (mouse.active) {
        rawTraces.forEach((trace) => {
          if (trace.tier === 'hairline') return;
          const pts = trace.points.map(([u, v]) => ({ x: u * W, y: v * H }));
          let proximityBoost = 0;
          for (const p of pts) {
            const d = Math.hypot(p.x - mouse.x, p.y - mouse.y);
            const maxD = trace.tier === 'highway' ? 200 : 160;
            if (d < maxD) {
              proximityBoost = Math.max(proximityBoost, 1 - d / maxD);
            }
          }
          if (proximityBoost > 0.05) {
            ctx.beginPath();
            ctx.moveTo(pts[0].x, pts[0].y);
            for (let i = 1; i < pts.length; i++) {
              ctx.lineTo(pts[i].x, pts[i].y);
            }
            if (trace.tier === 'highway') {
              ctx.strokeStyle = '#E5C678';
              ctx.globalAlpha = proximityBoost * 0.45;
              ctx.lineWidth = 2.4 + proximityBoost * 0.8;
            } else {
              ctx.strokeStyle = '#D8BE8A';
              ctx.globalAlpha = proximityBoost * 0.35;
              ctx.lineWidth = 1.35 + proximityBoost * 0.5;
            }
            ctx.stroke();
          }
        });
      }

      // 4. Draw Traveling Pulses along Existing Circuit Traces (Multi-Channel Deterministic Signal Flow)
      if (!prefersReduced) {
        // Density scaling: Desktop (4-8) -> 6-7, Tablet (3-5) -> 4, Mobile (2-4) -> 3
        let maxActivePulses = 6;
        if (W < 640) {
          maxActivePulses = 3;
        } else if (W < 1024) {
          maxActivePulses = 4;
        } else if (W >= 1440) {
          maxActivePulses = 7;
        }

        const speedMultiplier = (typeof window !== 'undefined' && (window as any).__HERO_CIRCUIT_SPEED_BOOST__) || 1.0;

        for (let i = 0; i < maxActivePulses; i++) {
          const p = PULSE_CHANNELS[i];
          if (!p) continue;

          if (p.pause > 0) {
            p.pause -= dt;
            continue;
          }

          const trace = rawTraces[p.traceIdx];
          if (!trace) continue;

          const rawPts = trace.points.map(([u, v]) => ({ x: u * W, y: v * H }));
          const pts = p.reverse ? [...rawPts].reverse() : rawPts;
          const { total, segs } = getTraceLengths(pts);

          p.dist += p.speed * dt * speedMultiplier;

          if (p.dist > total + p.length) {
            // Pause before replay: deterministic variation
            const pauseRange = p.pauseMax - p.pauseMin;
            p.pause = p.pauseMin + ((i * 0.17) % 1) * pauseRange;
            p.dist = 0;
          } else if (p.dist > 0 && p.dist - p.length < total) {
            const headDist = Math.min(p.dist, total);
            const tailDist = Math.max(p.dist - p.length, 0);

            const pHead = getPointAtDistance(pts, headDist, segs);
            const pTail = getPointAtDistance(pts, tailDist, segs);

            // 1. Subtle Outer Glow Stroke
            const glowGrad = ctx.createLinearGradient(pTail.x, pTail.y, pHead.x, pHead.y);
            glowGrad.addColorStop(0, 'rgba(255, 238, 179, 0)');
            glowGrad.addColorStop(0.5, p.glowColor);
            glowGrad.addColorStop(1, p.coreColor);

            ctx.beginPath();
            ctx.moveTo(pTail.x, pTail.y);
            ctx.lineTo(pHead.x, pHead.y);
            ctx.strokeStyle = glowGrad;
            ctx.lineWidth = p.coreWidth + 2.6;
            ctx.globalAlpha = 0.35;
            ctx.stroke();

            // 2. Crisp Metallic Core Stroke
            const coreGrad = ctx.createLinearGradient(pTail.x, pTail.y, pHead.x, pHead.y);
            coreGrad.addColorStop(0, 'rgba(255, 245, 210, 0)');
            coreGrad.addColorStop(0.55, 'rgba(255, 230, 140, 0.85)');
            coreGrad.addColorStop(1, p.coreColor);

            ctx.beginPath();
            ctx.moveTo(pTail.x, pTail.y);
            ctx.lineTo(pHead.x, pHead.y);
            ctx.strokeStyle = coreGrad;
            ctx.lineWidth = p.coreWidth;
            ctx.globalAlpha = 0.95;
            ctx.stroke();

            // 3. Radiant Head Spark (White hot center with warm gold corona)
            ctx.beginPath();
            ctx.arc(pHead.x, pHead.y, p.sparkRadius + 1.2, 0, Math.PI * 2);
            ctx.fillStyle = p.glowColor;
            ctx.globalAlpha = 0.6;
            ctx.fill();

            ctx.beginPath();
            ctx.arc(pHead.x, pHead.y, p.sparkRadius, 0, Math.PI * 2);
            ctx.fillStyle = '#FFFFFF';
            ctx.globalAlpha = 1.0;
            ctx.fill();
          }
        }
      }

      // 5. Draw Strategic PCB Nodes Only When Proximity Active (Base nodes/markers already cached on staticCanvas)
      if (mouse.active) {
        rawNodes.forEach((node) => {
          const x = node.u * W;
          const y = node.v * H;
          const d = Math.hypot(x - mouse.x, y - mouse.y);
          if (d >= 140) return;
          const prox = 1 - d / 140;

          if (node.shape === 'glow_via') {
            const haloRad = ctx.createRadialGradient(x, y, 1, x, y, node.size * 3.8);
            haloRad.addColorStop(0, 'rgba(230, 186, 92, 0.55)');
            haloRad.addColorStop(0.5, 'rgba(230, 186, 92, 0.20)');
            haloRad.addColorStop(1, 'rgba(230, 186, 92, 0)');
            ctx.fillStyle = haloRad;
            ctx.globalAlpha = 0.85 + prox * 0.15;
            ctx.beginPath();
            ctx.arc(x, y, node.size * 3.8, 0, Math.PI * 2);
            ctx.fill();
          } else if (node.shape === 'via') {
            ctx.beginPath();
            ctx.arc(x, y, node.size, 0, Math.PI * 2);
            ctx.fillStyle = '#C5A059';
            ctx.globalAlpha = 0.70 + prox * 0.25;
            ctx.fill();
          }
        });
      }

      ctx.globalAlpha = 1.0;
    }

    // Animation Loop
    function loop(now: number) {
      const dt = Math.min((now - lastTime) / 1000, 0.05);
      lastTime = now;

      drawFrame(now, dt);

      if (window.__PERF_METRICS__) {
        window.__PERF_METRICS__.circuitRunning = isCircuitVisible && !prefersReduced;
      }

      if (!prefersReduced && isCircuitVisible) {
        circuitLoopId = requestAnimationFrame(loop);
      }
    }

    // Connect Anime.js visibility lifecycle
    currentCircuitController = registerCircuitVisibility(canvas, (visible) => {
      isCircuitVisible = visible;
      if (window.__PERF_METRICS__) {
        window.__PERF_METRICS__.circuitRunning = visible && !prefersReduced;
      }
      if (visible && !prefersReduced) {
        lastTime = performance.now();
        if (circuitLoopId) cancelAnimationFrame(circuitLoopId);
        circuitLoopId = requestAnimationFrame(loop);
      } else if (circuitLoopId) {
        cancelAnimationFrame(circuitLoopId);
        circuitLoopId = null;
      }
    });

    // Event Listeners (Bound to Hero Section)
    const targetElement = heroSection || window;

    targetElement.addEventListener(
      'mousemove',
      (e: Event) => {
        const me = e as MouseEvent;
        const rect = canvas.getBoundingClientRect();
        mouse.x = me.clientX - rect.left;
        mouse.y = me.clientY - rect.top;
        mouse.active =
          mouse.x >= 0 && mouse.x <= rect.width && mouse.y >= 0 && mouse.y <= rect.height;
      },
      { passive: true }
    );

    targetElement.addEventListener('mouseleave', () => {
      mouse.active = false;
    });

    window.addEventListener('resize', resize, { passive: true });

    resize();
    if (!prefersReduced) {
      circuitLoopId = requestAnimationFrame(loop);
    }
  }

  function deferredInit(fn: () => void) {
    if ('requestIdleCallback' in window) {
      (window as any).requestIdleCallback(fn, { timeout: 600 });
    } else {
      setTimeout(fn, 150);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => deferredInit(initHeroPCB));
  } else {
    deferredInit(initHeroPCB);
  }

  document.addEventListener('astro:page-load', () => deferredInit(initHeroPCB));
</script>

<style>
  #circuitBoardCanvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }
</style>
