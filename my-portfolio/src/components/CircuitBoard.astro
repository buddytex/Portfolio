---
// CircuitBoard Component — High-Precision Deterministic PCB Architecture
// Engineered exclusively for the Hero Section:
// - 100% deterministic layout (NO Math.random)
// - Purposeful routing: frames typography, bridges CTA to 3D hardware core
// - Clear hierarchy: 10% hero highways, 20% secondary buses, 70% subtle hairlines
// - Generous negative space preserving typographic legibility
// - Contained strictly to Hero section (no leaking across rest of site)
// - High-DPR canvas rendering, interactive cursor proximity, traveling gold pulses
---

<canvas id="circuitBoardCanvas" aria-hidden="true"></canvas>

<script>
  import { registerCircuitVisibility, type CircuitController } from '../animations';

  let currentCircuitController: CircuitController | null = null;
  let circuitLoopId: number | null = null;
  let isCircuitVisible = true;

  function initHeroPCB() {
    if (currentCircuitController) {
      currentCircuitController.destroy();
      currentCircuitController = null;
    }
    if (circuitLoopId) {
      cancelAnimationFrame(circuitLoopId);
      circuitLoopId = null;
    }

    const canvas = document.getElementById('circuitBoardCanvas') as HTMLCanvasElement;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const heroSection = document.getElementById('hero');
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let W = 0;
    let H = 0;
    let DPR = 1;

    interface NodeDef {
      u: number; // 0..1 normalized X
      v: number; // 0..1 normalized Y
      shape: 'glow_via' | 'via' | 'pad' | 'ic' | 'dot';
      size: number;
      label?: string;
    }

    interface TraceDef {
      tier: 'highway' | 'medium' | 'hairline';
      points: [number, number][]; // array of [u, v]
      hasPulse?: boolean;
    }

    interface MarkerDef {
      u: number;
      v: number;
      type: 'cross' | 'dot_matrix' | 'label';
      text?: string;
    }

    // -----------------------------------------------------------
    // DETERMINISTIC PCB TOPOLOGY ARCHITECTURE
    // Intentionally routed around Hero content and leading into 3D core
    // -----------------------------------------------------------

    // 1. Strategic Functional Nodes (Glow Vias, Standard Vias, ICs)
    const rawNodes: NodeDef[] = [
      // Top Architectural Route (Well above eyebrow pill at v=0.28)
      { u: 0.16, v: 0.00, shape: 'via', size: 3.5 },
      { u: 0.16, v: 0.14, shape: 'via', size: 4.0 },
      { u: 0.26, v: 0.14, shape: 'glow_via', size: 5.5 },
      { u: 0.38, v: 0.14, shape: 'via', size: 3.5 },
      { u: 0.48, v: 0.14, shape: 'via', size: 4.5 },
      { u: 0.55, v: 0.18, shape: 'glow_via', size: 6.0 },

      // Upper Bridge into 3D System (leading directly to Top-Left Gold Sphere at u=0.60, v=0.22)
      { u: 0.60, v: 0.22, shape: 'glow_via', size: 5.5 },
      { u: 0.66, v: 0.16, shape: 'via', size: 3.5 },
      { u: 0.74, v: 0.12, shape: 'glow_via', size: 5.5 },

      // Step Rail / Left Edge Bus (u=0.04 to 0.06)
      { u: 0.04, v: 0.12, shape: 'via', size: 3.5 },
      { u: 0.04, v: 0.28, shape: 'glow_via', size: 5.0 },
      { u: 0.04, v: 0.45, shape: 'via', size: 3.5 },
      { u: 0.04, v: 0.68, shape: 'via', size: 3.5 },
      { u: 0.04, v: 0.84, shape: 'via', size: 4.5 },
      { u: 0.06, v: 0.22, shape: 'via', size: 2.5 },
      { u: 0.06, v: 0.62, shape: 'via', size: 2.5 },

      // Name Baseline Bus (v=0.56, beneath typography) & CTA Connection Bridge
      { u: 0.08, v: 0.56, shape: 'via', size: 4.0 },
      { u: 0.24, v: 0.56, shape: 'via', size: 3.5 },
      { u: 0.38, v: 0.56, shape: 'glow_via', size: 5.0 },
      { u: 0.44, v: 0.66, shape: 'via', size: 4.0 },
      { u: 0.52, v: 0.66, shape: 'via', size: 4.0 },
      { u: 0.62, v: 0.66, shape: 'glow_via', size: 6.0 },
      { u: 0.68, v: 0.74, shape: 'ic', size: 13 },

      // Bottom Finger Array Entering 3D Mechanism from Below
      { u: 0.52, v: 0.94, shape: 'via', size: 3.5 },
      { u: 0.52, v: 0.80, shape: 'via', size: 4.0 },
      { u: 0.56, v: 0.94, shape: 'via', size: 3.5 },
      { u: 0.56, v: 0.76, shape: 'glow_via', size: 5.0 },
      { u: 0.60, v: 0.94, shape: 'via', size: 3.5 },
      { u: 0.60, v: 0.80, shape: 'via', size: 4.0 },
      { u: 0.64, v: 0.92, shape: 'glow_via', size: 5.5 },
      { u: 0.64, v: 0.84, shape: 'via', size: 4.0 },

      // Bottom Left Industrial Ground Plane
      { u: 0.10, v: 0.88, shape: 'via', size: 4.0 },
      { u: 0.22, v: 0.88, shape: 'glow_via', size: 5.5 },
      { u: 0.34, v: 0.88, shape: 'via', size: 4.0 },
      { u: 0.42, v: 0.82, shape: 'via', size: 4.0 },
      { u: 0.14, v: 0.82, shape: 'ic', size: 12 },

      // Right Perimeter Actuator & Sensor Bus (Framing 3D assembly on right)
      { u: 0.92, v: 0.08, shape: 'via', size: 3.5 },
      { u: 0.92, v: 0.28, shape: 'glow_via', size: 5.5 },
      { u: 0.84, v: 0.28, shape: 'via', size: 4.0 },
      { u: 0.84, v: 0.46, shape: 'via', size: 3.5 },
      { u: 0.88, v: 0.54, shape: 'via', size: 4.0 },
      { u: 0.92, v: 0.68, shape: 'glow_via', size: 5.5 },
      { u: 0.86, v: 0.78, shape: 'via', size: 3.5 },
      { u: 0.90, v: 0.86, shape: 'via', size: 4.5 },
      { u: 0.94, v: 0.64, shape: 'ic', size: 12 },
    ];

    // 2. Deterministic Traces (Highways, Medium Signal Routes, Hairlines)
    const rawTraces: TraceDef[] = [
      // ---------------------------------------------
      // PRIMARY HIGHWAYS (~10%): Prominent, Embossed, Traveling Pulses
      // ---------------------------------------------
      // Highway A: Top Left -> Above Eyebrow -> Feeds 3D Core
      {
        tier: 'highway',
        hasPulse: true,
        points: [
          [0.16, 0.00],
          [0.16, 0.14],
          [0.48, 0.14],
          [0.55, 0.18],
          [0.60, 0.22],
          [0.66, 0.16],
          [0.74, 0.12],
        ],
      },
      // Highway B: Under Name Baseline -> CTA Bridge -> Into 3D Hardware Core
      {
        tier: 'highway',
        hasPulse: true,
        points: [
          [0.08, 0.56],
          [0.38, 0.56],
          [0.44, 0.66],
          [0.62, 0.66],
          [0.68, 0.74],
        ],
      },
      // Highway C: Left Industrial Edge Dual Bus
      {
        tier: 'highway',
        points: [
          [0.04, 0.12],
          [0.04, 0.84],
          [0.10, 0.88],
          [0.34, 0.88],
          [0.42, 0.82],
        ],
      },
      // Highway D: Bottom Vertical Power Bus rising into 3D Assembly
      {
        tier: 'highway',
        hasPulse: true,
        points: [
          [0.56, 0.94],
          [0.56, 0.76],
          [0.62, 0.66],
        ],
      },
      // Highway E: Right Perimeter Actuator Bus
      {
        tier: 'highway',
        points: [
          [0.92, 0.08],
          [0.92, 0.28],
          [0.84, 0.28],
          [0.84, 0.46],
          [0.88, 0.54],
          [0.92, 0.68],
          [0.90, 0.86],
        ],
      },

      // ---------------------------------------------
      // SECONDARY ROUTES (~20%): Medium Width Signals
      // ---------------------------------------------
      // Parallel to Highway A (Spacing 12px)
      {
        tier: 'medium',
        points: [
          [0.175, 0.00],
          [0.175, 0.125],
          [0.465, 0.125],
          [0.535, 0.165],
          [0.585, 0.205],
          [0.645, 0.145],
          [0.725, 0.105],
        ],
      },
      // Parallel to Left Edge Bus
      {
        tier: 'medium',
        points: [
          [0.06, 0.18],
          [0.06, 0.82],
          [0.115, 0.86],
          [0.32, 0.86],
          [0.40, 0.80],
        ],
      },
      // Secondary Name Underline framing CTA buttons
      {
        tier: 'medium',
        points: [
          [0.08, 0.58],
          [0.36, 0.58],
          [0.42, 0.68],
          [0.54, 0.68],
          [0.60, 0.74],
        ],
      },
      // Secondary Bottom Vertical Fingers into 3D core
      {
        tier: 'medium',
        points: [
          [0.52, 0.94],
          [0.52, 0.80],
        ],
      },
      {
        tier: 'medium',
        points: [
          [0.60, 0.94],
          [0.60, 0.80],
        ],
      },
      {
        tier: 'medium',
        points: [
          [0.64, 0.92],
          [0.64, 0.84],
          [0.68, 0.78],
        ],
      },
      // Right Secondary Parallel Trace
      {
        tier: 'medium',
        points: [
          [0.935, 0.10],
          [0.935, 0.30],
          [0.855, 0.30],
          [0.855, 0.44],
          [0.90, 0.52],
          [0.94, 0.64],
        ],
      },

      // ---------------------------------------------
      // SUBTLE HAIRLINES (~70%): Fine Architectural Background Weave
      // ---------------------------------------------
      // Top Area Faded Lines
      { tier: 'hairline', points: [[0.08, 0.08], [0.14, 0.08], [0.18, 0.12]] },
      { tier: 'hairline', points: [[0.28, 0.06], [0.38, 0.06], [0.42, 0.10], [0.48, 0.10]] },
      { tier: 'hairline', points: [[0.36, 0.12], [0.46, 0.12], [0.50, 0.14]] },
      { tier: 'hairline', points: [[0.58, 0.08], [0.66, 0.08], [0.70, 0.12]] },
      { tier: 'hairline', points: [[0.74, 0.06], [0.82, 0.06], [0.86, 0.10], [0.90, 0.10]] },

      // Mid-Left Margins (Outside typography exclusion box)
      { tier: 'hairline', points: [[0.02, 0.34], [0.05, 0.34], [0.07, 0.36]] },
      { tier: 'hairline', points: [[0.02, 0.48], [0.05, 0.48], [0.07, 0.50]] },
      { tier: 'hairline', points: [[0.02, 0.62], [0.05, 0.62]] },

      // Bottom Area Hairline Grid
      { tier: 'hairline', points: [[0.08, 0.92], [0.18, 0.92], [0.22, 0.94]] },
      { tier: 'hairline', points: [[0.26, 0.92], [0.38, 0.92], [0.44, 0.86]] },
      { tier: 'hairline', points: [[0.14, 0.78], [0.18, 0.78], [0.22, 0.82]] },
      { tier: 'hairline', points: [[0.44, 0.88], [0.48, 0.88], [0.50, 0.90]] },
      { tier: 'hairline', points: [[0.66, 0.90], [0.72, 0.90], [0.76, 0.86]] },
      { tier: 'hairline', points: [[0.78, 0.88], [0.84, 0.88], [0.88, 0.84]] },

      // 3D Visual Perimeter Hairlines (Framing Right Hardware)
      { tier: 'hairline', points: [[0.76, 0.24], [0.82, 0.24], [0.86, 0.28]] },
      { tier: 'hairline', points: [[0.78, 0.38], [0.82, 0.38], [0.84, 0.40]] },
      { tier: 'hairline', points: [[0.74, 0.62], [0.80, 0.62], [0.84, 0.66]] },
      { tier: 'hairline', points: [[0.82, 0.72], [0.86, 0.72], [0.88, 0.76]] },
      { tier: 'hairline', points: [[0.88, 0.20], [0.94, 0.20], [0.96, 0.24]] },
      { tier: 'hairline', points: [[0.90, 0.42], [0.95, 0.42]] },
    ];

    // 3. Technical Markers & Annotations
    const rawMarkers: MarkerDef[] = [
      { u: 0.12, v: 0.14, type: 'cross' },
      { u: 0.30, v: 0.22, type: 'cross' },
      { u: 0.46, v: 0.12, type: 'cross' },
      { u: 0.68, v: 0.12, type: 'cross' },
      { u: 0.82, v: 0.18, type: 'cross' },
      { u: 0.08, v: 0.74, type: 'cross' },
      { u: 0.48, v: 0.72, type: 'cross' },
      { u: 0.78, v: 0.80, type: 'cross' },
      { u: 0.94, v: 0.48, type: 'cross' },
      { u: 0.16, v: 0.70, type: 'dot_matrix' },
      { u: 0.74, v: 0.72, type: 'dot_matrix' },
      { u: 0.88, v: 0.36, type: 'dot_matrix' },
    ];

    // Deterministic 3-Wave Signal Propagation Cycle (§11 spec)
    // Wave 0: Highway B (Under Name Baseline -> CTA Bridge -> Into 3D Core)
    // Wave 1: Highway A (Top Left -> Above Eyebrow -> Feeds 3D Core)
    // Wave 2: Highway D (Bottom Vertical Power Bus rising into 3D Assembly)
    const PULSE_WAVE_TRACES = [1, 0, 3];
    let currentWaveIndex = 0;
    let waveDistTravelled = 0;
    let wavePauseTimer = 0;
    const WAVE_SPEED = 240; // px/sec
    const PULSE_LENGTH = 50; // px

    // Mouse coordinates relative to Hero canvas
    const mouse = { x: -9999, y: -9999, active: false };

    // Offscreen caching for static PCB elements (hairlines, base copper, markers, default vias)
    let staticCanvas: HTMLCanvasElement | null = null;
    let staticCtx: CanvasRenderingContext2D | null = null;

    function renderStaticLayers() {
      if (!staticCanvas) {
        staticCanvas = document.createElement('canvas');
      }
      staticCanvas.width = Math.floor(W * DPR);
      staticCanvas.height = Math.floor(H * DPR);
      staticCtx = staticCanvas.getContext('2d');
      if (!staticCtx) return;
      staticCtx.setTransform(DPR, 0, 0, DPR, 0, 0);
      staticCtx.clearRect(0, 0, W, H);
      staticCtx.lineCap = 'round';
      staticCtx.lineJoin = 'round';

      // 1. Subtle Hairlines
      rawTraces.forEach((trace) => {
        if (trace.tier !== 'hairline') return;
        const pts = trace.points.map(([u, v]) => ({ x: u * W, y: v * H }));
        staticCtx!.beginPath();
        staticCtx!.moveTo(pts[0].x, pts[0].y);
        for (let i = 1; i < pts.length; i++) {
          staticCtx!.lineTo(pts[i].x, pts[i].y);
        }
        staticCtx!.strokeStyle = '#D8BE8A';
        staticCtx!.globalAlpha = 0.18;
        staticCtx!.lineWidth = 0.85;
        staticCtx!.stroke();
      });

      // 2. Base Medium Traces
      rawTraces.forEach((trace) => {
        if (trace.tier !== 'medium') return;
        const pts = trace.points.map(([u, v]) => ({ x: u * W, y: v * H }));
        staticCtx!.beginPath();
        staticCtx!.moveTo(pts[0].x, pts[0].y);
        for (let i = 1; i < pts.length; i++) {
          staticCtx!.lineTo(pts[i].x, pts[i].y);
        }
        staticCtx!.strokeStyle = '#C5A059';
        staticCtx!.globalAlpha = 0.38;
        staticCtx!.lineWidth = 1.35;
        staticCtx!.stroke();
      });

      // 3. Base Highway Traces
      rawTraces.forEach((trace) => {
        if (trace.tier !== 'highway') return;
        const pts = trace.points.map(([u, v]) => ({ x: u * W, y: v * H }));
        staticCtx!.beginPath();
        staticCtx!.moveTo(pts[0].x, pts[0].y);
        for (let i = 1; i < pts.length; i++) {
          staticCtx!.lineTo(pts[i].x, pts[i].y);
        }
        staticCtx!.strokeStyle = '#B8924A';
        staticCtx!.globalAlpha = 0.78;
        staticCtx!.lineWidth = 2.4;
        staticCtx!.stroke();
      });

      // 4. Technical Markers
      rawMarkers.forEach((m) => {
        const x = m.u * W;
        const y = m.v * H;
        staticCtx!.globalAlpha = 0.35;

        if (m.type === 'cross') {
          staticCtx!.strokeStyle = '#B8924A';
          staticCtx!.lineWidth = 1.0;
          staticCtx!.beginPath();
          staticCtx!.moveTo(x - 5, y);
          staticCtx!.lineTo(x + 5, y);
          staticCtx!.moveTo(x, y - 5);
          staticCtx!.lineTo(x, y + 5);
          staticCtx!.stroke();
        } else if (m.type === 'dot_matrix') {
          staticCtx!.fillStyle = '#C5A059';
          for (let dx = -1; dx <= 1; dx++) {
            for (let dy = -1; dy <= 1; dy++) {
              staticCtx!.beginPath();
              staticCtx!.arc(x + dx * 5, y + dy * 5, 0.9, 0, Math.PI * 2);
              staticCtx!.fill();
            }
          }
        }
      });

      // 5. Base PCB Nodes
      rawNodes.forEach((node) => {
        const x = node.u * W;
        const y = node.v * H;

        if (node.shape === 'glow_via') {
          const haloRad = staticCtx!.createRadialGradient(x, y, 1, x, y, node.size * 3.8);
          haloRad.addColorStop(0, 'rgba(230, 186, 92, 0.55)');
          haloRad.addColorStop(0.5, 'rgba(230, 186, 92, 0.20)');
          haloRad.addColorStop(1, 'rgba(230, 186, 92, 0)');
          staticCtx!.fillStyle = haloRad;
          staticCtx!.globalAlpha = 0.85;
          staticCtx!.beginPath();
          staticCtx!.arc(x, y, node.size * 3.8, 0, Math.PI * 2);
          staticCtx!.fill();

          staticCtx!.beginPath();
          staticCtx!.arc(x, y, node.size, 0, Math.PI * 2);
          staticCtx!.fillStyle = '#B8924A';
          staticCtx!.globalAlpha = 0.95;
          staticCtx!.fill();

          staticCtx!.beginPath();
          staticCtx!.arc(x, y, node.size * 0.38, 0, Math.PI * 2);
          staticCtx!.fillStyle = '#222834';
          staticCtx!.fill();
        } else if (node.shape === 'via') {
          staticCtx!.beginPath();
          staticCtx!.arc(x, y, node.size, 0, Math.PI * 2);
          staticCtx!.fillStyle = '#C5A059';
          staticCtx!.globalAlpha = 0.70;
          staticCtx!.fill();

          staticCtx!.beginPath();
          staticCtx!.arc(x, y, node.size * 0.45, 0, Math.PI * 2);
          staticCtx!.fillStyle = '#F7F5F0';
          staticCtx!.fill();
        } else if (node.shape === 'ic') {
          const s = node.size;
          staticCtx!.fillStyle = 'rgba(28, 33, 44, 0.85)';
          staticCtx!.globalAlpha = 0.85;
          staticCtx!.fillRect(x - s / 2, y - s / 2, s, s);

          staticCtx!.strokeStyle = '#B8924A';
          staticCtx!.lineWidth = 1;
          staticCtx!.strokeRect(x - s / 2, y - s / 2, s, s);

          staticCtx!.fillStyle = '#E5C678';
          const pins = 3;
          for (let p = 0; p < pins; p++) {
            const py = y - s / 2 + (s / (pins + 1)) * (p + 1);
            staticCtx!.fillRect(x - s / 2 - 3, py - 1, 3, 2);
            staticCtx!.fillRect(x + s / 2, py - 1, 3, 2);
          }
        }
      });
      staticCtx.globalAlpha = 1.0;
    }

    function resize() {
      // Size canvas to Hero parent container (NOT entire window!)
      const parent = canvas.parentElement || heroSection || document.body;
      W = parent.clientWidth;
      H = parent.clientHeight;
      DPR = Math.min(window.devicePixelRatio || 1, 1.75);

      canvas.width = Math.floor(W * DPR);
      canvas.height = Math.floor(H * DPR);
      canvas.style.width = `${W}px`;
      canvas.style.height = `${H}px`;
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);

      renderStaticLayers();

      waveDistTravelled = 0;
      wavePauseTimer = 0.2;

      drawFrame(performance.now(), 0.016);
    }

    // Helper: compute total length of polyline
    function getTraceLengths(points: { x: number; y: number }[]): { total: number; segs: number[] } {
      let total = 0;
      const segs: number[] = [];
      for (let i = 0; i < points.length - 1; i++) {
        const d = Math.hypot(points[i + 1].x - points[i].x, points[i + 1].y - points[i].y);
        segs.push(d);
        total += d;
      }
      return { total, segs };
    }

    // Helper: interpolate point along polyline
    function getPointAtDistance(
      points: { x: number; y: number }[],
      targetDist: number,
      segs: number[]
    ): { x: number; y: number } {
      let accum = 0;
      for (let i = 0; i < segs.length; i++) {
        const segLen = segs[i];
        if (accum + segLen >= targetDist) {
          const ratio = (targetDist - accum) / (segLen || 1);
          return {
            x: points[i].x + (points[i + 1].x - points[i].x) * ratio,
            y: points[i].y + (points[i + 1].y - points[i].y) * ratio,
          };
        }
        accum += segLen;
      }
      return points[points.length - 1];
    }

    let lastTime = performance.now();

    function drawFrame(now: number, dt: number) {
      ctx.clearRect(0, 0, W, H);

      // Fast-path: Draw cached static PCB topology in 1 single GPU blit
      if (staticCanvas) {
        ctx.save();
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.drawImage(staticCanvas, 0, 0);
        ctx.restore();
      }

      // If mouse is active near Hero, draw dynamic proximity glow overlay
      if (mouse.active) {
        rawTraces.forEach((trace) => {
          if (trace.tier === 'hairline') return;
          const pts = trace.points.map(([u, v]) => ({ x: u * W, y: v * H }));
          let proximityBoost = 0;
          for (const p of pts) {
            const d = Math.hypot(p.x - mouse.x, p.y - mouse.y);
            const maxD = trace.tier === 'highway' ? 200 : 160;
            if (d < maxD) {
              proximityBoost = Math.max(proximityBoost, 1 - d / maxD);
            }
          }
          if (proximityBoost > 0.05) {
            ctx.beginPath();
            ctx.moveTo(pts[0].x, pts[0].y);
            for (let i = 1; i < pts.length; i++) {
              ctx.lineTo(pts[i].x, pts[i].y);
            }
            if (trace.tier === 'highway') {
              ctx.strokeStyle = '#E5C678';
              ctx.globalAlpha = proximityBoost * 0.45;
              ctx.lineWidth = 2.4 + proximityBoost * 0.8;
            } else {
              ctx.strokeStyle = '#D8BE8A';
              ctx.globalAlpha = proximityBoost * 0.35;
              ctx.lineWidth = 1.35 + proximityBoost * 0.5;
            }
            ctx.stroke();
          }
        });
      }

      // 4. Draw Traveling Pulse along Current Highway (Deterministic Sequential Propagation)
      if (!prefersReduced) {
        if (wavePauseTimer > 0) {
          wavePauseTimer -= dt;
        } else {
          const traceIdx = PULSE_WAVE_TRACES[currentWaveIndex];
          const trace = rawTraces[traceIdx];
          if (trace) {
            const pts = trace.points.map(([u, v]) => ({ x: u * W, y: v * H }));
            const { total, segs } = getTraceLengths(pts);

            waveDistTravelled += WAVE_SPEED * dt;

            if (waveDistTravelled > total + PULSE_LENGTH) {
              // Pause before next wave: 0.4s between waves, 0.9s after completing full 3-wave cycle
              wavePauseTimer = currentWaveIndex === PULSE_WAVE_TRACES.length - 1 ? 0.9 : 0.4;
              currentWaveIndex = (currentWaveIndex + 1) % PULSE_WAVE_TRACES.length;
              waveDistTravelled = 0;
            } else if (waveDistTravelled > 0 && waveDistTravelled - PULSE_LENGTH < total) {
              const headDist = Math.min(waveDistTravelled, total);
              const tailDist = Math.max(waveDistTravelled - PULSE_LENGTH, 0);

              const pHead = getPointAtDistance(pts, headDist, segs);
              const pTail = getPointAtDistance(pts, tailDist, segs);

              const grad = ctx.createLinearGradient(pTail.x, pTail.y, pHead.x, pHead.y);
              grad.addColorStop(0, 'rgba(255, 238, 179, 0)');
              grad.addColorStop(0.7, 'rgba(255, 230, 140, 0.85)');
              grad.addColorStop(1, '#FFF9E6');

              ctx.beginPath();
              ctx.moveTo(pTail.x, pTail.y);
              ctx.lineTo(pHead.x, pHead.y);
              ctx.strokeStyle = grad;
              ctx.lineWidth = 3.6;
              ctx.globalAlpha = 0.95;
              ctx.stroke();

              // Radiant head spark
              ctx.beginPath();
              ctx.arc(pHead.x, pHead.y, 2.8, 0, Math.PI * 2);
              ctx.fillStyle = '#FFFFFF';
              ctx.fill();
            }
          }
        }
      }

      // 5. Draw Technical Markers (Crosshairs +, Dot Grids)
      rawMarkers.forEach((m) => {
        const x = m.u * W;
        const y = m.v * H;
        ctx.globalAlpha = 0.35;

        if (m.type === 'cross') {
          ctx.strokeStyle = '#B8924A';
          ctx.lineWidth = 1.0;
          ctx.beginPath();
          ctx.moveTo(x - 5, y);
          ctx.lineTo(x + 5, y);
          ctx.moveTo(x, y - 5);
          ctx.lineTo(x, y + 5);
          ctx.stroke();
        } else if (m.type === 'dot_matrix') {
          ctx.fillStyle = '#C5A059';
          for (let dx = -1; dx <= 1; dx++) {
            for (let dy = -1; dy <= 1; dy++) {
              ctx.beginPath();
              ctx.arc(x + dx * 5, y + dy * 5, 0.9, 0, Math.PI * 2);
              ctx.fill();
            }
          }
        }
      });

      // 6. Draw Strategic PCB Nodes (Glow Vias, Standard Vias, ICs, Solder Pads)
      rawNodes.forEach((node) => {
        const x = node.u * W;
        const y = node.v * H;

        let prox = 0;
        if (mouse.active) {
          const d = Math.hypot(x - mouse.x, y - mouse.y);
          if (d < 140) prox = 1 - d / 140;
        }

        if (node.shape === 'glow_via') {
          // Radiant halo
          const haloRad = ctx.createRadialGradient(x, y, 1, x, y, node.size * 3.8);
          haloRad.addColorStop(0, 'rgba(230, 186, 92, 0.55)');
          haloRad.addColorStop(0.5, 'rgba(230, 186, 92, 0.20)');
          haloRad.addColorStop(1, 'rgba(230, 186, 92, 0)');
          ctx.fillStyle = haloRad;
          ctx.globalAlpha = 0.85 + prox * 0.15;
          ctx.beginPath();
          ctx.arc(x, y, node.size * 3.8, 0, Math.PI * 2);
          ctx.fill();

          // Copper ring
          ctx.beginPath();
          ctx.arc(x, y, node.size, 0, Math.PI * 2);
          ctx.fillStyle = '#B8924A';
          ctx.globalAlpha = 0.95;
          ctx.fill();

          // Inner drill via
          ctx.beginPath();
          ctx.arc(x, y, node.size * 0.38, 0, Math.PI * 2);
          ctx.fillStyle = '#222834';
          ctx.fill();
        } else if (node.shape === 'via') {
          // Standard Annular Via
          ctx.beginPath();
          ctx.arc(x, y, node.size, 0, Math.PI * 2);
          ctx.fillStyle = '#C5A059';
          ctx.globalAlpha = 0.70 + prox * 0.25;
          ctx.fill();

          ctx.beginPath();
          ctx.arc(x, y, node.size * 0.45, 0, Math.PI * 2);
          ctx.fillStyle = '#F7F5F0';
          ctx.fill();
        } else if (node.shape === 'ic') {
          // SMD IC Footprint
          const s = node.size;
          ctx.fillStyle = 'rgba(28, 33, 44, 0.85)';
          ctx.globalAlpha = 0.85;
          ctx.fillRect(x - s / 2, y - s / 2, s, s);

          ctx.strokeStyle = '#B8924A';
          ctx.lineWidth = 1;
          ctx.strokeRect(x - s / 2, y - s / 2, s, s);

          // Pin leads
          ctx.fillStyle = '#E5C678';
          const pins = 3;
          for (let p = 0; p < pins; p++) {
            const py = y - s / 2 + (s / (pins + 1)) * (p + 1);
            ctx.fillRect(x - s / 2 - 3, py - 1, 3, 2);
            ctx.fillRect(x + s / 2, py - 1, 3, 2);
          }
        }
      });

      ctx.globalAlpha = 1.0;
    }

    // Animation Loop
    function loop(now: number) {
      const dt = Math.min((now - lastTime) / 1000, 0.05);
      lastTime = now;

      drawFrame(now, dt);

      if (window.__PERF_METRICS__) {
        window.__PERF_METRICS__.circuitRunning = isCircuitVisible && !prefersReduced;
      }

      if (!prefersReduced && isCircuitVisible) {
        circuitLoopId = requestAnimationFrame(loop);
      }
    }

    // Connect Anime.js visibility lifecycle
    currentCircuitController = registerCircuitVisibility(canvas, (visible) => {
      isCircuitVisible = visible;
      if (window.__PERF_METRICS__) {
        window.__PERF_METRICS__.circuitRunning = visible && !prefersReduced;
      }
      if (visible && !prefersReduced) {
        lastTime = performance.now();
        if (circuitLoopId) cancelAnimationFrame(circuitLoopId);
        circuitLoopId = requestAnimationFrame(loop);
      } else if (circuitLoopId) {
        cancelAnimationFrame(circuitLoopId);
        circuitLoopId = null;
      }
    });

    // Event Listeners (Bound to Hero Section)
    const targetElement = heroSection || window;

    targetElement.addEventListener(
      'mousemove',
      (e: Event) => {
        const me = e as MouseEvent;
        const rect = canvas.getBoundingClientRect();
        mouse.x = me.clientX - rect.left;
        mouse.y = me.clientY - rect.top;
        mouse.active =
          mouse.x >= 0 && mouse.x <= rect.width && mouse.y >= 0 && mouse.y <= rect.height;
      },
      { passive: true }
    );

    targetElement.addEventListener('mouseleave', () => {
      mouse.active = false;
    });

    window.addEventListener('resize', resize, { passive: true });

    resize();
    if (!prefersReduced) {
      circuitLoopId = requestAnimationFrame(loop);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroPCB);
  } else {
    initHeroPCB();
  }

  document.addEventListener('astro:page-load', initHeroPCB);
</script>

<style>
  #circuitBoardCanvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }
</style>
