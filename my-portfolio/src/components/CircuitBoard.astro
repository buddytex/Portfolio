      { tier: 'hairline', points: [[0.82, 0.72], [0.86, 0.72], [0.88, 0.76]] },
      { tier: 'hairline', points: [[0.88, 0.20], [0.94, 0.20], [0.96, 0.24]] },
      { tier: 'hairline', points: [[0.90, 0.42], [0.95, 0.42]] },
    ];

    // 3. Technical Markers & Annotations
    const rawMarkers: MarkerDef[] = [
      { u: 0.12, v: 0.14, type: 'cross' },
      { u: 0.30, v: 0.22, type: 'cross' },
      { u: 0.46, v: 0.12, type: 'cross' },
      { u: 0.68, v: 0.12, type: 'cross' },
      { u: 0.82, v: 0.18, type: 'cross' },
      { u: 0.08, v: 0.74, type: 'cross' },
      { u: 0.48, v: 0.72, type: 'cross' },
      { u: 0.78, v: 0.80, type: 'cross' },
      { u: 0.94, v: 0.48, type: 'cross' },
      { u: 0.16, v: 0.70, type: 'dot_matrix' },
      { u: 0.74, v: 0.72, type: 'dot_matrix' },
      { u: 0.88, v: 0.36, type: 'dot_matrix' },
    ];

    // -----------------------------------------------------------
    // DETERMINISTIC MULTI-CHANNEL SIGNAL PROPAGATION ENGINE
    // 8 concurrent channels across visual hierarchy (outer -> center, center -> outer)
    // -----------------------------------------------------------
    interface PulseChannel {
      traceIdx: number;
      reverse: boolean;
      speed: number;       // Base speed in px/sec
      length: number;      // Length of pulse in px
      dist: number;        // Current distance traveled
      pause: number;       // Current pause timer
      pauseMin: number;    // Min pause before replay
      pauseMax: number;    // Max pause before replay
      coreColor: string;
      glowColor: string;
      coreWidth: number;
      sparkRadius: number;
    }

    const PULSE_CHANNELS: PulseChannel[] = [
      // Channel 0: Highway B (Center Name -> CTA Bridge -> Into 3D Core) - Fast Primary
      {
        traceIdx: 1,
        reverse: false,
        speed: 330,
        length: 58,
        dist: 0,
        pause: 0.05,
        pauseMin: 0.25,
        pauseMax: 0.55,
        coreColor: '#FFFDF5',
        glowColor: 'rgba(235, 195, 110, 0.90)',
        coreWidth: 3.4,
        sparkRadius: 3.2,
      },
      // Channel 1: Highway A (Top-Left Outer -> Above Eyebrow -> Feeds 3D Core) - Steady Inbound
      {
        traceIdx: 0,
        reverse: false,
        speed: 250,
        length: 52,
        dist: 0,
