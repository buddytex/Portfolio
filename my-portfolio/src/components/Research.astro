---
// Research Section — Technical Laboratory Notebook & R&D Tracks
const tracks = [
  {
    num: '01',
    title: 'PERCEPTION & SPATIAL GEOMETRY',
    focus: '3D LiDAR Point Cloud Clustering & Multi-Sensor Odometry',
    summary: 'Investigating real-time point-cloud spatial segmentation, ground-plane extraction, and multi-sensor fusion (IMU + wheel encoders + LiDAR) to maintain low-drift localization in GPS-denied environments.',
    tags: ['LiDAR Clustering', 'EKF Odometry', 'Spatial Geometry', 'Sensor Fusion'],
  },
  {
    num: '02',
    title: 'AUTONOMOUS NAVIGATION & TRAJECTORY PLANNING',
    focus: 'Dynamic Costmap Adaptation & Off-Road Non-Linear Control',
    summary: 'Evaluating dynamic costmap inflation and non-linear trajectory rollout algorithms capable of maintaining stability over low-traction, unmapped terrain where standard planar assumptions fail.',
    tags: ['Nav2 Local Planner', 'Trajectory Rollout', 'Costmap2D', 'Kinematic Limits'],
  },
  {
    num: '03',
    title: 'VISION-LANGUAGE-ACTION (VLA) MODELS',
    focus: 'Embodied AI & High-Level Task Planning for Physical Robots',
    summary: 'Studying how multimodal transformer models can decompose unstructured high-level commands into sequential waypoints while delegating real-time obstacle avoidance to deterministic safety layers.',
    tags: ['Embodied AI', 'VLA Architectures', 'Edge Neural Inference', 'Safety Interlocks'],
  },
  {
    num: '04',
    title: 'DISTRIBUTED SWARM CONSENSUS',
    focus: 'Decentralized Multi-Agent Coordination without Central Servers',
    summary: 'Engineering peer-to-peer communication protocols and consensus algorithms on microcontrollers (ESP32) for spatial formation maintenance across decentralized mobile robot networks.',
    tags: ['Multi-Agent Systems', 'TCP/IP Mesh', 'Consensus Algorithms', 'Distributed Robotics'],
  },
];

const lifecycle = [
  { step: '01', name: 'Formulate', desc: 'Identify physical edge cases & sensor degradation limits' },
  { step: '02', name: 'Model', desc: 'Mathematical kinematic modeling & state covariance derivation' },
  { step: '03', name: 'Simulate', desc: 'Closed-loop validation in Gazebo / Isaac Sim physics' },
  { step: '04', name: 'Benchmark', desc: 'Hardware deployment, bench trials & empirical validation' },
];
---

<section id="research" class="section research-section">
  <div class="container">
    <!-- Header -->
    <div class="section-header">
      <span class="section-num mono">02 // RESEARCH & EXPLORATION</span>
      <h2 class="section-title">Applied Robotics Research &<br/><span class="text-cyan">Autonomous Frontiers</span></h2>
      <p class="section-desc">
        Laboratory investigations bridging mathematical modeling, spatial perception, and real-world physical deployment.
        Approached with engineering rigor and reproducible methodology.
      </p>
    </div>

    <!-- Laboratory Lifecycle Strip -->
    <div class="lifecycle-bar">
      <div class="lifecycle-title mono">ENGINEERING R&D METHODOLOGY</div>
      <div class="lifecycle-grid">
        {lifecycle.map((item) => (
          <div class="lifecycle-item">
            <div class="lifecycle-step-row">
              <span class="step-num mono text-cyan">{item.step}</span>
              <span class="step-name mono">{item.name}</span>
            </div>
            <p class="step-desc">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Research Tracks Grid -->
    <div class="research-grid">
      {tracks.map((track) => (
        <div class="research-track-card">
          <div class="track-header">
            <span class="track-index mono text-cyan">{track.num}</span>
            <h3 class="track-title mono">{track.title}</h3>
            <span class="track-focus mono">{track.focus}</span>
          </div>

          <p class="track-summary">{track.summary}</p>

          <div class="track-tags">
            {track.tags.map((tag) => (
              <span class="track-tag mono">{tag}</span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Academic Scope Disclaimer -->
    <div class="research-disclaimer">
      <span class="mono disclaimer-text">
        LABORATORY NOTE: Research tracks represent active independent engineering investigations, prototype simulations, and hands-on laboratory validation.
      </span>
    </div>
  </div>
</section>

<style>
  .research-section {
    background: var(--bg);
  }

  /* Lifecycle Bar */
  .lifecycle-bar {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    margin-bottom: var(--space-12);
  }

  .lifecycle-title {
    font-size: var(--text-2xs);
    color: var(--text-muted);
    letter-spacing: 0.08em;
    margin-bottom: var(--space-4);
  }

  .lifecycle-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
  }

  .lifecycle-item {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .lifecycle-step-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }

  .step-num {
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .step-name {
    font-size: var(--text-sm);
    color: var(--text-primary);
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .step-desc {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    line-height: 1.5;
  }

  /* Research Tracks Grid */
  .research-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
  }

  .research-track-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    transition: border-color var(--duration-fast) var(--ease-spring);
  }

  .research-track-card:hover {
    border-color: var(--border-active);
  }

  .track-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .track-index {
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .track-title {
    font-size: var(--text-base);
    color: var(--text-primary);
    letter-spacing: 0.02em;
    line-height: 1.3;
  }

  .track-focus {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .track-summary {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .track-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
    padding-top: var(--space-2);
  }

  .track-tag {
    font-size: 0.6875rem;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-subtle);
    padding: 3px 8px;
    border-radius: var(--radius-xs);
  }

  .research-disclaimer {
    margin-top: var(--space-10);
    padding: var(--space-4) var(--space-6);
    background: rgba(255, 255, 255, 0.015);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xs);
  }

  .disclaimer-text {
    font-size: var(--text-xs);
    color: var(--text-muted);
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .lifecycle-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6);
    }
    .research-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .lifecycle-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
