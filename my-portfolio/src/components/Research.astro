---
// Research & Exploration Section — Editorial presentation of robotics research interests
const researchTracks = [
  {
    id: '01',
    title: 'Off-Road Autonomous Navigation & Trajectory Planning',
    focus: 'Dynamic Costmap Adaptation in Unstructured Environments',
    description: 'Investigating real-time local costmap updates and non-linear trajectory rollouts under low-traction off-road conditions where standard 2D geometric assumptions break down.',
    topics: ['3D LiDAR Point Clouds', 'Terrain Traversability', 'Nav2 Controller Tuning', 'Non-linear Kinematics'],
  },
  {
    id: '02',
    title: 'Multi-Sensor Fusion & Robust State Estimation',
    focus: 'Tightly-Coupled LiDAR-Inertial-Wheel Odometry',
    description: 'Studying robust pose estimation in degraded operational environments (GPS-denied, sensor occlusion, high mechanical shock) using Extended Kalman Filtering and sensor uncertainty modeling.',
    topics: ['Extended Kalman Filtering', 'IMU Calibration', 'Drift Minimization', 'CAN Wheel Odometry'],
  },
  {
    id: '03',
    title: 'Embodied AI & Multimodal Physical Systems',
    focus: 'Vision-Language-Action (VLA) for Real-World Manipulation',
    description: 'Exploring how multimodal foundation models can guide high-level spatial task planning while strictly maintaining low-level real-time safety, collision checks, and deterministic execution.',
    topics: ['Embodied AI', 'VLA Architectures', 'Edge Neural Inference', 'Deterministic Safety Interlocks'],
  },
  {
    id: '04',
    title: 'Decentralized Swarm & Multi-Agent Coordination',
    focus: 'Fault-Tolerant Consensus in Distributed Robot Meshes',
    description: 'Developing lightweight peer-to-peer consensus algorithms for cooperative mobile robot fleets operating in communication-constrained environments without centralized cloud servers.',
    topics: ['Multi-Agent Systems', 'Distributed Consensus', 'TCP/IP Sockets Protocol', 'Decentralized SLAM'],
  },
];

const methodology = [
  { step: '01', title: 'Characterize', desc: 'Real-world sensor telemetry & physical edge-case discovery' },
  { step: '02', title: 'Model', desc: 'Mathematical modeling of kinematics, perception, and state drift' },
  { step: '03', title: 'Simulate', desc: 'High-fidelity physics validation in Gazebo and Isaac Sim' },
  { step: '04', title: 'Validate', desc: 'Hardware deployment, bench testing, and closed-loop validation' },
];
---

<section id="research" class="section research-section">
  <div class="container">
    <!-- Header -->
    <div class="section-header">
      <span class="editorial-tag section-tag">Academic & R&D Interests</span>
      <h2>Engineering Research &<br/><span class="text-accent">Exploratory Frontiers</span></h2>
      <p class="section-lead">
        Active areas of theoretical investigation and engineering prototyping in real-world robotics autonomy,
        multi-modal perception, and intelligent physical systems.
      </p>
    </div>

    <!-- Research Methodology Strip -->
    <div class="methodology-bar">
      <div class="methodology-label mono">ENGINEERING LIFECYCLE</div>
      <div class="methodology-grid">
        {methodology.map((m, idx) => (
          <div class="method-item">
            <div class="method-header">
              <span class="method-num mono">{m.step}</span>
              <span class="method-title mono">{m.title}</span>
            </div>
            <p class="method-desc">{m.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Research Tracks Grid -->
    <div class="tracks-grid">
      {researchTracks.map((track) => (
        <div class="track-card">
          <div class="track-header">
            <span class="track-num mono">Track {track.id}</span>
            <h3 class="track-title">{track.title}</h3>
            <span class="track-focus mono">{track.focus}</span>
          </div>

          <p class="track-desc">{track.description}</p>

          <div class="track-tags">
            {track.topics.map((tag) => (
              <span class="track-pill mono">{tag}</span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Academic Integrity Note -->
    <div class="research-note">
      <p class="mono note-text">
        RESEARCH NOTE: Exploratory tracks represent ongoing independent R&D, prototype simulations, and hands-on laboratory validation.
      </p>
    </div>
  </div>
</section>

<style>
  .research-section {
    background: var(--bg);
  }

  /* Methodology Bar */
  .methodology-bar {
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-6) var(--space-8);
    margin-bottom: var(--space-12);
  }

  .methodology-label {
    font-size: var(--text-2xs);
    color: var(--text-muted);
    letter-spacing: 0.08em;
    margin-bottom: var(--space-4);
  }

  .methodology-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
  }

  .method-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .method-header {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }

  .method-num {
    font-size: var(--text-xs);
    color: var(--accent);
    font-weight: 600;
  }

  .method-title {
    font-size: var(--text-sm);
    color: var(--text);
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .method-desc {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    line-height: 1.5;
  }

  /* Tracks Grid */
  .tracks-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
  }

  .track-card {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    transition: border-color var(--duration-norm) var(--ease-editorial);
  }

  .track-card:hover {
    border-color: var(--border-hover);
  }

  .track-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .track-num {
    font-size: var(--text-xs);
    color: var(--accent);
    font-weight: 600;
  }

  .track-title {
    font-size: var(--text-lg);
    color: var(--text);
    line-height: 1.3;
  }

  .track-focus {
    font-size: var(--text-xs);
    color: var(--text-muted);
    letter-spacing: 0.03em;
  }

  .track-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .track-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: auto;
    padding-top: var(--space-2);
  }

  .track-pill {
    font-size: var(--text-xs);
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    padding: 4px 10px;
    border-radius: var(--radius-sm);
  }

  .research-note {
    margin-top: var(--space-10);
    padding: var(--space-4) var(--space-6);
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
  }

  .note-text {
    font-size: var(--text-xs);
    color: var(--text-muted);
    line-height: 1.5;
    letter-spacing: 0.03em;
  }

  @media (max-width: 900px) {
    .methodology-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6);
    }
    .tracks-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .methodology-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
