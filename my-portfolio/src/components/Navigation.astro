---
// Editorial Navigation — Clean, refined, minimal
const navLinks = [
  { href: '#work', label: 'Work' },
  { href: '#research', label: 'Research' },
  { href: '#about', label: 'About' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="nav" id="nav">
  <div class="container nav-inner">
    <a href="/" class="nav-brand" aria-label="Naveen Shaji George — Home">
      <span class="nav-name">NAVEEN SHAJI GEORGE</span>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="nav-links" aria-label="Primary Navigation">
      {navLinks.map((link) => (
        <a href={link.href} class="nav-link">
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Desktop Actions -->
    <div class="nav-actions">
      <a
        href="https://github.com/buddytex"
        target="_blank"
        rel="noopener noreferrer"
        class="nav-social-link"
        aria-label="GitHub Profile"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
        </svg>
      </a>

      <a
        href="/Naveen_Shaji_George_CV.pdf"
        class="btn-editorial btn-editorial-secondary nav-resume-btn"
        download
        aria-label="Download Resume PDF"
      >
        <span>Resume</span>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/>
        </svg>
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button class="nav-toggle" id="navToggle" aria-label="Toggle Navigation Menu" aria-expanded="false">
        <span class="toggle-bar"></span>
        <span class="toggle-bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Overlay -->
  <div class="mobile-menu" id="mobileMenu" aria-hidden="true">
    <div class="container mobile-menu-inner">
      <nav class="mobile-links" aria-label="Mobile Navigation">
        {navLinks.map((link) => (
          <a href={link.href} class="mobile-link">
            {link.label}
          </a>
        ))}
      </nav>

      <div class="mobile-actions">
        <a
          href="/Naveen_Shaji_George_CV.pdf"
          class="btn-editorial btn-editorial-primary mobile-resume-btn"
          download
        >
          Download Resume (PDF)
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  // Clean, robust mobile menu toggle
  const toggleBtn = document.getElementById('navToggle');
  const mobileMenu = document.getElementById('mobileMenu');
  const mobileLinks = document.querySelectorAll('.mobile-link');
  let isOpen = false;

  function toggleMenu(open?: boolean) {
    isOpen = open !== undefined ? open : !isOpen;
    if (toggleBtn && mobileMenu) {
      toggleBtn.setAttribute('aria-expanded', String(isOpen));
      mobileMenu.setAttribute('aria-hidden', String(!isOpen));
      mobileMenu.classList.toggle('active', isOpen);
      toggleBtn.classList.toggle('active', isOpen);
      document.body.style.overflow = isOpen ? 'hidden' : '';
    }
  }

  toggleBtn?.addEventListener('click', () => toggleMenu());
  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => toggleMenu(false));
  });

  // Header scroll appearance
  const nav = document.getElementById('nav');
  window.addEventListener('scroll', () => {
    if (nav) {
      if (window.scrollY > 20) {
        nav.classList.add('nav-scrolled');
      } else {
        nav.classList.remove('nav-scrolled');
      }
    }
  }, { passive: true });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    width: 100%;
    height: var(--nav-height);
    z-index: 1000;
    background: rgba(11, 13, 14, 0.7);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid transparent;
    transition: background var(--duration-norm) var(--ease-editorial),
                border-color var(--duration-norm) var(--ease-editorial);
  }

  .nav.nav-scrolled {
    background: rgba(11, 13, 14, 0.92);
    border-bottom-color: var(--border);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  /* Brand / Logo */
  .nav-brand {
    display: flex;
    align-items: center;
  }

  .nav-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
    color: var(--text);
  }

  /* Desktop Links */
  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }

  .nav-link {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    font-weight: 500;
    transition: color var(--duration-fast) var(--ease-editorial);
    position: relative;
    padding: var(--space-1) 0;
  }

  .nav-link:hover {
    color: var(--text);
  }

  /* Right Actions */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .nav-social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-pill);
    color: var(--text-muted);
    transition: all var(--duration-fast) var(--ease-editorial);
  }

  .nav-social-link:hover {
    color: var(--text);
    background: rgba(255, 255, 255, 0.05);
  }

  .nav-resume-btn {
    padding: 8px 16px;
    font-size: var(--text-xs);
  }

  /* Mobile Hamburger */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 36px;
    height: 36px;
    background: transparent;
    cursor: pointer;
  }

  .toggle-bar {
    width: 20px;
    height: 1.5px;
    background: var(--text);
    transition: transform var(--duration-fast) var(--ease-editorial),
                opacity var(--duration-fast) var(--ease-editorial);
  }

  .nav-toggle.active .toggle-bar:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }

  .nav-toggle.active .toggle-bar:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  /* Mobile Menu */
  .mobile-menu {
    display: none;
    position: fixed;
    top: var(--nav-height);
    inset-inline: 0;
    bottom: 0;
    background: rgba(11, 13, 14, 0.98);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    padding: var(--space-8) 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-norm) var(--ease-editorial);
  }

  .mobile-menu.active {
    opacity: 1;
    pointer-events: all;
  }

  .mobile-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    margin-bottom: var(--space-10);
  }

  .mobile-link {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 600;
    color: var(--text-secondary);
  }

  .mobile-link:hover {
    color: var(--text);
  }

  .mobile-actions {
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }

  .mobile-resume-btn {
    width: 100%;
    justify-content: center;
    padding: 14px 24px;
    font-size: var(--text-sm);
  }

  @media (max-width: 768px) {
    .nav-links {
      display: none;
    }
    .nav-resume-btn {
      display: none;
    }
    .nav-toggle {
      display: flex;
    }
    .mobile-menu {
      display: block;
    }
  }
</style>
