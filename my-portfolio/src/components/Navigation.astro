---
const navLinks = [
  { href: '#about', label: 'About' },
  { href: '#projects', label: 'Projects' },
  { href: '#systems', label: 'Systems' },
  { href: '#research', label: 'Research' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="nav" id="nav">
  <div class="container nav-inner">
    <a href="/" class="nav-logo" aria-label="Home">
      <span class="nav-logo-text">NSG</span>
      <span class="nav-logo-dot"></span>
    </a>

    <nav class="nav-links" aria-label="Main navigation">
      {navLinks.map((link) => (
        <a href={link.href} class="nav-link">{link.label}</a>
      ))}
    </nav>

    <div class="nav-right">
      <a href="https://github.com/buddytex" target="_blank" rel="noopener noreferrer" class="nav-icon" aria-label="GitHub">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
        </svg>
      </a>

      <a href="/Naveen_Shaji_George_CV.pdf" class="btn btn-secondary nav-cv-btn">
        Resume
      </a>
    </div>

    <!-- Mobile menu button -->
    <button class="nav-mobile-toggle" aria-label="Toggle menu" aria-expanded="false">
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div class="nav-mobile-menu" id="mobileMenu" aria-hidden="true">
    <nav class="nav-mobile-links">
      {navLinks.map((link) => (
        <a href={link.href} class="nav-mobile-link">{link.label}</a>
      ))}
      <a href="https://github.com/buddytex" target="_blank" rel="noopener noreferrer" class="nav-mobile-link">GitHub</a>
      <a href="/Naveen_Shaji_George_CV.pdf" class="nav-mobile-link">Resume</a>
    </nav>
  </div>
</header>

<script>
  // Sticky nav background on scroll
  const nav = document.getElementById('nav');
  const handleScroll = () => {
    if (window.scrollY > 50) {
      nav?.classList.add('nav-scrolled');
    } else {
      nav?.classList.remove('nav-scrolled');
    }
  };
  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();

  // Active section tracking
  const sections = document.querySelectorAll('section[id]');
  const navLinks = document.querySelectorAll('.nav-link');

  const sectionObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          navLinks.forEach((link) => {
            link.classList.toggle('active', link.getAttribute('href') === `#${id}`);
          });
        }
      });
    },
    { threshold: 0.3, rootMargin: '-80px 0px -40% 0px' }
  );

  sections.forEach((section) => sectionObserver.observe(section));

  // Mobile menu toggle
  const toggle = document.querySelector('.nav-mobile-toggle');
  const mobileMenu = document.getElementById('mobileMenu');
  const mobileLinks = document.querySelectorAll('.nav-mobile-link');

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    mobileMenu?.setAttribute('aria-hidden', String(isOpen));
    document.body.style.overflow = isOpen ? '' : 'hidden';
    toggle.classList.toggle('open');
  });

  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      mobileMenu?.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      toggle?.classList.remove('open');
    });
  });
</script>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    transition: background var(--duration-normal) var(--ease-out),
                border-color var(--duration-normal) var(--ease-out);
    border-bottom: 1px solid transparent;
  }

  .nav-scrolled {
    background: rgba(6, 9, 15, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom-color: var(--border);
  }

  .nav-inner {
    height: var(--nav-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Logo */
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 2px;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text);
    transition: color var(--duration-normal) var(--ease-out);
  }

  .nav-logo:hover {
    color: var(--accent);
  }

  .nav-logo-dot {
    width: 5px;
    height: 5px;
    background: var(--accent);
    border-radius: 50%;
    margin-left: 2px;
    margin-bottom: -2px;
  }

  /* Desktop links */
  .nav-links {
    display: flex;
    gap: var(--space-8);
  }

  .nav-link {
    font-size: var(--text-sm);
    color: var(--text-muted);
    transition: color var(--duration-normal) var(--ease-out);
    position: relative;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--accent);
    transition: width var(--duration-normal) var(--ease-out);
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--text);
  }

  .nav-link.active::after,
  .nav-link:hover::after {
    width: 100%;
  }

  /* Right area */
  .nav-right {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .nav-icon {
    color: var(--text-muted);
    transition: color var(--duration-normal) var(--ease-out);
    padding: var(--space-2);
  }

  .nav-icon:hover {
    color: var(--text);
  }

  .nav-cv-btn {
    padding: 8px 16px;
    font-size: var(--text-xs);
  }

  /* Mobile toggle */
  .nav-mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }

  .hamburger-line {
    width: 20px;
    height: 1.5px;
    background: var(--text);
    transition: transform var(--duration-normal) var(--ease-out),
                opacity var(--duration-normal) var(--ease-out);
  }

  .nav-mobile-toggle.open .hamburger-line:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .nav-mobile-toggle.open .hamburger-line:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  /* Mobile menu */
  .nav-mobile-menu {
    display: none;
    position: fixed;
    inset: var(--nav-height) 0 0 0;
    background: var(--bg);
    z-index: 99;
    padding: var(--space-8);
  }

  .nav-mobile-menu[aria-hidden="false"] {
    display: block;
  }

  .nav-mobile-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .nav-mobile-link {
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--text-secondary);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--border);
    transition: color var(--duration-normal) var(--ease-out);
  }

  .nav-mobile-link:hover {
    color: var(--text);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .nav-links,
    .nav-right {
      display: none;
    }

    .nav-mobile-toggle {
      display: flex;
    }
  }
</style>
