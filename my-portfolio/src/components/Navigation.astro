---
// Minimal Navigation — Graphite + Electric Cyan
const navItems = [
  { num: '01', href: '#work', label: 'WORK' },
  { num: '02', href: '#research', label: 'RESEARCH' },
  { num: '03', href: '#systems', label: 'SYSTEMS' },
  { num: '04', href: '#about', label: 'ABOUT' },
  { num: '05', href: '#contact', label: 'CONTACT' },
];
---

<header class="nav" id="nav">
  <div class="container nav-inner">
    <!-- Brand -->
    <a href="/" class="nav-brand" aria-label="Naveen — Home">
      <span class="nav-name">NAVEEN</span>
      <span class="nav-brand-dot" aria-hidden="true"></span>
    </a>

    <!-- Desktop Navigation Links with Numeric Indexing -->
    <nav class="nav-links" aria-label="Primary Navigation">
      {navItems.map((item) => (
        <a href={item.href} class="nav-item">
          <span class="nav-num mono">{item.num}</span>
          <span class="nav-label">{item.label}</span>
        </a>
      ))}
    </nav>

    <!-- Desktop Actions -->
    <div class="nav-actions">
      <a
        href="https://github.com/buddytex"
        target="_blank"
        rel="noopener noreferrer"
        class="nav-social-btn"
        aria-label="GitHub Profile"
      >
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
        </svg>
      </a>

      <a
        href="/Naveen_Shaji_George_CV.pdf"
        class="btn-graphite btn-graphite-secondary nav-resume-btn mono"
        download
        aria-label="Download Resume"
      >
        <span>RESUME</span>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/>
        </svg>
      </a>

      <!-- Mobile Hamburger Button -->
      <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation menu" aria-expanded="false">
        <span class="toggle-bar"></span>
        <span class="toggle-bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div class="mobile-drawer" id="mobileDrawer" aria-hidden="true">
    <div class="container mobile-drawer-inner">
      <nav class="mobile-nav-list" aria-label="Mobile Navigation">
        {navItems.map((item) => (
          <a href={item.href} class="mobile-item">
            <span class="mobile-num mono">{item.num}</span>
            <span class="mobile-label">{item.label}</span>
          </a>
        ))}
      </nav>

      <div class="mobile-actions">
        <a
          href="/Naveen_Shaji_George_CV.pdf"
          class="btn-graphite btn-graphite-primary mobile-resume-btn mono"
          download
        >
          DOWNLOAD RESUME (PDF)
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile drawer interaction
  const toggleBtn = document.getElementById('navToggle');
  const drawer = document.getElementById('mobileDrawer');
  const mobileLinks = document.querySelectorAll('.mobile-item');
  let open = false;

  function setDrawer(state?: boolean) {
    open = state !== undefined ? state : !open;
    if (toggleBtn && drawer) {
      toggleBtn.setAttribute('aria-expanded', String(open));
      drawer.setAttribute('aria-hidden', String(!open));
      drawer.classList.toggle('active', open);
      toggleBtn.classList.toggle('active', open);
      document.body.style.overflow = open ? 'hidden' : '';
    }
  }

  toggleBtn?.addEventListener('click', () => setDrawer());
  mobileLinks.forEach((link) => link.addEventListener('click', () => setDrawer(false)));

  // Active link indicator on scroll
  const navItems = document.querySelectorAll('.nav-item');
  const sections = document.querySelectorAll('section[id]');

  window.addEventListener('scroll', () => {
    let currentId = '';
    sections.forEach((sec) => {
      const top = (sec as HTMLElement).offsetTop - 120;
      if (window.scrollY >= top) {
        currentId = sec.getAttribute('id') || '';
      }
    });

    navItems.forEach((item) => {
      const href = item.getAttribute('href');
      if (href === `#${currentId}`) {
        item.classList.add('active');
      } else {
        item.classList.remove('active');
      }
    });
  }, { passive: true });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    width: 100%;
    height: var(--nav-height);
    z-index: 1000;
    background: rgba(11, 13, 15, 0.9);
    border-bottom: 1px solid var(--border-subtle);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: border-color var(--duration-norm) var(--ease-spring);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  /* Brand */
  .nav-brand {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .nav-name {
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--text-primary);
  }

  .nav-brand-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--cyan);
  }

  /* Desktop Navigation Links */
  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--text-secondary);
    position: relative;
    padding: var(--space-2) 0;
    transition: color var(--duration-fast) var(--ease-spring);
  }

  .nav-num {
    font-size: 0.625rem;
    color: var(--text-muted);
    transition: color var(--duration-fast) var(--ease-spring);
  }

  .nav-item:hover {
    color: var(--text-primary);
  }

  .nav-item:hover .nav-num {
    color: var(--cyan);
  }

  .nav-item.active {
    color: var(--text-primary);
  }

  .nav-item.active .nav-num {
    color: var(--cyan);
  }

  .nav-item.active::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1.5px;
    background: var(--cyan);
  }

  /* Actions */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .nav-social-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    transition: all var(--duration-fast) var(--ease-spring);
  }

  .nav-social-btn:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.04);
  }

  .nav-resume-btn {
    padding: 7px 16px;
    font-size: var(--text-xs);
    letter-spacing: 0.05em;
  }

  /* Mobile Toggle */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 32px;
    height: 32px;
    cursor: pointer;
  }

  .toggle-bar {
    width: 20px;
    height: 1.5px;
    background: var(--text-primary);
    transition: transform var(--duration-fast) var(--ease-spring),
                opacity var(--duration-fast) var(--ease-spring);
  }

  .nav-toggle.active .toggle-bar:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }

  .nav-toggle.active .toggle-bar:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  /* Mobile Drawer */
  .mobile-drawer {
    display: none;
    position: fixed;
    top: var(--nav-height);
    inset-inline: 0;
    bottom: 0;
    background: var(--bg);
    border-top: 1px solid var(--border);
    padding: var(--space-8) 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-norm) var(--ease-spring);
  }

  .mobile-drawer.active {
    opacity: 1;
    pointer-events: all;
  }

  .mobile-nav-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin-bottom: var(--space-8);
  }

  .mobile-item {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--text-secondary);
  }

  .mobile-item:hover {
    color: var(--text-primary);
  }

  .mobile-num {
    font-size: var(--text-xs);
    color: var(--cyan);
  }

  .mobile-actions {
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-subtle);
  }

  .mobile-resume-btn {
    width: 100%;
    justify-content: center;
    padding: 12px 20px;
  }

  @media (max-width: 840px) {
    .nav-links {
      display: none;
    }
    .nav-resume-btn {
      display: none;
    }
    .nav-toggle {
      display: flex;
    }
    .mobile-drawer {
      display: block;
    }
  }
</style>
