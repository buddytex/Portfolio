---
// Engineering Competencies & Tooling
const domains = [
  {
    title: 'Autonomy & Navigation',
    skills: [
      { name: 'ROS 2 / ROS', desc: 'DDS middleware, Node lifecycles, Action servers, TF2 coordinate transforms, URDF' },
      { name: 'Autonomous Navigation', desc: 'Nav2 stack, global A* pathing, local DWB trajectory rollout, Costmap2D layers' },
      { name: 'SLAM & Odometry', desc: 'Cartographer, SLAM Toolbox, Extended Kalman Filter (EKF) multi-sensor fusion' },
      { name: 'Drive-by-Wire Control', desc: 'Fail-safe electro-mechanical steering and electronic braking actuation' },
    ],
  },
  {
    title: 'Perception & Vision',
    skills: [
      { name: 'LiDAR Processing', desc: 'Planar scan filtering, point-cloud clustering, spatial Euclidean segmentation' },
      { name: 'Computer Vision', desc: 'OpenCV image processing, spatial filtering, contour tracking, homography' },
      { name: 'Edge AI Inference', desc: 'YOLO neural detection, multi-threaded RTSP acquisition, real-time spatial tracking' },
      { name: 'Sensor Calibration', desc: 'Camera intrinsic/extrinsic stereo calibration and LiDAR-camera alignment' },
    ],
  },
  {
    title: 'Embedded Systems & CAN Bus',
    skills: [
      { name: 'Custom ECU Design', desc: 'Multi-layer schematics, sensor signal conditioning, ruggedized power rails' },
      { name: 'CAN 2.0B Networks', desc: '500 kbps automotive arbitration, frame prioritization, DBC parsing' },
      { name: 'Microcontrollers', desc: 'ESP32 (dual-core RTOS), STM32, ARM Cortex-M architecture' },
      { name: 'Wiring & Harnessing', desc: 'Split-voltage HV/LV electrical isolation, EMI shielding, automotive Deutsch connectors' },
    ],
  },
  {
    title: 'Software & Simulation',
    skills: [
      { name: 'C / C++', desc: 'Real-time performance, memory safety, embedded firmware, rclcpp' },
      { name: 'Python', desc: 'Robotics algorithms, rclpy, NumPy, OpenCV, telemetry visualizers' },
      { name: 'Linux / OS', desc: 'Ubuntu, Bash automation, systemd robot daemons, PREEMPT_RT real-time kernel' },
      { name: 'Simulation & Debug', desc: 'Gazebo physics simulation, RViz 2 visualization, Foxglove Studio' },
    ],
  },
];
---

<section id="capabilities" class="section capabilities-section">
  <div class="container">
    <div class="section-header">
      <span class="editorial-tag section-tag">Core Competencies</span>
      <h2>Technical Stack &<br/><span class="text-accent">Engineering Capabilities</span></h2>
      <p class="section-lead">
        Applied expertise across automotive autonomy stacks, real-time embedded hardware,
        spatial perception, and robot operating systems.
      </p>
    </div>

    <!-- Competencies Grid -->
    <div class="competencies-grid">
      {domains.map((dom) => (
        <div class="competency-card">
          <h3 class="competency-title">{dom.title}</h3>
          <div class="skills-list">
            {dom.skills.map((skill) => (
              <div class="skill-row">
                <span class="skill-name mono">{skill.name}</span>
                <p class="skill-desc">{skill.desc}</p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .capabilities-section {
    background: var(--bg);
  }

  .competencies-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-8);
  }

  .competency-card {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .competency-title {
    font-size: var(--text-lg);
    color: var(--text);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
  }

  .skills-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .skill-row {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .skill-name {
    font-size: var(--text-sm);
    color: var(--accent);
    font-weight: 500;
  }

  .skill-desc {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .competencies-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
