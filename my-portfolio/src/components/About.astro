---
// About Component — Editorial Light Canvas
// Technical biography, academic foundation, and verified engineering chronology
import EngineeringTimeline from './EngineeringTimeline.astro';
---

<section id="about" class="section about-section">
  <div class="container-wide">
    <!-- Section Header (Apple HIG Clarity) -->
    <div class="section-header reveal">
      <span class="section-eyebrow">About & Foundation</span>
      <h2 class="section-title">Background &<br/><span class="accent">Engineering Focus</span></h2>
      <p class="section-lead">
        I work at the intersection of robotics, spatial perception, and intelligent machines. My focus centers on
        autonomous vehicles, ROS 2 middleware, edge computer vision, and real-world hardware reliability.
      </p>
    </div>

    <!-- Editorial Layout: Biography Left, Chronology Right -->
    <div class="about-grid">
      <!-- Left: Narrative Bio & Origin Journey -->
      <div class="bio-column">
        <div class="bio-card">
          <span class="card-kicker mono">Journey &amp; Origin</span>
          <h3 class="bio-heading">Hooked on building robotics from a very young age</h3>
          
          <div class="bio-text">
            <p>
              My obsession with robotics started young. As a kid, I was crazily excited whenever a science fair or school exhibition came around, spending weeks tinkering with motors, battery clips, and scrap mechanisms. In 7th grade, I took that passion to a state-level competition by designing, building, and dressing up in a full robot costume handcrafted out of cardboard boxes.
            </p>
            <p>
              That early spark evolved into serious, deep engineering during college. Early breadboard hobby circuits and Arduino experiments progressed into custom multi-layer automotive ECUs, autonomous mobile robots (AMRs), LiDAR SLAM pipelines, and leading the electrical and autonomous division for <em>Team Equinox</em> in BAJA SAE India to national top ranks (AIR 7 &amp; AIR 11).
            </p>
            <p>
              Whether it's routing deterministic CAN bus networks, calibrating Nav2 dynamic costmaps, or building fail-safe hardware interlocks, I love bridging physical hardware with intelligent software to create machines that operate dependably in the real world.
            </p>
          </div>

          <!-- Academic Foundation Block -->
          <div class="education-block">
            <span class="edu-badge mono">Academic Foundation</span>
            <div class="edu-content">
              <h4 class="edu-degree">B.Tech in Robotics &amp; Automation Engineering</h4>
              <span class="edu-institution">Saintgits College of Engineering · Autonomous Institution</span>
              <span class="edu-focus mono">Focus: Autonomous Navigation, Computer Vision, Embedded Controllers</span>
            </div>
          </div>

          <!-- CV Action -->
          <div class="bio-action">
            <a href="/Naveen_Shaji_George_CV.pdf" class="btn btn-primary" download>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/>
              </svg>
              <span>Download Curriculum Vitae (PDF)</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Right: Chronological Milestones -->
      <div class="chronology-column">
        <EngineeringTimeline />
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    background: transparent;
    border-top: 1px solid var(--border-subtle);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: var(--space-12);
    align-items: start;
  }

  /* Left Bio Card */
  .bio-column {
    position: sticky;
    top: calc(var(--nav-height) + 24px);
  }

  .bio-card {
    background: var(--surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--r-card);
    padding: var(--space-10);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    box-shadow: var(--shadow-resting);
  }

  .card-kicker {
    font-size: var(--text-2xs);
    letter-spacing: 0.06em;
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
  }

  .bio-heading {
    font-size: var(--text-3xl);
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    font-weight: 800;
  }

  .bio-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .bio-text p {
    font-size: var(--text-base);
    line-height: 1.8;
    color: var(--text-secondary);
  }

  .bio-text em {
    font-style: normal;
    color: var(--text-primary);
    font-weight: 600;
  }

  /* Education */
  .education-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-subtle);
    border-radius: var(--r-md);
  }

  .edu-badge {
    font-size: var(--text-2xs);
    color: var(--text-muted);
    letter-spacing: 0.06em;
    font-weight: 600;
    text-transform: uppercase;
  }

  .edu-content {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .edu-degree {
    font-size: var(--text-sm);
    color: var(--text-primary);
    font-weight: 700;
  }

  .edu-institution {
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  .edu-focus {
    font-size: var(--text-2xs);
    color: var(--text-muted);
    margin-top: var(--space-1);
  }

  .bio-action {
    padding-top: var(--space-2);
  }

  /* Right: Chronology column */
  .chronology-column {
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
    .bio-column {
      position: static;
    }
  }
</style>
