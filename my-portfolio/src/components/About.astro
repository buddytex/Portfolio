---
// About Section — Editorial biography and verified engineering chronology
const timeline = [
  {
    period: '2025 – 2026',
    role: 'Electrical & Electronics Head',
    organization: 'Team Equinox · BAJA SAE India',
    achievement: 'All India Rank AIR 7 (2025) & AIR 11 (2026)',
    description: 'Directed the end-to-end electrical architecture, custom ECU electronics, CAN bus protocol stack, and drive-by-wire electro-mechanical integration for an autonomous off-road vehicle competing nationwide.',
    skills: ['CAN Bus 2.0B', 'Custom Multi-Layer ECUs', 'Drive-by-Wire Actuators', 'HV/LV Harnessing', 'Safety Interlocks'],
  },
  {
    period: '2024 – 2025',
    role: 'Autonomy & Embedded Developer',
    organization: 'Hospital Service Autonomous Mobile Robot (AMR)',
    achievement: 'Closed-Loop Hospital Logistics Autonomous Testbed',
    description: 'Engineered 2D LiDAR SLAM, Nav2 local costmap dynamic tuning, and differential drive kinematics to achieve safe indoor transport of medical supplies.',
    skills: ['ROS 2 Humble', 'Nav2', 'SLAM Toolbox', 'Differential Kinematics', 'IoT Telemetry'],
  },
  {
    period: '2023 – 2024',
    role: 'Computer Vision & Systems Researcher',
    organization: 'Edge Perception & Swarm Robotics Platforms',
    achievement: 'Multi-Agent Mesh & Real-Time Computer Vision',
    description: 'Developed real-time RTSP anomaly detection with OpenCV and engineered peer-to-peer TCP/IP mesh coordination across distributed mobile robot swarm nodes.',
    skills: ['OpenCV', 'Python', 'TCP/IP Sockets Protocol', 'Edge AI', 'Distributed Systems'],
  },
];
---

<section id="about" class="section about-section">
  <div class="container">
    <!-- Header -->
    <div class="section-header">
      <span class="editorial-tag section-tag">Background & Experience</span>
      <h2>Engineering Philosophy &<br/><span class="text-accent">Chronology</span></h2>
      <p class="section-lead">
        A hands-on track record spanning autonomous off-road vehicle architecture,
        custom embedded electronics, and real-time robotic perception.
      </p>
    </div>

    <!-- Editorial Layout: Biography Left, Chronology Right -->
    <div class="about-grid">
      <!-- Left: Narrative Bio -->
      <div class="bio-column">
        <div class="bio-lead">
          <p>
            I am a robotics engineer driven by the challenge of bridging <strong class="text-white">physical hardware</strong> and
            <strong class="text-white">intelligent software</strong>. Rather than viewing robotics purely from an algorithmic or purely from a mechanical angle,
            I focus on complete, unified systems integration.
          </p>
        </div>

        <div class="bio-body">
          <p>
            As the Electrical & Electronics Head for <em>Team Equinox</em>, I spearheaded the complete electronic powertrain and autonomous architecture
            for our all-terrain vehicle, leading the team to top-tier national finishes (AIR 7 in 2025, AIR 11 in 2026).
            My day-to-day spans designing custom multi-layer ECUs, assembling isolated wiring harnesses, troubleshooting deterministic CAN bus frames on an oscilloscope,
            and tuning ROS 2 Nav2 costmaps.
          </p>
          <p>
            I thrive in research and R&D environments where safety-critical hardware reliability meets state-of-the-art spatial perception.
          </p>
        </div>

        <!-- Academic Foundation -->
        <div class="education-block">
          <span class="edu-label mono">ACADEMIC FOUNDATION</span>
          <h4 class="edu-degree">B.Tech in Robotics & Automation Engineering</h4>
          <span class="edu-school">Saintgits College of Engineering · Autonomous Institution</span>
        </div>

        <!-- Resume Action -->
        <div class="bio-actions">
          <a href="/Naveen_Shaji_George_CV.pdf" class="btn-editorial btn-editorial-primary" download>
            <span>Download Curriculum Vitae (PDF)</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Right: Engineering Chronology Tree -->
      <div class="chronology-column">
        <div class="chronology-label mono">DEPLOYED MILESTONES (2023 – 2026)</div>
        <div class="timeline-list">
          {timeline.map((item) => (
            <div class="timeline-item">
              <div class="timeline-period mono">{item.period}</div>
              <div class="timeline-content">
                <h4 class="timeline-role">{item.role}</h4>
                <div class="timeline-org mono">{item.organization}</div>
                {item.achievement && (
                  <div class="timeline-badge mono">{item.achievement}</div>
                )}
                <p class="timeline-desc">{item.description}</p>
                <div class="timeline-skills">
                  {item.skills.map((skill) => (
                    <span class="skill-tag mono">{skill}</span>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    background: var(--bg-subtle);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
    align-items: start;
  }

  /* Left Bio */
  .bio-column {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .bio-lead p {
    font-size: var(--text-lg);
    line-height: 1.65;
    color: var(--text-secondary);
  }

  .bio-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .bio-body p {
    font-size: var(--text-base);
    line-height: 1.75;
    color: var(--text-secondary);
  }

  .bio-body em {
    color: var(--text);
    font-style: normal;
  }

  /* Education */
  .education-block {
    padding: var(--space-5) var(--space-6);
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: var(--space-2);
  }

  .edu-label {
    font-size: var(--text-2xs);
    color: var(--accent);
    letter-spacing: 0.08em;
  }

  .edu-degree {
    font-size: var(--text-base);
    color: var(--text);
    font-weight: 600;
  }

  .edu-school {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .bio-actions {
    margin-top: var(--space-2);
  }

  /* Right Chronology */
  .chronology-column {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .chronology-label {
    font-size: var(--text-2xs);
    color: var(--text-muted);
    letter-spacing: 0.08em;
  }

  .timeline-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    position: relative;
  }

  .timeline-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-left: var(--space-6);
    border-left: 1px solid var(--border);
    position: relative;
  }

  .timeline-item::before {
    content: "";
    position: absolute;
    left: -3.5px;
    top: 4px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .timeline-period {
    font-size: var(--text-xs);
    color: var(--text-muted);
    letter-spacing: 0.04em;
  }

  .timeline-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .timeline-role {
    font-size: var(--text-lg);
    color: var(--text);
    line-height: 1.3;
  }

  .timeline-org {
    font-size: var(--text-xs);
    color: var(--accent);
  }

  .timeline-badge {
    font-size: var(--text-2xs);
    color: var(--text);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    width: fit-content;
    margin: 2px 0;
  }

  .timeline-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .timeline-skills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .skill-tag {
    font-size: var(--text-2xs);
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
  }

  @media (max-width: 960px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }
  }
</style>
