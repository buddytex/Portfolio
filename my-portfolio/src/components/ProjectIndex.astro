                  ) : (
                    <div class="project-hardware-blueprint" aria-label="LiDAR SLAM Navigation Testbed Schematic">
                      <svg viewBox="0 0 380 220" fill="none" class="blueprint-svg" aria-hidden="true">
                        <circle cx="190" cy="110" r="35" stroke="#0EA5E9" stroke-width="1" stroke-dasharray="3 3" opacity="0.4" />
                        <circle cx="190" cy="110" r="75" stroke="#0EA5E9" stroke-width="1" stroke-dasharray="3 3" opacity="0.3" />
                        <circle cx="190" cy="110" r="105" stroke="#0EA5E9" stroke-width="1" opacity="0.2" />
                        <rect x="175" y="95" width="30" height="30" rx="4" fill="#0EA5E9" fill-opacity="0.25" stroke="#0EA5E9" stroke-width="1.5" />
                        <circle cx="190" cy="110" r="4" fill="#38BDF8" />
                        <path d="M190 110 L190 65" stroke="#38BDF8" stroke-width="2" stroke-linecap="round" />
                        <polygon points="190,58 186,67 194,67" fill="#38BDF8" />
                        <line x1="40" y1="30" x2="340" y2="30" stroke="#64748B" stroke-width="1.5" stroke-dasharray="4 4" />
                        <line x1="40" y1="190" x2="340" y2="190" stroke="#64748B" stroke-width="1.5" stroke-dasharray="4 4" />
                        <g fill="#38BDF8" opacity="0.8">
                          <circle cx="80" cy="30" r="2" /><circle cx="130" cy="30" r="2" /><circle cx="240" cy="30" r="2" /><circle cx="300" cy="30" r="2" />
                          <circle cx="90" cy="190" r="2" /><circle cx="150" cy="190" r="2" /><circle cx="230" cy="190" r="2" /><circle cx="290" cy="190" r="2" />
                        </g>
                        <path d="M190 110 L110 40 M190 110 L150 32 M190 110 L230 32 M190 110 L270 40" stroke="#0EA5E9" stroke-width="0.8" opacity="0.45" />
                        <text x="190" y="145" fill="#94A3B8" font-size="8" font-family="monospace" text-anchor="middle">NAV2 COSTMAP // 360° PLANAR LIDAR</text>
                      </svg>
                    </div>
                  )}

                  <!-- Top Index & Status Badges -->
                  <div class="card-visual-top">
                    <span class="visual-index mono">{project.index}</span>
                    <span class="visual-status tag">{project.status}</span>
                  </div>

                  <!-- Precision Corner Ticks -->
                  <div class="card-corner corner-tl" aria-hidden="true"></div>
                  <div class="card-corner corner-tr" aria-hidden="true"></div>
                  <div class="card-corner corner-bl" aria-hidden="true"></div>
                  <div class="card-corner corner-br" aria-hidden="true"></div>

                  <!-- Hover Glassmorphic Overlay -->
                  <div class="card-hover-overlay" aria-hidden="true">
                    <div class="hover-overlay-content">
                      <div class="hover-header-row mono">
                        <span class="hover-category">{project.domain.split('/')[0].trim()}</span>
                        <span class="hover-year">{project.year}</span>
                      </div>
                      <h4 class="hover-title">{project.title}</h4>
                      <div class="hover-role-tag mono">
                        <span class="role-icon">⚡</span>
                        <span>{project.shortRole}</span>
                      </div>
                      <div class="hover-areas-list mono">
                        {project.keyAreas.slice(0, 3).map((area) => (
                          <span class="area-chip">{area}</span>
                        ))}
                      </div>
                      <div class="hover-cta-row">
                        <span class="inspect-btn mono">INSPECT CASE STUDY ↗</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Resting Card Footer -->
              <div class="card-footer-minimal">
                <div class="footer-primary-col">
                  <div class="card-domain-row mono">
                    <span class="card-domain">{project.domain.split('/')[0].trim()}</span>
                    <span class="card-year mono">{project.year}</span>
                  </div>
                  <h3 class="card-title" transition:name={`project-title-${project.id}`}>{project.title}</h3>
                  <div class="card-subtitle mono">{project.subtitle}</div>
                  <div class="card-mobile-areas mono">
                    {project.keyAreas.slice(0, 3).map((area) => (
                      <span class="mobile-area-chip">{area}</span>
                    ))}
                  </div>
                </div>
                <div class="footer-secondary-col">
                  <span class="role-badge mono">{project.shortRole}</span>
                  <div class="card-arrow-circle" aria-hidden="true">→</div>
                </div>
              </div>

            </a>
          </article>
        ))}
      </div>

      <!-- 03. RESEARCH PLATFORMS, MULTI-AGENT SYSTEMS & AUTOMATION: RailGuard AI, Swarm Robotics, Balancing Robot & Automated Vertical Parking System -->
      <div class="trio-grid-row">
        {supportingProjects.map((project) => (
          <article 
            class="project-card card-trio" 
            id={`card-${project.id}`} 
            data-project-id={project.id}
          >
            <a href={resolveHref(`/projects/${project.id}`)} class="card-link" aria-label={`View architecture case study for ${project.title}`}>
              
              <!-- Dominant Visual Stage (75-80% area) -->
              <div class="card-visual-wrap trio-visual" transition:name={`project-visual-${project.id}`}>
                <div class="card-media-stage">
                  {project.imagePath ? (
                    <div class="project-img-dual">
                      <img
                        src={resolveMediaUrl(project.imagePath)}
                        alt={`${project.title} Primary Artifact`}
                        class="project-real-img img-primary"
                        loading="eager"
                        decoding="async"
                      />
                      {project.secondaryImage && (
                        <img
                          src={resolveMediaUrl(project.secondaryImage)}
                          alt={`${project.title} Secondary Artifact`}
                          class="project-real-img img-secondary"
                          loading="eager"
                          decoding="async"
                        />
                      )}
                    </div>
                  ) : (
                    <div class="project-hardware-blueprint" aria-label="Decentralized Swarm Robotics Mesh Schematic">
                      <svg viewBox="0 0 380 220" fill="none" class="blueprint-svg" aria-hidden="true">
                        <line x1="90" y1="70" x2="190" y2="50" stroke="#0EA5E9" stroke-width="1.2" stroke-dasharray="2 2" opacity="0.6" />
                        <line x1="190" y1="50" x2="290" y2="80" stroke="#0EA5E9" stroke-width="1.2" stroke-dasharray="2 2" opacity="0.6" />
                        <line x1="90" y1="70" x2="140" y2="150" stroke="#0EA5E9" stroke-width="1.2" stroke-dasharray="2 2" opacity="0.6" />
                        <line x1="140" y1="150" x2="240" y2="160" stroke="#0EA5E9" stroke-width="1.2" stroke-dasharray="2 2" opacity="0.6" />
                        <line x1="240" y1="160" x2="290" y2="80" stroke="#0EA5E9" stroke-width="1.2" stroke-dasharray="2 2" opacity="0.6" />
                        <g fill="#10B981">
                          <circle cx="90" cy="70" r="7" /><circle cx="190" cy="50" r="7" /><circle cx="290" cy="80" r="7" />
                          <circle cx="140" cy="150" r="7" /><circle cx="240" cy="160" r="7" />
                        </g>
                        <g fill="#FFFFFF" font-size="7" font-family="monospace" text-anchor="middle" font-weight="bold">
                          <text x="90" y="73">01</text><text x="190" y="53">02</text><text x="290" y="83">03</text>
                          <text x="140" y="153">04</text><text x="240" y="163">05</text>
                        </g>
                        <circle cx="190" cy="105" r="4" fill="#F59E0B" />
                        <circle cx="190" cy="105" r="16" stroke="#F59E0B" stroke-width="1" stroke-dasharray="2 2" opacity="0.7" />
                        <text x="190" y="130" fill="#FBBF24" font-size="7" font-family="monospace" text-anchor="middle">VIRTUAL TARGET ATTRACTOR</text>
                        <text x="190" y="195" fill="#94A3B8" font-size="8" font-family="monospace" text-anchor="middle">ESP32 AD-HOC TCP/IP MESH // CONSENSUS</text>
                      </svg>
                    </div>
                  )}

                  <!-- Top Index & Badges -->
                  <div class="card-visual-top">
                    <span class="visual-index mono">{project.index}</span>
                    <span class="visual-status tag">{project.status}</span>
                  </div>

                  <!-- Precision Corner Ticks -->
                  <div class="card-corner corner-tl" aria-hidden="true"></div>
                  <div class="card-corner corner-tr" aria-hidden="true"></div>
                  <div class="card-corner corner-bl" aria-hidden="true"></div>
                  <div class="card-corner corner-br" aria-hidden="true"></div>

                  <!-- Hover Glassmorphic Overlay -->
                  <div class="card-hover-overlay" aria-hidden="true">
                    <div class="hover-overlay-content">
                      <div class="hover-header-row mono">
                        <span class="hover-category">{project.domain.split('/')[0].trim()}</span>
                        <span class="hover-year">{project.year}</span>
                      </div>
                      <h4 class="hover-title">{project.title}</h4>
                      <div class="hover-role-tag mono">
                        <span class="role-icon">⚡</span>
                        <span>{project.shortRole}</span>
                      </div>
                      <div class="hover-areas-list mono">
                        {project.keyAreas.slice(0, 3).map((area) => (
                          <span class="area-chip">{area}</span>
                        ))}
                      </div>
                      <div class="hover-cta-row">
                        <span class="inspect-btn mono">INSPECT CASE STUDY ↗</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Resting Card Footer -->
              <div class="card-footer-minimal">
                <div class="footer-primary-col">
                  <div class="card-domain-row mono">
                    <span class="card-domain">{project.domain.split('/')[0].trim()}</span>
                    <span class="card-year mono">{project.year}</span>
                  </div>
                  <h3 class="card-title" transition:name={`project-title-${project.id}`}>{project.title}</h3>
                  <div class="card-subtitle mono">{project.subtitle}</div>
                  <div class="card-mobile-areas mono">
                    {project.keyAreas.slice(0, 3).map((area) => (
                      <span class="mobile-area-chip">{area}</span>
                    ))}
                  </div>
                </div>
                <div class="footer-secondary-col">
                  <span class="role-badge mono">{project.shortRole}</span>
                  <div class="card-arrow-circle" aria-hidden="true">→</div>
                </div>
              </div>

            </a>
          </article>
        ))}
      </div>

    </div>

    <!-- All Projects Archive Action Banner -->
    <div class="archive-action-wrap" id="projectArchiveBanner">
      <div class="archive-action-inner">
        <div class="archive-meta">
          <div class="archive-badge mono">
            <span class="badge-pip"></span>
            <span>REPOSITORY SYSTEMS INDEX</span>
          </div>
          <h3 class="archive-heading">Explore All {projects.length} Engineering Projects</h3>
          <p class="archive-summary">
            Including inverted pendulum balance robotics, multi-sensor AGV EKF navigation, and real-time highway lane tracking testbeds.
          </p>
        </div>

        <div class="archive-btn-wrap">
          <a href={resolveHref('/projects')} class="see-all-projects-btn" id="seeAllProjectsBtn">
            <span class="btn-main-label">SEE ALL PROJECTS</span>
            <span class="btn-count mono">({projects.length})</span>
            <span class="btn-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initProjectCardsAnimation } from '../animations';

  let projectCleanup: (() => void) | null = null;

  function initCardClicks() {
    const cards = document.querySelectorAll<HTMLElement>('.project-card');
    cards.forEach((card) => {
      if (card.dataset.navBound === 'true') return;
      card.dataset.navBound = 'true';

      card.addEventListener('click', (e) => {
        // If an anchor was already clicked directly, allow native link navigation
        const closestAnchor = (e.target as HTMLElement).closest('a');
        if (closestAnchor) return;

        // If clicked on any outer part of the card, activate its primary link
        const cardLink = card.querySelector<HTMLAnchorElement>('a.card-link');
        if (cardLink) {
          cardLink.click();
        }
      });
    });
  }

  function initProjects() {
    if (projectCleanup) {
      projectCleanup();
      projectCleanup = null;
    }
    const workSection = document.getElementById('work');
    if (workSection) {
      projectCleanup = initProjectCardsAnimation(workSection);
    }
    initCardClicks();
  }

  document.addEventListener('astro:page-load', initProjects);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProjects);
  } else {
    initProjects();
  }
</script>

<style>
  .work-section {
    border-top: 1px solid var(--border-subtle);
    padding: var(--section-pad) 0;
    background: transparent;
  }

  .header-kicker {
    font-size: var(--text-2xs);
    color: var(--accent-primary);
    font-weight: 700;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-2);
  }

  .work-section .section-title {
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    margin-bottom: var(--space-3);
  }

  .work-section .section-lead {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    max-width: 680px;
    line-height: 1.65;
  }

  /* Editorial Projects Wrap */
  .editorial-projects-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .flagship-row {
    width: 100%;
  }

  .baja-grid-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }

  .duo-grid-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }

  .trio-grid-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }

  .project-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-card);
    overflow: hidden;
    box-shadow: var(--shadow-resting);
    position: relative;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    opacity: 1;
    transition: opacity 220ms var(--ease-standard),
                transform 180ms var(--ease-standard),
                border-color 180ms var(--ease-standard),
                box-shadow 180ms var(--ease-standard);
    will-change: transform, opacity;
  }

  .project-card.is-revealed {
    opacity: 1;
  }

  .project-card:hover,
  .project-card:focus-within {
    transform: translateY(-4px);
    border-color: var(--accent-primary);
    box-shadow: 0 16px 36px -12px rgba(184, 146, 74, 0.22), 0 8px 20px -8px rgba(20, 24, 34, 0.12);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }

  .card-link {
    display: flex;
    flex-direction: column;
    flex: 1 1 100%;
    width: 100%;
    height: 100%;
    text-decoration: none;
    color: inherit;
    border-radius: var(--r-card);
    position: relative;
    z-index: 1;
  }

  .card-link:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }

  /* Hardware Photo / Blueprint Artifact Stage: Visual-Dominant (75–80%) */
  .card-visual-wrap {
    position: relative;
    width: 100%;
    background: #EEEAE3;
    border-bottom: 1px solid var(--border);
    overflow: hidden;
    border-top-left-radius: var(--r-card);
    border-top-right-radius: var(--r-card);
  }

  .flagship-visual {
    height: 440px;
  }

  .baja-visual {
    height: 380px;
  }

  .duo-visual {
    height: 340px;
  }

  .trio-visual {
    height: 300px;
  }

  .card-media-stage {
    width: 100%;
    height: 100%;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(circle at center, #191E2B 0%, #0F131D 100%);
    box-shadow: inset 0 0 40px rgba(0, 0, 0, 0.45);
    overflow: hidden;
  }

  .card-media-stage::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 24px 24px;
    pointer-events: none;
    z-index: 0;
  }

  .project-img-dual {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    z-index: 1;
  }

  .project-real-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), filter 0.35s ease;
    filter: brightness(0.98) contrast(1.04);
  }

  /* Intelligent focal positions per engineering artifact so vehicles, hardware, and teams fill the frame without clipping */
  #card-baja-2025 .project-real-img {
    object-position: center 42%;
  }

  #card-baja-2026 .project-real-img {
    object-position: center 32%;
  }

  #card-hospital-amr .project-real-img {
    object-position: center 25%;
