---
// ProjectIndex Component — Interactive Robotics Engineering Project Index
// Visual-Dominant Editorial Layout: 75–80% image area, 20–25% metadata
// Asymmetrical layout: Flagship monumental aBAJA card, balanced featured duo, supporting trio
// Hover: subtle zoom, dark glass overlay with role, key technical areas, and inspect CTA
import { projects } from '../data/projects';
import { resolveMediaUrl, resolveHref } from '../utils/media';
const featuredProjects = projects.filter(p => p.featured);
const bajaProjects = featuredProjects.filter(p => p.id === 'baja-2025' || p.id === 'baja-2026');
const duoProjects = featuredProjects.filter(p => p.id === 'hospital-amr' || p.id === 'smart-cctv');
const supportingProjects = featuredProjects.filter(p => p.id === 'railguard-ai' || p.id === 'swarm-robotics' || p.id === 'balancing-robot' || p.id === 'automated-vertical-parking');
---

<section id="work" class="section work-section">
  <div class="container-wide">
    <!-- Section Header -->
    <div class="section-header">
      <div class="header-kicker mono">[ 03 // SELECTED SYSTEMS ]</div>
      <h2 class="section-title">Autonomous Machines Built for the <span class="accent">Physical World</span></h2>
      <p class="section-lead">
        Physical autonomous platforms, high-throughput edge perception, custom vehicle ECUs, and real-time control algorithms.
        Engineered to operate reliably under real physical constraints.
      </p>
    </div>

    <!-- Editorial Projects Layout -->
    <div class="editorial-projects-wrap" id="featuredGrid" role="feed" aria-label="Selected Engineering Projects">
      
      <!-- 01 & 02. DUAL BAJA SAEINDIA CAMPAIGN ROW: 2025 (Car A12) & 2026 (Car A18) -->
      <div class="baja-grid-row">
        {bajaProjects.map((project) => (
          <article 
            class="project-card card-baja" 
            id={`card-${project.id}`} 
            data-project-id={project.id}
          >
            <a href={resolveHref(`/projects/${project.id}`)} class="card-link" aria-label={`View architecture case study for ${project.title}`}>
              
              <!-- Dominant Visual Stage (75-80% area) -->
              <div class="card-visual-wrap baja-visual" transition:name={`project-visual-${project.id}`}>
                <div class="card-media-stage">
                  <div class="project-img-dual">
                    <img
                      src={resolveMediaUrl(project.imagePath)}
                      alt={`${project.title} Primary Artifact`}
                      class="project-real-img img-primary"
                      loading="eager"
                      decoding="async"
                    />
                    {project.secondaryImage && (
                      <img
                        src={resolveMediaUrl(project.secondaryImage)}
                        alt={`${project.title} Secondary Artifact`}
                        class="project-real-img img-secondary"
                        loading="eager"
                        decoding="async"
                      />
                    )}
                  </div>

                  <!-- Visual Status Badges & Hardware Stamp -->
                  <div class="card-visual-top">
                    <span class="visual-index mono">{project.index} // {project.year === '2025' ? 'AIR 7 NATIONAL' : 'AIR 11 NATIONAL'}</span>
                    <span class="visual-status tag status-flagship">{project.status}</span>
                  </div>

                  <!-- Precision Corner Hardware Ticks -->
                  <div class="card-corner corner-tl" aria-hidden="true"></div>
                  <div class="card-corner corner-tr" aria-hidden="true"></div>
                  <div class="card-corner corner-bl" aria-hidden="true"></div>
                  <div class="card-corner corner-br" aria-hidden="true"></div>

                  <!-- Hover Glassmorphic Overlay: Revealed on intentional hover -->
                  <div class="card-hover-overlay" aria-hidden="true">
                    <div class="hover-overlay-content">
                      <div class="hover-header-row mono">
                        <span class="hover-category">{project.domain.split('/')[0].trim()}</span>
                        <span class="hover-year">{project.year}</span>
                      </div>
                      <h4 class="hover-title">{project.title}</h4>
                      <div class="hover-role-tag mono">
                        <span class="role-icon">⚡</span>
                        <span>{project.shortRole}</span>
                      </div>
                      <div class="hover-areas-list mono">
                        {project.keyAreas.slice(0, 4).map((area) => (
                          <span class="area-chip">{area}</span>
                        ))}
                      </div>
                      <div class="hover-cta-row">
                        <span class="inspect-btn mono">INSPECT CASE STUDY ↗</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Resting Card Footer: Clean, Minimal, Non-Bloated (20-25% area) -->
              <div class="card-footer-minimal">
                <div class="footer-primary-col">
                  <div class="card-domain-row mono">
                    <span class="card-domain">{project.domain.split('/')[0].trim()}</span>
                    <span class="card-year mono">{project.year}</span>
                  </div>
                  <h3 class="card-title" transition:name={`project-title-${project.id}`}>{project.title}</h3>
                  <div class="card-subtitle mono">{project.subtitle}</div>
                  {project.ownershipStory && (
                    <div class="card-ownership-tag mono">
                      <span class="ownership-glyph">★</span>
                      <span>{project.ownershipStory.title}</span>
                    </div>
                  )}
                  <div class="card-mobile-areas mono">
                    {project.keyAreas.slice(0, 3).map((area) => (
                      <span class="mobile-area-chip">{area}</span>
                    ))}
                  </div>
                </div>
                <div class="footer-secondary-col">
                  <span class="role-badge mono">{project.shortRole}</span>
                  <div class="card-arrow-circle" aria-hidden="true">→</div>
                </div>
              </div>

            </a>
          </article>
        ))}
      </div>

      <!-- 02. BALANCED FEATURED DUO: Smart CCTV & Hospital AMR -->
      <div class="duo-grid-row">
        {duoProjects.map((project) => (
          <article 
            class="project-card card-duo" 
            id={`card-${project.id}`} 
            data-project-id={project.id}
          >
            <a href={resolveHref(`/projects/${project.id}`)} class="card-link" aria-label={`View architecture case study for ${project.title}`}>
              
              <!-- Dominant Visual Stage (75-80% area) -->
              <div class="card-visual-wrap duo-visual" transition:name={`project-visual-${project.id}`}>
                <div class="card-media-stage">
                  {project.imagePath ? (
                    <div class="project-img-dual">
                      <img
                        src={resolveMediaUrl(project.imagePath)}
                        alt={`${project.title} Primary Artifact`}
                        class="project-real-img img-primary"
                        loading="eager"
                        decoding="async"
                      />
                      {project.secondaryImage && (
                        <img
                          src={resolveMediaUrl(project.secondaryImage)}
                          alt={`${project.title} Secondary Artifact`}
                          class="project-real-img img-secondary"
