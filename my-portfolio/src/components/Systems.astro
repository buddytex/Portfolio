---
// ROS 2 Autonomy Stack & Systems Architecture
// Clean technical schematic representing real ROS 2 computational graph
const nodes = [
  {
    id: 'node-lidar',
    name: '/sensors/rplidar_driver',
    type: 'Hardware Driver',
    pub: '/scan [sensor_msgs/LaserScan]',
    sub: 'None (Hardware Serial /dev/ttyUSB0)',
    qos: 'Best Effort · 10 Hz',
    desc: 'Acquires 360° raw time-of-flight laser range measurements over high-speed UART and publishes planar scan arrays.',
  },
  {
    id: 'node-perception',
    name: '/perception/obstacle_detector',
    type: 'Perception Node',
    pub: '/detected_obstacles [visualization_msgs/MarkerArray]',
    sub: '/scan · /tf',
    qos: 'Reliable · 10 Hz',
    desc: 'Segments point cloud clusters, filters sensor noise, and extracts bounding obstacles with spatial clearance zones.',
  },
  {
    id: 'node-localization',
    name: '/localization/ekf_odom_node',
    type: 'State Estimation',
    pub: '/odom [nav_msgs/Odometry] · /tf',
    sub: '/wheel_encoders · /imu/data',
    qos: 'Reliable · 50 Hz',
    desc: 'Extended Kalman Filter fusing wheel tick encoders, IMU angular velocity, and scan matching for drift-free vehicle pose.',
  },
  {
    id: 'node-nav2',
    name: '/navigation/nav2_controller',
    type: 'Path Planning',
    pub: '/cmd_vel [geometry_msgs/Twist]',
    sub: '/scan · /odom · /tf · /goal_pose',
    qos: 'Reliable · 20 Hz',
    desc: 'Computes global A* paths and local DWB collision-avoidance velocity vectors to drive the platform safely to target waypoints.',
  },
  {
    id: 'node-can',
    name: '/actuation/can_bridge_ecu',
    type: 'Vehicle Gateway',
    pub: '/can_rx · /wheel_encoders',
    sub: '/cmd_vel [geometry_msgs/Twist]',
    qos: 'Deterministic Real-Time · 100 Hz',
    desc: 'Translates velocity twists into high-priority CAN 2.0B arbitration frames (0x120, 0x124) commanding custom drive-by-wire ECUs.',
  },
];
---

<section id="systems" class="section systems-section">
  <div class="container">
    <!-- Header -->
    <div class="section-header">
      <span class="editorial-tag section-tag">Computational Graph</span>
      <h2>ROS 2 Autonomy Stack &<br/><span class="text-accent">Systems Architecture</span></h2>
      <p class="section-lead">
        A real-time, deterministic software architecture orchestrating sensor ingestion, spatial perception,
        probabilistic state estimation, and CAN 2.0B vehicle bus actuation.
      </p>
    </div>

    <!-- Architecture Layout: Left Schematic Graph, Right Subsystem Inspector -->
    <div class="systems-grid">
      <!-- Left: Interactive Computational Pipeline -->
      <div class="graph-column">
        <div class="graph-caption mono">AUTONOMY DATAFLOW PIPELINE · CLICK NODE TO INSPECT</div>
        <div class="nodes-list" role="tablist">
          {nodes.map((node, idx) => (
            <button
              class:list={['node-button', { active: idx === 0 }]}
              data-id={node.id}
              data-name={node.name}
              data-type={node.type}
              data-pub={node.pub}
              data-sub={node.sub}
              data-qos={node.qos}
              data-desc={node.desc}
              role="tab"
              aria-selected={idx === 0 ? "true" : "false"}
            >
              <div class="node-num mono">0{idx + 1}</div>
              <div class="node-info">
                <span class="node-title mono">{node.name}</span>
                <span class="node-subtitle">{node.type}</span>
              </div>
              <div class="node-arrow" aria-hidden="true">→</div>
            </button>
          ))}
        </div>
      </div>

      <!-- Right: Subsystem Inspector -->
      <div class="inspector-column">
        <div class="inspector-panel" id="inspectorPanel">
          <div class="inspector-header">
            <span class="inspector-tag mono">Subsystem Specification</span>
            <h3 class="inspector-title mono" id="inspName">{nodes[0].name}</h3>
            <span class="inspector-type" id="inspType">{nodes[0].type}</span>
          </div>

          <div class="inspector-body">
            <div class="spec-field">
              <span class="spec-lbl mono">QoS Reliability</span>
              <span class="spec-val mono" id="inspQoS">{nodes[0].qos}</span>
            </div>

            <div class="spec-field">
              <span class="spec-lbl mono">Subscribed Input</span>
              <span class="spec-val mono" id="inspSub">{nodes[0].sub}</span>
            </div>

            <div class="spec-field">
              <span class="spec-lbl mono">Published Output</span>
              <span class="spec-val mono accent" id="inspPub">{nodes[0].pub}</span>
            </div>

            <div class="spec-field desc-field">
              <span class="spec-lbl mono">Architectural Role</span>
              <p class="spec-desc" id="inspDesc">{nodes[0].desc}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Clean Node inspector switcher
  const nodeButtons = document.querySelectorAll('.node-button');
  const inspName = document.getElementById('inspName');
  const inspType = document.getElementById('inspType');
  const inspQoS = document.getElementById('inspQoS');
  const inspSub = document.getElementById('inspSub');
  const inspPub = document.getElementById('inspPub');
  const inspDesc = document.getElementById('inspDesc');
  const inspPanel = document.getElementById('inspectorPanel');

  nodeButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      nodeButtons.forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');

      if (inspName) inspName.textContent = btn.getAttribute('data-name') || '';
      if (inspType) inspType.textContent = btn.getAttribute('data-type') || '';
      if (inspQoS) inspQoS.textContent = btn.getAttribute('data-qos') || '';
      if (inspSub) inspSub.textContent = btn.getAttribute('data-sub') || '';
      if (inspPub) inspPub.textContent = btn.getAttribute('data-pub') || '';
      if (inspDesc) inspDesc.textContent = btn.getAttribute('data-desc') || '';

      // Subtle feedback fade
      if (inspPanel) {
        inspPanel.style.opacity = '0.7';
        setTimeout(() => {
          inspPanel.style.opacity = '1';
        }, 80);
      }
    });
  });
</script>

<style>
  .systems-section {
    background: var(--bg-subtle);
  }

  .systems-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: var(--space-8);
    align-items: start;
  }

  .graph-caption {
    font-size: var(--text-2xs);
    color: var(--text-muted);
    letter-spacing: 0.08em;
    margin-bottom: var(--space-4);
  }

  .nodes-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .node-button {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    text-align: left;
    width: 100%;
    transition: all var(--duration-fast) var(--ease-editorial);
    cursor: pointer;
  }

  .node-button:hover {
    border-color: var(--border-hover);
    background: var(--bg-surface-hover);
    transform: translateX(3px);
  }

  .node-button.active {
    background: var(--bg-surface-hover);
    border-color: var(--accent);
    box-shadow: 0 4px 20px rgba(59, 130, 246, 0.12);
  }

  .node-num {
    font-size: var(--text-xs);
    color: var(--text-dim);
    font-weight: 600;
  }

  .node-button.active .node-num {
    color: var(--accent);
  }

  .node-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
  }

  .node-title {
    font-size: var(--text-sm);
    color: var(--text);
    font-weight: 500;
  }

  .node-subtitle {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .node-arrow {
    color: var(--text-dim);
    font-size: var(--text-sm);
    transition: transform var(--duration-fast) var(--ease-editorial),
                color var(--duration-fast) var(--ease-editorial);
  }

  .node-button.active .node-arrow {
    color: var(--accent);
    transform: translateX(4px);
  }

  /* Right: Inspector */
  .inspector-panel {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    transition: opacity var(--duration-fast) var(--ease-editorial);
  }

  .inspector-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
  }

  .inspector-tag {
    font-size: var(--text-2xs);
    color: var(--text-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .inspector-title {
    font-size: var(--text-base);
    color: var(--text);
    font-weight: 600;
    word-break: break-all;
  }

  .inspector-type {
    font-size: var(--text-xs);
    color: var(--accent);
    font-weight: 500;
  }

  .inspector-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .spec-field {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .spec-lbl {
    font-size: var(--text-2xs);
    color: var(--text-muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .spec-val {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .spec-val.accent {
    color: var(--accent);
  }

  .spec-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.65;
  }

  @media (max-width: 900px) {
    .systems-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }
</style>
