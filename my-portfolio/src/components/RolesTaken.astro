---
// RolesTaken Component — Engineering Background & Roles I've Taken
// Side-by-side layout: Journey & Academic Foundation on left;
// Interactive collapsed-by-default "ROLES I'VE TAKEN" technical index on right.
import { rolesData } from '../data/roles';
---

<section id="roles" class="roles-section" aria-labelledby="rolesSectionHeading">
  <div class="roles-container">
    <!-- Main Two-Column Side-by-Side Grid -->
    <div class="roles-grid">
      <!-- LEFT COLUMN: Journey, Origin, Academic Foundation & CV Download -->
      <aside class="roles-sidebar-left scroll-reveal-node" data-reveal="sidebar">
        <!-- Journey & Origin Card -->
        <article class="bio-panel">
          <div class="panel-header">
            <span class="panel-kicker mono">[ 02 // JOURNEY &amp; ORIGIN ]</span>
            <span class="origin-tag mono">ENGINEERING ROOTS</span>
          </div>

          <h3 class="bio-heading">Hooked on building robotics from a very young age</h3>
          
          <div class="bio-text">
            <p>
              My obsession with robotics started young. As a kid, I was crazily excited whenever a science fair or school exhibition came around, spending weeks tinkering with motors, battery clips, and scrap mechanisms. In 7th grade, I took that passion to a state-level competition by designing, building, and dressing up in a full robot costume handcrafted out of cardboard boxes.
            </p>
            <p>
              That early spark evolved into serious, deep engineering during college. Early breadboard hobby circuits and Arduino experiments progressed into custom multi-layer automotive ECUs, autonomous mobile robots (AMRs), LiDAR SLAM pipelines, and leading the Electrical and Electronics division of <em>Team Equinox</em> in BAJA SAE India to national top ranks (AIR 7 &amp; AIR 11), while teaching and guiding junior members.
            </p>
            <p>
              Whether it's routing deterministic CAN bus networks, calibrating Nav2 dynamic costmaps, or building fail-safe hardware interlocks, I love bridging physical hardware with intelligent software to create machines that operate dependably in the real world.
            </p>
          </div>

          <!-- Academic Foundation Block -->
          <div class="education-block">
            <span class="edu-badge mono">ACADEMIC FOUNDATION</span>
            <div class="edu-content">
              <h4 class="edu-degree">B.Tech in Robotics &amp; Automation</h4>
              <span class="edu-institution">Saintgits College of Engineering</span>
              <div class="edu-status-row mono">
                <span class="edu-years">B.Tech Robotics &amp; Automation</span>
                <span class="edu-sep">·</span>
                <span class="edu-graduated-tag">2022–2026</span>
              </div>
            </div>
          </div>

          <!-- Compact Verified Credential Preview with Interactive Micro-Selector -->
          <div class="credential-verification-card" id="credentialCard">
            <div class="cred-header">
              <span class="cred-pip" aria-hidden="true"></span>
              <span class="cred-title mono">VERIFIED ENGINEERING CREDENTIALS</span>
            </div>

            <!-- Restrained micro-selector tabs -->
            <div class="cred-tabs" role="tablist" aria-label="Credential Selector">
              <button type="button" class="cred-tab-pill mono active" data-cred="baja" role="tab" aria-selected="true">BAJA SAE</button>
              <button type="button" class="cred-tab-pill mono" data-cred="intel" role="tab" aria-selected="false">INTEL AI</button>
              <button type="button" class="cred-tab-pill mono" data-cred="sae-ad" role="tab" aria-selected="false">AUTONOMOUS</button>
              <button type="button" class="cred-tab-pill mono" data-cred="srishti" role="tab" aria-selected="false">SRISHTI '24</button>
              <button type="button" class="cred-tab-pill mono" data-cred="nakshatra" role="tab" aria-selected="false">NAKSHATRA</button>
            </div>

            <div class="cred-preview-row">
              <a 
                id="credLink" 
                href="/media/achievements/certificates/sae-baja-2025-cert.jpg" 
                class="cred-thumb-wrap img-expandable" 
                data-lightbox="/media/achievements/certificates/sae-baja-2025-cert.jpg"
                data-title="SAEINDIA aBAJA 2025 Certificate"
                data-badge="OFFICIAL CREDENTIAL"
                data-caption="Certificate of Participation & Technical Safety Compliance · Team Equinox"
                title="Inspect Official Certificate in Full Resolution"
              >
                <img
                  id="credImg"
                  src="/media/achievements/certificates/sae-baja-2025-cert.jpg"
                  alt="SAEINDIA aBAJA 2025 Certificate of Participation awarded to Naveen Shaji George"
                  class="cred-thumb-img img-contain"
                  width="140"
                  height="180"
                  loading="lazy"
                />
                <span class="cred-zoom-glyph mono" aria-hidden="true">↗</span>
              </a>
              <div class="cred-info">
                <span id="credAward" class="cred-award-name">SAEINDIA aBAJA 2025</span>
                <span id="credRecipient" class="cred-recipient mono">Naveen Shaji George · AIR 7</span>
                <span id="credMeta" class="cred-meta">Certificate of Participation &amp; Technical Safety Compliance · Team Equinox</span>
              </div>
            </div>
          </div>

          <!-- CV Download Action -->
          <div class="bio-action">
            <a href="/CV_1.pdf" class="btn-cv-pill" download>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/>
              </svg>
              <span class="mono">Download Curriculum Vitae (PDF)</span>
            </a>
          </div>
        </article>
      </aside>

      <!-- RIGHT COLUMN: Interactive "ROLES I'VE TAKEN" Technical Index -->
      <div class="roles-main-right">
        <!-- Section Header for Roles -->
        <header class="roles-header scroll-reveal-node" data-reveal="header">
          <div class="roles-kicker-wrap">
            <span class="roles-kicker mono">[ 02 // ROLES I'VE TAKEN ]</span>
          </div>

          <h2 id="rolesSectionHeading" class="roles-title">
            ROLES I'VE <span class="title-gold">TAKEN</span>
          </h2>
          <p class="roles-lead">
            Select a role to inspect leadership scope, core responsibilities, and operational focus areas.
          </p>
        </header>

        <!-- Interactive Technical Roles Accordion (Collapsed by Default) -->
        <div 
          class="roles-index-tree" 
          id="rolesAccordion" 
          role="region" 
          aria-label="Roles I've Taken Interactive Index"
        >
          {rolesData.map((role, idx) => (
            <article 
              class="role-item scroll-reveal-node" 
              id={`role-item-${role.id}`}
              data-reveal="row"
              data-index={idx}
            >
              <!-- Technical Datum Line connecting roles with gold active highlight -->
              <div class="role-line-datum" aria-hidden="true">
                <span class="datum-fill"></span>
              </div>

              <!-- Entire Row as an Accessible Toggle Button -->
              <button 
                type="button" 
                class="role-row-btn"
                id={`role-btn-${role.id}`}
                aria-expanded="false"
                aria-controls={`role-content-${role.id}`}
                data-target={role.id}
              >
                <!-- Number + Node Pip -->
                <div class="role-num-col mono">
                  <span class="role-node-pip" aria-hidden="true"></span>
                  <span class="role-num">{role.num}</span>
                </div>

                <!-- Role Title & Subtle Domain Category Badge -->
                <div class="role-summary-col">
                  <div class="role-title-row">
                    <h3 class="role-title">{role.title}</h3>
                    <span class="role-domain-pill mono">{role.domainCategory}</span>
                  </div>
                  {role.organization && (
                    <div class="role-preview-meta mono">
                      <span class="role-org-text">{role.organization}</span>
                      {role.period && (
                        <>
                          <span class="meta-sep" aria-hidden="true">·</span>
                          <span class="role-period-text">{role.period}</span>
                        </>
                      )}
                    </div>
                  )}
                </div>

                <!-- Toggle Morph Indicator (+ / −) -->
                <div class="role-toggle-col" aria-hidden="true">
                  <span class="toggle-circle">
                    <span class="toggle-bar bar-h"></span>
                    <span class="toggle-bar bar-v"></span>
                  </span>
                </div>
              </button>

              <!-- Smooth Animated Drawer Expansion (CSS Grid 0fr -> 1fr) -->
              <div 
                id={`role-content-${role.id}`}
                class="role-drawer"
                role="region"
                aria-labelledby={`role-btn-${role.id}`}
              >
                <div class="role-drawer-inner">
                  <div class="role-expanded-body">
                    <div class="role-expanded-content">
                      <div class="role-text-column">
                        {role.description && (
                          <div class="role-context-pane">
                            <div class="context-eyebrow mono">
                              <span class="eyebrow-accent">↳</span>
                              <span>ROLE CONTEXT &amp; SCOPE</span>
                            </div>
                            <p class="role-desc">{role.description}</p>
                          </div>
                        )}

                        {role.responsibilities && role.responsibilities.length > 0 && (
                          <div class="role-details-pane">
                            <div class="context-eyebrow mono">
                              <span class="eyebrow-accent">⚡</span>
                              <span>CORE RESPONSIBILITIES &amp; EXECUTION</span>
                            </div>
                            
                            <ul class="role-responsibilities-list">
                              {role.responsibilities.map((resp) => (
                                <li class="resp-item">
                                  <span class="resp-bullet" aria-hidden="true"></span>
                                  <span class="resp-text">{resp}</span>
                                </li>
                              ))}
                            </ul>
                          </div>
                        )}

                        {role.focusAreas && role.focusAreas.length > 0 && (
                          <div class="role-tech-block">
                            <span class="tech-title mono">CORE FOCUS AREAS:</span>
                            <div class="tech-pills">
                              {role.focusAreas.map((area) => (
                                <span class="tech-pill mono">{area}</span>
                              ))}
                            </div>
                          </div>
                        )}
                      </div>

                      {role.visualEvidence && (
                        <aside class="role-evidence-aside" aria-label="Visual Evidence of Role">
                          <div class="role-evidence-card">
                            <div class="evidence-header">
                              <span class="evidence-pip" aria-hidden="true"></span>
                              <span class="evidence-badge mono">{role.visualEvidence.badge}</span>
                            </div>

                            <div 
                              class="evidence-image-wrap img-expandable"
                              data-lightbox={role.visualEvidence.image}
                              data-title={role.title}
                              data-badge={role.visualEvidence.badge}
                              data-caption={role.visualEvidence.caption}
                              title="Click to view full uncropped photograph"
                            >
                              <img
                                src={role.visualEvidence.image}
                                alt={role.visualEvidence.caption}
                                class="evidence-img img-contain"
                                width="360"
                                height="480"
                                loading="lazy"
                              />

                              {role.visualEvidence.secondaryImage && (
                                <div class="evidence-inset-pill" title={role.visualEvidence.secondaryCaption || 'Official Technical Inspection Pass'}>
                                  <img
                                    src={role.visualEvidence.secondaryImage}
                                    alt={role.visualEvidence.secondaryCaption || 'Secondary Credential'}
                                    class="evidence-inset-img"
                                    width="120"
                                    height="160"
                                    loading="lazy"
                                  />
                                  <span class="inset-badge mono">{role.visualEvidence.secondaryBadge || 'VERIFIED'}</span>
                                </div>
                              )}
                            </div>

                            <p class="evidence-caption mono">{role.visualEvidence.caption}</p>
                          </div>
                        </aside>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initRolesAccordion } from '../animations';

  let rolesCleanup: (() => void) | null = null;

  function setupCredentialTabs() {
    const credCard = document.getElementById('credentialCard');
    if (!credCard) return;

    const credData: Record<string, { href: string; src: string; award: string; recipient: string; meta: string }> = {
      baja: {
        href: '/media/achievements/certificates/sae-baja-2025-cert.jpg',
        src: '/media/achievements/certificates/sae-baja-2025-cert.jpg',
        award: 'SAEINDIA aBAJA 2025',
        recipient: 'Naveen Shaji George · AIR 7',
        meta: 'Certificate of Participation & Technical Safety Compliance · Team Equinox'
      },
      intel: {
        href: '/media/achievements/certificates/intel-genai-hackathon-top25.jpg',
        src: '/media/achievements/certificates/intel-genai-hackathon-top25.jpg',
        award: 'Intel GenAI Hackathon 2024',
        recipient: 'Naveen Shaji George · Top 25 Finalist',
        meta: 'National Level Hackathon in association with Intel · KPR Institute'
      },
      'sae-ad': {
        href: '/media/achievements/certificates/sae-self-driving-car-cert.jpg',
        src: '/media/achievements/certificates/sae-self-driving-car-cert.jpg',
        award: 'Self Driving Car Workshop',
        recipient: 'Naveen Shaji George · SAEISS Chennai',
        meta: 'SAEINDIA Southern Section 4-Day Autonomous Systems Intensive'
      },
      srishti: {
        href: '/media/achievements/certificates/93b5c232-34bf-4c5f-a807-b2f59067b084_page-0001.jpg',
        src: '/media/achievements/certificates/93b5c232-34bf-4c5f-a807-b2f59067b084_page-0001.jpg',
        award: 'SRISHTI 2024 Exhibition',
        recipient: 'Naveen Shaji George · AI for Sustainability',
        meta: '10th National Level Technical Project Exhibition & Competition Recognition'
      },
      nakshatra: {
        href: '/media/achievements/certificates/1156ae7c-fc50-424e-af60-4bcc8e38810b_page-0001.jpg',
        src: '/media/achievements/certificates/1156ae7c-fc50-424e-af60-4bcc8e38810b_page-0001.jpg',
        award: 'Nakshatra 2024 Recognition',
        recipient: 'Naveen Shaji George · Best Anchor',
        meta: 'Saintgits College of Engineering · National Level Cultural Fest'
      }
    };

    const pills = credCard.querySelectorAll<HTMLButtonElement>('.cred-tab-pill');
    const link = credCard.querySelector<HTMLAnchorElement>('#credLink');
    const img = credCard.querySelector<HTMLImageElement>('#credImg');
    const award = credCard.querySelector<HTMLElement>('#credAward');
    const recipient = credCard.querySelector<HTMLElement>('#credRecipient');
    const meta = credCard.querySelector<HTMLElement>('#credMeta');

    pills.forEach((pill) => {
      pill.onclick = (e) => {
        e.preventDefault();
        const id = pill.getAttribute('data-cred');
        if (!id || !credData[id]) return;

        const data = credData[id];
        pills.forEach((p) => {
          p.classList.remove('active');
          p.setAttribute('aria-selected', 'false');
        });
        pill.classList.add('active');
        pill.setAttribute('aria-selected', 'true');

        if (img) img.src = data.src;
        if (link) link.href = data.href;
        if (award) award.textContent = data.award;
        if (recipient) recipient.textContent = data.recipient;
        if (meta) meta.textContent = data.meta;
      };
    });
  }

  function initRolesSection() {
    if (rolesCleanup) {
      rolesCleanup();
      rolesCleanup = null;
    }
    const rolesSection = document.getElementById('roles');
    if (rolesSection) {
      rolesCleanup = initRolesAccordion(rolesSection);
    }
    setupCredentialTabs();
  }

  document.addEventListener('astro:page-load', initRolesSection);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRolesSection);
  } else {
    initRolesSection();
  }
</script>

<style>
  /* ============================================================
     ROLES I'VE TAKEN — SIDE-BY-SIDE ENGINEERING BACKGROUND & ROLES
     Consistent with Hero: #F7F5F0 paper, dark typography, metallic gold
     ============================================================ */
  .roles-section {
    position: relative;
    padding: clamp(5rem, 8vh, 7.5rem) 0 clamp(4.5rem, 7vh, 6rem);
    background: var(--color-paper, #F7F5F0);
    border-top: 1px solid rgba(20, 24, 34, 0.08);
    overflow: hidden;
  }

  .roles-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 clamp(1.5rem, 4.5vw, 4rem) 0 clamp(3.8rem, 6.5vw, 6.5rem);
  }

  /* ------------------------------------------------------------
     Two-Column Side-by-Side Layout
     ------------------------------------------------------------ */
  .roles-grid {
    display: grid;
    grid-template-columns: 1fr 1.35fr;
    gap: clamp(2.5rem, 4.5vw, 5rem);
    align-items: start;
  }

  /* ------------------------------------------------------------
     Left Column: Bio & Academic Foundation (Philosophy Removed)
     ------------------------------------------------------------ */
  .roles-sidebar-left {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 2.5vh, 2.2rem);
  }

  .bio-panel {
    background: #FFFFFF;
    border: 1px solid rgba(20, 24, 34, 0.09);
    border-radius: 8px;
    padding: clamp(1.4rem, 2.5vw, 2.2rem);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    box-shadow: 0 2px 8px rgba(20, 24, 34, 0.03);
    transition: border-color 0.25s ease;
  }

  .bio-panel:hover {
    border-color: rgba(184, 146, 74, 0.35);
  }

  .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .panel-kicker {
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--color-ink-muted, #767571);
    letter-spacing: 0.1em;
  }

  .origin-tag {
    font-size: 0.62rem;
    font-weight: 700;
    color: #8C6A28;
    background: rgba(184, 146, 74, 0.08);
    border: 1px solid rgba(184, 146, 74, 0.25);
    padding: 2px 7px;
    border-radius: 999px;
    letter-spacing: 0.06em;
  }

  .bio-heading {
    font-size: clamp(1.15rem, 1.6vw, 1.4rem);
    font-weight: 800;
    color: var(--color-ink, #141822);
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin: 0;
  }

  .bio-text {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .bio-text p {
    font-size: 0.88rem;
    line-height: 1.65;
    color: var(--color-ink-light, #484743);
    margin: 0;
  }

  .bio-text em {
    font-style: normal;
    color: var(--color-ink, #141822);
    font-weight: 600;
  }

  /* Academic Foundation */
  .education-block {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1rem 1.1rem;
    background: rgba(20, 24, 34, 0.02);
    border: 1px solid rgba(20, 24, 34, 0.08);
    border-radius: 6px;
  }

  .edu-badge {
    font-size: 0.62rem;
    font-weight: 700;
    color: #B8924A;
    letter-spacing: 0.08em;
  }

  .edu-content {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .edu-degree {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--color-ink, #141822);
    margin: 0;
  }

  .edu-institution {
    font-size: 0.78rem;
    color: var(--color-ink-muted, #767571);
  }

  .edu-status-row {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.72rem;
    margin-top: 3px;
  }

  .edu-years {
    color: var(--color-ink-muted, #767571);
  }

  .edu-sep {
    color: var(--color-ink-muted, #767571);
  }

  .edu-graduated-tag {
    color: #059669;
    font-weight: 700;
    letter-spacing: 0.06em;
    background: rgba(16, 185, 129, 0.1);
    padding: 1px 6px;
    border-radius: 3px;
    border: 1px solid rgba(16, 185, 129, 0.25);
  }

  /* Compact Verified Credential Preview Card */
  .credential-verification-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.9rem 1rem;
    background: rgba(184, 146, 74, 0.04);
    border: 1px solid rgba(184, 146, 74, 0.22);
    border-radius: 6px;
  }

  .cred-header {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .cred-pip {
    width: 4.5px;
    height: 4.5px;
    border-radius: 50%;
    background: #B8924A;
  }

  .cred-title {
    font-size: 0.58rem;
    font-weight: 700;
    color: #8C6A28;
    letter-spacing: 0.08em;
  }

  .cred-tabs {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
    margin: 2px 0 4px 0;
  }

  .cred-tab-pill {
    font-size: 0.54rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 2px 6px;
    border-radius: 3px;
    border: 1px solid rgba(20, 24, 34, 0.12);
    background: rgba(20, 24, 34, 0.03);
    color: var(--color-ink-muted, #767571);
    cursor: pointer;
    transition: all 0.18s ease;
  }

  .cred-tab-pill:hover {
    border-color: rgba(184, 146, 74, 0.4);
    color: var(--color-ink, #141822);
    background: rgba(184, 146, 74, 0.08);
  }

  .cred-tab-pill.active {
    background: #B8924A;
    color: #FFFFFF;
    border-color: #B8924A;
  }

  .cred-preview-row {
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 0.75rem;
    align-items: center;
  }

  .cred-thumb-wrap {
    position: relative;
    border-radius: 4px;
    overflow: hidden;
    border: 1px solid rgba(184, 146, 74, 0.3);
    background: radial-gradient(circle at center, #191E2B 0%, #0F131D 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 3 / 4;
    transition: transform 0.2s ease, border-color 0.2s ease;
    cursor: zoom-in;
  }

  .cred-thumb-wrap:hover {
    transform: scale(1.05);
    border-color: #B8924A;
  }

  .cred-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .cred-zoom-glyph {
    position: absolute;
    bottom: 2px;
    right: 2px;
    background: rgba(20, 24, 34, 0.85);
    color: #E5C378;
    font-size: 0.55rem;
    padding: 1px 3px;
    border-radius: 2px;
  }

  .cred-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .cred-award-name {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-ink, #141822);
    line-height: 1.25;
  }

  .cred-recipient {
    font-size: 0.65rem;
    color: #8C6A28;
    font-weight: 600;
  }

  .cred-meta {
    font-size: 0.65rem;
    color: var(--color-ink-muted, #767571);
    line-height: 1.35;
  }

  /* CV Button */
  .bio-action {
    padding-top: 0.25rem;
  }

  .btn-cv-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.65rem 1.35rem;
    background: var(--color-ink, #141822);
    color: var(--color-paper, #F7F5F0);
    border: 1px solid rgba(20, 24, 34, 0.2);
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: all 0.24s cubic-bezier(0.16, 1, 0.3, 1);
