---
// Footer Component — Editorial Light Canvas
// Clean minimal signature
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-left">
      <span class="footer-brand">Naveen Shaji George</span>
      <span class="footer-sep" aria-hidden="true">·</span>
      <span class="footer-sub">Robotics Engineer</span>
    </div>

    <div class="footer-center">
      <span class="footer-loc">Kottayam, Kerala, India · Open Worldwide</span>
    </div>

    <div class="footer-right">
      <span class="footer-copy">© {currentYear} · Precision Engineered</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: var(--space-8) 0;
    background: var(--bg);
    position: relative;
    z-index: 1;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .footer-left {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  .footer-brand {
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: 0.04em;
  }

  .footer-sep {
    color: var(--text-dim);
  }

  .footer-sub {
    color: var(--text-muted);
  }

  .footer-center {
    font-size: var(--text-2xs);
    color: var(--text-muted);
    letter-spacing: 0.03em;
  }

  .footer-right {
    font-size: var(--text-2xs);
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }
  }
</style>
