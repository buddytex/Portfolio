---
// Footer Component — Graphite + Electric Cyan minimal technical signature
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-left">
      <span class="footer-brand">NAVEEN SHAJI GEORGE</span>
      <span class="footer-sep" aria-hidden="true">/</span>
      <span class="footer-sub">Robotics & Autonomous Systems Engineer</span>
    </div>

    <div class="footer-center">
      <span class="system-status mono">
        <span class="status-pulse"></span>
        SYSTEM STATUS: NOMINAL
      </span>
    </div>

    <div class="footer-right">
      <span class="footer-copy mono">© {currentYear} · Precision Engineered</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: var(--space-8) 0;
    background: var(--bg);
    position: relative;
    z-index: 1;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .footer-left {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  .footer-brand {
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: 0.04em;
  }

  .footer-sep {
    color: var(--text-dim);
  }

  .footer-sub {
    color: var(--text-muted);
  }

  .footer-center {
    display: flex;
    align-items: center;
  }

  .system-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-2xs);
    color: var(--text-muted);
    letter-spacing: 0.06em;
  }

  .status-pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 6px var(--cyan);
  }

  .footer-right {
    font-size: var(--text-xs);
    color: var(--text-dim);
  }

  @media (max-width: 800px) {
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }
    .footer-center {
      order: 3;
    }
    .footer-right {
      order: 2;
    }
  }
</style>
