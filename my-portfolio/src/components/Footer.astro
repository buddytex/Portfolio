---
// Footer Component — Minimal editorial signature
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-left">
      <span class="footer-brand">NAVEEN SHAJI GEORGE</span>
      <span class="footer-sep" aria-hidden="true">·</span>
      <span class="footer-sub">Robotics & Autonomous Systems Engineer</span>
    </div>

    <div class="footer-right">
      <span class="footer-copy mono">© {currentYear} · Designed & Engineered with Precision</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border-subtle);
    padding: var(--space-8) 0;
    background: var(--bg);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .footer-left {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  .footer-brand {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--text);
    letter-spacing: 0.04em;
  }

  .footer-sep {
    color: var(--text-dim);
  }

  .footer-sub {
    color: var(--text-muted);
  }

  .footer-right {
    font-size: var(--text-xs);
    color: var(--text-dim);
  }

  @media (max-width: 640px) {
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }
  }
</style>
