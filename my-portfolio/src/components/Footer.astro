---
// Footer Component
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-left">
      <span class="footer-id mono">NAVEEN SHAJI GEORGE</span>
      <span class="footer-sep" aria-hidden="true">·</span>
      <span class="footer-spec mono">ROBOTICS · AUTONOMOUS SYSTEMS · AI</span>
    </div>

    <div class="footer-right">
      <span class="status-beacon">
        <span class="beacon-dot"></span>
        <span class="mono footer-status">SYSTEM STATUS: ONLINE</span>
      </span>
      <span class="footer-sep" aria-hidden="true">·</span>
      <span class="footer-copy mono">© {new Date().getFullYear()}</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: var(--space-6) 0;
    background: var(--bg);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .footer-left,
  .footer-right {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .footer-id {
    font-size: var(--text-2xs);
    font-weight: 700;
    color: var(--text);
    letter-spacing: 0.06em;
  }

  .footer-spec {
    font-size: 0.625rem;
    color: var(--text-muted);
  }

  .footer-status {
    font-size: 0.625rem;
    color: var(--accent);
  }

  .footer-copy {
    font-size: 0.625rem;
    color: var(--text-muted);
  }

  .footer-sep {
    color: var(--border-strong);
  }

  @media (max-width: 600px) {
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }
  }
</style>
