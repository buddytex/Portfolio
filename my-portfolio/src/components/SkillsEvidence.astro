---
// SkillsEvidence Component — Compact Engineering Skill Index
// Homepage version: horizontal technical chips, clickable → /skills/[id]
// All skills from data layer, no fabricated percentages
import { skillsData } from '../data/skills';
---

<section id="skills" class="section skills-section">
  <div class="container-wide">
    <!-- Section Header -->
    <div class="section-header reveal">
      <span class="section-eyebrow">Skills & Evidence</span>
      <h2 class="section-title">Engineering Competencies<br/><span class="accent">Validated by Real Systems</span></h2>
      <p class="section-lead">
        Select any competency to inspect actual hardware schematics, firmware architecture, design trade-offs, and deployed results.
      </p>
    </div>

    <!-- Compact Skill Chip Index -->
    <div class="skill-index-wrap reveal">
      <div class="skill-chips-grid" role="list" aria-label="Engineering Competencies">
        {skillsData.map((skill) => (
          <a
            href={`/skills/${skill.id}`}
            class="skill-chip"
            role="listitem"
            aria-label={`View evidence for ${skill.title}`}
          >
            <span class="chip-label">{skill.title}</span>
            <span class="chip-category mono">{skill.category}</span>
            <span class="chip-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>

    <!-- View All Skills CTA -->
    <div class="skills-cta-wrap reveal">
      <a href="/skills" class="skills-cta-btn">
        <span>View All Competencies & Evidence</span>
        <span class="cta-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .skills-section {
    padding: var(--section-pad) 0;
    position: relative;
    background: transparent;
  }

  /* Reduced section title for this section */
  .skills-section .section-title {
    font-size: clamp(1.6rem, 2.6vw, 2.4rem);
  }

  /* Skill Chip Grid - ~3 rows on desktop */
  .skill-index-wrap {
    margin-top: var(--space-4);
  }

  .skill-chips-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--space-3);
    align-items: start;
  }

  .skill-chip {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-5);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    text-decoration: none;
    color: inherit;
    transition: all var(--dur-fast) var(--ease-out);
    box-shadow: var(--shadow-resting);
    min-height: 80px;
  }

  .skill-chip:hover,
  .skill-chip:focus-visible {
    border-color: var(--cyan);
    transform: translateY(-2px);
    box-shadow: var(--shadow-hover);
    background: var(--surface-elevated);
  }

  .skill-chip:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 2px;
  }

  .chip-label {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .chip-category {
    font-size: var(--text-2xs);
    color: var(--cyan-dark);
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .chip-arrow {
    margin-top: var(--space-1);
    font-size: var(--text-xs);
    color: var(--text-dim);
    align-self: flex-end;
    transition: transform var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }

  .skill-chip:hover .chip-arrow,
  .skill-chip:focus-visible .chip-arrow {
    color: var(--cyan);
    transform: translateX(4px);
  }

  /* CTA Button */
  .skills-cta-wrap {
    margin-top: var(--space-8);
    text-align: center;
  }

  .skills-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-8);
    background: var(--text-primary);
    color: var(--bg);
    border-radius: var(--r-sm);
    font-weight: 600;
    font-size: var(--text-sm);
    letter-spacing: 0.02em;
    transition: all var(--dur-fast) var(--ease-out);
    box-shadow: var(--shadow-resting);
  }

  .skills-cta-btn:hover {
    background: var(--cyan-dark);
    color: #FFFFFF;
    transform: translateY(-2px);
    box-shadow: var(--shadow-hover);
  }

  .skills-cta-btn .cta-arrow {
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .skills-cta-btn:hover .cta-arrow {
    transform: translateX(4px);
  }

  @media (max-width: 640px) {
    .skill-chips-grid {
      grid-template-columns: 1fr;
    }
    
    .skill-chip {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      min-height: 60px;
      padding: var(--space-3) var(--space-4);
    }
    
    .chip-category {
      order: -1;
    }
    
    .chip-arrow {
      margin-top: 0;
    }
  }
</style>