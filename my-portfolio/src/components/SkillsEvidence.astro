---
// SkillsEvidence Component — Interactive Engineering Skill Map
// A deterministic, organized bubble composition of all engineering competencies.
// Skills are arranged in domain clusters with three hierarchy levels:
//   DOMAIN (large label bubbles) → SKILLS (medium) → SUPPORTING (smaller)
// Hover reveals live connection inspector with project/role evidence.
import { skillCategories, allSkills, type SkillCategory, type SkillItem } from '../data/skills';
import { resolveHref } from '../utils/media';

const coreCategories = skillCategories.filter(c => c.tier === 'core');
const complementaryCategories = skillCategories.filter(c => c.tier === 'complementary');
const defaultSkill = allSkills.find(s => s.id === 'vehicle-system-integration') || allSkills[0];

// Pre-compute cluster data for the bubble map
const clusterData = skillCategories.map(cat => ({
  ...cat,
  skillCount: cat.skills.length,
  connectionCount: cat.skills.reduce((sum, s) => sum + s.connectedEntities.length, 0),
}));
---

<section id="skills" class="section skills-section" aria-label="Engineering Skill Map">
  <div class="container-wide">
    
    <!-- Section Header -->
    <div class="section-header">
      <div class="header-kicker mono">[ 06 // TECHNICAL CAPABILITIES ]</div>
      <h2 class="section-title">Engineering <span class="accent">Skill Map</span></h2>
      <p class="section-lead">
        An interconnected map of <strong>{allSkills.length} verified competencies</strong> across {skillCategories.length} engineering disciplines.
        Hover or tap any skill to inspect its real-world evidence and project connections.
      </p>
    </div>

    <!-- Tier Legend Bar -->
    <div class="map-legend mono">
      <div class="legend-item">
        <span class="legend-dot dot-core"></span>
        <span>CORE ENGINEERING</span>
      </div>
      <div class="legend-item">
        <span class="legend-dot dot-comp"></span>
        <span>COMPLEMENTARY</span>
      </div>
      <div class="legend-separator"></div>
      <div class="legend-item">
        <span class="legend-size size-strong"></span>
        <span>STRONG</span>
      </div>
      <div class="legend-item">
        <span class="legend-size size-working"></span>
        <span>WORKING</span>
      </div>
      <div class="legend-item">
        <span class="legend-size size-experience"></span>
        <span>EXPOSURE</span>
      </div>
    </div>

    <!-- Main Interactive Skill Map -->
    <div class="skill-map-workspace">
      
      <!-- The Bubble Map Canvas -->
      <div class="skill-map-canvas" id="skillMapCanvas">
        
        {skillCategories.map((category, catIdx) => (
          <div 
            class={`domain-cluster cluster-${category.tier}`}
            data-domain-id={category.id}
            data-domain-tier={category.tier}
            id={`domain-${category.id}`}
          >
            <!-- Domain Label Bubble -->
            <div class="domain-label-bubble">
              <span class="domain-idx mono">{category.index}</span>
              <span class="domain-name">{category.shortTitle}</span>
            </div>

            <!-- Skill Bubbles -->
            <div class="skill-bubbles-group">
              {category.skills.map((skill, skillIdx) => (
                <button
                  class={`skill-bubble proficiency-${skill.proficiency} tier-${skill.tier}`}
                  data-skill-id={skill.id}
                  data-skill-name={skill.name}
                  data-skill-category={skill.category}
                  data-skill-category-idx={skill.categoryIndex}
                  data-skill-tier={skill.tier}
                  data-skill-proficiency={skill.proficiency}
                  data-skill-evidence={skill.evidence}
                  data-skill-context={skill.context}
                  data-skill-tools={JSON.stringify(skill.tools || [])}
                  data-skill-connections={JSON.stringify(skill.connectedEntities || [])}
                  data-domain-id={category.id}
                  aria-label={`${skill.name} — ${skill.proficiency} proficiency. ${skill.evidence}`}
                  title={skill.name}
                >
                  <span class="bubble-label">{skill.name}</span>
                  {skill.connectedEntities.length > 0 && (
                    <span class="bubble-conn-count mono">{skill.connectedEntities.length}</span>
                  )}
                </button>
              ))}
            </div>
          </div>
        ))}

      </div>

      <!-- Floating Connection Inspector HUD -->
      <aside class="map-hud-inspector" id="mapHud" aria-label="Skill Inspector">
        <div class="hud-inner">
          
          <!-- HUD Header -->
          <div class="hud-header mono">
            <div class="hud-status">
              <span class="hud-pulse"></span>
              <span>SKILL INSPECTOR</span>
            </div>
            <span class="hud-idx" id="hudIdx">{defaultSkill.categoryIndex}</span>
          </div>

          <!-- Active Skill -->
          <div class="hud-skill-info">
            <div class="hud-tier-row mono">
              <span class="hud-tier-badge" id="hudTierBadge">
                {defaultSkill.tier === 'core' ? 'CORE' : 'COMPLEMENTARY'}
              </span>
              <span class="hud-cat-label" id="hudCatLabel">{defaultSkill.category}</span>
            </div>
            <h4 class="hud-skill-name" id="hudSkillName">{defaultSkill.name}</h4>
            <div class="hud-prof mono" id="hudProficiency">
              {defaultSkill.proficiency.toUpperCase()} PROFICIENCY
            </div>
          </div>

          <!-- Evidence -->
          <div class="hud-block">
            <div class="hud-block-title mono">
              <span class="block-glyph">▸</span> ENGINEERING EVIDENCE
            </div>
            <blockquote class="hud-evidence" id="hudEvidence">
              "{defaultSkill.evidence}"
            </blockquote>
            <p class="hud-context" id="hudContext">{defaultSkill.context}</p>
          </div>

          <!-- Connected Projects -->
          <div class="hud-block">
            <div class="hud-block-title mono">
              <span class="block-glyph">⚡</span> CONNECTED PROJECTS
            </div>
            <div class="hud-projects" id="hudProjects">
              {defaultSkill.connectedEntities
                .filter(e => e.type === 'project' || e.type === 'hardware')
                .map((item) => (
                  <a href={resolveHref(item.url || '#')} class="hud-proj-link">
                    <span class="proj-name mono">{item.name}</span>
                    {item.badge && <span class="proj-badge mono">{item.badge}</span>}
                  </a>
                ))}
            </div>
          </div>

          <!-- Connected Roles -->
          <div class="hud-block">
            <div class="hud-block-title mono">
              <span class="block-glyph">⬡</span> ROLES & ORGANIZATIONS
            </div>
            <div class="hud-roles" id="hudRoles">
              {defaultSkill.connectedEntities
                .filter(e => e.type === 'role' || e.type === 'activity')
                .map((item) => (
                  <span class="hud-role-chip mono">
                    {item.name}
                    {item.badge && <span class="role-badge">{item.badge}</span>}
                  </span>
                ))}
            </div>
          </div>

          <!-- Tools -->
          <div class="hud-block">
            <div class="hud-block-title mono">
              <span class="block-glyph">⚙</span> TOOLS & PROTOCOLS
            </div>
            <div class="hud-tools" id="hudTools">
              {defaultSkill.tools?.map((tool) => (
                <span class="hud-tool-chip mono">{tool}</span>
              ))}
            </div>
          </div>

          <!-- Deep Dive CTA -->
          <a 
            href={resolveHref(`/skills/${defaultSkill.id}`)}
            class="hud-cta mono" 
            id="hudCta"
          >
            <span>VIEW FULL SPECIFICATION</span>
            <span class="cta-arrow">↗</span>
          </a>

        </div>
      </aside>

    </div>

    <!-- Bottom Stats Bar -->
    <div class="map-stats-bar mono">
      <span class="stat-item">
        <span class="stat-val">{allSkills.length}</span>
        <span class="stat-label">TOTAL SKILLS</span>
      </span>
      <span class="stat-item">
        <span class="stat-val">{skillCategories.length}</span>
        <span class="stat-label">DOMAINS</span>
      </span>
      <span class="stat-item">
        <span class="stat-val">{coreCategories.length}</span>
        <span class="stat-label">CORE DISCIPLINES</span>
      </span>
      <span class="stat-item">
        <span class="stat-val">{allSkills.reduce((sum, s) => sum + s.connectedEntities.length, 0)}</span>
        <span class="stat-label">PROJECT CONNECTIONS</span>
      </span>
    </div>

  </div>
</section>

<script>
  import { initSkillsAnimation } from '../animations';

  let skillsCleanup: (() => void) | null = null;

  interface ConnectedEntity {
    id: string;
    name: string;
    type: 'project' | 'role' | 'hardware' | 'activity';
    badge?: string;
    url?: string;
    detail?: string;
  }

  function initSkillMap() {
    const bubbles = document.querySelectorAll<HTMLButtonElement>('.skill-bubble');
    const domainClusters = document.querySelectorAll<HTMLElement>('.domain-cluster');
    
    // HUD Elements
    const hudIdx = document.getElementById('hudIdx');
    const hudTierBadge = document.getElementById('hudTierBadge');
    const hudCatLabel = document.getElementById('hudCatLabel');
    const hudSkillName = document.getElementById('hudSkillName');
    const hudProficiency = document.getElementById('hudProficiency');
    const hudEvidence = document.getElementById('hudEvidence');
    const hudContext = document.getElementById('hudContext');
    const hudProjects = document.getElementById('hudProjects');
    const hudRoles = document.getElementById('hudRoles');
    const hudTools = document.getElementById('hudTools');
    const hudCta = document.getElementById('hudCta') as HTMLAnchorElement | null;
    const mapHud = document.getElementById('mapHud');

    const basePath = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
    const resolveClientHref = (rawPath: string | null | undefined): string => {
      if (!rawPath || rawPath === '#') return rawPath || '#';
      if (
        rawPath.startsWith('http://') ||
        rawPath.startsWith('https://') ||
        rawPath.startsWith('mailto:') ||
        rawPath.startsWith('tel:') ||
        rawPath.startsWith('#')
      ) {
        return rawPath;
      }
      const cleanPath = rawPath.startsWith('/') ? rawPath : `/${rawPath}`;
      return cleanPath === '/' ? (basePath ? `${basePath}/` : '/') : `${basePath}${cleanPath}`;
    };

    function activateBubble(bubble: HTMLButtonElement) {
      // Remove active from all bubbles
      bubbles.forEach(b => b.classList.remove('is-active'));
      bubble.classList.add('is-active');

      // Highlight parent domain
      domainClusters.forEach(c => c.classList.remove('domain-active'));
      const domainId = bubble.getAttribute('data-domain-id');
      const parentDomain = document.getElementById(`domain-${domainId}`);
      if (parentDomain) parentDomain.classList.add('domain-active');

      // Show HUD
      if (mapHud) mapHud.classList.add('hud-visible');

      // Extract data
      const skillId = bubble.getAttribute('data-skill-id') || '';
      const name = bubble.getAttribute('data-skill-name') || '';
      const category = bubble.getAttribute('data-skill-category') || '';
      const catIdx = bubble.getAttribute('data-skill-category-idx') || '';
      const tier = bubble.getAttribute('data-skill-tier') || 'core';
      const prof = bubble.getAttribute('data-skill-proficiency') || 'strong';
      const evidence = bubble.getAttribute('data-skill-evidence') || '';
      const context = bubble.getAttribute('data-skill-context') || '';

      let tools: string[] = [];
      let connections: ConnectedEntity[] = [];
      try { tools = JSON.parse(bubble.getAttribute('data-skill-tools') || '[]'); } catch(e) { tools = []; }
      try { connections = JSON.parse(bubble.getAttribute('data-skill-connections') || '[]'); } catch(e) { connections = []; }

      // Update HUD
      if (hudIdx) hudIdx.textContent = catIdx;
      if (hudSkillName) hudSkillName.textContent = name;
      if (hudCatLabel) hudCatLabel.textContent = category;
      if (hudTierBadge) {
        hudTierBadge.textContent = tier === 'core' ? 'CORE' : 'COMPLEMENTARY';
        hudTierBadge.className = `hud-tier-badge ${tier === 'core' ? 'badge-core' : 'badge-comp'}`;
      }
      if (hudProficiency) hudProficiency.textContent = `${prof.toUpperCase()} PROFICIENCY`;
      if (hudEvidence) hudEvidence.textContent = `"${evidence}"`;
      if (hudContext) hudContext.textContent = context;
      if (hudCta) hudCta.href = resolveClientHref(`/skills/${skillId}`);

      // Update Projects
      if (hudProjects) {
        const projectItems = connections.filter(c => c.type === 'project' || c.type === 'hardware');
        if (projectItems.length > 0) {
          hudProjects.innerHTML = projectItems.map(p => `
            <a href="${resolveClientHref(p.url || '#')}" class="hud-proj-link">
              <span class="proj-name mono">${p.name}</span>
              ${p.badge ? `<span class="proj-badge mono">${p.badge}</span>` : ''}
            </a>
          `).join('');
        } else {
          hudProjects.innerHTML = `<span class="hud-empty mono">APPLIED ACROSS LAB & TOOLING</span>`;
        }
      }

      // Update Roles
      if (hudRoles) {
        const roleItems = connections.filter(c => c.type === 'role' || c.type === 'activity');
        if (roleItems.length > 0) {
          hudRoles.innerHTML = roleItems.map(r => `
            <span class="hud-role-chip mono">
              ${r.name}
              ${r.badge ? `<span class="role-badge">${r.badge}</span>` : ''}
            </span>
          `).join('');
        } else {
          hudRoles.innerHTML = `<span class="hud-empty mono">DIRECT TECHNICAL COMPETENCY</span>`;
        }
      }

      // Update Tools
      if (hudTools) {
        if (tools.length > 0) {
          hudTools.innerHTML = tools.map(t => `<span class="hud-tool-chip mono">${t}</span>`).join('');
        } else {
          hudTools.innerHTML = `<span class="hud-tool-chip mono">STANDARD TOOLCHAIN</span>`;
        }
      }

      // Highlight same-domain bubbles with a subtle glow
      bubbles.forEach(b => {
        b.classList.remove('same-domain');
        if (b !== bubble && b.getAttribute('data-domain-id') === domainId) {
          b.classList.add('same-domain');
        }
      });
    }

    bubbles.forEach(bubble => {
      bubble.addEventListener('mouseenter', () => activateBubble(bubble));
      bubble.addEventListener('focus', () => activateBubble(bubble));
      bubble.addEventListener('click', (e) => {
        e.preventDefault();
        activateBubble(bubble);
        if (window.innerWidth <= 1024) {
          const hud = document.getElementById('mapHud');
          if (hud) {
            hud.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
        }
      });
    });

    // Anime.js 4.5.x Center-Out Stagger & Replay-on-Return
    if (skillsCleanup) {
      skillsCleanup();
      skillsCleanup = null;
    }
    const skillsSection = document.getElementById('skills');
    if (skillsSection) {
      skillsCleanup = initSkillsAnimation(skillsSection);
    }
  }

  document.addEventListener('astro:page-load', initSkillMap);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSkillMap);
  } else {
    initSkillMap();
  }
</script>

<style>
  /* ============================
     SKILLS SECTION — SKILL MAP
     ============================ */
  .skills-section {
    padding: var(--section-pad) 0;
    position: relative;
    border-top: 1px solid var(--border-subtle);
    background: transparent;
    overflow: hidden;
  }

  .header-kicker {
    font-size: var(--text-2xs);
    color: var(--accent-primary);
    font-weight: 700;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-2);
  }

  .skills-section .section-title {
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    margin-bottom: var(--space-3);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .skills-section .section-lead {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    max-width: 680px;
    line-height: 1.65;
  }

  /* Legend Bar */
  .map-legend {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    margin-top: var(--space-6);
    margin-bottom: var(--space-8);
    padding: var(--space-3) var(--space-5);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-pill);
    width: fit-content;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .legend-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .dot-core {
    background: var(--accent-primary);
    box-shadow: 0 0 6px rgba(184, 146, 74, 0.4);
  }

  .dot-comp {
    background: var(--color-muted);
    opacity: 0.6;
  }

  .legend-separator {
    width: 1px;
    height: 14px;
    background: var(--border);
  }

  .legend-size {
    border-radius: 50%;
    border: 1.5px solid var(--color-muted);
    opacity: 0.5;
  }

  .size-strong { width: 12px; height: 12px; }
  .size-working { width: 9px; height: 9px; }
  .size-experience { width: 6px; height: 6px; }

  /* ============================
     MAIN WORKSPACE LAYOUT
     ============================ */
  .skill-map-workspace {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: var(--space-8);
    align-items: start;
  }

  /* ============================
     THE BUBBLE MAP CANVAS
     ============================ */
  .skill-map-canvas {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  /* Domain Cluster */
  .domain-cluster {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-card);
    padding: var(--space-5);
    transition: all 0.35s var(--ease-out);
    opacity: 0;
    transform: translateY(20px);
    position: relative;
    overflow: hidden;
  }

  .domain-cluster::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: transparent;
    transition: background 0.3s var(--ease-out);
  }

  .cluster-core::before {
    background: linear-gradient(90deg, var(--accent-primary), rgba(184, 146, 74, 0.2));
  }

  .cluster-complementary::before {
    background: linear-gradient(90deg, var(--color-muted), rgba(100, 116, 139, 0.2));
  }

  .domain-cluster.cluster-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .domain-cluster:hover,
  .domain-cluster.domain-active {
    border-color: rgba(184, 146, 74, 0.35);
    box-shadow: 0 8px 32px rgba(184, 146, 74, 0.08);
  }

  .domain-cluster.domain-active::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(184, 146, 74, 0.02);
    pointer-events: none;
    border-radius: inherit;
  }

  /* Stagger reveal animation */
  .domain-cluster:nth-child(1).cluster-visible { transition-delay: 0ms; }
  .domain-cluster:nth-child(2).cluster-visible { transition-delay: 60ms; }
  .domain-cluster:nth-child(3).cluster-visible { transition-delay: 120ms; }
  .domain-cluster:nth-child(4).cluster-visible { transition-delay: 180ms; }
  .domain-cluster:nth-child(5).cluster-visible { transition-delay: 240ms; }
  .domain-cluster:nth-child(6).cluster-visible { transition-delay: 300ms; }
  .domain-cluster:nth-child(7).cluster-visible { transition-delay: 360ms; }
  .domain-cluster:nth-child(8).cluster-visible { transition-delay: 420ms; }
  .domain-cluster:nth-child(9).cluster-visible { transition-delay: 480ms; }
  .domain-cluster:nth-child(10).cluster-visible { transition-delay: 540ms; }
  .domain-cluster:nth-child(11).cluster-visible { transition-delay: 600ms; }

  /* Domain Label Bubble */
  .domain-label-bubble {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-subtle);
  }

  .domain-idx {
    font-size: 0.6rem;
    font-weight: 800;
    color: var(--accent-primary);
    background: rgba(184, 146, 74, 0.08);
    padding: 3px 7px;
    border-radius: var(--r-xs);
    letter-spacing: 0.08em;
  }

  .domain-name {
    font-size: clamp(0.85rem, 1.2vw, 1rem);
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }

  .cluster-complementary .domain-idx {
    color: var(--color-muted);
    background: rgba(100, 116, 139, 0.08);
  }

  /* ============================
     SKILL BUBBLES
     ============================ */
  .skill-bubbles-group {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .skill-bubble {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    border: none;
    border-radius: var(--r-pill);
    cursor: pointer;
    font-family: var(--font-sans);
    font-weight: 600;
    letter-spacing: -0.005em;
    color: var(--text-primary);
    background: var(--bg-primary);
    transition: all 0.25s var(--ease-out);
    white-space: nowrap;
    position: relative;
    outline: none;
    line-height: 1.3;
  }

  /* SIZE by proficiency (three-level hierarchy) */
  .skill-bubble.proficiency-strong {
    font-size: 0.78rem;
    padding: 7px 14px;
    border: 1.5px solid rgba(184, 146, 74, 0.25);
  }

  .skill-bubble.proficiency-working {
    font-size: 0.72rem;
    padding: 5px 11px;
    border: 1px solid var(--border);
  }

  .skill-bubble.proficiency-experience,
  .skill-bubble.proficiency-awareness {
    font-size: 0.66rem;
    padding: 4px 9px;
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
  }

  /* Core vs Complementary tinting */
  .skill-bubble.tier-core.proficiency-strong {
    background: rgba(184, 146, 74, 0.06);
  }

  .skill-bubble.tier-complementary {
    border-color: rgba(100, 116, 139, 0.2);
  }

  /* Connection count badge */
  .bubble-conn-count {
    font-size: 0.52rem;
    font-weight: 800;
    color: var(--accent-primary);
    background: rgba(184, 146, 74, 0.1);
    padding: 1px 4px;
    border-radius: var(--r-pill);
    min-width: 14px;
    text-align: center;
    line-height: 1.4;
  }

  /* Hover / Active states */
  .skill-bubble:hover,
  .skill-bubble:focus-visible {
    background: rgba(184, 146, 74, 0.1);
    border-color: var(--accent-primary);
    color: var(--text-primary);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(184, 146, 74, 0.15);
  }

  .skill-bubble.is-active {
    background: var(--text-primary);
    color: var(--bg-primary);
    border-color: var(--text-primary);
    transform: translateY(-3px) scale(1.05);
    box-shadow: 0 6px 24px rgba(20, 24, 34, 0.2);
    z-index: 10;
  }

  .skill-bubble.is-active .bubble-conn-count {
    color: var(--bg-primary);
    background: rgba(255, 255, 255, 0.2);
  }

  .skill-bubble.same-domain {
    background: rgba(184, 146, 74, 0.06);
    border-color: rgba(184, 146, 74, 0.3);
  }

