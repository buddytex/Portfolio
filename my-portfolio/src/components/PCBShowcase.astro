---
// PCBShowcase Component — Physical Engineering Artifact Inspector
// Uses React Three Fiber with OrbitControls for proper 3D interaction
import { pcbArtifacts } from '../data/pcbArtifacts';
import PCBShowcaseReact from './react/PCBShowcaseReact.tsx';
import { resolveMediaUrl, resolveHref } from '../utils/media';
---

<div class="pcb-showcase-container" id="pcbShowcase">
  <div class="pcb-header-bar">
    <div class="pcb-header-left">
      <span class="pcb-tag mono">[ 07 // HARDWARE &amp; PCB LAB ]</span>
      <h3 class="pcb-heading">Physical PCB Engineering Showcase</h3>
      <p class="pcb-lead mono">
        Interactive 3D inspection of production PCBs designed in KiCad EDA. Rendered directly from manufacturing Gerber geometry (RS-274X stackup) with authentic copper layers and zero artificial components.
      </p>
    </div>

    <!-- Carousel Controls -->
    <div class="pcb-nav-controls">
      <div class="pcb-dots" role="tablist" aria-label="PCB Board Artifacts">
        {pcbArtifacts.map((board, idx) => {
          const tabLabel = board.tabLabel || board.name.toUpperCase();
          return (
            <button
              class:list={['pcb-dot-btn', { active: idx === 0 }]}
              id={`pcbDot-${board.id}`}
              data-index={idx}
              role="tab"
              aria-selected={idx === 0 ? "true" : "false"}
              aria-label={`Select ${board.name}`}
            >
              <span class="dot-pip"></span>
              <span class="dot-label mono">{tabLabel}</span>
            </button>
          );
        })}
      </div>

      <div class="pcb-arrows">
        <button id="pcbPrevBtn" class="pcb-arrow-btn" aria-label="Previous PCB Board">
          <span aria-hidden="true">←</span>
        </button>
        <button id="pcbNextBtn" class="pcb-arrow-btn" aria-label="Next PCB Board">
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Stage: Two-Column Interactive Stage (3D Viewport Left, Telemetry Right) -->
  <div class="pcb-stage-grid">
    <!-- Left Column: Interactive 3D Artifact Viewport -->
    <div class="pcb-viewport-wrap" id="pcbViewportWrap">
      <PCBShowcaseReact client:load />
    </div>

    <!-- Right Column: Engineering Metadata & Problem Rationale -->
    <div class="pcb-telemetry-panel" id="pcbTelemetryPanel" role="region" aria-live="polite">
      {pcbArtifacts.map((board, idx) => (
        <article
          class:list={['pcb-details-card', { active: idx === 0 }]}
          id={`pcbDetails-${board.id}`}
          data-board-id={board.id}
          hidden={idx !== 0}
        >
          <!-- Title & Subsystem -->
          <div class="details-top">
            <div class="badge-row">
              <span class="subsystem-badge mono">{board.subsystem}</span>
              <span class="layer-pill mono">{board.layerCount}</span>
            </div>
            <h4 class="board-title">{board.name}</h4>
            <div class="project-association">
              <span class="assoc-label mono">PROJECT:</span>
              {board.projectId ? (
                <a href={resolveHref(`/projects/${board.projectId}`)} class="assoc-link mono">
                  <span>{board.project}</span>
                  <span class="assoc-arrow">↗</span>
                </a>
              ) : (
                <span class="assoc-link mono">{board.project}</span>
              )}
            </div>

            <!-- Provenance & CAD Tool -->
            <div class="provenance-grid mono">
              <div class="provenance-item">
                <span class="prov-label">CAD SOFTWARE:</span>
                <span class="prov-val">{board.designSoftware || 'KiCad EDA'}</span>
              </div>
              <div class="provenance-item">
                <span class="prov-label">DATA PROVENANCE:</span>
                <span class="prov-val">{board.dataUsed || 'Production Gerbers'}</span>
              </div>
            </div>

            <!-- What Naveen Personally Designed -->
            {board.whatIDesigned && (
              <div class="personal-design-block">
                <div class="personal-design-kicker mono">
                  <span class="design-pip">⚡</span>
                  <span>MY DIRECT PCB DESIGN WORK:</span>
                </div>
                <p class="personal-design-text">{board.whatIDesigned}</p>
              </div>
            )}
          </div>

          <!-- Technical Specs Table -->
          <div class="specs-grid-section">
            <span class="section-label mono">FABRICATION & ELECTRICAL PARAMETERS:</span>
            <div class="specs-mini-table">
              {board.specs.map((s) => (
                <div class="spec-row">
                  <span class="spec-k mono">{s.label}</span>
                  <span class="spec-v mono">{s.value}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Physical Engineering Rationale -->
          {(board.problemSolved || board.designDecisions) && (
          <div class="rationale-section">
            {board.problemSolved && (
            <div class="rationale-block">
              <div class="rationale-title mono">
                <span class="dot-warn">●</span>
                <span>PHYSICAL PROBLEM SOLVED</span>
              </div>
              <p class="rationale-text">{board.problemSolved}</p>
            </div>
            )}

            {board.designDecisions && (
            <div class="rationale-block">
              <div class="rationale-title mono">
                <span class="dot-accent">●</span>
                <span>HARDWARE DESIGN DECISIONS & TRADE-OFFS</span>
              </div>
              <p class="rationale-text">{board.designDecisions}</p>
            </div>
            )}
          </div>
          )}

          <!-- Physical Build Verification (Photographic & Live Test Proof) -->
          {board.id === 'vehicle-ecu' && (
            <div class="physical-proof-strip">
              <div class="proof-header">
                <div class="proof-title-wrap">
                  <span class="proof-pip" aria-hidden="true">●</span>
                  <span class="proof-label mono">PHYSICAL FABRICATION &amp; BENCH VERIFICATION</span>
                </div>
                <button type="button" class="btn-toggle-proof mono" id="btnToggleProof" aria-expanded="false">
                  <span>[ View Real Enclosure Photo ]</span>
                </button>
              </div>

              <div class="proof-drawer" id="proofDrawer" hidden>
                <div class="proof-media-row">
                  <div 
                    class="proof-img-card img-expandable" 
                    data-lightbox={resolveMediaUrl('/media/projects/baja/baja-2026/electrical/WhatsApp Image 2026-09-14 at 00.14.57(3).jpeg')}
                    data-title="Custom Equinox Back-Box ECU Assembled in Chassis Enclosure"
                    data-badge="PHYSICAL PROOF"
                    data-caption="Custom multi-layer Back-Box ECU with galvanic isolation barrier and screw terminal interface, photographed mounted inside the competition vehicle sealed chassis enclosure."
                    title="Click to view full resolution photograph"
                  >
                    <img
                      src={resolveMediaUrl('/media/projects/baja/baja-2026/electrical/WhatsApp Image 2026-09-14 at 00.14.57(3).jpeg')}
                      alt="Custom Equinox Back-Box ECU Assembled in Chassis Enclosure"
                      class="proof-thumb-img img-contain"
                      loading="lazy"
                    />
                    <span class="proof-tag mono">ASSEMBLED ECU IN VEHICLE ↗</span>
                  </div>
                  <div class="proof-desc-block">
                    <p class="proof-text">
                      Custom multi-layer Back-Box ECU with galvanic isolation barrier and screw terminal interface, photographed mounted inside the competition vehicle sealed chassis enclosure.
                    </p>
                    <a href={resolveHref('/projects/baja-2026#engineeringDossier')} class="proof-link mono">
                      <span>Inspect Live Power-On Testing Video</span>
                      <span aria-hidden="true">→</span>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          )}

          <!-- Gerber Actions -->
          {(board.gerberArchive || board.gerberDataFile) && (
            <div class="gerber-actions-strip">
              {board.gerberDataFile && (
                <button
                  type="button"
                  class="btn-view-gerber3d mono"
                  data-board-index={idx}
                  aria-label={`View real 3D PCB for ${board.name}`}
                >
                  <span class="gerber-icon">⬡</span>
                  <span>VIEW REAL PCB</span>
                </button>
              )}
              {board.gerberArchive && (
                <a
                  href={resolveMediaUrl(`/media/${board.gerberArchive}`)}
                  download
                  class="btn-download-gerbers mono"
                >
                  <span>↓ DOWNLOAD GERBERS</span>
                </a>
              )}
              {board.renders && Object.entries(board.renders).map(([view, file]) => (
                <a
                  href={resolveMediaUrl(`/media/${file}`)}
                  download
                  class="btn-download-gerbers mono"
                  title={`Download ${view} render (PNG, transparent background)`}
                >
                  <span>↓ {view.toUpperCase()} PNG</span>
                </a>
              ))}
            </div>
          )}

          <!-- Live Test Point Inspector Callout (Updated on TP hover) -->
          {board.testPoints.length > 0 && (
          <div class="live-tp-callout" id={`tpCallout-${board.id}`}>
            <div class="tp-callout-header mono">
              <span class="tp-icon">⌖</span>
              <span id={`tpCalloutTitle-${board.id}`}>INSPECTION CALLOUT: HOVER TEST POINTS ON BOARD</span>
            </div>
            <p class="tp-callout-body" id={`tpCalloutDesc-${board.id}`}>
              Click or hover any glowing gold test point on the physical PCB schematic to read electrical signal parameters and trace routing rationale.
            </p>
          </div>
          )}
        </article>
      ))}
    </div>
  </div>
</div>

<script>
  import { animate, isReducedMotion } from '../animations';

  function initPCBShowcase() {
    let currentBoardIdx = 0;
    const boardsCount = document.querySelectorAll('.pcb-dot-btn').length || 4;
    const dotBtns = document.querySelectorAll<HTMLButtonElement>('.pcb-dot-btn');
    const detailCards = document.querySelectorAll<HTMLElement>('.pcb-details-card');
    const prevBtn = document.getElementById('pcbPrevBtn');
    const nextBtn = document.getElementById('pcbNextBtn');

    if (!dotBtns.length || !detailCards.length) return;

    // Switch Active Board with Sequenced Gap (§6 Spec)
    function setBoard(index: number) {
      const nextIdx = (index + boardsCount) % boardsCount;
      if (nextIdx === currentBoardIdx) return;

      const outgoingCard = detailCards[currentBoardIdx];
      const incomingCard = detailCards[nextIdx];
      currentBoardIdx = nextIdx;

      // Update Dots
      dotBtns.forEach((dot, idx) => {
        const isActive = idx === currentBoardIdx;
        dot.classList.toggle('active', isActive);
        dot.setAttribute('aria-selected', String(isActive));
      });

      if (isReducedMotion()) {
        detailCards.forEach((c, idx) => {
          c.hidden = idx !== currentBoardIdx;
          c.classList.toggle('active', idx === currentBoardIdx);
          c.style.opacity = '1';
        });
        window.dispatchEvent(new CustomEvent('pcb-board-change', { detail: { index: currentBoardIdx } }));
        return;
      }

      // Outgoing content fades out 100ms before incoming content fades in (no simultaneous crossfade)
      if (outgoingCard) {
        animate(outgoingCard, {
          opacity: [1, 0],
          duration: 100,
          ease: 'inQuart',
          onComplete: () => {
            outgoingCard.hidden = true;
            outgoingCard.classList.remove('active');

            if (incomingCard) {
              incomingCard.hidden = false;
              incomingCard.classList.add('active');
              incomingCard.style.opacity = '0';
              animate(incomingCard, {
                opacity: [0, 1],
                duration: 150,
                ease: 'outExpo',
              });
            }
          }
        });
      } else if (incomingCard) {
        incomingCard.hidden = false;
        incomingCard.classList.add('active');
        incomingCard.style.opacity = '0';
        animate(incomingCard, {
          opacity: [0, 1],
          duration: 150,
          ease: 'outExpo',
        });
      }

      // Notify React component to switch board
      window.dispatchEvent(new CustomEvent('pcb-board-change', { detail: { index: currentBoardIdx } }));
    }

    // Prev / Next Listeners
    prevBtn?.addEventListener('click', () => setBoard(currentBoardIdx - 1));
    nextBtn?.addEventListener('click', () => setBoard(currentBoardIdx + 1));

    dotBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = Number(btn.dataset.index);
        if (!isNaN(idx)) setBoard(idx);
      });
    });

    // Keyboard Navigation
    document.addEventListener('keydown', (e: KeyboardEvent) => {
      const pcbSection = document.getElementById('hardware');
      if (!pcbSection) return;
      const rect = pcbSection.getBoundingClientRect();
      const inView = rect.top < window.innerHeight && rect.bottom > 0;
      
      if (!inView) return;

      switch (e.key) {
        case 'ArrowLeft':
          e.preventDefault();
          setBoard(currentBoardIdx - 1);
          break;
        case 'ArrowRight':
          e.preventDefault();
          setBoard(currentBoardIdx + 1);
          break;
      }
    });

    // Handle 3D PCB Test Point Hover Events (§3 Spec)
    window.addEventListener('pcb-tp-hover', (e: Event) => {
      const customEvent = e as CustomEvent<{ tp: { id: string; label: string; desc: string }; hovered: boolean }>;
      const { tp, hovered } = customEvent.detail;
      const activeCard = document.querySelector<HTMLElement>('.pcb-details-card.active');
      if (!activeCard) return;

      const callout = activeCard.querySelector<HTMLElement>('.live-tp-callout');
      const titleEl = activeCard.querySelector<HTMLElement>('[id^="tpCalloutTitle-"]');
      const descEl = activeCard.querySelector<HTMLElement>('[id^="tpCalloutDesc-"]');

      if (hovered && tp) {
        if (titleEl) titleEl.textContent = `TEST POINT ${tp.label} // ACTIVE`;
        if (descEl) descEl.textContent = tp.desc;
        callout?.classList.add('is-active');
      } else {
        if (titleEl) titleEl.textContent = 'INSPECTION CALLOUT: HOVER TEST POINTS ON BOARD';
        if (descEl) descEl.textContent = 'Click or hover any glowing gold test point on the physical PCB schematic to read electrical signal parameters and trace routing rationale.';
        callout?.classList.remove('is-active');
      }
    });

    // VIEW REAL PCB buttons — dispatch event to React component
    document.querySelectorAll<HTMLButtonElement>('.btn-view-gerber3d').forEach(btn => {
      btn.addEventListener('click', () => {
        const boardIndex = parseInt(btn.dataset.boardIndex || '0', 10);
        window.dispatchEvent(new CustomEvent('pcb-view-gerber3d', { detail: { boardIndex } }));
      });
    });

    // Toggle Real Physical Build Proof Drawer
    const toggleProofBtn = document.getElementById('btnToggleProof');
    const proofDrawer = document.getElementById('proofDrawer');
    if (toggleProofBtn && proofDrawer) {
      toggleProofBtn.addEventListener('click', () => {
        const isHidden = proofDrawer.hidden;
        proofDrawer.hidden = !isHidden;
        toggleProofBtn.setAttribute('aria-expanded', String(isHidden));
        const span = toggleProofBtn.querySelector('span');
        if (span) {
          span.textContent = isHidden ? '[ Hide Enclosure Photo ]' : '[ View Real Enclosure Photo ]';
        }
      });
    }
  }

  document.addEventListener('astro:page-load', initPCBShowcase);
  document.addEventListener('DOMContentLoaded', initPCBShowcase);
</script>

<style>
  .pcb-showcase-container {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-card);
    padding: var(--space-8);
    box-shadow: var(--shadow-resting);
    margin-top: var(--space-6);
  }

  /* Header Bar */
  .pcb-header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: var(--space-8);
  }

  .pcb-header-left {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .pcb-tag {
    font-size: var(--text-2xs);
    color: var(--color-muted);
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .pcb-heading {
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .pcb-lead {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    max-width: 640px;
    line-height: 1.5;
    margin-top: 4px;
  }

  .provenance-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-2);
    margin-top: var(--space-3);
    padding: var(--space-2) var(--space-3);
    background: var(--bg-primary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--r-xs);
    font-size: var(--text-2xs);
  }

  .provenance-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .prov-label {
    color: var(--text-muted);
    font-size: 9px;
    letter-spacing: 0.05em;
  }

  .prov-val {
    color: var(--accent-primary);
    font-weight: 700;
  }

  .personal-design-block {
    margin-top: var(--space-3);
    padding: var(--space-2) var(--space-3);
    background: rgba(184, 146, 74, 0.06);
    border: 1px solid rgba(184, 146, 74, 0.25);
    border-radius: var(--r-xs);
  }

  .personal-design-kicker {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 10px;
    font-weight: 700;
    color: var(--accent-primary);
    margin-bottom: 4px;
    letter-spacing: 0.05em;
  }

  .design-pip {
    color: var(--accent-primary);
  }

  .personal-design-text {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    line-height: 1.45;
    margin: 0;
  }

  /* Controls */
  .pcb-nav-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    width: 100%;
  }

  .pcb-dots {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem 0.5rem;
  }

  .pcb-dot-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 4px 10px;
    background: var(--bg-primary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--r-xs);
    cursor: pointer;
    font-size: var(--text-2xs);
    color: var(--text-muted);
    transition: all 120ms var(--ease-standard);
  }

  .pcb-dot-btn:hover,
  .pcb-dot-btn:focus-visible {
    border-color: var(--accent-primary);
    color: var(--text-primary);
    outline: none;
    transition: all var(--dur-micro) var(--ease-standard);
  }

  .pcb-dot-btn.active {
    background: var(--accent-muted);
    border-color: var(--accent-primary);
    color: var(--accent-primary);
    font-weight: 700;
  }

  .dot-pip {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--border);
    transition: background 120ms var(--ease-standard), box-shadow 120ms var(--ease-standard);
  }

  .pcb-dot-btn.active .dot-pip {
    background: var(--accent-primary);
    box-shadow: 0 0 8px var(--accent-glow);
  }

  .pcb-arrows {
    display: flex;
    gap: 0.35rem;
  }

  .pcb-arrow-btn {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--r-sm);
    background: var(--bg-primary);
    border: 1px solid var(--border);
    cursor: pointer;
    color: var(--text-primary);
    font-size: var(--text-sm);
    transition: all 120ms var(--ease-standard);
  }

  .pcb-arrow-btn:hover,
  .pcb-arrow-btn:focus-visible {
    background: var(--surface);
    border-color: var(--accent-primary);
    color: var(--accent-primary);
    outline: none;
    transition: all var(--dur-micro) var(--ease-standard);
  }

  /* Stage Grid */
  .pcb-stage-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: var(--space-8);
    align-items: start;
  }

  /* 3D Perspective Stage */
  .pcb-viewport-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  .pcb-viewport-wrap :global(astro-island),
  .pcb-viewport-wrap > div,
  .pcb-viewport-wrap :global(.gerber-viewer-container) {
    width: 100%;
    max-width: 720px;
    display: block;
  }

  /* Telemetry Panel (Right) */
  .pcb-telemetry-panel {
    display: flex;
    flex-direction: column;
  }

  .pcb-details-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .pcb-details-card[hidden] {
    display: none !important;
  }

  .details-top {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
  }

  .badge-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .subsystem-badge {
    font-size: var(--text-2xs);
    font-weight: 700;
    color: var(--color-muted);
    letter-spacing: 0.04em;
  }

  .layer-pill {
    font-size: 0.65rem;
    padding: 2px 6px;
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: var(--r-xs);
    color: var(--text-muted);
  }

  .board-title {
    font-size: clamp(1.3rem, 2vw, 1.65rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .project-association {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-xs);
    margin-top: 2px;
  }

  .assoc-label {
    color: var(--text-muted);
    font-size: 0.65rem;
    font-weight: 700;
  }

  .assoc-link {
    color: var(--text-primary);
    text-decoration: none;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 2px;
    transition: color 0.2s ease;
  }

  .assoc-link:hover {
    color: var(--accent-primary);
  }

  .assoc-arrow {
    color: var(--accent-primary);
  }

  /* Specs Grid */
  .specs-grid-section {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .section-label {
    font-size: 0.65rem;
    color: var(--text-muted);
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .specs-mini-table {
    display: flex;
    flex-direction: column;
    background: var(--bg-primary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--r-sm);
    overflow: hidden;
  }

  .spec-row {
    display: flex;
    justify-content: space-between;
    padding: 6px 12px;
    font-size: 0.75rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.04);
  }

  .spec-row:last-child {
    border-bottom: none;
  }

  .spec-k {
    color: var(--text-muted);
    font-weight: 500;
  }

  .spec-v {
    color: var(--text-primary);
    font-weight: 600;
  }

  /* Rationale */
  .rationale-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .rationale-block {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: var(--space-4);
    background: var(--bg-primary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--r-sm);
  }

  .rationale-title {
    display: flex;
    align-items: center;
    gap: 0.4rem;
