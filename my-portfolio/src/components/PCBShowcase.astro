---
// PCBShowcase Component — Physical Engineering Artifact Inspector
// Uses React Three Fiber with OrbitControls for proper 3D interaction
import { pcbArtifacts } from '../data/pcbArtifacts';
import PCBShowcaseReact from './react/PCBShowcaseReact.tsx';
---

<div class="pcb-showcase-container" id="pcbShowcase">
  <div class="pcb-header-bar">
    <div class="pcb-header-left">
      <span class="pcb-tag mono">[ HARDWARE ARTIFACT INSPECTOR ]</span>
      <h3 class="pcb-heading">Physical PCB Engineering Showcase</h3>
    </div>

    <!-- Carousel Controls -->
    <div class="pcb-nav-controls">
      <div class="pcb-dots" role="tablist" aria-label="PCB Board Artifacts">
        {pcbArtifacts.map((board, idx) => (
          <button
            class:list={['pcb-dot-btn', { active: idx === 0 }]}
            id={`pcbDot-${board.id}`}
            data-index={idx}
            role="tab"
            aria-selected={idx === 0 ? "true" : "false"}
            aria-label={`Select ${board.name}`}
          >
            <span class="dot-pip"></span>
            <span class="dot-label mono">BOARD 0{idx + 1}</span>
          </button>
        ))}
      </div>

      <div class="pcb-arrows">
        <button id="pcbPrevBtn" class="pcb-arrow-btn" aria-label="Previous PCB Board">
          <span aria-hidden="true">←</span>
        </button>
        <button id="pcbNextBtn" class="pcb-arrow-btn" aria-label="Next PCB Board">
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Stage: Two-Column Interactive Stage (3D Viewport Left, Telemetry Right) -->
  <div class="pcb-stage-grid">
    <!-- Left Column: Interactive 3D Artifact Viewport -->
    <div class="pcb-viewport-wrap" id="pcbViewportWrap">
      <PCBShowcaseReact client:visible />
    </div>

    <!-- Right Column: Engineering Metadata & Problem Rationale -->
    <div class="pcb-telemetry-panel" id="pcbTelemetryPanel" role="region" aria-live="polite">
      {pcbArtifacts.map((board, idx) => (
        <article
          class:list={['pcb-details-card', { active: idx === 0 }]}
          id={`pcbDetails-${board.id}`}
          data-board-id={board.id}
          hidden={idx !== 0}
        >
          <!-- Title & Subsystem -->
          <div class="details-top">
            <div class="badge-row">
              <span class="subsystem-badge mono">{board.subsystem}</span>
              <span class="layer-pill mono">{board.layerCount}</span>
            </div>
            <h4 class="board-title">{board.name}</h4>
            <div class="project-association">
              <span class="assoc-label mono">PROJECT:</span>
              <a href={`/projects/${board.projectId}`} class="assoc-link mono">
                <span>{board.project}</span>
                <span class="assoc-arrow">↗</span>
              </a>
            </div>
          </div>

          <!-- Technical Specs Table -->
          <div class="specs-grid-section">
            <span class="section-label mono">FABRICATION & ELECTRICAL PARAMETERS:</span>
            <div class="specs-mini-table">
              {board.specs.map((s) => (
                <div class="spec-row">
                  <span class="spec-k mono">{s.label}</span>
                  <span class="spec-v mono">{s.value}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Physical Engineering Rationale -->
          <div class="rationale-section">
            <div class="rationale-block">
              <div class="rationale-title mono">
                <span class="dot-warn">●</span>
                <span>PHYSICAL PROBLEM SOLVED</span>
              </div>
              <p class="rationale-text">{board.problemSolved}</p>
            </div>

            <div class="rationale-block">
              <div class="rationale-title mono">
                <span class="dot-accent">●</span>
                <span>HARDWARE DESIGN DECISIONS & TRADE-OFFS</span>
              </div>
              <p class="rationale-text">{board.designDecisions}</p>
            </div>
          </div>

          <!-- Live Test Point Inspector Callout (Updated on TP hover) -->
          <div class="live-tp-callout" id={`tpCallout-${board.id}`}>
            <div class="tp-callout-header mono">
              <span class="tp-icon">⌖</span>
              <span id={`tpCalloutTitle-${board.id}`}>INSPECTION CALLOUT: HOVER TEST POINTS ON BOARD</span>
            </div>
            <p class="tp-callout-body" id={`tpCalloutDesc-${board.id}`}>
              Click or hover any glowing gold test point on the physical PCB schematic to read electrical signal parameters and trace routing rationale.
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>
</div>

<script>
  import { animate, isReducedMotion } from '../lib/motion';
  import { pcbArtifacts } from '../data/pcbArtifacts';

  let currentBoardIdx = 0;
  const boardsCount = 3;
  const dotBtns = document.querySelectorAll<HTMLButtonElement>('.pcb-dot-btn');
  const detailCards = document.querySelectorAll<HTMLElement>('.pcb-details-card');
  const prevBtn = document.getElementById('pcbPrevBtn');
  const nextBtn = document.getElementById('pcbNextBtn');

  // Switch Active Board
  function setBoard(index: number) {
    currentBoardIdx = (index + boardsCount) % boardsCount;

    // Update Dots
    dotBtns.forEach((dot, idx) => {
      const isActive = idx === currentBoardIdx;
      dot.classList.toggle('active', isActive);
      dot.setAttribute('aria-selected', String(isActive));
    });

    // Update Cards with clean transition
    detailCards.forEach((card, idx) => {
      const isTarget = idx === currentBoardIdx;
      if (isTarget) {
        card.hidden = false;
        card.classList.add('active');
        animate(card, {
          opacity: [0.35, 1],
          y: [8, 0],
          duration: 280,
          ease: 'outExpo',
        });
      } else {
        card.hidden = true;
        card.classList.remove('active');
      }
    });

    // Notify React component to switch board
    window.dispatchEvent(new CustomEvent('pcb-board-change', { detail: { index: currentBoardIdx } }));
  }

  // Prev / Next Listeners
  prevBtn?.addEventListener('click', () => setBoard(currentBoardIdx - 1));
  nextBtn?.addEventListener('click', () => setBoard(currentBoardIdx + 1));

  dotBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = Number(btn.dataset.index);
      if (!isNaN(idx)) setBoard(idx);
    });
  });

  // Keyboard Navigation
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    const pcbSection = document.getElementById('hardware');
    if (!pcbSection) return;
    const rect = pcbSection.getBoundingClientRect();
    const inView = rect.top < window.innerHeight && rect.bottom > 0;
    
    if (!inView) return;

    switch (e.key) {
      case 'ArrowLeft':
        e.preventDefault();
        setBoard(currentBoardIdx - 1);
        break;
      case 'ArrowRight':
        e.preventDefault();
        setBoard(currentBoardIdx + 1);
        break;
    }
  });
</script>

<style>
  .pcb-showcase-container {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-card);
    padding: var(--space-8);
    box-shadow: var(--shadow-resting);
    margin-top: var(--space-6);
  }

  /* Header Bar */
  .pcb-header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: var(--space-8);
  }

  .pcb-header-left {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .pcb-tag {
    font-size: var(--text-2xs);
    color: var(--accent-primary);
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .pcb-heading {
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  /* Controls */
  .pcb-nav-controls {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .pcb-dots {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .pcb-dot-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 4px 10px;
    background: var(--bg-primary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--r-xs);
    cursor: pointer;
    font-size: var(--text-2xs);
    color: var(--text-muted);
    transition: all 0.2s ease;
  }

  .pcb-dot-btn:hover {
    border-color: var(--accent-primary);
    color: var(--text-primary);
  }

  .pcb-dot-btn.active {
    background: var(--accent-muted);
    border-color: var(--accent-primary);
    color: var(--accent-primary);
    font-weight: 700;
  }

  .dot-pip {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--border);
  }

  .pcb-dot-btn.active .dot-pip {
    background: var(--accent-primary);
  }

  .pcb-arrows {
    display: flex;
    gap: 0.35rem;
  }

  .pcb-arrow-btn {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--r-sm);
    background: var(--bg-primary);
    border: 1px solid var(--border);
    cursor: pointer;
    color: var(--text-primary);
    font-size: var(--text-sm);
    transition: all 0.2s ease;
  }

  .pcb-arrow-btn:hover {
    background: var(--surface);
    border-color: var(--accent-primary);
    color: var(--accent-primary);
  }

  /* Stage Grid */
  .pcb-stage-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: var(--space-8);
    align-items: start;
  }

  /* 3D Perspective Stage */
  .pcb-viewport-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .pcb-viewport-wrap > div {
    width: 100%;
    aspect-ratio: 1.38 / 1;
    max-width: 720px;
  }

  /* Telemetry Panel (Right) */
  .pcb-telemetry-panel {
    display: flex;
    flex-direction: column;
  }

  .pcb-details-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .details-top {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
  }

  .badge-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .subsystem-badge {
    font-size: var(--text-2xs);
    font-weight: 700;
    color: var(--accent-primary);
    letter-spacing: 0.04em;
  }

  .layer-pill {
    font-size: 0.65rem;
    padding: 2px 6px;
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: var(--r-xs);
    color: var(--text-muted);
  }

  .board-title {
    font-size: clamp(1.3rem, 2vw, 1.65rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .project-association {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-xs);
    margin-top: 2px;
  }

  .assoc-label {
    color: var(--text-muted);
    font-size: 0.65rem;
    font-weight: 700;
  }

  .assoc-link {
    color: var(--text-primary);
    text-decoration: none;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 2px;
    transition: color 0.2s ease;
  }

  .assoc-link:hover {
    color: var(--accent-primary);
  }

  .assoc-arrow {
    color: var(--accent-primary);
  }

  /* Specs Grid */
  .specs-grid-section {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .section-label {
    font-size: 0.65rem;
    color: var(--text-muted);
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .specs-mini-table {
    display: flex;
    flex-direction: column;
    background: var(--bg-primary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--r-sm);
    overflow: hidden;
  }

  .spec-row {
    display: flex;
    justify-content: space-between;
    padding: 6px 12px;
    font-size: 0.75rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.04);
  }

  .spec-row:last-child {
    border-bottom: none;
  }

  .spec-k {
    color: var(--text-muted);
    font-weight: 500;
  }

  .spec-v {
    color: var(--text-primary);
    font-weight: 600;
  }

  /* Rationale */
  .rationale-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .rationale-block {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: var(--space-4);
    background: var(--bg-primary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--r-sm);
  }

  .rationale-title {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }

  .dot-warn {
    color: #D97706;
  }

  .dot-accent {
    color: var(--accent-primary);
  }

  .rationale-text {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  /* Live TP Callout */
  .live-tp-callout {
    padding: var(--space-4);
    background: var(--accent-muted);
    border: 1px solid rgba(184, 154, 97, 0.2);
    border-radius: var(--r-sm);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .tp-callout-header {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--accent-primary);
    letter-spacing: 0.04em;
  }

  .tp-callout-body {
    font-size: 0.75rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  @media (max-width: 960px) {
    .pcb-stage-grid {
      grid-template-columns: 1fr;
    }
    
    .pcb-viewport-wrap > div {
      max-width: 100%;
    }
  }

  @media (max-width: 640px) {
    .pcb-nav-controls {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>