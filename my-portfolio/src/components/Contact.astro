---
// Contact Section — Mission Debrief & Comms Uplink
---

<section id="contact" class="section contact-section">
  <div class="container">
    <!-- Header -->
    <div class="section-header-wrap">
      <div class="section-meta-row">
        <span class="sys-num">06</span>
        <span class="sys-label">MISSION DEBRIEF // COMMS UPLINK</span>
      </div>
      <h2>Mission complete.<br/><span class="heading-accent">Ready for the next deployment.</span></h2>
      <p class="section-desc">
        Actively seeking full-time and R&D engineering roles in robotics, autonomous systems,
        robot perception, and embedded vehicle electronics. Open to opportunities across Germany, Japan, South Korea, and global teams.
      </p>
    </div>

    <!-- Comms Terminals Grid -->
    <div class="comms-grid">
      <!-- Direct Email Channel -->
      <div class="comms-card hud-card">
        <div class="comms-card-top">
          <span class="mono comms-protocol">PROTOCOL // DIRECT_EMAIL</span>
          <span class="status-beacon">
            <span class="beacon-dot"></span>
            <span class="mono">LISTENING</span>
          </span>
        </div>
        <div class="comms-card-body">
          <span class="comms-val mono" id="emailVal">naveensg.rbb2226@saintgits.org</span>
          <p class="comms-hint">Fastest response for engineering interviews, inquiries, and technical collaboration.</p>
        </div>
        <div class="comms-card-actions">
          <a href="mailto:naveensg.rbb2226@saintgits.org" class="btn-tactical btn-primary-tactical">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            TRANSMIT MESSAGE
          </a>
          <button class="btn-tactical btn-secondary-tactical" id="copyEmailBtn" type="button">
            <span id="copyText">COPY ADDRESS</span>
          </button>
        </div>
      </div>

      <!-- Professional Networks -->
      <div class="comms-card hud-card">
        <div class="comms-card-top">
          <span class="mono comms-protocol">TRANSMISSION // NETWORKS & REPOSITORIES</span>
          <span class="mono comms-auth">AUTHENTICATED</span>
        </div>
        <div class="comms-card-body">
          <div class="net-links-list">
            <a href="https://www.linkedin.com/in/naveen-shaji-george-a55b55243" target="_blank" rel="noopener noreferrer" class="net-link-row">
              <div class="net-link-left">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>
                </svg>
                <span class="mono net-label">LinkedIn</span>
              </div>
              <span class="mono net-val">naveen-shaji-george ↗</span>
            </a>

            <a href="https://github.com/buddytex" target="_blank" rel="noopener noreferrer" class="net-link-row">
              <div class="net-link-left">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
                </svg>
                <span class="mono net-label">GitHub</span>
              </div>
              <span class="mono net-val">@buddytex ↗</span>
            </a>

            <a href="/Naveen_Shaji_George_CV.pdf" class="net-link-row" download>
              <div class="net-link-left">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/>
                </svg>
                <span class="mono net-label">Curriculum Vitae</span>
              </div>
              <span class="mono net-val" style="color: var(--accent);">DOWNLOAD_PDF ↗</span>
            </a>
          </div>
        </div>
        <div class="comms-card-footer">
          <span class="mono comms-sec-note">UPLINK CHANNEL SECURE // READY FOR TELEMETRY</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // 1-Click Copy Email to clipboard with Anime.js feedback
  const copyBtn = document.getElementById('copyEmailBtn');
  const copyText = document.getElementById('copyText');
  const emailVal = document.getElementById('emailVal');
  const email = 'naveensg.rbb2226@saintgits.org';
  const anime = (window as any).anime;

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(email);
      if (copyText) copyText.textContent = 'COPIED TO CLIPBOARD ✓';

      if (anime) {
        try {
          const animateFn = anime.animate || anime;
          animateFn(copyBtn, {
            scale: [1, 0.94, 1.05, 1],
            duration: 400,
            ease: 'outBack',
          });

          if (emailVal) {
            animateFn(emailVal, {
              color: ['#7BE0B2', '#F2F5F3'],
              duration: 800,
              ease: 'outQuad',
            });
          }
        } catch {}
      }

      setTimeout(() => {
        if (copyText) copyText.textContent = 'COPY ADDRESS';
      }, 2500);
    } catch {
      // Fallback
    }
  });
</script>

<style>
  .contact-section {
    background: var(--bg-elevated);
  }

  .comms-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
  }

  .comms-card {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .comms-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border);
  }

  .comms-protocol {
    font-size: var(--text-2xs);
    color: var(--accent);
    font-weight: 700;
  }

  .comms-auth {
    font-size: 0.625rem;
    color: var(--accent-blue);
  }

  .comms-card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }

  .comms-val {
    font-size: var(--text-md);
    color: var(--text);
    font-weight: 600;
    word-break: break-all;
  }

  .comms-hint {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .comms-card-actions {
    display: flex;
    gap: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border);
    flex-wrap: wrap;
  }

  /* Net Links */
  .net-links-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .net-link-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-4);
    background: rgba(10, 13, 12, 0.6);
    border: 1px solid var(--border);
    border-radius: var(--radius-xs);
    transition: all var(--duration-fast);
  }

  .net-link-row:hover {
    border-color: var(--border-bright);
    background: var(--bg-surface-2);
    transform: translateX(3px);
  }

  .net-link-left {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--text);
  }

  .net-label {
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .net-val {
    font-size: var(--text-2xs);
    color: var(--accent);
  }

  .comms-card-footer {
    padding-top: var(--space-2);
    border-top: 1px solid var(--border);
  }

  .comms-sec-note {
    font-size: 0.625rem;
    color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .comms-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
