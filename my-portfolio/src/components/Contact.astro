---
// Contact Component — Final Engineering Handoff
// Direct professional communication, verified credentials, and open collaboration
---

<section id="contact" class="section contact-section">
  <div class="container-wide">
    <!-- Section Header -->
    <div class="section-header">
      <span class="section-eyebrow">[ 06 // DIRECT DISPATCH ]</span>
      <h2 class="section-title">Let's Build Something <span class="accent">Meaningful.</span></h2>
      <p class="section-lead">
        Actively exploring robotics engineering roles, autonomous systems R&D, and technical collaborations worldwide.
        Whether you have an ambitious platform to build or an engineering challenge to solve, reach out directly.
      </p>
    </div>

    <!-- Contact Grid -->
    <div class="contact-grid">
      <!-- Left: Direct Communication Card -->
      <div class="contact-card">
        <div class="card-meta">
          <span class="card-tag">Direct Communication</span>
          <span class="status-indicator">
            <span class="status-dot"></span>
            Open for Opportunities
          </span>
        </div>

        <div class="card-main">
          <div class="email-display" id="emailVal">ngbuddy5@gmail.com</div>
          <p class="email-note">
            The most reliable channel for engineering roles, technical inquiries, and project discussions.
            Typically responds within 24 hours.
          </p>
        </div>

        <div class="card-actions">
          <a href="mailto:ngbuddy5@gmail.com" class="btn btn-primary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            <span>Send Email</span>
          </a>

          <button class="btn btn-secondary" id="copyEmailBtn" type="button" aria-label="Copy email address to clipboard">
            <span id="copyText">Copy Address</span>
          </button>
        </div>
      </div>

      <!-- Right: Verified Profiles & Credentials -->
      <div class="networks-card">
        <div class="card-meta">
          <span class="card-tag">Verified Networks</span>
        </div>

        <div class="networks-list">
          <a
            href="https://www.linkedin.com/in/naveen-shaji-george-a55b55243"
            target="_blank"
            rel="noopener noreferrer"
            class="network-link"
          >
            <div class="network-info">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>
              </svg>
              <div class="network-text">
                <span class="network-name">LinkedIn</span>
                <span class="network-sub">naveen-shaji-george</span>
              </div>
            </div>
            <span class="network-action">Connect ↗</span>
          </a>

          <a
            href="https://github.com/buddytex"
            target="_blank"
            rel="noopener noreferrer"
            class="network-link"
          >
            <div class="network-info">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
              </svg>
              <div class="network-text">
                <span class="network-name">GitHub</span>
                <span class="network-sub">@buddytex</span>
              </div>
            </div>
            <span class="network-action">Repositories ↗</span>
          </a>

          <a
            href="/CV_1.pdf"
            class="network-link"
            download
          >
            <div class="network-info">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>
              </svg>
              <div class="network-text">
                <span class="network-name">Curriculum Vitae</span>
                <span class="network-sub">PDF (Updated 2026)</span>
              </div>
            </div>
            <span class="network-action">Download ↓</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Final Signature -->
    <div class="contact-signature">
      <div class="signature-line"></div>
      <p class="signature-text mono">— Naveen Shaji George</p>
      <p class="signature-role">Robotics & Autonomous Systems Engineer</p>
    </div>
  </div>
</section>

<script>
  // 1-Click Email copy to clipboard
  const copyBtn = document.getElementById('copyEmailBtn');
  const copyText = document.getElementById('copyText');
  const email = 'ngbuddy5@gmail.com';

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(email);
      if (copyText) {
        copyText.textContent = 'Copied to Clipboard ✓';
        copyText.style.color = 'var(--accent-primary)';
      }
      setTimeout(() => {
        if (copyText) {
          copyText.textContent = 'Copy Address';
          copyText.style.color = '';
        }
      }, 2500);
    } catch {
      // Fallback
    }
  });
</script>

<style>
  .contact-section {
    background: transparent;
    border-top: 1px solid var(--border-subtle);
    min-height: 100svh;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-12);
    align-items: stretch;
  }

  .contact-card,
  .networks-card {
    background: var(--surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--r-card);
    padding: var(--space-10);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    box-shadow: var(--shadow-resting);
  }

  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-subtle);
  }

  .card-tag {
    font-size: var(--text-2xs);
    color: var(--text-muted);
    letter-spacing: 0.06em;
    font-weight: 600;
    text-transform: uppercase;
  }

  .status-indicator {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-2xs);
    color: #16A34A;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #16A34A;
    box-shadow: 0 0 0 3px rgba(22, 163, 74, 0.15);
  }

  .card-main {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .email-display {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 700;
    color: var(--text-primary);
    word-break: break-all;
    letter-spacing: -0.015em;
  }

  .email-note {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .card-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-4);
  }

  .networks-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .network-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-5) var(--space-6);
    background: rgba(20, 24, 34, 0.02);
    border: 1px solid var(--border-subtle);
    border-radius: var(--r-md);
    box-shadow: none;
    transition: transform var(--dur-norm) var(--ease-out),
                box-shadow var(--dur-norm) var(--ease-out),
                border-color var(--dur-norm) var(--ease-out),
                background var(--dur-norm) var(--ease-out);
    text-decoration: none;
  }

  .network-link:hover,
  .network-link:focus-visible {
    background: var(--surface);
    border-color: var(--accent-primary);
    transform: translateY(-2px);
    box-shadow: var(--shadow-hover);
  }

  .network-link:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }

  .network-info {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--text-primary);
  }

  .network-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .network-name {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--text-primary);
  }

  .network-sub {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .network-action {
    font-size: var(--text-sm);
    color: var(--accent-primary);
    font-weight: 500;
  }

  /* Final Signature */
  .contact-signature {
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: 1px solid var(--border-subtle);
    text-align: center;
  }

  .signature-line {
    width: 120px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent-primary), transparent);
    margin: 0 auto var(--space-4);
  }

  .signature-text {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin-bottom: 2px;
  }

  .signature-role {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .contact-section {
      min-height: auto;
    }
  }
</style>