---
// Contact Section — Professional international contact channels
---

<section id="contact" class="section contact-section">
  <div class="container">
    <!-- Header -->
    <div class="section-header">
      <span class="editorial-tag section-tag">Communication</span>
      <h2>Let's build the next generation of<br/><span class="text-accent">autonomous machines</span></h2>
      <p class="section-lead">
        Actively exploring engineering opportunities and research roles in robotics, autonomous vehicle systems,
        spatial perception, and embedded vehicle electronics worldwide.
      </p>
    </div>

    <!-- Contact Grid -->
    <div class="contact-grid">
      <!-- Direct Email Card -->
      <div class="contact-card email-card">
        <div class="card-header">
          <span class="card-tag mono">Direct Communication</span>
          <span class="card-status mono">Available for Opportunities</span>
        </div>

        <div class="card-body">
          <div class="email-display mono" id="emailVal">naveensg.rbb2226@saintgits.org</div>
          <p class="email-desc">
            The fastest channel for technical inquiries, engineering interviews, and project collaborations.
          </p>
        </div>

        <div class="card-actions">
          <a href="mailto:naveensg.rbb2226@saintgits.org" class="btn-editorial btn-editorial-primary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            <span>Send Email</span>
          </a>

          <button class="btn-editorial btn-editorial-secondary" id="copyEmailBtn" type="button">
            <span id="copyText">Copy Address</span>
          </button>
        </div>
      </div>

      <!-- Professional Networks Card -->
      <div class="contact-card networks-card">
        <div class="card-header">
          <span class="card-tag mono">Verified Profiles</span>
        </div>

        <div class="networks-list">
          <a
            href="https://www.linkedin.com/in/naveen-shaji-george-a55b55243"
            target="_blank"
            rel="noopener noreferrer"
            class="network-row"
          >
            <div class="network-info">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>
              </svg>
              <span class="network-name">LinkedIn</span>
            </div>
            <span class="network-action mono">Connect ↗</span>
          </a>

          <a
            href="https://github.com/buddytex"
            target="_blank"
            rel="noopener noreferrer"
            class="network-row"
          >
            <div class="network-info">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
              </svg>
              <span class="network-name">GitHub</span>
            </div>
            <span class="network-action mono">View Code ↗</span>
          </a>

          <a
            href="/Naveen_Shaji_George_CV.pdf"
            class="network-row"
            download
          >
            <div class="network-info">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>
              </svg>
              <span class="network-name">Curriculum Vitae</span>
            </div>
            <span class="network-action mono text-accent">Download PDF ↓</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // 1-Click Email copy to clipboard
  const copyBtn = document.getElementById('copyEmailBtn');
  const copyText = document.getElementById('copyText');
  const email = 'naveensg.rbb2226@saintgits.org';

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(email);
      if (copyText) copyText.textContent = 'Copied to Clipboard ✓';
      setTimeout(() => {
        if (copyText) copyText.textContent = 'Copy Address';
      }, 2500);
    } catch {
      // Fallback
    }
  });
</script>

<style>
  .contact-section {
    background: var(--bg);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: var(--space-8);
    align-items: stretch;
  }

  .contact-card {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .card-tag {
    font-size: var(--text-2xs);
    color: var(--text-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .card-status {
    font-size: var(--text-2xs);
    color: var(--accent);
    letter-spacing: 0.04em;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .email-display {
    font-size: clamp(1.125rem, 2vw, 1.35rem);
    color: var(--text);
    word-break: break-all;
    font-weight: 500;
  }

  .email-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .card-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-top: auto;
    padding-top: var(--space-4);
    flex-wrap: wrap;
  }

  /* Networks List */
  .networks-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .network-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-5);
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    transition: all var(--duration-fast) var(--ease-editorial);
  }

  .network-row:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: var(--border-hover);
    transform: translateX(3px);
  }

  .network-info {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--text);
  }

  .network-name {
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .network-action {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .network-row:hover .network-action {
    color: var(--text);
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
