---
// Editorial Engineering Case Study Card
interface Props {
  index: string;
  category: string;
  title: string;
  role: string;
  badge?: string;
  description: string;
  problem: string;
  approach: string;
  pipeline: string[];
  hardware: string[];
  software: string[];
  results: string[];
  github?: string;
  demo?: string;
  featured?: boolean;
}

const {
  index,
  category,
  title,
  role,
  badge,
  description,
  problem,
  approach,
  pipeline,
  hardware,
  software,
  results,
  github,
  demo,
  featured = false,
} = Astro.props;
---

<article class:list={['case-study', { 'featured-study': featured }]} id={`project-${index}`}>
  <!-- Case Study Header -->
  <div class="case-header">
    <div class="case-meta-row">
      <div class="case-index-group">
        <span class="case-num mono">{index}</span>
        <span class="case-category mono">{category}</span>
      </div>
      {badge && <span class="case-badge mono">{badge}</span>}
    </div>

    <h3 class="case-title">{title}</h3>
    <div class="case-role mono">{role}</div>
    <p class="case-lead">{description}</p>
  </div>

  <!-- Technical Subsystem Architecture Pipeline -->
  {pipeline && pipeline.length > 0 && (
    <div class="case-pipeline-wrap">
      <div class="pipeline-caption mono">System Architecture & Dataflow</div>
      <div class="pipeline-flow">
        {pipeline.map((stage, idx) => (
          <div class="pipeline-node">
            <span class="node-box mono">{stage}</span>
            {idx < pipeline.length - 1 && (
              <span class="flow-arrow" aria-hidden="true">→</span>
            )}
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- Problem vs Approach (The Engineering Story) -->
  <div class="case-deepdive-grid">
    <div class="deepdive-col">
      <h4 class="deepdive-heading mono">The Engineering Challenge</h4>
      <p class="deepdive-text">{problem}</p>
    </div>

    <div class="deepdive-col">
      <h4 class="deepdive-heading mono">Architecture & Implementation</h4>
      <p class="deepdive-text">{approach}</p>
    </div>
  </div>

  <!-- Hardware & Software Stacks -->
  <div class="case-tech-section">
    {hardware && hardware.length > 0 && (
      <div class="tech-group">
        <span class="tech-label mono">Hardware & Electronics</span>
        <div class="tech-tags">
          {hardware.map((item) => (
            <span class="tech-pill mono">{item}</span>
          ))}
        </div>
      </div>
    )}

    {software && software.length > 0 && (
      <div class="tech-group">
        <span class="tech-label mono">Software & Firmware</span>
        <div class="tech-tags">
          {software.map((item) => (
            <span class="tech-pill mono software">{item}</span>
          ))}
        </div>
      </div>
    )}
  </div>

  <!-- Validated Results & Case Footer -->
  <div class="case-footer">
    <div class="results-group">
      <span class="results-label mono">Verified Results</span>
      <ul class="results-list">
        {results.map((res) => (
          <li class="result-item">
            <span class="result-bullet">✓</span>
            <span class="result-txt">{res}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="case-actions">
      {github && (
        <a href={github} target="_blank" rel="noopener noreferrer" class="case-link mono">
          <span>Repository</span>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/>
          </svg>
        </a>
      )}
      {demo && (
        <a href={demo} target="_blank" rel="noopener noreferrer" class="case-link mono">
          <span>Demonstration</span>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="5 3 19 12 5 21 5 3"/>
          </svg>
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .case-study {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: clamp(2rem, 4vw, 3.5rem);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    transition: border-color var(--duration-norm) var(--ease-editorial),
                transform var(--duration-norm) var(--ease-editorial);
  }

  .case-study:hover {
    border-color: var(--border-hover);
  }

  .featured-study {
    background: linear-gradient(180deg, #181D23 0%, var(--bg-surface) 100%);
    border-color: rgba(59, 130, 246, 0.25);
  }

  /* Header */
  .case-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .case-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-2);
  }

  .case-index-group {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .case-num {
    font-size: var(--text-xs);
    color: var(--accent);
    font-weight: 600;
  }

  .case-category {
    font-size: var(--text-xs);
    color: var(--text-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .case-badge {
    font-size: var(--text-2xs);
    color: var(--text);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--border);
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    letter-spacing: 0.04em;
  }

  .case-title {
    font-size: clamp(1.5rem, 2.5vw, 2.25rem);
    letter-spacing: -0.025em;
    line-height: 1.15;
    color: var(--text);
  }

  .case-role {
    font-size: var(--text-xs);
    color: var(--accent);
    letter-spacing: 0.04em;
  }

  .case-lead {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.7;
    margin-top: var(--space-2);
    max-width: 900px;
  }

  /* Technical Subsystem Architecture Pipeline */
  .case-pipeline-wrap {
    padding: var(--space-5) var(--space-6);
    background: rgba(11, 13, 14, 0.65);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .pipeline-caption {
    font-size: var(--text-2xs);
    color: var(--text-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: var(--space-3);
  }

  .pipeline-flow {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .pipeline-node {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .node-box {
    font-size: var(--text-xs);
    color: var(--text);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    letter-spacing: 0.02em;
  }

  .flow-arrow {
    color: var(--text-dim);
    font-size: var(--text-sm);
  }

  /* Deep Dive Grid (Problem & Approach) */
  .case-deepdive-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
    padding-top: var(--space-2);
  }

  .deepdive-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .deepdive-heading {
    font-size: var(--text-xs);
    color: var(--text-muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .deepdive-text {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.7;
  }

  /* Tech Stacks */
  .case-tech-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-5) 0;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .tech-group {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .tech-label {
    font-size: var(--text-xs);
    color: var(--text-muted);
    min-width: 170px;
    padding-top: 4px;
    letter-spacing: 0.04em;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tech-pill {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    padding: 4px 10px;
    border-radius: var(--radius-sm);
  }

  .tech-pill.software {
    color: #93C5FD;
    border-color: rgba(59, 130, 246, 0.2);
  }

  /* Footer & Results */
  .case-footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
    flex-wrap: wrap;
  }

  .results-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 600px;
  }

  .results-label {
    font-size: var(--text-xs);
    color: var(--text-muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .results-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .result-item {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text);
  }

  .result-bullet {
    color: var(--accent);
    font-size: var(--text-xs);
  }

  .case-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .case-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-secondary);
    padding: 8px 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    transition: all var(--duration-fast) var(--ease-editorial);
  }

  .case-link:hover {
    color: var(--text);
    border-color: var(--border-hover);
    background: rgba(255, 255, 255, 0.04);
  }

  @media (max-width: 860px) {
    .case-deepdive-grid {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
    .tech-group {
      flex-direction: column;
      gap: var(--space-2);
    }
    .tech-label {
      min-width: unset;
    }
  }
</style>
