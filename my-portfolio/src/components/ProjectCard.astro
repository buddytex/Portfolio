---
// Project Case Study Presentation — Graphite + Electric Cyan
interface Props {
  index: string;
  category: string;
  title: string;
  role: string;
  badge?: string;
  summary: string;
  built: string;
  howItWorks: string;
  challenges: string;
  pipeline: string[];
  hardware: string[];
  software: string[];
  results: string[];
  visualType: 'trajectory' | 'amr_map' | 'vision_bbox' | 'swarm_mesh';
  github?: string;
  demo?: string;
}

const {
  index,
  category,
  title,
  role,
  badge,
  summary,
  built,
  howItWorks,
  challenges,
  pipeline,
  hardware,
  software,
  results,
  visualType,
  github,
  demo,
} = Astro.props;
---

<article class="case-study-entry" id={`project-${index}`}>
  <!-- Top Meta & Title Bar -->
  <div class="case-top-bar">
    <div class="case-index-label mono">
      <span class="index-num text-cyan">{index}</span>
      <span class="index-sep">/</span>
      <span class="index-cat">{category}</span>
    </div>
    {badge && <span class="case-badge mono">{badge}</span>}
  </div>

  <div class="case-title-row">
    <h3 class="case-title">{title}</h3>
    <span class="case-role mono">{role}</span>
  </div>

  <p class="case-summary">{summary}</p>

  <!-- Interactive Project Technical Visualizer (Simulates sensors / trajectory on hover) -->
  <div class="case-visual-container" data-visual={visualType}>
    <div class="visual-canvas-mock">
      {visualType === 'trajectory' && (
        <svg class="visual-svg" viewBox="0 0 800 240" fill="none" xmlns="http://www.w3.org/2000/svg">
          <!-- Off-road terrain contour lines -->
          <path d="M 0 160 Q 200 130 400 170 T 800 140" stroke="#1B2025" stroke-width="1.5" stroke-dasharray="4 4" />
          <path d="M 0 190 Q 200 160 400 200 T 800 170" stroke="#1B2025" stroke-width="1.5" stroke-dasharray="4 4" />
          <!-- Obstacles -->
          <circle cx="280" cy="110" r="14" fill="#171C21" stroke="#252B30" stroke-width="1.5" />
          <circle cx="540" cy="130" r="18" fill="#171C21" stroke="#252B30" stroke-width="1.5" />
          <!-- Planned Trajectory Spline -->
          <path class="anim-path" d="M 50 180 C 180 180, 220 70, 380 90 S 620 180, 750 90" stroke="#00E5FF" stroke-width="2" stroke-dasharray="6 4" />
          <!-- Robot Origin -->
          <circle cx="50" cy="180" r="6" fill="#00E5FF" />
          <text x="65" y="184" fill="#8B949E" font-family="'JetBrains Mono', monospace" font-size="10">START_POSE</text>
          <!-- Goal Waypoint -->
          <circle cx="750" cy="90" r="6" fill="#F2F4F5" stroke="#00E5FF" stroke-width="2" />
          <text x="670" y="80" fill="#00E5FF" font-family="'JetBrains Mono', monospace" font-size="10">WAYPOINT_GOAL</text>
          <!-- Sensor Rays from Robot -->
          <line x1="50" y1="180" x2="160" y2="120" stroke="rgba(0, 229, 255, 0.2)" stroke-width="1" />
          <line x1="50" y1="180" x2="200" y2="150" stroke="rgba(0, 229, 255, 0.3)" stroke-width="1" />
          <line x1="50" y1="180" x2="180" y2="200" stroke="rgba(0, 229, 255, 0.2)" stroke-width="1" />
        </svg>
      )}

      {visualType === 'amr_map' && (
        <svg class="visual-svg" viewBox="0 0 800 240" fill="none" xmlns="http://www.w3.org/2000/svg">
          <!-- Hospital Corridor Walls -->
          <rect x="60" y="40" width="680" height="160" fill="none" stroke="#252B30" stroke-width="1.5" />
          <line x1="280" y1="40" x2="280" y2="130" stroke="#252B30" stroke-width="1.5" />
          <line x1="500" y1="110" x2="500" y2="200" stroke="#252B30" stroke-width="1.5" />
          <!-- 2D LiDAR Costmap Inflation -->
          <circle cx="390" cy="120" r="22" fill="rgba(0, 229, 255, 0.06)" stroke="#00E5FF" stroke-width="1" stroke-dasharray="3 3" />
          <!-- Robot Path -->
          <path class="anim-path" d="M 120 120 L 220 120 Q 280 120 280 160 T 360 170 Q 420 170 450 80 T 640 80" stroke="#00E5FF" stroke-width="2" stroke-dasharray="5 3" />
          <!-- AMR Footprint -->
          <rect x="110" y="112" width="20" height="16" rx="2" fill="#171C21" stroke="#00E5FF" stroke-width="1.5" />
          <text x="80" y="105" fill="#8B949E" font-family="'JetBrains Mono', monospace" font-size="10">AMR_LOCALIZED</text>
        </svg>
      )}

      {visualType === 'vision_bbox' && (
        <svg class="visual-svg" viewBox="0 0 800 240" fill="none" xmlns="http://www.w3.org/2000/svg">
          <!-- Camera Grid & Detected Targets -->
          <rect x="80" y="50" width="180" height="140" fill="rgba(255, 255, 255, 0.01)" stroke="#252B30" stroke-width="1" />
          <rect x="310" y="50" width="180" height="140" fill="rgba(255, 255, 255, 0.01)" stroke="#252B30" stroke-width="1" />
          <rect x="540" y="50" width="180" height="140" fill="rgba(255, 255, 255, 0.01)" stroke="#252B30" stroke-width="1" />
          <!-- YOLO Bounding Box 1 -->
          <rect x="130" y="80" width="80" height="90" fill="rgba(0, 229, 255, 0.05)" stroke="#00E5FF" stroke-width="1.5" />
          <text x="134" y="74" fill="#00E5FF" font-family="'JetBrains Mono', monospace" font-size="9">TARGET_01: 98.4%</text>
          <!-- YOLO Bounding Box 2 -->
          <rect x="360" y="90" width="90" height="85" fill="rgba(0, 229, 255, 0.05)" stroke="#00E5FF" stroke-width="1.5" />
          <text x="364" y="84" fill="#00E5FF" font-family="'JetBrains Mono', monospace" font-size="9">TARGET_02: 96.1%</text>
        </svg>
      )}

      {visualType === 'swarm_mesh' && (
        <svg class="visual-svg" viewBox="0 0 800 240" fill="none" xmlns="http://www.w3.org/2000/svg">
          <!-- Swarm Mesh Interconnections -->
          <line x1="180" y1="120" x2="320" y2="70" stroke="rgba(0, 229, 255, 0.3)" stroke-width="1.2" stroke-dasharray="4 4" />
          <line x1="320" y1="70" x2="480" y2="100" stroke="rgba(0, 229, 255, 0.3)" stroke-width="1.2" stroke-dasharray="4 4" />
          <line x1="480" y1="100" x2="620" y2="160" stroke="rgba(0, 229, 255, 0.3)" stroke-width="1.2" stroke-dasharray="4 4" />
          <line x1="180" y1="120" x2="360" y2="180" stroke="rgba(0, 229, 255, 0.3)" stroke-width="1.2" stroke-dasharray="4 4" />
          <line x1="360" y1="180" x2="620" y2="160" stroke="rgba(0, 229, 255, 0.3)" stroke-width="1.2" stroke-dasharray="4 4" />
          <!-- Swarm Nodes -->
          <circle cx="180" cy="120" r="8" fill="#171C21" stroke="#00E5FF" stroke-width="2" />
          <circle cx="320" cy="70" r="8" fill="#171C21" stroke="#00E5FF" stroke-width="2" />
          <circle cx="480" cy="100" r="8" fill="#171C21" stroke="#00E5FF" stroke-width="2" />
          <circle cx="620" cy="160" r="8" fill="#171C21" stroke="#00E5FF" stroke-width="2" />
          <circle cx="360" cy="180" r="8" fill="#171C21" stroke="#00E5FF" stroke-width="2" />
          <text x="290" y="55" fill="#8B949E" font-family="'JetBrains Mono', monospace" font-size="10">P2P_TCP_MESH [SELF-HEALING]</text>
        </svg>
      )}
    </div>
    <div class="visual-footer-tag mono">
      <span>INTERACTIVE TECHNICAL VISUALIZATION</span>
      <span class="text-cyan">SIMULATED SENSORY TELEMETRY</span>
    </div>
  </div>

  <!-- Deep Dive Content Columns -->
  <div class="case-details-grid">
    <div class="detail-col">
      <h4 class="detail-title mono">WHAT WAS BUILT</h4>
      <p class="detail-text">{built}</p>
    </div>

    <div class="detail-col">
      <h4 class="detail-title mono">HOW IT WORKS</h4>
      <p class="detail-text">{howItWorks}</p>
    </div>

    <div class="detail-col">
      <h4 class="detail-title mono">ENGINEERING CHALLENGES</h4>
      <p class="detail-text">{challenges}</p>
    </div>
  </div>

  <!-- Subsystem Pipeline Strip -->
  {pipeline && pipeline.length > 0 && (
    <div class="case-pipeline-strip">
      <span class="strip-label mono">SUBSYSTEM PIPELINE</span>
      <div class="pipeline-tags">
        {pipeline.map((step, idx) => (
          <div class="pipeline-step">
            <span class="step-box mono">{step}</span>
            {idx < pipeline.length - 1 && (
              <span class="step-arrow mono" aria-hidden="true">→</span>
            )}
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- Hardware / Software Separation & Verified Results -->
  <div class="case-meta-footer">
    <div class="stacks-col">
      <div class="stack-row">
        <span class="stack-label mono">HARDWARE</span>
        <div class="stack-pills">
          {hardware.map((item) => (
            <span class="stack-pill mono">{item}</span>
          ))}
        </div>
      </div>
      <div class="stack-row">
        <span class="stack-label mono">SOFTWARE</span>
        <div class="stack-pills">
          {software.map((item) => (
            <span class="stack-pill mono text-cyan-subtle">{item}</span>
          ))}
        </div>
      </div>
    </div>

    <div class="results-col">
      <span class="results-heading mono">VERIFIED RESULTS</span>
      <ul class="results-items">
        {results.map((res) => (
          <li class="res-item">
            <span class="res-bullet text-cyan">✓</span>
            <span class="res-text">{res}</span>
          </li>
        ))}
      </ul>
      {github && (
        <a href={github} target="_blank" rel="noopener noreferrer" class="case-repo-link mono">
          <span>View Source on GitHub ↗</span>
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .case-study-entry {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: clamp(2rem, 4vw, 3.5rem);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    transition: border-color var(--duration-fast) var(--ease-spring);
  }

  .case-study-entry:hover {
    border-color: var(--border-active);
  }

  /* Top Bar */
  .case-top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: var(--space-2);
  }

  .case-index-label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
  }

  .index-num {
    font-weight: 600;
  }

  .index-sep {
    color: var(--border);
  }

  .index-cat {
    color: var(--text-muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .case-badge {
    font-size: 0.6875rem;
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    padding: 3px 10px;
    border-radius: var(--radius-pill);
  }

  /* Title */
  .case-title-row {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .case-title {
    font-size: clamp(1.5rem, 2.5vw, 2.25rem);
    color: var(--text-primary);
    letter-spacing: -0.025em;
  }

  .case-role {
    font-size: var(--text-xs);
    color: var(--cyan);
  }

  .case-summary {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 880px;
  }

  /* Visualizer Preview Box */
  .case-visual-container {
    background: #080A0C;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    overflow: hidden;
    margin: var(--space-2) 0;
  }

  .visual-canvas-mock {
    width: 100%;
    height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .visual-svg {
    width: 100%;
    height: 100%;
  }

  .visual-footer-tag {
    display: flex;
    justify-content: space-between;
    padding: 6px 14px;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.625rem;
    color: var(--text-dim);
    letter-spacing: 0.06em;
  }

  /* Deep Dive Grid */
  .case-details-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    padding-top: var(--space-2);
  }

  .detail-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .detail-title {
    font-size: var(--text-2xs);
    color: var(--text-muted);
    letter-spacing: 0.08em;
  }

  .detail-text {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    line-height: 1.65;
  }

  /* Pipeline Strip */
  .case-pipeline-strip {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    background: rgba(255, 255, 255, 0.015);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    flex-wrap: wrap;
  }

  .strip-label {
    font-size: 0.625rem;
    color: var(--text-muted);
    letter-spacing: 0.08em;
  }

  .pipeline-tags {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .pipeline-step {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .step-box {
    font-size: 0.6875rem;
    color: var(--text-primary);
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 4px 8px;
    border-radius: var(--radius-xs);
  }

  .step-arrow {
    color: var(--text-dim);
    font-size: 0.6875rem;
  }

  /* Meta Footer */
  .case-meta-footer {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: var(--space-8);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-subtle);
  }

  .stacks-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .stack-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
  }

  .stack-label {
    font-size: 0.625rem;
    color: var(--text-muted);
    min-width: 90px;
    letter-spacing: 0.06em;
  }

  .stack-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .stack-pill {
    font-size: 0.6875rem;
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-subtle);
    padding: 3px 8px;
    border-radius: var(--radius-xs);
  }

  .stack-pill.text-cyan-subtle {
    color: #94E9F2;
    border-color: rgba(0, 229, 255, 0.18);
  }

  .results-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .results-heading {
    font-size: 0.625rem;
    color: var(--text-muted);
    letter-spacing: 0.08em;
  }

  .results-items {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .res-item {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-primary);
  }

  .res-bullet {
    font-size: 0.625rem;
  }

  .case-repo-link {
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    color: var(--cyan);
    display: inline-block;
    transition: color var(--duration-fast) var(--ease-spring);
  }

  .case-repo-link:hover {
    color: #FFFFFF;
  }

  @media (max-width: 900px) {
    .case-details-grid {
      grid-template-columns: 1fr;
    }
    .case-meta-footer {
      grid-template-columns: 1fr;
    }
    .stack-row {
      flex-direction: column;
      gap: var(--space-2);
    }
  }
</style>
