---
interface Props {
  missionId: string;
  codeName: string;
  title: string;
  role: string;
  status: string;
  badge?: string;
  description: string;
  problem: string;
  approach: string;
  pipeline: string[];
  hardware: string[];
  software: string[];
  results: string[];
  github?: string;
  demo?: string;
  featured?: boolean;
}

const {
  missionId,
  codeName,
  title,
  role,
  status,
  badge,
  description,
  problem,
  approach,
  pipeline,
  hardware,
  software,
  results,
  github,
  demo,
  featured = false,
} = Astro.props;
---

<article class:list={['mission-dossier', 'hud-card', { 'featured-mission': featured }]}>
  <!-- Mission Dossier Header -->
  <div class="mission-header">
    <div class="mission-identity">
      <span class="mono mission-id">MISSION // {missionId}</span>
      <span class="mission-sep">::</span>
      <span class="mono mission-codename">{codeName}</span>
    </div>

    <div class="mission-status-wrap">
      {badge && <span class="mission-badge mono">{badge}</span>}
      <span class="status-beacon">
        <span class="beacon-dot"></span>
        <span class="mono status-txt">{status}</span>
      </span>
    </div>
  </div>

  <!-- Mission Body -->
  <div class="mission-body">
    <div class="mission-title-area">
      <span class="mission-role mono">{role}</span>
      <h3 class="mission-title">{title}</h3>
      <p class="mission-overview">{description}</p>
    </div>

    <!-- Dataflow Pipeline Diagram -->
    {pipeline && pipeline.length > 0 && (
      <div class="mission-pipeline-box">
        <div class="pipeline-header">
          <span class="mono pipeline-label">SUBSYSTEM ARCHITECTURE & DATAFLOW</span>
        </div>
        <div class="pipeline-stages">
          {pipeline.map((stage, idx) => (
            <div class="stage-item">
              <span class="stage-pill mono">{stage}</span>
              {idx < pipeline.length - 1 && <span class="stage-arrow mono" aria-hidden="true">──►</span>}
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Engineering Deep Dive -->
    <div class="mission-specs-grid">
      <div class="spec-block">
        <span class="spec-label mono">[CHALLENGE & SPECIFICATION]</span>
        <p class="spec-text">{problem}</p>
      </div>

      <div class="spec-block">
        <span class="spec-label mono">[ENGINEERING EXECUTION]</span>
        <p class="spec-text">{approach}</p>
      </div>
    </div>

    <!-- Hardware & Software Subsystems -->
    <div class="mission-subsystems-row">
      <div class="subsystem-col">
        <span class="subsystem-label mono">HARDWARE ARCHITECTURE</span>
        <div class="tags-cluster">
          {hardware.map((h) => <span class="tech-tag">{h}</span>)}
        </div>
      </div>

      <div class="subsystem-col">
        <span class="subsystem-label mono">SOFTWARE & PROTOCOLS</span>
        <div class="tags-cluster">
          {software.map((s) => <span class="tech-tag" style="border-color: rgba(115, 169, 255, 0.25); color: #B4CEFF;">{s}</span>)}
        </div>
      </div>
    </div>

    <!-- Results & Milestones -->
    {results && results.length > 0 && (
      <div class="mission-results-bar">
        <span class="mono results-label">VERIFIED RESULTS:</span>
        <div class="results-tags">
          {results.map((res) => (
            <span class="result-tag mono">
              <span class="result-check">✓</span>
              {res}
            </span>
          ))}
        </div>
      </div>
    )}
  </div>

  <!-- Mission Footer Links -->
  <div class="mission-footer">
    <div class="mission-footer-left">
      <span class="mono mission-hash">INTEGRATION_STATUS: 100%_VERIFIED</span>
    </div>

    <div class="mission-links">
      {github && (
        <a href={github} target="_blank" rel="noopener noreferrer" class="btn-tactical btn-secondary-tactical mission-btn">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
          </svg>
          SOURCE REPO
        </a>
      )}
      {demo && (
        <a href={demo} target="_blank" rel="noopener noreferrer" class="btn-tactical btn-primary-tactical mission-btn">
          <span>DEMO VIDEO</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 17L17 7M17 7H7M17 7v10"/>
          </svg>
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .mission-dossier {
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .featured-mission {
    grid-column: 1 / -1;
    background: var(--bg-elevated);
    border-color: var(--border-bright);
  }

  /* Header */
  .mission-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .mission-identity {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .mission-id {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.08em;
  }

  .mission-sep {
    color: var(--text-muted);
  }

  .mission-codename {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    letter-spacing: 0.04em;
  }

  .mission-status-wrap {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .mission-badge {
    font-size: 0.625rem;
    color: var(--accent-blue);
    background: var(--accent-blue-dim);
    border: 1px solid rgba(115, 169, 255, 0.3);
    padding: 2px 8px;
    border-radius: var(--radius-xs);
    letter-spacing: 0.04em;
  }

  .status-txt {
    font-size: var(--text-2xs);
    letter-spacing: 0.06em;
  }

  /* Body */
  .mission-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .mission-title-area {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .mission-role {
    font-size: var(--text-xs);
    color: var(--text-muted);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .mission-title {
    font-size: var(--text-2xl);
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .featured-mission .mission-title {
    font-size: clamp(1.75rem, 3.2vw, 2.35rem);
  }

  .mission-overview {
    font-size: var(--text-md);
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 860px;
  }

  /* Subsystem Architecture Pipeline */
  .mission-pipeline-box {
    background: rgba(10, 13, 12, 0.8);
    border: 1px solid var(--border);
    border-radius: var(--radius-xs);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .pipeline-header {
    display: flex;
    align-items: center;
  }

  .pipeline-label {
    font-size: 0.625rem;
    color: var(--text-muted);
    letter-spacing: 0.08em;
  }

  .pipeline-stages {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .stage-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .stage-pill {
    font-size: 0.6875rem;
    color: var(--accent);
    background: var(--accent-dim);
    border: 1px solid var(--border);
    padding: 3px 8px;
    border-radius: var(--radius-xs);
    white-space: nowrap;
  }

  .stage-arrow {
    font-size: 0.6875rem;
    color: var(--text-muted);
    opacity: 0.5;
  }

  /* Specifications */
  .mission-specs-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }

  .spec-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .spec-label {
    font-size: var(--text-2xs);
    color: var(--accent);
    letter-spacing: 0.08em;
  }

  .spec-text {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.65;
  }

  /* Subsystem Hardware & Software Columns */
  .mission-subsystems-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
  }

  .subsystem-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .subsystem-label {
    font-size: 0.625rem;
    color: var(--text-muted);
    letter-spacing: 0.08em;
  }

  .tags-cluster {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  /* Results Bar */
  .mission-results-bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: rgba(123, 224, 178, 0.04);
    border: 1px solid var(--border);
    border-radius: var(--radius-xs);
    flex-wrap: wrap;
  }

  .results-label {
    font-size: var(--text-2xs);
    color: var(--accent);
    font-weight: 700;
  }

  .results-tags {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .result-tag {
    font-size: var(--text-xs);
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .result-check {
    color: var(--accent);
    font-weight: 700;
  }

  /* Footer */
  .mission-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .mission-hash {
    font-size: 0.625rem;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }

  .mission-links {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .mission-btn {
    padding: 6px 14px;
    font-size: var(--text-2xs);
  }

  @media (max-width: 860px) {
    .mission-specs-grid,
    .mission-subsystems-row {
      grid-template-columns: 1fr;
    }

    .mission-dossier {
      padding: var(--space-5);
    }
  }
</style>
