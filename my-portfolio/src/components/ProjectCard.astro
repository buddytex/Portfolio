---
// ProjectCard — Editorial Case Study Layout
// Large composition, not a uniform grid card

export interface ProjectData {
  index: string;
  title: string;
  subtitle: string;
  role: string;
  year: string;
  summary: string;
  challenge: string;
  approach: string;
  stack: string[];
  hw: string[];
  outcomes: string[];
  repoUrl?: string;
  status?: string;
}

type Props = ProjectData;

const {
  index,
  title,
  subtitle,
  role,
  year,
  summary,
  challenge,
  approach,
  stack,
  hw,
  outcomes,
  repoUrl,
  status = 'DEPLOYED',
} = Astro.props;
---

<article class="case reveal" id={`project-${index}`}>
  <!-- Index + meta bar -->
  <header class="case-head">
    <div class="case-id mono">{index}</div>
    <div class="case-meta-row">
      <span class="case-status tag">{status}</span>
      <span class="case-year mono">{year}</span>
      <span class="case-role mono">{role}</span>
    </div>
  </header>

  <!-- Title block — editorial large -->
  <div class="case-title-block">
    <h3 class="case-title">{title}</h3>
    <p class="case-subtitle">{subtitle}</p>
  </div>

  <!-- Summary -->
  <p class="case-summary">{summary}</p>

  <!-- Two-column detail: Challenge + Approach -->
  <div class="case-detail-grid">
    <div class="case-col">
      <div class="col-label mono">THE CHALLENGE</div>
      <p class="col-text">{challenge}</p>
    </div>
    <div class="case-col">
      <div class="col-label mono">THE APPROACH</div>
      <p class="col-text">{approach}</p>
    </div>
  </div>

  <!-- Stack + Hardware + Outcomes -->
  <div class="case-bottom">
    <div class="case-tech-block">
      <div class="tech-row">
        <span class="tech-label mono">SOFTWARE</span>
        <div class="tech-tags">
          {stack.map((s) => <span class="tag">{s}</span>)}
        </div>
      </div>
      {hw.length > 0 && (
        <div class="tech-row">
          <span class="tech-label mono">HARDWARE</span>
          <div class="tech-tags">
            {hw.map((h) => <span class="tag">{h}</span>)}
          </div>
        </div>
      )}
    </div>

    <div class="case-outcomes">
      <div class="col-label mono">OUTCOMES</div>
      <ul class="outcomes-list">
        {outcomes.map((o) => (
          <li class="outcome-item">
            <span class="outcome-tick">→</span>
            <span>{o}</span>
          </li>
        ))}
      </ul>
      {repoUrl && (
        <a href={repoUrl} target="_blank" rel="noopener noreferrer" class="repo-link mono">
          View Repository ↗
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .case {
    padding: clamp(2.5rem, 5vw, 4rem) 0;
    border-bottom: 1px solid var(--border-subtle);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  /* Head */
  .case-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-6);
    justify-content: space-between;
    flex-wrap: wrap;
  }

  .case-id {
    font-size: var(--text-2xs);
    color: var(--text-dim);
    letter-spacing: 0.06em;
    font-weight: 600;
  }

  .case-meta-row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .case-status { font-size: var(--text-2xs); }

  .case-year, .case-role {
    font-size: var(--text-2xs);
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }

  /* Title */
  .case-title-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .case-title {
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--text-primary);
  }

  .case-subtitle {
    font-size: var(--text-base);
    color: var(--text-muted);
    font-weight: 400;
    line-height: 1.4;
  }

  /* Summary */
  .case-summary {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 740px;
  }

  /* Two-col detail */
  .case-detail-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--space-8);
  }

  .case-col { display: flex; flex-direction: column; gap: var(--space-3); }

  .col-label {
    font-size: var(--text-2xs);
    color: var(--text-muted);
    letter-spacing: 0.1em;
    font-weight: 600;
  }

  .col-text {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.65;
  }

  /* Bottom strip */
  .case-bottom {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-8);
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--space-8);
  }

  .case-tech-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .tech-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .tech-label {
    font-size: var(--text-2xs);
    color: var(--text-muted);
    letter-spacing: 0.1em;
    font-weight: 600;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  /* Outcomes */
  .case-outcomes {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .outcomes-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .outcome-item {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .outcome-tick {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--cyan-dark);
    flex-shrink: 0;
  }

  .repo-link {
    font-size: var(--text-xs);
    color: var(--cyan-dark);
    letter-spacing: 0.02em;
    transition: color var(--dur-fast) var(--ease-out);
    margin-top: var(--space-2);
    display: inline-block;
  }

  .repo-link:hover { color: var(--text-primary); }

  @media (max-width: 900px) {
    .case-detail-grid { grid-template-columns: 1fr; }
    .case-bottom { grid-template-columns: 1fr; }
  }

  @media (max-width: 640px) {
    .case-head { flex-direction: column; gap: var(--space-3); }
  }
</style>
