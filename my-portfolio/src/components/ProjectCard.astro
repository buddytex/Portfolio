---
interface Props {
  number: string;
  title: string;
  subtitle?: string;
  description: string;
  problem?: string;
  approach?: string;
  technologies: string[];
  hardware?: string[];
  software?: string[];
  github?: string;
  demo?: string;
  featured?: boolean;
}

const {
  number,
  title,
  subtitle,
  description,
  problem,
  approach,
  technologies,
  hardware,
  software,
  github,
  demo,
  featured = false,
} = Astro.props;
---

<article class:list={['project-card', { 'project-featured': featured }]}>
  <div class="project-card-header">
    <span class="project-number mono">{number}</span>
    {featured && <span class="project-badge label">Featured</span>}
  </div>

  <div class="project-card-body">
    <h3 class="project-title">
      {title}
      {subtitle && <span class="project-subtitle">{subtitle}</span>}
    </h3>

    <p class="project-description">{description}</p>

    {problem && (
      <div class="project-detail">
        <span class="project-detail-label mono">Problem</span>
        <p class="project-detail-text">{problem}</p>
      </div>
    )}

    {approach && (
      <div class="project-detail">
        <span class="project-detail-label mono">Approach</span>
        <p class="project-detail-text">{approach}</p>
      </div>
    )}

    {hardware && hardware.length > 0 && (
      <div class="project-detail">
        <span class="project-detail-label mono">Hardware</span>
        <div class="project-tags">
          {hardware.map((h) => <span class="tag">{h}</span>)}
        </div>
      </div>
    )}

    {software && software.length > 0 && (
      <div class="project-detail">
        <span class="project-detail-label mono">Software</span>
        <div class="project-tags">
          {software.map((s) => <span class="tag">{s}</span>)}
        </div>
      </div>
    )}
  </div>

  <div class="project-card-footer">
    <div class="project-tech-strip">
      {technologies.map((tech) => (
        <span class="project-tech">{tech}</span>
      ))}
    </div>

    <div class="project-links">
      {github && (
        <a href={github} target="_blank" rel="noopener noreferrer" class="project-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
          </svg>
          Source
        </a>
      )}
      {demo && (
        <a href={demo} target="_blank" rel="noopener noreferrer" class="project-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/>
          </svg>
          Demo
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .project-card {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    transition:
      border-color var(--duration-normal) var(--ease-out),
      transform var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out);
    position: relative;
    overflow: hidden;
  }

  .project-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    opacity: 0;
    transition: opacity var(--duration-normal) var(--ease-out);
  }

  .project-card:hover {
    border-color: var(--border-accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(0, 212, 255, 0.04);
  }

  .project-card:hover::before {
    opacity: 1;
  }

  .project-featured {
    grid-column: 1 / -1;
    background: var(--bg-elevated);
    border-color: var(--border-light);
  }

  .project-featured .project-card-body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6) var(--space-10);
  }

  .project-featured .project-title {
    grid-column: 1 / -1;
    font-size: var(--text-2xl);
  }

  .project-featured .project-description {
    grid-column: 1;
  }

  /* Header */
  .project-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .project-number {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .project-badge {
    font-size: 0.625rem;
    padding: 2px 8px;
    background: var(--accent-dim);
    border-radius: var(--radius-sm);
    color: var(--accent);
  }

  /* Body */
  .project-card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    flex: 1;
  }

  .project-title {
    font-size: var(--text-xl);
    color: var(--text);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .project-subtitle {
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--text-secondary);
  }

  .project-description {
    font-size: var(--text-base);
    line-height: 1.7;
  }

  .project-detail {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .project-detail-label {
    font-size: 0.625rem;
    color: var(--accent);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .project-detail-text {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* Footer */
  .project-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
    flex-wrap: wrap;
  }

  .project-tech-strip {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }

  .project-tech {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-muted);
  }

  .project-links {
    display: flex;
    gap: var(--space-4);
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--accent);
    transition: opacity var(--duration-fast);
  }

  .project-link:hover {
    opacity: 0.8;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .project-card {
      padding: var(--space-6);
    }

    .project-featured .project-card-body {
      grid-template-columns: 1fr;
    }

    .project-featured .project-title {
      font-size: var(--text-xl);
    }
  }
</style>
