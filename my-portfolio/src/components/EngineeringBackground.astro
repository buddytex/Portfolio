---
// EngineeringBackground Component — Engineering Background + Chronology
// Appears immediately after Hero. Fits ~1 desktop viewport.
import EngineeringTimeline from './EngineeringTimeline.astro';
---

<section id="background" class="section background-section" aria-labelledby="backgroundTitle">
  <div class="container-wide">
    <!-- Section Header -->
    <header class="section-header">
      <span class="header-kicker mono">[ 02 // ENGINEERING BACKGROUND ]</span>
      <h2 id="backgroundTitle" class="section-title">Engineering <span class="accent">Background</span></h2>
    </header>

    <div class="background-grid">
      <!-- Left Column: Journey & Philosophy -->
      <div class="background-left">
        <!-- Journey & Origin -->
        <article class="bio-card">
          <span class="card-kicker mono">Journey & Origin</span>
          <h3 class="bio-heading">Hooked on building robotics from a very young age</h3>
          
          <div class="bio-text">
            <p>
              My obsession with robotics started young. As a kid, I was crazily excited whenever a science fair or school exhibition came around, spending weeks tinkering with motors, battery clips, and scrap mechanisms. In 7th grade, I took that passion to a state-level competition by designing, building, and dressing up in a full robot costume handcrafted out of cardboard boxes.
            </p>
            <p>
              That early spark evolved into serious, deep engineering during college. Early breadboard hobby circuits and Arduino experiments progressed into custom multi-layer automotive ECUs, autonomous mobile robots (AMRs), LiDAR SLAM pipelines, and leading the Electrical and Electronics division of <em>Team Equinox</em> in BAJA SAE India to national top ranks (AIR 7 & AIR 11), while teaching and guiding junior members.
            </p>
            <p>
              Whether it's routing deterministic CAN bus networks, calibrating Nav2 dynamic costmaps, or building fail-safe hardware interlocks, I love bridging physical hardware with intelligent software to create machines that operate dependably in the real world.
            </p>
          </div>

          <!-- Academic Foundation Block -->
          <div class="education-block">
            <span class="edu-badge mono">Academic Foundation</span>
            <div class="edu-content">
              <h4 class="edu-degree">B.Tech in Robotics & Automation Engineering</h4>
              <span class="edu-institution">Saintgits College of Engineering · Autonomous Institution</span>
              <span class="edu-focus mono">Focus: Autonomous Navigation, Computer Vision, Embedded Controllers</span>
            </div>
          </div>

          <!-- CV Action -->
          <div class="bio-action">
            <a href="/CV_1.pdf" class="btn btn-primary" download>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/>
              </svg>
              <span>Download Curriculum Vitae (PDF)</span>
            </a>
          </div>
        </article>
      </div>

      <!-- Right Column: Engineering Chronology -->
      <div class="background-right">
        <EngineeringTimeline />
      </div>
    </div>
  </div>
</section>

<style>
  .background-section {
    padding: var(--section-pad) 0;
    background: transparent;
    border-top: 1px solid var(--border-subtle);
  }

  .header-kicker {
    font-size: var(--text-2xs);
    color: var(--color-muted);
    font-weight: 700;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-2);
  }

  /* Two-column grid: Left (Journey + Philosophy), Right (Timeline) */
  .background-grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: var(--space-8);
    align-items: start;
  }

  /* Left Column */
  .background-left {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .bio-card,
  .philosophy-card {
    background: var(--surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--r-card);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    box-shadow: var(--shadow-resting);
  }

  .card-kicker {
    font-size: var(--text-2xs);
    letter-spacing: 0.06em;
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
  }

  .bio-heading,
  .philosophy-heading {
    font-size: var(--text-lg);
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    font-weight: 800;
  }

  .bio-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .bio-text p {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
  }

  .bio-text em {
    font-style: normal;
    color: var(--text-primary);
    font-weight: 600;
  }

  /* Education */
  .education-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-3);
    background: rgba(20, 24, 34, 0.02);
    border: 1px solid var(--border-subtle);
    border-radius: var(--r-md);
  }

  .edu-badge {
    font-size: var(--text-2xs);
    color: var(--text-muted);
    letter-spacing: 0.06em;
    font-weight: 600;
    text-transform: uppercase;
  }

  .edu-content {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .edu-degree {
    font-size: var(--text-sm);
    color: var(--text-primary);
    font-weight: 700;
  }

  .edu-institution {
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  .edu-focus {
    font-size: var(--text-2xs);
    color: var(--text-muted);
    margin-top: var(--space-1);
  }

  .bio-action {
    padding-top: var(--space-1);
  }

  /* Philosophy Card */
  .philosophy-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .philosophy-text p {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
  }

  /* Right Column - Timeline */
  .background-right {
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 1024px) {
    .background-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
      height: auto;
    }

    .background-right {
      position: static;
      max-height: none;
      overflow-y: visible;
    }
  }

  @media (max-width: 768px) {
    .background-section {
      min-height: auto;
    }

    .background-section .section-header {
      position: static;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      border-bottom: none;
      padding-bottom: var(--space-2);
    }

    .bio-card,
    .philosophy-card {
      padding: var(--space-4);
    }

    .bio-heading,
    .philosophy-heading {
      font-size: var(--text-lg);
    }
  }
</style>