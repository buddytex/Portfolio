---
// Hero — Editorial Art-Directed Composition
// Massive Typography + 1:1 Video Placeholder Frame + Site-Wide Spatial Perception Field
---

<section class="hero" id="hero">
  <!-- Subtle editorial floating tags framing the composition -->
  <div class="hero-tag ht-1 mono" aria-hidden="true">ROS 2 HUMBLE</div>
  <div class="hero-tag ht-2 mono" aria-hidden="true">3D LiDAR PERCEPTION</div>
  <div class="hero-tag ht-3 mono" aria-hidden="true">CUSTOM VEHICLE ECUs</div>
  <div class="hero-tag ht-4 mono" aria-hidden="true">AIR 7 · AIR 11 BAJA</div>

  <div class="container hero-container">
    <!-- Left Column: Huge Typographic Statement -->
    <div class="hero-left">
      <div class="hero-eyebrow mono hero-anim" style="--d:0ms">
        ROBOTICS & AUTONOMOUS SYSTEMS ENGINEER
      </div>

      <h1 class="hero-name hero-anim" style="--d:80ms">
        NAVEEN<br/>
        SHAJI<br/>
        <span class="hero-george">GEORGE</span>
      </h1>

      <div class="hero-body hero-anim" style="--d:160ms">
        <p class="hero-statement">
          I build intelligent robotic systems that <em>perceive</em>, <em>reason</em>, and <em>act</em> in the physical world.
        </p>

        <div class="hero-context mono">
          <span class="context-tag">AIR 7 & AIR 11</span>
          <span class="context-text">BAJA SAE India National Campaign · Electrical & Autonomy Lead</span>
        </div>

        <div class="hero-actions">
          <a href="#work" class="btn btn-primary">
            <span>Explore Selected Work</span>
            <span class="btn-arrow" aria-hidden="true">↓</span>
          </a>
          <a href="#skills" class="btn btn-secondary">
            <span>Skills & Evidence</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Right Column: 1:1 Video Placeholder Frame -->
    <div class="hero-right hero-anim" style="--d:220ms">
      <div class="video-container" id="introVideoContainer">
        <!-- Top bar -->
        <div class="video-bar-top mono">
          <span class="video-bar-title">INTRODUCTION VIDEO</span>
          <span class="video-bar-ratio">1:1</span>
        </div>

        <!-- 1:1 Media Box -->
        <div class="video-aspect-box">
          <!-- Video element: auto-plays if user drops /video/introduction.mp4 into public/video/ -->
          <video
            id="introVideo"
            src="/video/introduction.mp4"
            playsinline
            muted
            loop
            preload="metadata"
            class="video-player"
          ></video>

          <!-- Elegant Architectural Standby Placeholder -->
          <div class="video-standby-view" id="videoStandby">
            <!-- Delicate geometric alignment marks -->
            <span class="align-mark top-left" aria-hidden="true">+</span>
            <span class="align-mark top-right" aria-hidden="true">+</span>
            <span class="align-mark bottom-left" aria-hidden="true">+</span>
            <span class="align-mark bottom-right" aria-hidden="true">+</span>

            <div class="standby-middle">
              <div class="play-button-glyph">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <polygon points="6 3 20 12 6 21 6 3"/>
                </svg>
              </div>
              <div class="standby-heading mono">INTRODUCTION VIDEO</div>
              <p class="standby-sub">Engineering overview, laboratory walkthrough, and physical vehicle trials</p>
            </div>

            <!-- Path indication -->
            <div class="standby-foot mono">
              <span class="foot-label">SOURCE:</span>
              <span class="foot-path">/public/video/introduction.mp4</span>
            </div>
          </div>
        </div>

        <!-- Bottom bar -->
        <div class="video-bar-bottom mono">
          <span class="video-format">1:1 ASPECT RATIO</span>
          <span class="video-ready text-cyan">AWAITING SOURCE MEDIA</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Automatic video detection script:
  // If the user places /public/video/introduction.mp4, it seamlessly reveals and plays.
  const videoEl = document.getElementById('introVideo') as HTMLVideoElement;
  const standbyEl = document.getElementById('videoStandby');

  if (videoEl && standbyEl) {
    videoEl.addEventListener('loadeddata', () => {
      standbyEl.style.display = 'none';
      videoEl.style.display = 'block';
      videoEl.play().catch(() => {});
    });

    videoEl.addEventListener('error', () => {
      // Graceful fallback to architectural placeholder
      standbyEl.style.display = 'flex';
      videoEl.style.display = 'none';
    });
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: calc(96vh - var(--nav-height));
    display: flex;
    align-items: center;
    padding: clamp(4rem, 10vh, 7.5rem) 0;
    overflow: hidden;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.18fr 0.82fr;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
    position: relative;
    z-index: 2;
  }

  /* === LEFT COLUMN: HUGE NAME & TYPOGRAPHY === */
  .hero-left {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .hero-eyebrow {
    font-size: var(--text-2xs);
    color: var(--text-muted);
    letter-spacing: 0.14em;
    font-weight: 700;
  }

  .hero-name {
    font-size: clamp(3.8rem, 8.8vw, 7.8rem);
    font-weight: 900;
    letter-spacing: -0.05em;
    line-height: 0.9;
    color: var(--text-primary);
    text-transform: uppercase;
  }

  .hero-george {
    font-weight: 300;
    font-style: italic;
    color: var(--text-secondary);
  }

  .hero-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-width: 580px;
    margin-top: var(--space-2);
  }

  .hero-statement {
    font-size: clamp(1.15rem, 1.8vw, 1.4rem);
    color: var(--text-secondary);
    line-height: 1.55;
    font-weight: 400;
  }

  .hero-statement em {
    color: var(--text-primary);
    font-style: normal;
    font-weight: 700;
  }

  .hero-context {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .context-tag {
    display: inline-flex;
    font-weight: 700;
    color: var(--cyan-dark);
    background: var(--cyan-light);
    border: 1px solid rgba(14, 165, 233, 0.28);
    padding: 3px 9px;
    border-radius: var(--r-pill);
    letter-spacing: 0.04em;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-2);
  }

  .btn-arrow {
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .btn-primary:hover .btn-arrow {
    transform: translateY(2px);
  }

  /* === RIGHT COLUMN: 1:1 VIDEO PLACEHOLDER FRAME === */
  .hero-right {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .video-container {
    width: 100%;
    max-width: 440px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.03);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform var(--dur-norm) var(--ease-out),
                border-color var(--dur-norm) var(--ease-out),
                box-shadow var(--dur-norm) var(--ease-out);
  }

  .video-container:hover {
    transform: translateY(-3px);
    border-color: var(--border-strong);
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.06);
  }

  .video-bar-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 18px;
    background: var(--surface-dim);
    border-bottom: 1px solid var(--border-subtle);
    font-size: var(--text-2xs);
  }

  .video-bar-title {
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-primary);
  }

  .video-bar-ratio {
    color: var(--text-muted);
    font-weight: 600;
  }

  .video-aspect-box {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    background: #FAF9F6;
    overflow: hidden;
  }

  .video-player {
    display: none;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video-standby-view {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-8);
    background: radial-gradient(circle at center, #FFFFFF 0%, #F5F4F0 100%);
    text-align: center;
  }

  .align-mark {
    position: absolute;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--border-strong);
    line-height: 1;
    user-select: none;
  }
  .align-mark.top-left { top: 12px; left: 14px; }
  .align-mark.top-right { top: 12px; right: 14px; }
  .align-mark.bottom-left { bottom: 12px; left: 14px; }
  .align-mark.bottom-right { bottom: 12px; right: 14px; }

  .standby-middle {
    margin: auto 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .play-button-glyph {
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: var(--surface);
    border: 1.5px solid var(--border-strong);
    color: var(--text-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
    transition: transform var(--dur-norm) var(--ease-out),
                border-color var(--dur-norm) var(--ease-out),
                color var(--dur-norm) var(--ease-out);
  }

  .video-container:hover .play-button-glyph {
    transform: scale(1.08);
    border-color: var(--cyan);
    color: var(--cyan-dark);
  }

  .standby-heading {
    font-size: var(--text-xs);
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: 0.08em;
  }

  .standby-sub {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    max-width: 250px;
    line-height: 1.5;
  }

  .standby-foot {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.625rem;
    color: var(--text-muted);
    background: var(--surface);
    border: 1px solid var(--border-subtle);
    padding: 4px 10px;
    border-radius: var(--r-sm);
  }

  .foot-label {
    color: var(--cyan-dark);
    font-weight: 700;
  }

  .video-bar-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 18px;
    background: var(--surface-dim);
    border-top: 1px solid var(--border-subtle);
    font-size: var(--text-2xs);
  }

  .video-format {
    color: var(--text-muted);
    font-weight: 600;
  }

  .video-ready {
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  /* === SUBTLE EDITORIAL FLOATING TAGS === */
  .hero-tag {
    position: absolute;
    font-size: var(--text-2xs);
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid var(--border);
    padding: 4px 10px;
    border-radius: var(--r-sm);
    letter-spacing: 0.06em;
    pointer-events: none;
    z-index: 1;
    backdrop-filter: blur(4px);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02);
  }

  .ht-1 { top: 8%; right: 14%; }
  .ht-2 { top: 20%; right: 4%; }
  .ht-3 { bottom: 12%; right: 18%; }
  .ht-4 { top: 10%; left: 4%; }

  /* Entrance animations */
  .hero-anim {
    animation: fadeUp 0.85s var(--ease-out) both;
    animation-delay: var(--d, 0ms);
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(22px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 1024px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }
    .hero-right {
      order: 2;
    }
    .hero-tag {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .video-container {
      max-width: 100%;
    }
    .hero-name {
      font-size: clamp(3.2rem, 14vw, 4.5rem);
    }
  }
</style>
