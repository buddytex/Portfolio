---
// Hero Component — Monumental Dark Maximalist Engineering Centerpiece
// Naveen Shaji George · Robotics & Autonomous Systems Engineer
// Enormous typography, large portrait, integrated circuit field, sophisticated spatial composition
---

<section class="hero" id="hero" aria-labelledby="heroName">
  <div class="hero-canvas" id="heroCanvas" aria-hidden="true">
    <!-- Circuit field will be injected here by EngineeringSignalField -->
    <div id="heroCircuitField" class="hero-circuit-field"></div>
  </div>

  <div class="container hero-container">
    <!-- Left Column: Monumental Editorial Statement -->
    <div class="hero-left" id="heroLeft">
      <div class="hero-eyebrow hero-orchestrated" id="heroEyebrow">
        <span class="eyebrow-pip" aria-hidden="true"></span>
        <span>Robotics & Autonomous Systems Engineer</span>
      </div>

      <h1 id="heroName" class="hero-name" aria-label="Naveen Shaji George">
        <span class="hero-name-line hero-orchestrated">NAVEEN</span>
        <span class="hero-name-line hero-orchestrated">SHAJI</span>
        <span class="hero-name-line hero-orchestrated">GEORGE</span>
      </h1>

      <div class="hero-disciplines hero-orchestrated" id="heroDisciplines">
        <span class="discipline-item mono">Autonomous Systems</span>
        <span class="discipline-sep" aria-hidden="true">·</span>
        <span class="discipline-item mono">Robotics</span>
        <span class="discipline-sep" aria-hidden="true">·</span>
        <span class="discipline-item mono">Embedded Systems</span>
        <span class="discipline-sep" aria-hidden="true">·</span>
        <span class="discipline-item mono">Perception</span>
        <span class="discipline-sep" aria-hidden="true">·</span>
        <span class="discipline-item mono">Hardware</span>
      </div>

      <div class="hero-statement-wrap hero-orchestrated" id="heroStatement">
        <p class="hero-statement">
          I build autonomous machines that <em>perceive</em>, <em>reason</em>, and <em>act</em> in the physical world —
          bridging custom automotive ECUs and isolated CAN networks with ROS&nbsp;2 Humble, Nav2, and 3D&nbsp;LiDAR perception.
        </p>
      </div>

      <!-- Direct CTAs -->
      <div class="hero-actions hero-orchestrated" id="heroActions">
        <a href="#work" class="btn btn-primary">
          <span>Explore Projects</span>
          <span class="btn-arrow" aria-hidden="true">↓</span>
        </a>
        <a href="#skills" class="btn btn-secondary">
          <span>Inspect Engineering Evidence</span>
          <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <!-- Right Column: Integrated Engineering Portrait Composition -->
    <div class="hero-right hero-orchestrated" id="heroPortrait">
      <div class="portrait-composition" id="portraitComposition">
        <!-- Atmospheric depth separation -->
        <div class="portrait-atmosphere" aria-hidden="true"></div>
        
        <!-- Subtle circuit halo behind figure -->
        <div class="portrait-circuit-halo" aria-hidden="true">
          <svg class="portrait-circuit-svg" viewBox="0 0 600 650" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- Major trace layer - routes around portrait -->
            <g class="trace-major" stroke-linecap="round" stroke-linejoin="round">
              <path d="M40 200 L140 200 L180 250 L280 250" />
              <path d="M560 260 L440 260 L400 310 L300 310" />
              <path d="M300 330 L300 450 L240 480 L160 480" />
              <path d="M500 400 L380 400 L340 460 L240 460" />
              <path d="M300 150 L300 80" />
              <path d="M300 580 L300 650" />
            </g>
            
            <!-- Secondary trace layer - denser supporting geometry -->
            <g class="trace-secondary" stroke-linecap="round" stroke-linejoin="round" opacity="0.6">
              <path d="M80 300 L160 300 L200 350 L260 350" />
              <path d="M520 350 L420 350 L380 400 L320 400" />
              <path d="M200 180 L200 120" />
              <path d="M400 180 L400 120" />
              <path d="M150 500 L150 550" />
              <path d="M450 500 L450 550" />
            </g>

            <!-- Micro geometry layer - nodes, junctions, geometric markers -->
            <g class="trace-micro" fill="none" stroke-linecap="round">
              <circle cx="140" cy="200" r="2" />
              <circle cx="440" cy="260" r="2" />
              <circle cx="300" cy="330" r="1.5" />
              <circle cx="240" cy="480" r="1.5" />
              <circle cx="380" cy="400" r="1.5" />
              <circle cx="160" cy="350" r="1" />
              <circle cx="380" cy="350" r="1" />
              <circle cx="200" cy="460" r="1" />
              <circle cx="300" cy="150" r="1.5" />
              <circle cx="300" cy="580" r="1.5" />
              <rect x="298" y="250" width="4" height="4" rx="1" />
              <rect x="298" y="400" width="4" height="4" rx="1" />
            </g>
          </svg>
        </div>

        <!-- Transparent Cutout Engineering Portrait -->
        <div class="portrait-cutout-wrap" id="portraitCutoutWrap">
          <img
            src="/images/naveen-portrait.png"
            alt="Naveen Shaji George — Robotics & Autonomous Systems Engineer"
            class="portrait-cutout-img"
            id="heroPortraitImg"
            width="720"
            height="780"
            loading="eager"
            decoding="async"
          />
        </div>

        <!-- Subtle architectural registration marks (editorial) -->
        <div class="reg-mark reg-tl mono" aria-hidden="true">+</div>
        <div class="reg-mark reg-tr mono" aria-hidden="true">+</div>
        <div class="reg-mark reg-bl mono" aria-hidden="true">+</div>
        <div class="reg-mark reg-br mono" aria-hidden="true">+</div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="hero-scroll-indicator" aria-hidden="true">
    <svg width="24" height="40" viewBox="0 0 24 40" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="11" y="0" width="2" height="40" rx="1" fill="currentColor" opacity="0.15"/>
      <circle cx="12" cy="10" r="3" fill="currentColor" opacity="0.4">
        <animate attributeName="cy" values="10;30;10" dur="2s" repeatCount="indefinite" calcMode="spline" keySplines="0.4 0 0.6 1"/>
        <animate attributeName="opacity" values="0.4;0;0.4" dur="2s" repeatCount="indefinite" calcMode="spline" keySplines="0.4 0 0.6 1"/>
      </circle>
    </svg>
  </div>
</section>

<script>
  import { initHeroEntrance } from '../lib/motion';
  import { initPortraitMotion } from '../lib/animations/portraitMotion';
  import { initHeroCircuitField } from '../lib/animations/heroCircuitField';
  import { animateTyping, isReducedMotion } from '../lib/motion';

  async function setupHero() {
    const heroSection = document.getElementById('hero');
    const circuitContainer = document.getElementById('heroCircuitField');
    const statementEl = document.querySelector<HTMLElement>('.hero-statement');
    
    let circuitController: { setCursorPosition: (x: number, y: number, active: boolean) => void } | null = null;

    if (heroSection) {
      initHeroEntrance(heroSection);
      initPortraitMotion(heroSection);
    }
    
    if (circuitContainer) {
      circuitController = await initHeroCircuitField(circuitContainer);
    }

    // Typing animation for hero statement
    if (statementEl && !isReducedMotion()) {
      const originalText = statementEl.textContent || '';
      await animateTyping(statementEl, originalText, {
        duration: 1200,
        delay: 800,
        ease: 'outExpo',
      });
    }

    // Cursor interaction with hero circuit field
    if (circuitController && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let rafId: number | null = null;
      let lastX = 0.5;
      let lastY = 0.5;
      let targetX = 0.5;
      let targetY = 0.5;
      let isOverHero = false;

      function updateCursor() {
        if (!circuitController) return;
        // Smooth interpolation
        lastX += (targetX - lastX) * 0.1;
        lastY += (targetY - lastY) * 0.1;
        circuitController.setCursorPosition(lastX, lastY, isOverHero);
        rafId = requestAnimationFrame(updateCursor);
      }

      heroSection?.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = heroSection.getBoundingClientRect();
        targetX = (e.clientX - rect.left) / rect.width;
        targetY = (e.clientY - rect.top) / rect.height;
        isOverHero = true;
      });

      heroSection?.addEventListener('mouseenter', () => {
        isOverHero = true;
        if (!rafId) rafId = requestAnimationFrame(updateCursor);
      });

      heroSection?.addEventListener('mouseleave', () => {
        isOverHero = false;
        targetX = 0.5;
        targetY = 0.5;
      });

      // Touch support
      heroSection?.addEventListener('touchmove', (e: TouchEvent) => {
        const touch = e.touches[0];
        const rect = heroSection.getBoundingClientRect();
        targetX = (touch.clientX - rect.left) / rect.width;
        targetY = (touch.clientY - rect.top) / rect.height;
        isOverHero = true;
      }, { passive: true });

      heroSection?.addEventListener('touchstart', () => {
        isOverHero = true;
        if (!rafId) rafId = requestAnimationFrame(updateCursor);
      }, { passive: true });

      heroSection?.addEventListener('touchend', () => {
        isOverHero = false;
        targetX = 0.5;
        targetY = 0.5;
      }, { passive: true });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupHero);
  } else {
    setupHero();
  }
</script>

<style>
  /* ================================================
     HERO LAYOUT — Monumental Dark Maximalist
     ================================================ */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: clamp(4rem, 10vh, 7rem) 0 clamp(3rem, 6vh, 5rem);
    background: var(--bg-hero);
    overflow: hidden;
    isolation: isolate;
  }

  /* Canvas layer behind content for circuit field */
  .hero-canvas {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .hero-circuit-field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(3rem, 6vw, 7rem);
    align-items: center;
    position: relative;
    z-index: 2;
  }

  /* ================================================
     LEFT COLUMN — MONUMENTAL TYPOGRAPHY
     ================================================ */
  .hero-left {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    justify-content: center;
    padding-right: var(--space-4);
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--cyan);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
  }

  .eyebrow-pip {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 12px var(--cyan-glow);
  }

  /* Monumental Name — One of the largest elements on the site */
  .hero-name {
    font-size: var(--text-display-tight);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.055em;
    color: var(--text-primary);
    margin: 0;
  }

  .hero-name-line {
    display: block;
    will-change: transform, opacity;
    text-transform: uppercase;
  }

  /* Engineering Disciplines Row */
  .hero-disciplines {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-top: var(--space-2);
  }

  .discipline-item {
    font-weight: 500;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .discipline-sep {
    opacity: 0.3;
  }

  .hero-disciplines:hover .discipline-item {
    color: var(--text-secondary);
  }

  /* Supporting Statement */
  .hero-statement-wrap {
    max-width: 640px;
  }

  .hero-statement {
    font-size: clamp(1.1rem, 1.5vw, 1.35rem);
    line-height: 1.7;
    color: var(--text-secondary);
    font-weight: 400;
  }

  .hero-statement em {
    font-style: normal;
    color: var(--text-primary);
    font-weight: 600;
  }

  /* Verified Campaign Credential */
  .hero-credential {
    padding: var(--space-4) 0;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    max-width: 580px;
  }

  .cred-tag-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .cred-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.85rem;
    background: var(--cyan-subtle);
    color: var(--cyan-dark);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    border-radius: var(--r-xs);
    border: 1px solid rgba(0, 174, 239, 0.2);
    letter-spacing: 0.02em;
  }

  .cred-desc {
    font-size: var(--text-xs);
    color: var(--text-muted);
    font-weight: 500;
  }

  /* Actions */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding-top: var(--space-3);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.6rem;
    font-size: var(--text-sm);
    font-weight: 600;
    border-radius: var(--r-sm);
    transition: all var(--dur-norm) var(--ease-out);
    cursor: pointer;
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .btn-primary {
    background: var(--text-primary);
    color: var(--bg);
    border: 1px solid transparent;
  }

  .btn-primary:hover {
    background: #FFFFFF;
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(242, 243, 241, 0.15);
  }

  .btn-secondary {
    background: var(--surface);
    color: var(--text-primary);
    border: 1px solid var(--border);
  }

  .btn-secondary:hover {
    background: var(--surface-elevated);
    border-color: var(--cyan);
    transform: translateY(-2px);
    box-shadow: var(--shadow-hover);
  }

  .btn-arrow {
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .btn:hover .btn-arrow {
    transform: translate(3px, 3px);
  }

  /* ================================================
     RIGHT COLUMN — INTEGRATED PORTRAIT COMPOSITION
     ================================================ */
  .hero-right {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }

  .portrait-composition {
    position: relative;
    width: 100%;
    max-width: 520px;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-6);
  }

  /* Atmospheric separation layer */
  .portrait-atmosphere {
    position: absolute;
    inset: -4%;
    border-radius: 50%;
    background: 
      radial-gradient(ellipse at 50% 35%, rgba(0, 174, 239, 0.06) 0%, transparent 55%),
      radial-gradient(ellipse at 50% 70%, rgba(0, 174, 239, 0.03) 0%, transparent 45%);
    filter: blur(60px);
    pointer-events: none;
    z-index: 0;
  }

  /* Circuit halo behind portrait */
  .portrait-circuit-halo {
    position: absolute;
    inset: 2%;
    pointer-events: none;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    animation: haloFadeIn 1.2s var(--ease-out) 0.8s forwards;
  }

  @keyframes haloFadeIn {
    from { opacity: 0; transform: scale(1.05); }
    to { opacity: 1; transform: scale(1); }
  }

  .portrait-circuit-svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .portrait-cutout-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1.08;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    /* Soft dissolve at base */
    mask-image: linear-gradient(to bottom, black 85%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, black 85%, transparent 100%);
  }

  .portrait-cutout-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    filter: drop-shadow(0 30px 48px rgba(0, 0, 0, 0.5)) contrast(1.02);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .portrait-cutout-wrap:hover .portrait-cutout-img {
    transform: scale(1.01);
  }

  /* Architectural Registration Marks (+) */
  .reg-mark {
    position: absolute;
    font-size: 14px;
    font-weight: 700;
    color: var(--text-dim);
    pointer-events: none;
    z-index: 3;
    line-height: 1;
    opacity: 0.5;
  }

  .reg-tl { top: -8px; left: -8px; }
  .reg-tr { top: -8px; right: -8px; }
  .reg-bl { bottom: -8px; left: -8px; }
  .reg-br { bottom: -8px; right: -8px; }

  /* Scroll indicator */
  .hero-scroll-indicator {
    position: absolute;
    bottom: clamp(2rem, 4vh, 3rem);
    left: 50%;
    transform: translateX(-50%);
    color: var(--text-muted);
    opacity: 0.5;
    animation: scrollFade 2s ease-in-out infinite;
    pointer-events: none;
    z-index: 10;
  }

  @keyframes scrollFade {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 0.6; }
  }

  /* Orchestration initial state for JS entrance */
  .hero-orchestrated {
    opacity: 0;
  }

  /* Fallback when JS is disabled or reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .hero-orchestrated {
      opacity: 1 !important;
      transform: none !important;
    }
    .portrait-circuit-halo {
      animation: none;
      opacity: 1;
    }
  }

  /* ================================================
     RESPONSIVE
     ================================================ */
  @media (max-width: 1100px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .hero-right {
      order: -1;
      max-width: 420px;
      margin: 0 auto;
    }

    .portrait-composition {
      max-width: 380px;
    }

    .hero-name {
      font-size: var(--text-display-tight);
    }

    .hero-disciplines {
      font-size: var(--text-xs);
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding: clamp(3rem, 8vh, 5rem) 0;
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .btn {
      justify-content: center;
    }

    .hero-name {
      font-size: clamp(3.5rem, 12vw, 5.5rem);
    }

    .hero-statement {
      font-size: var(--text-base);
    }
  }

  @media (max-width: 480px) {
    .hero-disciplines {
      gap: 0.35rem;
    }
    .discipline-sep {
      display: none;
    }
  }
</style>