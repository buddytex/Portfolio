---
// Hero Section — Graphite + Electric Cyan
// Free-floating spatial perception point cloud with physical spring-inertia cursor interaction
---

<section class="hero" id="hero">
  <div class="container hero-container">
    <!-- Left: Editorial Content -->
    <div class="hero-content">
      <div class="hero-header">
        <h1 class="hero-title">
          NAVEEN SHAJI<br/>
          <span class="hero-name-accent">GEORGE</span>
        </h1>
        <div class="hero-subtitle mono">
          ROBOTICS · AUTONOMOUS SYSTEMS · AI
        </div>
      </div>

      <p class="hero-statement">
        I build machines that <strong class="text-primary">perceive</strong>,
        <strong class="text-primary">reason</strong>, and <strong class="text-primary">act</strong>.
      </p>

      <p class="hero-narrative">
        Specializing in autonomous navigation, robot perception (LiDAR & computer vision),
        custom embedded ECUs, CAN bus networks, and full-stack vehicle hardware-software integration.
      </p>

      <!-- Focus Metadata Area (Restrained, technical, not a dashboard) -->
      <div class="hero-focus-block">
        <div class="focus-label mono">FOCUS AREAS</div>
        <div class="focus-tags">
          <span class="focus-tag mono">Robotics</span>
          <span class="focus-sep">/</span>
          <span class="focus-tag mono">Computer Vision</span>
          <span class="focus-sep">/</span>
          <span class="focus-tag mono">Autonomous Systems</span>
          <span class="focus-sep">/</span>
          <span class="focus-tag mono">ROS 2</span>
          <span class="focus-sep">/</span>
          <span class="focus-tag mono">AI / ML</span>
        </div>
      </div>

      <!-- Verified Achievements -->
      <div class="hero-milestones">
        <div class="milestone-item">
          <span class="milestone-rank mono text-cyan">AIR 7 & AIR 11</span>
          <span class="milestone-desc">Team Equinox · BAJA SAE India Autonomous Vehicle</span>
        </div>
        <div class="milestone-divider"></div>
        <div class="milestone-item">
          <span class="milestone-rank mono">E&E HEAD</span>
          <span class="milestone-desc">Vehicle Electronics, CAN Bus & Drive-by-Wire</span>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="hero-actions">
        <a href="#work" class="btn-graphite btn-graphite-primary">
          <span>View Projects</span>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <polyline points="19 12 12 19 5 12"></polyline>
          </svg>
        </a>

        <a href="#contact" class="btn-graphite btn-graphite-secondary">
          <span>Contact</span>
        </a>
      </div>
    </div>

    <!-- Right: Free-Floating Spatial Perception Field -->
    <!-- Directly on the page, no card, no radar circles, no fake sweep line -->
    <div class="hero-visual">
      <div class="pointcloud-viewport" id="pointcloudViewport">
        <canvas id="pointcloudCanvas" aria-label="Interactive Spatial Sensor Field"></canvas>
        <div class="pointcloud-annotation mono">
          <span class="annotation-dot"></span>
          SPATIAL PERCEPTION FIELD · INTERACTIVE OBJECT DEFLECTION
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // ==========================================================
  // FREE-FLOATING SPATIAL PERCEPTION POINT CLOUD
  // 95% Neutral Gray + ~5% Electric Cyan
  // Physical spring-inertia cursor repulsion (No scanner sweep)
  // ==========================================================

  interface Point3D {
    baseX: number;
    baseY: number;
    baseZ: number;
    x: number;
    y: number;
    z: number;
    vx: number;
    vy: number;
    vz: number;
    radius: number;
    isCyan: boolean;
    phase: number;
    driftSpeed: number;
  }

  const canvas = document.getElementById('pointcloudCanvas') as HTMLCanvasElement;
  const viewport = document.getElementById('pointcloudViewport');

  if (canvas && viewport) {
    const ctx = canvas.getContext('2d');
    if (ctx) {
      let width = 0;
      let height = 0;
      let animId = 0;
      const points: Point3D[] = [];
      const numPoints = 360;

      const mouse = {
        x: -9999,
        y: -9999,
        targetX: -9999,
        targetY: -9999,
        active: false,
      };

      function resize() {
        const rect = viewport!.getBoundingClientRect();
        width = rect.width;
        height = rect.height;
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = width * dpr;
        canvas.height = height * dpr;
        ctx!.scale(dpr, dpr);
      }

      window.addEventListener('resize', resize);
      resize();

      // Initialize 3D point cloud in spatial environment
      function initPoints() {
        points.length = 0;
        const cx = width / 2;
        const cy = height / 2;

        for (let i = 0; i < numPoints; i++) {
          // Spatial geometry distribution
          const theta = Math.random() * Math.PI * 2;
          const phi = (Math.random() - 0.5) * Math.PI * 0.8;
          const r = 50 + Math.pow(Math.random(), 0.75) * (Math.min(width, height) * 0.44);

          const bx = cx + Math.cos(theta) * Math.cos(phi) * r;
          const by = cy + Math.sin(phi) * r * 0.82 + Math.sin(theta) * 20;
          const bz = Math.sin(theta) * Math.cos(phi) * 150;

          // 95% neutral gray, 5% electric cyan
          const isCyan = Math.random() < 0.055;

          points.push({
            baseX: bx,
            baseY: by,
            baseZ: bz,
            x: bx,
            y: by,
            z: bz,
            vx: 0,
            vy: 0,
            vz: 0,
            radius: isCyan ? 1.8 : 1.3 + Math.random() * 1.2,
            isCyan,
            phase: Math.random() * Math.PI * 2,
            driftSpeed: 0.0006 + Math.random() * 0.0006,
          });
        }
      }

      initPoints();

      // Track cursor position relative to canvas
      window.addEventListener('mousemove', (e) => {
        const rect = canvas.getBoundingClientRect();
        mouse.targetX = e.clientX - rect.left;
        mouse.targetY = e.clientY - rect.top;
        mouse.active = true;
      }, { passive: true });

      window.addEventListener('mouseleave', () => {
        mouse.active = false;
        mouse.targetX = -9999;
        mouse.targetY = -9999;
      });

      let time = 0;
      const focalLength = 300;
      const reactionRadius = 140;
      const springK = 0.042;
      const damping = 0.87;

      function render() {
        time += 1;
        ctx!.clearRect(0, 0, width, height);

        // Smooth mouse interpolation
        mouse.x += (mouse.targetX - mouse.x) * 0.12;
        mouse.y += (mouse.targetY - mouse.y) * 0.12;

        // 1. Update point physics
        for (let i = 0; i < points.length; i++) {
          const pt = points[i];

          // Subtle natural spatial drift (no fast scanning)
          const targetX = pt.baseX + Math.sin(time * pt.driftSpeed + pt.phase) * 8;
          const targetY = pt.baseY + Math.cos(time * pt.driftSpeed * 1.1 + pt.phase) * 8;
          const targetZ = pt.baseZ + Math.sin(time * 0.001 + pt.phase) * 10;

          // Cursor physical repulsion
          if (mouse.active && mouse.x > -500) {
            const dx = pt.x - mouse.x;
            const dy = pt.y - mouse.y;
            const dist = Math.hypot(dx, dy);

            if (dist < reactionRadius && dist > 0.01) {
              const norm = dist / reactionRadius;
              const force = Math.pow(1 - norm, 1.8) * 4.6;
              const angle = Math.atan2(dy, dx);

              pt.vx += Math.cos(angle) * force;
              pt.vy += Math.sin(angle) * force;
              pt.vz += force * 1.4; // Reveal depth when pushed
            }
          }

          // Damped spring return
          const ax = (targetX - pt.x) * springK;
          const ay = (targetY - pt.y) * springK;
          const az = (targetZ - pt.z) * springK;

          pt.vx = (pt.vx + ax) * damping;
          pt.vy = (pt.vy + ay) * damping;
          pt.vz = (pt.vz + az) * damping;

          pt.x += pt.vx;
          pt.y += pt.vy;
          pt.z += pt.vz;
        }

        // 2. Subtle connection mesh between nearby points (Restrained hairlines)
        ctx!.lineWidth = 0.75;
        for (let i = 0; i < points.length; i += 3) {
          const p1 = points[i];
          for (let j = i + 1; j < Math.min(i + 6, points.length); j++) {
            const p2 = points[j];
            const d = Math.hypot(p1.x - p2.x, p1.y - p2.y);
            if (d < 42) {
              const alpha = (1 - d / 42) * (p1.isCyan || p2.isCyan ? 0.22 : 0.08);
              ctx!.strokeStyle = p1.isCyan || p2.isCyan
                ? `rgba(0, 229, 255, ${alpha})`
                : `rgba(139, 148, 158, ${alpha})`;
              ctx!.beginPath();
              ctx!.moveTo(p1.x, p1.y);
              ctx!.lineTo(p2.x, p2.y);
              ctx!.stroke();
            }
          }
        }

        // 3. Render projected 3D points
        for (let i = 0; i < points.length; i++) {
          const pt = points[i];
          const scale = focalLength / (focalLength + pt.z);
          const r = Math.max(0.6, pt.radius * scale);
          const alpha = Math.min(1, Math.max(0.2, (pt.z + 160) / 320));

          ctx!.beginPath();
          ctx!.arc(pt.x, pt.y, r, 0, Math.PI * 2);

          if (pt.isCyan) {
            // The 1% Electric Cyan energy
            ctx!.fillStyle = `rgba(0, 229, 255, ${alpha * 0.95})`;
          } else {
            // Neutral graphite / muted gray points
            ctx!.fillStyle = `rgba(139, 148, 158, ${alpha * 0.65})`;
          }

          ctx!.fill();
        }

        animId = requestAnimationFrame(render);
      }

      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!prefersReduced) {
        const obs = new IntersectionObserver(([entry]) => {
          if (entry.isIntersecting) {
            if (!animId) render();
          } else {
            if (animId) {
              cancelAnimationFrame(animId);
              animId = 0;
            }
          }
        }, { threshold: 0.05 });

        obs.observe(canvas);
        render();
      } else {
        render();
        cancelAnimationFrame(animId);
      }
    }
  }
</script>

<style>
  .hero {
    position: relative;
    padding: clamp(4rem, 8vh, 6.5rem) 0 clamp(4.5rem, 9vh, 7rem);
    min-height: calc(90vh - var(--nav-height));
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: var(--space-12);
    align-items: center;
  }

  /* Left Content */
  .hero-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-width: 620px;
    z-index: 2;
  }

  .hero-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .hero-title {
    font-size: clamp(2.75rem, 5.5vw, 4.75rem);
    letter-spacing: -0.04em;
    line-height: 0.94;
    color: var(--text-primary);
  }

  .hero-name-accent {
    color: var(--text-secondary);
    font-weight: 500;
  }

  .hero-subtitle {
    font-size: var(--text-xs);
    color: var(--cyan);
    letter-spacing: 0.12em;
    font-weight: 600;
  }

  .hero-statement {
    font-size: clamp(1.125rem, 1.8vw, 1.35rem);
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .hero-narrative {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 560px;
  }

  /* Focus Metadata Block */
  .hero-focus-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background: var(--surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    width: fit-content;
  }

  .focus-label {
    font-size: 0.625rem;
    color: var(--text-muted);
    letter-spacing: 0.08em;
  }

  .focus-tags {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .focus-tag {
    font-size: var(--text-xs);
    color: var(--text-primary);
  }

  .focus-sep {
    font-size: var(--text-xs);
    color: var(--border);
  }

  /* Milestones */
  .hero-milestones {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-3) 0;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .milestone-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .milestone-rank {
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .milestone-desc {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .milestone-divider {
    width: 1px;
    height: 32px;
    background: var(--border-subtle);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-2);
    flex-wrap: wrap;
  }

  /* Right Visual: Free-Floating Point Cloud */
  .hero-visual {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 480px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pointcloud-viewport {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #pointcloudCanvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    cursor: default;
  }

  .pointcloud-annotation {
    position: absolute;
    bottom: 8px;
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    pointer-events: none;
    display: flex;
    align-items: center;
    gap: 6px;
    opacity: 0.8;
  }

  .annotation-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--cyan);
  }

  @media (max-width: 1024px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .hero-visual {
      min-height: 360px;
    }
    .pointcloud-viewport {
      min-height: 380px;
    }
  }

  @media (max-width: 640px) {
    .hero-milestones {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }
    .milestone-divider {
      display: none;
    }
  }
</style>
