---
// Hero Component — High-Precision Robotics Engineering Centerpiece
// Naveen Shaji George · Robotics and Automation Engineer
// Real Three.js WebGL 3D mechanical assembly behind authentic portrait,
// metallic champagne gold circuitry, monumental editorial typography, and technical HUD.
import CircuitBoard from './CircuitBoard.astro';
import { resolveMediaUrl } from '../utils/media';
---

<section class="hero" id="hero" aria-labelledby="heroName">
  <!-- Deterministic Hero-Only PCB Circuit Background -->
  <CircuitBoard />

  <div class="hero-inner-frame">
    <!-- Left Column: Identity, Monumental Editorial Typography, CTAs -->
    <div class="hero-left" id="heroLeft">
      <!-- Technical Eyebrow Pill -->
      <div class="hero-eyebrow" id="heroEyebrow">
        <span class="eyebrow-capsule" aria-hidden="true"></span>
        <span class="eyebrow-dot" aria-hidden="true"></span>
        <span class="eyebrow-text mono">ROBOTICS ENGINEER // B.TECH ROBOTICS &amp; AUTOMATION</span>
      </div>

      <!-- Monumental Editorial Typography -->
      <h1 id="heroName" class="hero-name" aria-label="Naveen Shaji George">
        <span class="hero-name-line">NAVEEN</span>
        <span class="hero-name-line">
          SHAJI <span class="hero-name-gold">GEORGE</span>
        </span>
      </h1>

      <!-- Supporting Engineering Disciplines -->
      <div class="hero-disciplines" id="heroDisciplines">
        <span class="discipline-item mono">EMBEDDED SYSTEMS</span>
        <span class="discipline-sep" aria-hidden="true">·</span>
        <span class="discipline-item mono">AUTONOMOUS VEHICLES</span>
        <span class="discipline-sep" aria-hidden="true">·</span>
        <span class="discipline-item mono">ROBOTICS HARDWARE</span>
        <span class="discipline-sep" aria-hidden="true">·</span>
        <span class="discipline-item mono">ROS 2 &amp; PERCEPTION</span>
      </div>

      <!-- Premium Pill CTAs matching Reference Image -->
      <div class="hero-actions" id="heroActions">
        <a href="#work" class="btn-hero-pill btn-hero-dark" id="heroExploreBtn">
          <span>Explore Projects</span>
          <span class="btn-arrow" aria-hidden="true">↓</span>
        </a>
        <a href="#skills" class="btn-hero-pill btn-hero-light" id="heroEvidenceBtn">
          <span>Inspect Engineering Evidence</span>
          <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <!-- Right Column: REAL 3D Three.js WebGL Scene + Cutout Portrait + HUD Annotations -->
    <div class="hero-right" id="heroPortrait">
      <div class="portrait-stage" id="portraitComposition">
        
        <!-- REAL 3D Three.js WebGL Canvas (Positions directly BEHIND portrait) -->
        <canvas id="hero3dCanvas" class="hero-3d-canvas" width="1040" height="920" aria-hidden="true"></canvas>

        <!-- Ambient Occlusion Depth Shadow between 3D object and portrait -->
        <div class="portrait-ao-shadow" aria-hidden="true"></div>

        <!-- Authentic User Cutout Portrait (Positions IN FRONT of 3D objects) -->
        <div class="portrait-cutout-wrap" id="portraitCutoutWrap">
          <img
            src={resolveMediaUrl('/images/naveen-portrait.png')}
            alt="Naveen Shaji George — Robotics and Automation Engineer"
            class="portrait-cutout-img"
            id="heroPortraitImg"
            width="720"
            height="780"
            loading="eager"
            decoding="async"
          />
        </div>

        <!-- Top-Right Glassmorphic HUD Badge (BUILD, EXPLORE, AUTOMATE, IMPROVE) -->
        <div class="hero-hud-badge" aria-hidden="true">
          <div class="hud-badge-row">
            <span class="hud-pip">·</span>
            <span class="hud-label mono">BUILD</span>
          </div>
          <div class="hud-badge-row">
            <span class="hud-pip">·</span>
            <span class="hud-label mono">EXPLORE</span>
            <span class="hud-bar"></span>
          </div>
          <div class="hud-badge-row">
            <span class="hud-pip">·</span>
            <span class="hud-label mono">AUTOMATE</span>
            <span class="hud-bar"></span>
          </div>
          <div class="hud-badge-row">
            <span class="hud-pip">·</span>
            <span class="hud-label mono">IMPROVE</span>
            <span class="hud-bar"></span>
          </div>
        </div>

        <!-- Lower-Right Glassmorphic HUD Panel (IDEAS, HARDWARE, REAL-WORLD IMPACT +) -->
        <div class="hero-hud-panel" aria-hidden="true">
          <div class="hud-panel-col">
            <div class="hud-panel-text mono">IDEAS</div>
            <div class="hud-panel-text mono">HARDWARE</div>
            <div class="hud-panel-text mono">REAL-WORLD IMPACT</div>
          </div>
          <div class="hud-panel-plus mono" aria-hidden="true">+</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Technical Engineering Footers -->
  <div class="hero-bottom-bar" aria-hidden="true">
    <!-- Bottom Left Tagline -->
    <div class="hero-bottom-left mono">
      <div class="foot-title">ENGINEERING</div>
      <div class="foot-desc">
        <span>A MORE AUTONOMOUS TOMORROW</span>
        <span class="foot-gold-line"></span>
      </div>
    </div>

    <!-- Bottom Right Annotation -->
    <div class="hero-bottom-right mono">
      <div class="foot-code">// 01 ――――</div>
      <div class="foot-phase">DESIGN × BUILD × DEPLOY</div>
    </div>
  </div>
</section>

<!-- Pure Vanilla Three.js Client Controller: Immediate 60fps initialization, real 3D depth, metallic shaders, mouse parallax -->
<script>
  import * as THREE from 'three';
  import {
    initHeroAnimation,
    type HeroController,
    isReducedMotion,
  } from '../animations';

  let heroController: HeroController | null = null;
  let hero3dRunning = false;
  let hero3dCancelId: number | null = null;

  // 1. Initialize Anime.js 4.5.x Hero Lifecycle & Parallax
  function setupHero() {
    if (heroController) {
      heroController.destroy();
      heroController = null;
    }
    const heroSection = document.getElementById('hero');
    if (!heroSection) return;

    // Initialize Hero with skipEntrance: true so resting state is immediately established
    heroController = initHeroAnimation(heroSection, { skipEntrance: true });
  }

  // 2. REAL Three.js 3D Mechanical Assembly Behind Portrait
  function initHero3DScene() {
    const canvas = document.getElementById('hero3dCanvas') as HTMLCanvasElement;
    if (!canvas) return;

    const width = 1040;
    const height = 920;

    // High-performance WebGL renderer with hardware compositor blitting
    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
      preserveDrawingBuffer: false,
      powerPreference: 'high-performance',
    });
    renderer.setSize(width, height, false);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.75));
    renderer.setClearColor(0x000000, 0);

    // Scene & Camera: 40 deg FOV with deep perspective
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(40, width / height, 0.1, 100);
    camera.position.set(0, 0, 8.4);

    // Master Group for Parallax
    const masterGroup = new THREE.Group();
    scene.add(masterGroup);

    // ----------------------------------------------------
    // MATERIALS: Gunmetal Charcoal, Dark Graphite, Polished Gold, Luminous Inner Rim
    // ----------------------------------------------------
    // Primary Gunmetal: Rich dark metallic alloy with visible 3D geometry & specular sheen
    const primaryMetalMaterial = new THREE.MeshStandardMaterial({
      color: new THREE.Color('#242935'),
      roughness: 0.16,
      metalness: 0.84,
    });

    // Secondary Graphite: Nested interlocking element
    const secMetalMaterial = new THREE.MeshStandardMaterial({
      color: new THREE.Color('#1A1E27'),
      roughness: 0.20,
      metalness: 0.80,
    });

    // Mirror Champagne Gold: Luxurious metallic sheen for hero spheres and accents
    const goldMetallicMaterial = new THREE.MeshStandardMaterial({
      color: new THREE.Color('#E5C678'),
      emissive: new THREE.Color('#8A6B22'),
      emissiveIntensity: 0.18,
      roughness: 0.10,
      metalness: 0.95,
    });

    // Luminous Inner Gold Filament: Thin recessed wire casting warm glow on inner collar walls
    const goldGlowRimMaterial = new THREE.MeshStandardMaterial({
      color: new THREE.Color('#FFF4D0'),
      emissive: new THREE.Color('#DFBF6E'),
      emissiveIntensity: 2.2,
      roughness: 0.1,
      metalness: 0.85,
    });

    // Dark Spheres: Matte gunmetal sphere
    const darkSphereMaterial = new THREE.MeshStandardMaterial({
      color: new THREE.Color('#1B1F27'),
      roughness: 0.18,
      metalness: 0.86,
    });

    // Fine Orbital Wire: Polished champagne gold wire
    const goldOrbitalWireMaterial = new THREE.MeshBasicMaterial({
      color: new THREE.Color('#C8A251'),
      transparent: true,
      opacity: 0.55,
    });

    // ----------------------------------------------------
    // 3D GEOMETRY CLUSTER: CNC Precision Machined Aerospace Collars
    // ----------------------------------------------------
    const torusGroup = new THREE.Group();
    // Position collar behind portrait collarbone/shoulders (lowered so face is 100% unobstructed)
    torusGroup.position.set(0.08, -0.42, -0.45);
    masterGroup.add(torusGroup);

    // 1. Primary Dominant Dark Mechanical Collar (Lathe profile with chamfered bevels)
    const r_in = 2.10;
    const r_out = 2.70;
    const h = 0.34;
    const c = 0.07;
    const collarPoints = [
      new THREE.Vector2(r_in, -h),
      new THREE.Vector2(r_in, -0.06),
      new THREE.Vector2(r_in + 0.04, -0.06), // recessed groove
      new THREE.Vector2(r_in + 0.04, 0.06),
      new THREE.Vector2(r_in, 0.06),
      new THREE.Vector2(r_in, h - c),
      new THREE.Vector2(r_in + c, h),        // inner top chamfer
      new THREE.Vector2(r_out - c, h),       // outer top chamfer start
      new THREE.Vector2(r_out, h - c),       // outer wall start
      new THREE.Vector2(r_out, -h + c),      // outer bottom chamfer start
      new THREE.Vector2(r_out - c, -h),      // outer bottom chamfer end
      new THREE.Vector2(r_in, -h),
    ];
    const primaryCollarGeom = new THREE.LatheGeometry(collarPoints, 120);
    const primaryCollar = new THREE.Mesh(primaryCollarGeom, primaryMetalMaterial);
    // Tilted backwards and angled diagonally matching reference
    primaryCollar.rotation.set(Math.PI * 0.38, -Math.PI * 0.10, Math.PI * 0.36);
    primaryCollar.scale.set(1.06, 1.06, 1.06);
    torusGroup.add(primaryCollar);

    // 2. Luminous Gold Filament recessed inside inner collar groove
    const innerGoldGeom = new THREE.TorusGeometry(r_in + 0.02, 0.015, 16, 120);
    const innerGold = new THREE.Mesh(innerGoldGeom, goldGlowRimMaterial);
    innerGold.rotation.set(Math.PI * 0.38, -Math.PI * 0.10, Math.PI * 0.36);
    innerGold.scale.set(1.06, 1.06, 1.06);
    torusGroup.add(innerGold);

    // 3. Secondary Interlocking Dark Ring / Nested Collar
    const r2_in = 1.76;
    const r2_out = 2.26;
    const h2 = 0.26;
    const c2 = 0.05;
    const secPoints = [
      new THREE.Vector2(r2_in, -h2),
      new THREE.Vector2(r2_in, h2 - c2),
      new THREE.Vector2(r2_in + c2, h2),
      new THREE.Vector2(r2_out - c2, h2),
      new THREE.Vector2(r2_out, h2 - c2),
      new THREE.Vector2(r2_out, -h2 + c2),
      new THREE.Vector2(r2_out - c2, -h2),
      new THREE.Vector2(r2_in, -h2),
    ];
    const secCollarGeom = new THREE.LatheGeometry(secPoints, 96);
    const secCollar = new THREE.Mesh(secCollarGeom, secMetalMaterial);
    secCollar.rotation.set(Math.PI * 0.44, -Math.PI * 0.06, Math.PI * 0.44);
    secCollar.position.set(0.12, -0.34, -0.65);
    secCollar.scale.set(1.06, 1.06, 1.06);
    torusGroup.add(secCollar);

    // Secondary Gold Accent Ring on nested collar
    const secGoldGeom = new THREE.TorusGeometry(r2_in + 0.012, 0.014, 16, 96);
    const secGold = new THREE.Mesh(secGoldGeom, goldGlowRimMaterial);
    secGold.rotation.set(Math.PI * 0.44, -Math.PI * 0.06, Math.PI * 0.44);
    secGold.position.set(0.12, -0.34, -0.65);
    secGold.scale.set(1.06, 1.06, 1.06);
    torusGroup.add(secGold);

    // ----------------------------------------------------
    // FLOATING METALLIC SPHERES (Shifted slightly down with assembly)
    // ----------------------------------------------------
    // Sphere 1: Polished Champagne Gold Sphere (Top-Left of Portrait)
    const sphere1Geom = new THREE.SphereGeometry(0.20, 36, 36);
    const sphere1 = new THREE.Mesh(sphere1Geom, goldMetallicMaterial);
    sphere1.position.set(-1.75, 0.85, 0.75);
    masterGroup.add(sphere1);

    // Sphere 2: Medium Gunmetal Sphere (Mid-Left of Portrait, above GEORGE)
    const sphere2Geom = new THREE.SphereGeometry(0.16, 36, 36);
    const sphere2 = new THREE.Mesh(sphere2Geom, darkSphereMaterial);
    sphere2.position.set(-1.18, 0.25, 0.65);
    masterGroup.add(sphere2);

    // Sphere 3: Polished Metallic Gold Sphere (Far-Right of Ring)
    const sphere3Geom = new THREE.SphereGeometry(0.15, 36, 36);
    const sphere3 = new THREE.Mesh(sphere3Geom, goldMetallicMaterial);
    sphere3.position.set(2.35, -0.25, 0.70);
    masterGroup.add(sphere3);

    // ----------------------------------------------------
    // GOLD ORBITAL SYSTEM & MEASUREMENT ARCS (Lowered with assembly)
    // ----------------------------------------------------
    const beadGeom = new THREE.SphereGeometry(0.038, 18, 18);

    // Orbital 1: Large Master Ellipse wrapping completely around the silhouette
    const orbit1Group = new THREE.Group();
    orbit1Group.position.set(0.08, -0.45, -0.55);
    orbit1Group.rotation.set(Math.PI * 0.36, -Math.PI * 0.12, Math.PI * 0.32);
    masterGroup.add(orbit1Group);

    const orbit1Geom = new THREE.TorusGeometry(3.85, 0.006, 16, 180);
    const orbit1Mesh = new THREE.Mesh(orbit1Geom, goldOrbitalWireMaterial);
    orbit1Group.add(orbit1Mesh);

    const bead1A = new THREE.Mesh(beadGeom, goldMetallicMaterial);
    bead1A.position.set(3.85, 0, 0);
    orbit1Group.add(bead1A);

    const bead1B = new THREE.Mesh(beadGeom, goldMetallicMaterial);
    bead1B.position.set(-3.85, 0, 0);
    orbit1Group.add(bead1B);

    // Orbital 2: Concentric Fine Outer Measurement Arc
    const orbit2Group = new THREE.Group();
    orbit2Group.position.set(0.08, -0.42, -0.45);
    orbit2Group.rotation.set(Math.PI * 0.42, -Math.PI * 0.05, Math.PI * 0.42);
    masterGroup.add(orbit2Group);

    const orbit2Geom = new THREE.TorusGeometry(3.35, 0.005, 16, 140, Math.PI * 1.1);
    const orbit2Mesh = new THREE.Mesh(orbit2Geom, goldOrbitalWireMaterial);
    orbit2Group.add(orbit2Mesh);

    const bead2 = new THREE.Mesh(beadGeom, goldMetallicMaterial);
    bead2.position.set(0, 3.35, 0);
    orbit2Group.add(bead2);

    // ----------------------------------------------------
    // STUDIO LIGHTING: High-Contrast Key, Specular Rim, Warm Inner Fill
    // ----------------------------------------------------
    const ambientLight = new THREE.AmbientLight(0xFFFDF8, 1.25);
    scene.add(ambientLight);

    // Key Light from Top-Left: Crisp white illumination
    const keyLight = new THREE.DirectionalLight(0xFFFFFF, 3.8);
    keyLight.position.set(-5.0, 5.0, 4.5);
    scene.add(keyLight);

    // Golden Specular Rim Light from Rear-Right (Razor-sharp champagne rim sheen)
    const rimLight = new THREE.DirectionalLight(0xFFDE90, 5.8);
    rimLight.position.set(5.5, 4.2, -2.8);
    scene.add(rimLight);

    // Front-Right Fill Light: Accents the outer chamfers
    const fillRightLight = new THREE.DirectionalLight(0xF0CB74, 2.2);
    fillRightLight.position.set(4.0, -2.0, 3.5);
    scene.add(fillRightLight);

    // Warm Inner Point Light inside the glowing filament
    const goldPointLight = new THREE.PointLight(0xFFE599, 3.8, 6.0);
    goldPointLight.position.set(0.08, -0.42, -0.38);
    scene.add(goldPointLight);

    // Soft Low Fill Light
    const fillLight = new THREE.DirectionalLight(0xC0CAD8, 0.8);
    fillLight.position.set(0, -4.5, 3.0);
    scene.add(fillLight);

    // Force frame 0 render immediately for instant paint
    renderer.render(scene, camera);

    // ----------------------------------------------------
    // CONTINUOUS ANIMATION LOOP (Slow, Mechanical, Hypnotic)
    // ----------------------------------------------------
    let mouse = { x: 0, y: 0, targetX: 0, targetY: 0 };
    const prefersReduced = isReducedMotion();

    window.addEventListener('mousemove', (e) => {
      const nx = (e.clientX / window.innerWidth) * 2 - 1;
      const ny = -(e.clientY / window.innerHeight) * 2 + 1;
      mouse.targetX = nx * 0.16;
      mouse.targetY = ny * 0.12;
    }, { passive: true });

    let clock = new THREE.Clock();
    let isVisible = true;
    let isDocumentVisible = !document.hidden;

    function startLoop() {
      if (hero3dRunning) return;
      hero3dRunning = true;
      if (window.__PERF_METRICS__) window.__PERF_METRICS__.hero3dRunning = true;
      clock.start();
      hero3dCancelId = requestAnimationFrame(animate);
    }

    function stopLoop() {
      if (!hero3dRunning) return;
      hero3dRunning = false;
      if (window.__PERF_METRICS__) window.__PERF_METRICS__.hero3dRunning = false;
      if (hero3dCancelId) {
        cancelAnimationFrame(hero3dCancelId);
        hero3dCancelId = null;
      }
      clock.stop();
    }

    function checkVisibility() {
      if (isVisible && isDocumentVisible && !prefersReduced) {
        startLoop();
      } else {
        stopLoop();
      }
    }

    function animate() {
      if (!hero3dRunning) return;

      const delta = Math.min(clock.getDelta(), 0.1);
      const time = clock.getElapsedTime();

      if (!prefersReduced) {
        // Continuous subtle mechanical rotation on independent axes
        torusGroup.rotation.y = Math.sin(time * 0.35) * 0.06;
        torusGroup.rotation.x = Math.cos(time * 0.28) * 0.04;

        secCollar.rotation.z += delta * 0.022;
        secCollar.rotation.x -= delta * 0.010;

        // Subtle mouse parallax easing
        mouse.x += (mouse.targetX - mouse.x) * 0.04;
        mouse.y += (mouse.targetY - mouse.y) * 0.04;
        masterGroup.rotation.y = mouse.x;
        masterGroup.rotation.x = -mouse.y;

        // Floating spheres organic bobbing (lowered with collar assembly)
        sphere1.position.y = 0.85 + Math.sin(time * 1.2) * 0.05;
        sphere1.position.x = -1.75 + Math.cos(time * 0.9) * 0.03;

        sphere2.position.y = 0.25 + Math.sin(time * 1.5 + 1.2) * 0.04;
        sphere2.position.x = -1.18 + Math.cos(time * 1.1 + 0.8) * 0.03;

        sphere3.position.y = -0.25 + Math.sin(time * 1.3 + 2.5) * 0.04;
        sphere3.position.x = 2.35 + Math.cos(time * 1.0 + 1.8) * 0.03;

        // Orbitals slow rotation
        orbit1Group.rotation.z += delta * 0.038;
        orbit2Group.rotation.z -= delta * 0.028;

        // Inner gold rim luminous breathing
        const glowPulse = 2.0 + Math.sin(time * 2.0) * 0.5;
        goldGlowRimMaterial.emissiveIntensity = glowPulse;
        goldPointLight.intensity = glowPulse * 1.4;
      }

      renderer.render(scene, camera);
      hero3dCancelId = requestAnimationFrame(animate);
    }

    // Viewport IntersectionObserver: strictly pauses Three.js when scrolled out of view
    let heroObserver: IntersectionObserver | null = null;
    const heroSectionEl = document.getElementById('hero');
    if (heroSectionEl && 'IntersectionObserver' in window) {
      heroObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          isVisible = entry.isIntersecting;
          checkVisibility();
        });
      }, { threshold: 0.05 });
      heroObserver.observe(heroSectionEl);
    }

    document.addEventListener('visibilitychange', () => {
      isDocumentVisible = !document.hidden;
      checkVisibility();
    });

    if (hero3dCancelId) cancelAnimationFrame(hero3dCancelId);
    checkVisibility();

    // Expose 3D controls
    (window as any).__HERO_3D_CONTROLS__ = {
      masterGroup,
      torusGroup,
      primaryCollar,
      secCollar,
      sphere1,
      sphere2,
      sphere3,
      orbit1Group,
      orbit2Group,
      keyLight,
      rimLight,
      resetToNormal: () => {
        if (torusGroup) {
          torusGroup.position.set(0.08, -0.42, -0.45);
          torusGroup.scale.set(1.0, 1.0, 1.0);
          torusGroup.rotation.set(0, 0, 0);
        }
        if (secCollar) {
          secCollar.position.set(0.12, -0.34, -0.65);
          secCollar.scale.set(1.06, 1.06, 1.06);
          secCollar.rotation.set(Math.PI * 0.44, -Math.PI * 0.06, Math.PI * 0.44);
        }
        if (sphere1) sphere1.scale.set(1, 1, 1);
        if (sphere2) sphere2.scale.set(1, 1, 1);
        if (sphere3) sphere3.scale.set(1, 1, 1);
        if (orbit1Group) orbit1Group.scale.set(1, 1, 1);
      },
    };
  }

  function deferredInit(fn: () => void) {
    if ('requestIdleCallback' in window) {
      (window as any).requestIdleCallback(fn, { timeout: 500 });
    } else {
      setTimeout(fn, 100);
    }
  }

  // Run on page load: defer heavy 3D scene init so it does not compete with initial paint/layout
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      deferredInit(() => {
        initHero3DScene();
        setupHero();
      });
    });
  } else {
    deferredInit(() => {
      initHero3DScene();
      setupHero();
    });
  }

  document.addEventListener('astro:page-load', () => {
    deferredInit(() => {
      initHero3DScene();
      setupHero();
    });
  });
</script>

<style>
  /* ================================================
     HERO LAYOUT — High-End Robotics Engineering Laboratory
     ================================================ */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(4.2rem, 7.5vh, 5.5rem) 0 1.5rem;
    background: transparent;
    overflow: hidden;
  }

  .hero-inner-frame {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 3.5vw, 4.5rem);
    align-items: center;
    max-width: 1440px;
    margin: 0 auto;
    width: 100%;
    padding: 0 clamp(1.5rem, 4.5vw, 4rem) 0 clamp(4.2rem, 6.5vw, 6.5rem);
    position: relative;
    z-index: 2;
  }

  /* ================================================
     LEFT COLUMN — MONUMENTAL EDITORIAL TYPOGRAPHY
     ================================================ */
  .hero-left {
    display: flex;
    flex-direction: column;
    gap: clamp(0.9rem, 2vh, 1.5rem);
    justify-content: center;
    transform: translateY(clamp(20px, 5vh, 48px));
  }

  /* Technical Eyebrow Pill */
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .eyebrow-capsule {
    width: 22px;
    height: 4.5px;
    border-radius: 2px;
    background: var(--color-gold);
  }

  .eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-gold);
    box-shadow: 0 0 6px rgba(184, 146, 74, 0.6);
  }

  .eyebrow-text {
    font-size: clamp(0.58rem, 2.2vw, 0.78rem);
    font-weight: 700;
    color: var(--color-gold);
    letter-spacing: 0.10em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Monumental Name */
  .hero-name {
