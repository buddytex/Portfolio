---
// Hero Section — Editorial Robotics Engineering Identity
// Features borderless, free-form floating spatial perception field (LiDAR)
---

<section class="hero" id="hero">
  <div class="container hero-container">
    <!-- Left: Editorial Content -->
    <div class="hero-content">
      <div class="hero-meta">
        <span class="editorial-tag">
          <span class="tag-line"></span>
          Robotics & Autonomous Systems
        </span>
      </div>

      <h1 class="hero-title">
        Naveen Shaji<br/>
        <span class="hero-title-sub">George</span>
      </h1>

      <div class="hero-role">
        <span class="mono hero-role-title">ROBOTICS ENGINEER</span>
        <span class="hero-role-dot">/</span>
        <span class="mono hero-role-loc">AUTONOMOUS SYSTEMS R&D</span>
      </div>

      <p class="hero-quote">
        “I build machines that <strong class="text-white">perceive</strong>,
        <strong class="text-white">reason</strong>, and <strong class="text-white">act</strong> in the real world.”
      </p>

      <p class="hero-description">
        Specializing in autonomous navigation, robot perception (3D LiDAR & computer vision),
        custom embedded ECUs, isolated CAN bus networks, and full-stack vehicle hardware-software integration.
      </p>

      <!-- Verified Milestones -->
      <div class="hero-credentials">
        <div class="cred-item">
          <span class="cred-badge mono">AIR 7 & AIR 11</span>
          <span class="cred-desc">Team Equinox · BAJA SAE India Autonomous Campaign</span>
        </div>
        <div class="cred-divider"></div>
        <div class="cred-item">
          <span class="cred-badge mono">E&E HEAD</span>
          <span class="cred-desc">Autonomous Vehicle Electrical Architecture & CAN Bus</span>
        </div>
      </div>

      <!-- Action Links -->
      <div class="hero-actions">
        <a href="#work" class="btn-editorial btn-editorial-primary">
          <span>Explore Projects</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <polyline points="19 12 12 19 5 12"></polyline>
          </svg>
        </a>

        <a href="#research" class="btn-editorial btn-editorial-secondary">
          <span>Research & Systems</span>
        </a>
      </div>
    </div>

    <!-- Right: Free-Form Spatial Perception Field (LiDAR) -->
    <!-- Integrated directly into the environment without cards, boxes, or radar borders -->
    <div class="hero-visual">
      <div class="pointcloud-wrap" id="pointcloudWrap">
        <canvas id="pointcloudCanvas" aria-label="Interactive 3D LiDAR Spatial Perception Field"></canvas>
        <div class="pointcloud-caption mono">
          [ SPATIAL PERCEPTION FIELD · INTERACTIVE OBJECT DEFLECTION ]
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // ==========================================================
  // FREE-FORM SPATIAL PERCEPTION POINT CLOUD (LiDAR)
  // Physical spring-inertia cursor repulsion & 3D depth field
  // ==========================================================

  interface Point3D {
    baseX: number;
    baseY: number;
    baseZ: number;
    x: number;
    y: number;
    z: number;
    vx: number;
    vy: number;
    vz: number;
    radius: number;
    phase: number;
    orbitSpeed: number;
    colorType: 'blue' | 'cyan' | 'slate';
  }

  const canvas = document.getElementById('pointcloudCanvas') as HTMLCanvasElement;
  const wrap = document.getElementById('pointcloudWrap');

  if (canvas && wrap) {
    const ctx = canvas.getContext('2d');
    if (ctx) {
      let width = 0;
      let height = 0;
      let animId = 0;
      const points: Point3D[] = [];
      const numPoints = 420;

      // Cursor position in canvas coordinates
      const cursor = {
        x: -9999,
        y: -9999,
        active: false,
      };

      function resize() {
        const rect = wrap!.getBoundingClientRect();
        width = rect.width;
        height = rect.height;
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = width * dpr;
        canvas.height = height * dpr;
        ctx!.scale(dpr, dpr);
      }

      window.addEventListener('resize', resize);
      resize();

      // Initialize spatial points in 3D perception volume
      function initPoints() {
        points.length = 0;
        const cx = width / 2;
        const cy = height / 2;

        for (let i = 0; i < numPoints; i++) {
          // Semi-structured organic distribution reminiscent of a real LiDAR scan of surroundings
          const theta = Math.random() * Math.PI * 2;
          const phi = (Math.random() - 0.5) * Math.PI * 0.75;
          const dist = 60 + Math.pow(Math.random(), 0.7) * (Math.min(width, height) * 0.42);

          const bx = cx + Math.cos(theta) * Math.cos(phi) * dist;
          const by = cy + Math.sin(phi) * dist * 0.85 + Math.sin(theta) * 35;
          const bz = Math.sin(theta) * Math.cos(phi) * 160;

          const rand = Math.random();
          const colorType: 'blue' | 'cyan' | 'slate' =
            rand > 0.45 ? 'blue' : (rand > 0.18 ? 'cyan' : 'slate');

          points.push({
            baseX: bx,
            baseY: by,
            baseZ: bz,
            x: bx,
            y: by,
            z: bz,
            vx: 0,
            vy: 0,
            vz: 0,
            radius: 1.4 + Math.random() * 1.6,
            phase: Math.random() * Math.PI * 2,
            orbitSpeed: 0.0006 + Math.random() * 0.0008,
            colorType,
          });
        }
      }

      initPoints();

      // Track cursor relative to canvas
      const updateCursor = (clientX: number, clientY: number) => {
        const rect = canvas.getBoundingClientRect();
        cursor.x = clientX - rect.left;
        cursor.y = clientY - rect.top;
        cursor.active = true;
      };

      window.addEventListener('mousemove', (e) => updateCursor(e.clientX, e.clientY));
      window.addEventListener('touchmove', (e) => {
        if (e.touches.length > 0) {
          updateCursor(e.touches[0].clientX, e.touches[0].clientY);
        }
      }, { passive: true });

      window.addEventListener('mouseleave', () => {
        cursor.active = false;
        cursor.x = -9999;
        cursor.y = -9999;
      });

      let time = 0;
      const focalLength = 320;
      const reactionRadius = 140;
      const springK = 0.045; // Spring restoring tension
      const damping = 0.87;  // Viscous fluid inertia damping

      function render() {
        time += 1;
        ctx!.clearRect(0, 0, width, height);

        const cx = width / 2;
        const cy = height / 2;

        // Periodic subtle LiDAR laser excitation sweep
        const laserSweepZ = Math.sin(time * 0.02) * 160;

        // 1. Update physics for each point
        for (let i = 0; i < points.length; i++) {
          const pt = points[i];

          // Natural subtle organic drift
          const driftX = Math.sin(time * pt.orbitSpeed + pt.phase) * 14;
          const driftY = Math.cos(time * pt.orbitSpeed * 1.1 + pt.phase) * 12;
          const targetX = pt.baseX + driftX;
          const targetY = pt.baseY + driftY;
          const targetZ = pt.baseZ + Math.sin(time * 0.001 + pt.phase) * 15;

          // PHYSICAL CURSOR INTERACTION (Cursor behaves as physical obstacle in LiDAR space)
          if (cursor.active) {
            const dx = pt.x - cursor.x;
            const dy = pt.y - cursor.y;
            const dist = Math.hypot(dx, dy);

            if (dist < reactionRadius && dist > 0.001) {
              // Smooth non-linear repulsion force with inertia
              const normDist = dist / reactionRadius;
              const force = Math.pow(1 - normDist, 1.8) * 5.5;
              const angle = Math.atan2(dy, dx);

              pt.vx += Math.cos(angle) * force;
              pt.vy += Math.sin(angle) * force;
              pt.vz += force * 1.8; // Displace in depth like a 3D obstacle
            }
          }

          // Damped Spring Return to equilibrium
          const ax = (targetX - pt.x) * springK;
          const ay = (targetY - pt.y) * springK;
          const az = (targetZ - pt.z) * springK;

          pt.vx = (pt.vx + ax) * damping;
          pt.vy = (pt.vy + ay) * damping;
          pt.vz = (pt.vz + az) * damping;

          pt.x += pt.vx;
          pt.y += pt.vy;
          pt.z += pt.vz;
        }

        // 2. Spatial Connectivity Lines (Subtle perception mesh)
        ctx!.lineWidth = 0.75;
        for (let i = 0; i < points.length; i += 3) {
          const p1 = points[i];
          for (let j = i + 1; j < Math.min(i + 8, points.length); j++) {
            const p2 = points[j];
            const d = Math.hypot(p1.x - p2.x, p1.y - p2.y);
            if (d < 46) {
              const alpha = (1 - d / 46) * 0.12;
              ctx!.strokeStyle = `rgba(59, 130, 246, ${alpha})`;
              ctx!.beginPath();
              ctx!.moveTo(p1.x, p1.y);
              ctx!.lineTo(p2.x, p2.y);
              ctx!.stroke();
            }
          }
        }

        // 3. Render projected 3D Points
        for (let i = 0; i < points.length; i++) {
          const pt = points[i];

          // 3D perspective projection scale
          const scale = focalLength / (focalLength + pt.z);
          const r = Math.max(0.6, pt.radius * scale);

          // Proximity to periodic sweep
          const isSwept = Math.abs(pt.z - laserSweepZ) < 25;
          const baseAlpha = Math.min(1, Math.max(0.2, (pt.z + 180) / 340));
          const finalAlpha = isSwept ? Math.min(1, baseAlpha * 1.6) : baseAlpha * 0.85;

          ctx!.beginPath();
          ctx!.arc(pt.x, pt.y, r, 0, Math.PI * 2);

          if (isSwept) {
            ctx!.fillStyle = `rgba(255, 255, 255, ${finalAlpha})`;
          } else if (pt.colorType === 'blue') {
            ctx!.fillStyle = `rgba(59, 130, 246, ${finalAlpha})`;
          } else if (pt.colorType === 'cyan') {
            ctx!.fillStyle = `rgba(96, 165, 250, ${finalAlpha * 0.9})`;
          } else {
            ctx!.fillStyle = `rgba(203, 213, 225, ${finalAlpha * 0.5})`;
          }

          ctx!.fill();
        }

        animId = requestAnimationFrame(render);
      }

      // IntersectionObserver: Pause when offscreen for high performance
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!prefersReduced) {
        const observer = new IntersectionObserver(([entry]) => {
          if (entry.isIntersecting) {
            if (!animId) render();
          } else {
            if (animId) {
              cancelAnimationFrame(animId);
              animId = 0;
            }
          }
        }, { threshold: 0.05 });

        observer.observe(canvas);
        render();
      } else {
        render();
        cancelAnimationFrame(animId);
      }
    }
  }
</script>

<style>
  .hero {
    position: relative;
    padding: clamp(4rem, 8vh, 6.5rem) 0 clamp(5rem, 10vh, 8rem);
    min-height: calc(90vh - var(--nav-height));
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: var(--space-12);
    align-items: center;
  }

  /* Left Editorial Content */
  .hero-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-width: 660px;
    z-index: 2;
  }

  .hero-meta {
    display: flex;
    align-items: center;
  }

  .tag-line {
    display: inline-block;
    width: 24px;
    height: 1px;
    background: var(--accent);
  }

  .hero-title {
    font-size: clamp(3rem, 6.2vw, 5.25rem);
    letter-spacing: -0.04em;
    line-height: 0.94;
    color: var(--text);
  }

  .hero-title-sub {
    color: var(--text-secondary);
    font-weight: 500;
  }

  .hero-role {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
  }

  .hero-role-title {
    color: var(--accent);
    font-weight: 600;
  }

  .hero-role-dot {
    color: var(--text-dim);
  }

  .hero-role-loc {
    color: var(--text-muted);
  }

  .hero-quote {
    font-size: clamp(1.125rem, 1.8vw, 1.35rem);
    color: var(--text-secondary);
    line-height: 1.5;
    font-weight: 400;
  }

  .hero-description {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 580px;
  }

  /* Verified Credentials */
  .hero-credentials {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    margin-top: var(--space-2);
  }

  .cred-item {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .cred-badge {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text);
    letter-spacing: 0.04em;
  }

  .cred-desc {
    font-size: var(--text-xs);
    color: var(--text-muted);
    line-height: 1.4;
  }

  .cred-divider {
    width: 1px;
    height: 36px;
    background: var(--border-subtle);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-2);
    flex-wrap: wrap;
  }

  /* Right Visual: Free-Form Spatial Point Cloud */
  .hero-visual {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 480px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pointcloud-wrap {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 520px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #pointcloudCanvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    cursor: grab;
  }

  .pointcloud-caption {
    position: absolute;
    bottom: 10px;
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    color: var(--text-dim);
    pointer-events: none;
    text-align: center;
    opacity: 0.75;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }
    .hero-visual {
      min-height: 380px;
    }
    .pointcloud-wrap {
      min-height: 420px;
    }
  }

  @media (max-width: 640px) {
    .hero-credentials {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }
    .cred-divider {
      display: none;
    }
  }
</style>
