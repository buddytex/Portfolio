---
// Dynamic Professional & Clinical Experience Route: /experience/[id]
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import { experiences, type ExperienceItem } from '../../data/experience';
import { resolveMediaUrl } from '../../utils/media';

export function getStaticPaths() {
  return experiences.map((exp) => ({
    params: { id: exp.id },
    props: { exp },
  }));
}

interface Props {
  exp: ExperienceItem;
}

const { exp } = Astro.props;
---

<Layout
  title={`${exp.title} — Professional Experience | Naveen Shaji George`}
  description={exp.summary}
  showSpine={false}
>
  <Navigation />

  <main class="experience-page">
    <div class="container exp-container">
      <!-- Back button -->
      <div class="exp-nav-bar">
        <a href="/#experience" class="back-link mono">
          <span class="back-arrow" aria-hidden="true">←</span>
          <span>Back to Experience</span>
        </a>
        <div class="exp-meta-pill mono">
          <span>{exp.badge}</span>
        </div>
      </div>

      <!-- Header Block -->
      <header class="exp-hero">
        <div class="exp-domain mono">{exp.organization} · {exp.location}</div>
        <h1 class="exp-title">{exp.title}</h1>
        <p class="exp-subtitle">{exp.role} · {exp.period}</p>

        <div class="exp-attributes mono">
          <div class="attr-item">
            <span class="attr-label">ROLE</span>
            <span class="attr-val">{exp.role}</span>
          </div>
          <div class="attr-item">
            <span class="attr-label">TIMELINE</span>
            <span class="attr-val">{exp.period}</span>
          </div>
          <div class="attr-item">
            <span class="attr-label">NATURE</span>
            <span class="attr-val status-val">CLINICAL OBSERVATION &amp; WORKFLOW STUDY</span>
          </div>
        </div>
      </header>

      <!-- Primary Video / Media Showcase -->
      <div class="exp-hero-visual">
        <div class="exp-video-box">
          <video
            src={resolveMediaUrl(exp.videoPath)}
            autoplay
            loop
            muted
            playsinline
            class="exp-main-video"
            poster={resolveMediaUrl(exp.imagePath)}
            title="CMR Versius Surgeon Console Teleoperation Hand Controllers"
          ></video>
          <div class="video-hud-overlay mono">
            <span class="hud-dot">●</span>
            <span>CMR VERSIUS SURGEON CONSOLE TELEOPERATION DEMONSTRATION</span>
          </div>
        </div>
      </div>

      <!-- Executive Overview -->
      <section class="case-section summary-section">
        <h2 class="section-kicker mono">EXECUTIVE EXPERIENCE SUMMARY</h2>
        <p class="summary-lead">{exp.summary}</p>
      </section>

      <!-- Scope Breakdown Grid: Observed vs Exposed vs Applied -->
      <div class="scope-grid">
        <!-- Systems Exposed -->
        <section class="case-section col-box">
          <h2 class="section-kicker mono">SYSTEMS &amp; HARDWARE EXPOSED TO</h2>
          <ul class="clean-list">
            {exp.systemsExposed.map((item) => (
              <li class="clean-item">
                <span class="bullet mono">■</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </section>

        <!-- Observed Workflows -->
        <section class="case-section col-box">
          <h2 class="section-kicker mono">OBSERVED CLINICAL PROCEDURES</h2>
          <ul class="clean-list">
            {exp.observedActivities.map((item) => (
              <li class="clean-item">
                <span class="bullet mono text-cyan">▸</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </section>
      </div>

      <!-- Applied Insights -->
      <section class="case-section applied-section">
        <div class="section-kicker mono">
          <span class="accent-glyph">⚡</span>
          <span>TRANSFERABLE ENGINEERING INSIGHTS APPLIED TO ROBOTICS PROJECTS</span>
        </div>
        <div class="applied-card">
          <ul class="applied-list">
            {exp.appliedLearnings.map((item) => (
              <li class="applied-item">
                <span class="applied-bullet mono">✓</span>
                <span class="applied-text">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- Supporting Clinical Imagery -->
      <section class="case-section gallery-section">
        <h2 class="section-kicker mono">CLINICAL IMMERSION ARTIFACTS</h2>
        <div class="clinical-gallery-grid">
          <div
            class="gallery-card"
            data-lightbox={resolveMediaUrl(exp.secondaryImage)}
            data-title="Sterile Operating Suite Immersion"
            data-badge="CLINICAL ENVIRONMENT"
            data-caption="Naveen Shaji George in sterile surgical scrubs, cap, and mask inside the live operating suite at Muthoot Hospitals."
          >
            <img src={resolveMediaUrl(exp.secondaryImage)} alt="Sterile Operating Suite Immersion" class="gallery-img img-expandable" loading="lazy" />
            <div class="gallery-info mono">
              <span class="info-badge">CLINICAL SUITE</span>
              <span class="info-desc">Operating Theatre Sterile Scrubs &amp; Environment</span>
            </div>
          </div>

          <div
            class="gallery-card"
            data-lightbox={resolveMediaUrl(exp.imagePath)}
            data-title="CMR Versius Bedside Robotic Arms"
            data-badge="ROBOT HARDWARE"
            data-caption="Modular bedside robotic arm units configured with articulated laparoscopic surgical instruments."
          >
            <img src={resolveMediaUrl(exp.imagePath)} alt="CMR Versius Bedside Robotic Arms" class="gallery-img img-expandable" loading="lazy" />
            <div class="gallery-info mono">
              <span class="info-badge">ROBOTIC ARMS</span>
              <span class="info-desc">Modular Patient Bedside Articulated Arms</span>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .experience-page {
    background: var(--bg-primary);
    min-height: 100vh;
    padding-top: calc(var(--nav-height) + var(--space-8));
    padding-bottom: var(--space-24);
  }

  .exp-container {
    max-width: var(--max-width-content);
    margin: 0 auto;
    padding-inline: var(--space-6);
  }

  .exp-nav-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--dur-micro) var(--ease-out);
  }

  .back-link:hover {
    color: var(--color-gold);
  }

  .exp-meta-pill {
    font-size: 0.65rem;
    color: var(--color-gold);
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .exp-hero {
    margin-bottom: var(--space-8);
  }

  .exp-domain {
    font-size: var(--text-xs);
    color: var(--color-gold);
    font-weight: 700;
    letter-spacing: 0.06em;
    margin-bottom: var(--space-2);
  }

  .exp-title {
    font-size: var(--text-4xl);
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.15;
    margin-bottom: var(--space-2);
  }

  .exp-subtitle {
    font-size: var(--text-base);
    color: var(--text-muted);
    margin-bottom: var(--space-6);
  }

  .exp-attributes {
    display: flex;
    gap: var(--space-6);
    flex-wrap: wrap;
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-subtle);
  }

  .attr-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .attr-label {
    font-size: 0.6rem;
    color: var(--text-dim);
    letter-spacing: 0.06em;
  }

  .attr-val {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--text-primary);
  }

  .status-val {
    color: var(--color-gold);
  }

  .exp-hero-visual {
    margin-bottom: var(--space-12);
  }

  .exp-video-box {
    position: relative;
    border-radius: var(--r-card);
    overflow: hidden;
    background: #000;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-hover);
  }

  .exp-main-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video-hud-overlay {
    position: absolute;
    bottom: 12px;
    left: 12px;
    right: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.68rem;
    color: #F8FAFC;
    background: rgba(14, 17, 23, 0.85);
    backdrop-filter: blur(8px);
    padding: 6px 12px;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .hud-dot {
    color: #EF4444;
  }

  .case-section {
    margin-bottom: var(--space-12);
  }

  .section-kicker {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: var(--space-4);
  }

  .summary-lead {
    font-size: var(--text-lg);
    line-height: 1.7;
    color: var(--text-primary);
  }

  .scope-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    margin-bottom: var(--space-12);
  }

  .col-box {
    background: var(--surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--r-card);
    padding: var(--space-6);
    box-shadow: var(--shadow-resting);
  }

  .clean-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .clean-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .bullet {
    font-size: 0.6rem;
    color: var(--color-gold);
    margin-top: 3px;
    flex-shrink: 0;
  }

  .applied-card {
    background: rgba(184, 146, 74, 0.05);
    border: 1px solid rgba(184, 146, 74, 0.25);
    border-radius: var(--r-card);
    padding: var(--space-6);
  }

  .applied-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .applied-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: var(--text-sm);
    color: var(--text-primary);
    line-height: 1.6;
  }

  .applied-bullet {
    color: var(--color-gold);
    font-weight: 800;
    margin-top: 1px;
    flex-shrink: 0;
  }

  .clinical-gallery-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }

  .gallery-card {
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-resting);
    cursor: pointer;
  }

  .gallery-img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    transition: transform var(--dur-norm) var(--ease-out);
  }

  .gallery-card:hover .gallery-img {
    transform: scale(1.03);
  }

  .gallery-info {
    padding: var(--space-3) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 2px;
    border-top: 1px solid var(--border-subtle);
  }

  .info-badge {
    font-size: 0.62rem;
    font-weight: 700;
    color: var(--color-gold);
  }

  .info-desc {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .scope-grid,
    .clinical-gallery-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  function setupExpDetailVideo() {
    const video = document.querySelector<HTMLVideoElement>('.exp-main-video');
    if (!video) return;

    video.muted = true;

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        });
      }, { rootMargin: '100px 0px 100px 0px', threshold: 0.1 });

      observer.observe(video);
    } else {
      video.play().catch(() => {});
    }
  }

  document.addEventListener('DOMContentLoaded', setupExpDetailVideo);
  document.addEventListener('astro:page-load', setupExpDetailVideo);
</script>
