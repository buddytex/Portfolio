---
// Dedicated Projects Media Experience: /projects
// Naveen Shaji George · Precision Robotics & Autonomous Systems
// Pure Media-First Masonry Wall · Natural Aspect Ratios · Narrow Margins · Hover-Only Metadata
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import { projectMediaCollage } from '../../data/projectMediaCollage';
import { resolveMediaUrl } from '../../utils/media';

const totalArtifacts = projectMediaCollage.length;
const heroLeft = projectMediaCollage.filter((item) => item.isHeroVehicle && item.heroPlacement === 'left');
const heroRight = projectMediaCollage.filter((item) => item.isHeroVehicle && item.heroPlacement === 'right');
const standardItems = projectMediaCollage.filter((item) => !item.isHeroVehicle);

// Domain filter categories
const filterTabs = [
  { id: 'all', label: 'ALL SYSTEMS', count: totalArtifacts },
  { id: 'autonomous', label: 'AUTONOMOUS VEHICLES', count: projectMediaCollage.filter(i => i.category === 'autonomous').length },
  { id: 'robotics', label: 'ROBOTICS & SLAM', count: projectMediaCollage.filter(i => i.category === 'robotics').length },
  { id: 'vision', label: 'COMPUTER VISION', count: projectMediaCollage.filter(i => i.category === 'vision').length },
  { id: 'embedded', label: 'EMBEDDED & HARDWARE', count: projectMediaCollage.filter(i => i.category === 'embedded' || i.category === 'hardware').length },
];
---

<Layout
  title="Projects Media Archive — Naveen Shaji George"
  description="Immersive editorial engineering archive of autonomous competition vehicles, multi-agent swarm platforms, custom 4-layer ECUs, and real-time computer vision systems."
  showSpine={false}
>
  <Navigation />

  <!-- Dedicated Dark Atmosphere Page Wrapper -->
  <div class="projects-experience-root" id="projectsExperience">
    <!-- Ambient Scroll-Graded Dynamic Background Canvases -->
    <div class="ambient-gradient-layer" id="ambientGradientLayer" aria-hidden="true">
      <div class="gradient-stage stage-graphite active"></div>
      <div class="gradient-stage stage-navy" id="stageNavy"></div>
      <div class="gradient-stage stage-slate" id="stageSlate"></div>
      <div class="gradient-stage stage-burgundy" id="stageBurgundy"></div>
      <div class="gradient-stage stage-forest" id="stageForest"></div>
    </div>

    <!-- Interactive Background Circuit Network Canvas -->
    <canvas id="collageCircuitCanvas" class="collage-circuit-canvas" aria-hidden="true"></canvas>

    <!-- Subtle Technical Grid & Grain Overlay -->
    <div class="technical-grid-mesh" aria-hidden="true"></div>

    <main class="collage-container" id="mainContent">
      <!-- Ultra-Minimal Category Filter Strip (Zero Text Clutter, Narrow Padding) -->
      <div class="archive-compact-bar">
        <div class="filter-strip" role="tablist" aria-label="Filter Media by Engineering Domain">
          {filterTabs.map((tab, idx) => (
            <button
              class:list={['filter-pill mono', { active: idx === 0 }]}
              data-category={tab.id}
              role="tab"
              aria-selected={idx === 0 ? "true" : "false"}
            >
              <span class="tab-label">{tab.label}</span>
              <span class="tab-count">[{tab.count}]</span>
            </button>
          ))}
        </div>
      </div>

      <!-- Top Featured Baja Vehicles Showcase (Enlarged Hero Display on Top) -->
      {(heroLeft.length > 0 || heroRight.length > 0) && (
        <section class="top-vehicles-showcase" id="topVehiclesShowcase" data-category="autonomous">
          <div class="top-vehicles-grid">
            <div class="top-vehicle-col left-col">
              {heroLeft.map((item) => (
                <article
                  class="collage-item top-vehicle-card"
                  data-item-id={item.id}
                  data-project-id={item.projectId}
                  data-category={item.category}
                >
                  <a
                    href={item.href || `/projects/${item.projectId}`}
                    class="tile-link"
                    aria-label={`Inspect ${item.projectTitle}: ${item.title}`}
                  >
                    <div class="media-wrap">
                      {item.type === 'video' ? (
                        <div class="video-shell">
                          <video
                            poster={item.poster ? resolveMediaUrl(item.poster) : undefined}
                            autoplay
                            loop
                            muted
                            playsinline
                            preload="metadata"
                            class="collage-video-el"
                            data-video-id={item.id}
                          >
                            <source src={resolveMediaUrl(item.src)} type="video/mp4" />
                          </video>
                          <div class="video-indicator-badge mono" aria-hidden="true">
                            <span class="live-dot">●</span>
                            <span>LIVE</span>
                          </div>
                        </div>
                      ) : (
                        <img
                          src={resolveMediaUrl(item.src)}
                          alt={`${item.projectTitle} — ${item.title}`}
                          class="collage-img-el vehicle-hero-img"
                          loading="eager"
                          decoding="async"
                        />
                      )}
                    </div>
                    <div class="tile-hover-scrim">
                      <div class="hover-card-inner">
                        <div class="hover-top mono">
                          <span class="hover-project-pill">[ {item.projectTitle.toUpperCase()} ]</span>
                          <span class="hover-category">{item.category.toUpperCase()}</span>
                        </div>
                        <div class="hover-bottom">
                          <h3 class="hover-title">{item.title}</h3>
                          <p class="hover-metric mono">{item.technicalMetric}</p>
                          <div class="hover-cta-badge mono">
                            <span>INSPECT VEHICLE</span>
                            <span class="hover-cta-arrow">→</span>
                          </div>
                        </div>
                      </div>
                    </div>
                  </a>
                </article>
              ))}
            </div>

            <div class="top-vehicle-col right-col">
              {heroRight.map((item) => (
                <article
                  class="collage-item top-vehicle-card"
                  data-item-id={item.id}
                  data-project-id={item.projectId}
                  data-category={item.category}
                >
                  <a
                    href={item.href || `/projects/${item.projectId}`}
                    class="tile-link"
                    aria-label={`Inspect ${item.projectTitle}: ${item.title}`}
                  >
                    <div class="media-wrap">
                      {item.type === 'video' ? (
                        <div class="video-shell">
                          <video
                            poster={item.poster ? resolveMediaUrl(item.poster) : undefined}
                            autoplay
                            loop
                            muted
                            playsinline
                            preload="metadata"
                            class="collage-video-el"
                            data-video-id={item.id}
                          >
                            <source src={resolveMediaUrl(item.src)} type="video/mp4" />
                          </video>
                          <div class="video-indicator-badge mono" aria-hidden="true">
                            <span class="live-dot">●</span>
                            <span>LIVE</span>
                          </div>
                        </div>
                      ) : (
                        <img
                          src={resolveMediaUrl(item.src)}
                          alt={`${item.projectTitle} — ${item.title}`}
                          class="collage-img-el vehicle-hero-img"
                          loading="eager"
                          decoding="async"
                        />
                      )}
                    </div>
                    <div class="tile-hover-scrim">
                      <div class="hover-card-inner">
                        <div class="hover-top mono">
                          <span class="hover-project-pill">[ {item.projectTitle.toUpperCase()} ]</span>
                          <span class="hover-category">{item.category.toUpperCase()}</span>
                        </div>
                        <div class="hover-bottom">
                          <h3 class="hover-title">{item.title}</h3>
                          <p class="hover-metric mono">{item.technicalMetric}</p>
                          <div class="hover-cta-badge mono">
                            <span>INSPECT VEHICLE</span>
                            <span class="hover-cta-arrow">→</span>
                          </div>
                        </div>
                      </div>
                    </div>
                  </a>
                </article>
              ))}
            </div>
          </div>
        </section>
      )}

      <!-- Pure Media-First Masonry Wall: Natural Proportions, Zero Cropping, Full Width -->
      <section class="media-wall-section" aria-label="Engineering Media Wall">
        <div class="media-masonry-wall" id="collageGrid">
          {standardItems.map((item, idx) => (
            <article
              class="collage-item"
              data-item-id={item.id}
              data-project-id={item.projectId}
              data-category={item.category}
            >
              <a
                href={item.href || (item.projectId === 'surgical-robotics' ? '/experience/surgical-robotics' : `/projects/${item.projectId}`)}
                class="tile-link"
                aria-label={`Inspect ${item.projectTitle}: ${item.title}`}
              >
                <!-- Media Stage (Exact Natural Dimensions, No Forced Cropping) -->
                <div class="media-wrap">
                  {item.type === 'video' ? (
                    <div class="video-shell">
                      <video
                        poster={item.poster ? resolveMediaUrl(item.poster) : undefined}
                        autoplay
                        loop
                        muted
                        playsinline
                        preload="metadata"
                        class="collage-video-el"
                        data-video-id={item.id}
                      >
                        <source src={resolveMediaUrl(item.src)} type="video/mp4" />
                      </video>
                      <div class="video-indicator-badge mono" aria-hidden="true">
                        <span class="live-dot">●</span>
                        <span>LIVE</span>
                      </div>
                    </div>
                  ) : (
                    <img
                      src={resolveMediaUrl(item.src)}
                      alt={`${item.projectTitle} — ${item.title}`}
                      class="collage-img-el"
                      loading={idx < 8 ? "eager" : "lazy"}
                      decoding="async"
                    />
                  )}
                </div>

                <!-- Hover-Only Technical Scrim (Zero text in default state) -->
                <div class="tile-hover-scrim">
                  <div class="hover-card-inner">
                    <div class="hover-top mono">
                      <span class="hover-project-pill">[ {item.projectTitle.toUpperCase()} ]</span>
                      <span class="hover-category">{item.category.toUpperCase()}</span>
                    </div>

                    <div class="hover-bottom">
                      <h3 class="hover-title">{item.title}</h3>
                      <p class="hover-metric mono">{item.technicalMetric}</p>
                      <div class="hover-cta-badge mono">
                        <span>{item.projectId === 'surgical-robotics' ? 'INSPECT INTERNSHIP' : 'INSPECT SYSTEM'}</span>
                        <span class="hover-cta-arrow">→</span>
                      </div>
                    </div>
                  </div>
                </div>
              </a>
            </article>
          ))}
        </div>

        <!-- Empty Filter State -->
        <div class="empty-collage-state" id="emptyCollageState" style="display: none;">
          <span class="empty-code mono">[ ARTIFACTS_FILTER_EMPTY ]</span>
          <p class="empty-text">No technical artifacts match this domain filter.</p>
          <button class="empty-reset-btn mono" id="resetCollageFilter">RESET FILTER</button>
        </div>
      </section>

      <!-- Return to Light Portfolio Horizon Link -->
      <div class="collage-footer-nav">
        <a href="/" class="return-home-btn mono">
          <span class="ret-arrow">←</span>
          <span>RETURN TO OVERVIEW PORTFOLIO</span>
        </a>
      </div>
    </main>

    <Footer dark={true} />
  </div>
</Layout>

<style>
  /* Root Dark Theme Container */
  .projects-experience-root {
    position: relative;
    min-height: 100vh;
    background-color: #0B0E14;
    color: #E2E8F0;
    overflow-x: hidden;
  }

  /* Ambient Dynamic Background Gradients Tied to Scroll */
  .ambient-gradient-layer {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .gradient-stage {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .stage-graphite {
    background: radial-gradient(circle at 50% 20%, #151922 0%, #0B0E14 100%);
    opacity: 1;
  }

  .stage-navy {
    background: radial-gradient(circle at 60% 30%, #0D1B2E 0%, #09101C 100%);
  }

  .stage-slate {
    background: radial-gradient(circle at 40% 40%, #111E2E 0%, #0A121D 100%);
  }

  .stage-burgundy {
    background: radial-gradient(circle at 50% 50%, #20111A 0%, #0D0A11 100%);
  }

  .stage-forest {
    background: radial-gradient(circle at 45% 60%, #09201C 0%, #081212 100%);
  }

  /* Technical Grid Mesh Overlay */
  .technical-grid-mesh {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(circle at center, black 40%, transparent 90%);
  }

  /* Circuit Canvas Network */
  .collage-circuit-canvas {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 1;
  }

  /* Full-Bleed Container with Narrow Margins */
  .collage-container {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: calc(var(--nav-height, 64px) + 8px) 12px 24px;
    box-sizing: border-box;
  }

  /* Ultra-Minimal Filter Strip */
  .archive-compact-bar {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 12px;
    padding: 0 4px;
  }

  .filter-strip {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: rgba(15, 20, 28, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 9999px;
    padding: 4px 6px;
    backdrop-filter: blur(12px);
  }

  .filter-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 12px;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 9999px;
    color: #94A3B8;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .filter-pill:hover {
    background: rgba(245, 158, 11, 0.08);
    color: #F8FAFC;
    border-color: rgba(245, 158, 11, 0.3);
  }

  .filter-pill.active {
    background: rgba(245, 158, 11, 0.16);
    border-color: #F59E0B;
    color: #FDE68A;
    box-shadow: 0 0 12px rgba(245, 158, 11, 0.2);
  }

  .tab-count {
    opacity: 0.65;
    font-size: 0.66rem;
  }

  /* ============================================================
     TOP FEATURED BAJA VEHICLES: ENLARGED HERO GRID
     ============================================================ */
  .top-vehicles-showcase {
    width: 100%;
    margin-bottom: 12px;
  }

  .top-vehicles-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    align-items: start;
    width: 100%;
  }

  .top-vehicle-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    min-width: 0;
  }

  @media (max-width: 860px) {
    .top-vehicles-grid {
      grid-template-columns: 1fr;
      gap: 10px;
    }
  }

  .top-vehicle-card {
    width: 100%;
    margin-bottom: 0;
  }

  .top-vehicle-card .media-wrap {
    width: 100%;
    height: auto;
    overflow: hidden;
    position: relative;
    background: #090B0F;
  }

  .top-vehicle-card .vehicle-hero-img,
  .top-vehicle-card .collage-video-el {
    width: 100%;
    height: auto;
    display: block;
    object-fit: unset;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), filter 0.3s ease;
  }

  .top-vehicle-card:hover .vehicle-hero-img,
  .top-vehicle-card:hover .collage-video-el {
    transform: scale(1.02);
    filter: brightness(1.03) contrast(1.06);
  }

  /* ============================================================
     TRUE MASONRY WALL: NATURAL PROPORTIONS, EXACT SIZES
     ============================================================ */
  .media-wall-section {
    width: 100%;
  }

  .media-masonry-wall {
    column-count: 4;
    column-gap: 12px;
    width: 100%;
  }

  @media (min-width: 1920px) {
    .media-masonry-wall {
      column-count: 5;
      column-gap: 14px;
    }
  }

  @media (max-width: 1350px) {
    .media-masonry-wall {
      column-count: 3;
      column-gap: 10px;
    }
  }

  @media (max-width: 860px) {
    .media-masonry-wall {
      column-count: 2;
      column-gap: 8px;
    }
  }

  @media (max-width: 520px) {
    .media-masonry-wall {
      column-count: 1;
      column-gap: 8px;
    }
  }

  /* Individual Collage Item */
  .collage-item {
    break-inside: avoid;
    margin-bottom: 12px;
    position: relative;
    border-radius: 4px;
    overflow: hidden;
    background: #0E1118;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.45);
    display: inline-block;
    width: 100%;
    vertical-align: top;
    transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
  }

  .collage-item:hover {
    border-color: rgba(245, 158, 11, 0.65);
    box-shadow: 0 12px 28px -6px rgba(0, 0, 0, 0.7), 0 0 16px rgba(245, 158, 11, 0.18);
    transform: translateY(-2px);
    z-index: 5;
  }

  .tile-link {
    display: block;
    width: 100%;
    text-decoration: none;
    color: inherit;
    position: relative;
  }

  .media-wrap {
    width: 100%;
    height: auto;
    position: relative;
    overflow: hidden;
    background: #0E1118;
  }

  /* NO object-fit: cover! Exact natural image size without stretching or cropping */
  .collage-img-el,
  .collage-video-el {
    width: 100%;
    height: auto;
    display: block;
    filter: brightness(0.95) contrast(1.04);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), filter 0.3s ease;
  }

  .collage-item:hover .collage-img-el,
  .collage-item:hover .collage-video-el {
    transform: scale(1.02);
    filter: brightness(1.02) contrast(1.06);
  }

  .video-shell {
    position: relative;
    width: 100%;
  }

  .video-indicator-badge {
    position: absolute;
    top: 8px;
    right: 8px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: rgba(0, 0, 0, 0.75);
    border: 1px solid rgba(245, 158, 11, 0.35);
    padding: 2px 6px;
    border-radius: 3px;
    font-size: 0.58rem;
    color: #F8FAFC;
    letter-spacing: 0.08em;
    backdrop-filter: blur(6px);
    z-index: 3;
    pointer-events: none;
  }

  .live-dot {
    color: #10B981;
    font-size: 0.5rem;
    animation: livePip 1.8s infinite ease-in-out;
  }

  @keyframes livePip {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  /* Hover-Only Technical Scrim (Zero text in default state) */
  .tile-hover-scrim {
    position: absolute;
    inset: 0;
    z-index: 10;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: stretch;
    padding: 16px;
    background: rgba(11, 14, 20, 0.88);
    backdrop-filter: blur(5px);
    opacity: 0;
    transition: opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }

  .collage-item:hover .tile-hover-scrim {
    opacity: 1;
  }

  .hover-card-inner {
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: rgba(22, 27, 38, 0.7);
    border: 1px solid rgba(245, 158, 11, 0.3);
    border-radius: 4px;
    padding: 14px 12px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6);
  }

  .hover-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.62rem;
    letter-spacing: 0.06em;
  }

  .hover-project-pill {
    color: #F59E0B;
    font-weight: 700;
    background: rgba(245, 158, 11, 0.15);
    padding: 2px 6px;
    border-radius: 3px;
    border: 1px solid rgba(245, 158, 11, 0.4);
  }

  .hover-category {
    color: #94A3B8;
  }

  .hover-bottom {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .hover-title {
    font-size: 0.88rem;
    font-weight: 700;
    color: #FFFFFF;
    line-height: 1.3;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.9);
    margin: 0;
  }

  .hover-metric {
    font-size: 0.68rem;
    color: #CBD5E1;
    line-height: 1.35;
    margin: 0;
  }

  .hover-cta-badge {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.65rem;
    font-weight: 700;
    color: #F59E0B;
    letter-spacing: 0.06em;
    padding-top: 6px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .hover-cta-arrow {
    transition: transform 0.2s ease;
  }

  .collage-item:hover .hover-cta-arrow {
    transform: translateX(3px);
  }

  /* Empty Filter State */
  .empty-collage-state {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 64px 24px;
    text-align: center;
    gap: 12px;
  }

  .empty-code {
    font-size: 0.8rem;
    color: #F59E0B;
  }

  .empty-text {
    font-size: 1.05rem;
    color: #94A3B8;
  }

  .empty-reset-btn {
    padding: 6px 16px;
    background: rgba(245, 158, 11, 0.15);
    border: 1px solid #F59E0B;
    border-radius: 9999px;
    color: #FDE68A;
    font-size: 0.72rem;
    cursor: pointer;
    letter-spacing: 0.06em;
  }

  /* Return to Light Portfolio Button */
  .collage-footer-nav {
    display: flex;
    justify-content: center;
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .return-home-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(245, 158, 11, 0.35);
    border-radius: 9999px;
    color: #F8FAFC;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .return-home-btn:hover {
    background: rgba(245, 158, 11, 0.15);
    border-color: #F59E0B;
    color: #FDE68A;
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(245, 158, 11, 0.2);
  }

  @media (prefers-reduced-motion: reduce) {
    .gradient-stage {
      transition: none;
    }
    .collage-img-el,
    .collage-video-el {
      transition: none;
    }
  }
</style>

<script>
  import { animate, isReducedMotion, stagger } from '../../animations';

  let videoObserver: IntersectionObserver | null = null;
  let circuitAnimationFrame: number | null = null;

  // ============================================================
  // 1. SCROLL COLOR ENVIRONMENT & BACKGROUND COLOR EVOLUTION
  // ============================================================
  function initScrollColorEvolution() {
    const stageNavy = document.getElementById('stageNavy');
    const stageSlate = document.getElementById('stageSlate');
    const stageBurgundy = document.getElementById('stageBurgundy');
    const stageForest = document.getElementById('stageForest');

    if (!stageNavy || !stageSlate || !stageBurgundy || !stageForest) return;

    let ticking = false;

    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progress = totalHeight > 0 ? Math.min(1, Math.max(0, window.scrollY / totalHeight)) : 0;

        // Stage 1: Navy (progress: 0.15 -> 0.35)
        const navyOp = progress < 0.1 ? 0 : progress < 0.3 ? (progress - 0.1) / 0.2 : progress < 0.45 ? 1 - (progress - 0.3) / 0.15 : 0;
        stageNavy.style.opacity = String(Math.min(1, Math.max(0, navyOp * 0.9)));

        // Stage 2: Slate (progress: 0.35 -> 0.58)
        const slateOp = progress < 0.3 ? 0 : progress < 0.5 ? (progress - 0.3) / 0.2 : progress < 0.68 ? 1 - (progress - 0.5) / 0.18 : 0;
        stageSlate.style.opacity = String(Math.min(1, Math.max(0, slateOp * 0.9)));

        // Stage 3: Burgundy (progress: 0.58 -> 0.80)
        const burgundyOp = progress < 0.52 ? 0 : progress < 0.7 ? (progress - 0.52) / 0.18 : progress < 0.85 ? 1 - (progress - 0.7) / 0.15 : 0;
        stageBurgundy.style.opacity = String(Math.min(1, Math.max(0, burgundyOp * 0.85)));

        // Stage 4: Forest Teal (progress: 0.78 -> 1.0)
        const forestOp = progress < 0.72 ? 0 : progress < 0.9 ? (progress - 0.72) / 0.18 : 1 - (progress - 0.9) / 0.1;
        stageForest.style.opacity = String(Math.min(1, Math.max(0, forestOp * 0.85)));

        ticking = false;
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  // ============================================================
  // 2. SOPHISTICATED CIRCUIT NETWORK CANVAS
  // ============================================================
  function initCollageCircuits() {
    const canvas = document.getElementById('collageCircuitCanvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    if (isReducedMotion()) return;

    let width = 0;
    let height = 0;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);

    function resize() {
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    resize();
    window.addEventListener('resize', resize, { passive: true });

    interface TraceNode {
      points: Array<{ x: number; y: number }>;
      pulses: Array<{ progress: number; speed: number; length: number; color: string }>;
    }

    const traces: TraceNode[] = [
      {
        points: [
          { x: 0, y: 160 },
          { x: 260, y: 160 },
          { x: 380, y: 280 },
          { x: 740, y: 280 },
          { x: 860, y: 160 },
          { x: 1920, y: 160 }
        ],
        pulses: [
          { progress: 0.1, speed: 0.0018, length: 70, color: '#F59E0B' },
          { progress: 0.6, speed: 0.0024, length: 90, color: 'rgba(255,255,255,0.85)' }
        ]
      },
      {
        points: [
          { x: 120, y: 0 },
          { x: 120, y: 360 },
          { x: 280, y: 520 },
          { x: 620, y: 520 },
          { x: 740, y: 640 },
          { x: 1920, y: 640 }
        ],
        pulses: [
          { progress: 0.3, speed: 0.0015, length: 80, color: '#D97706' },
          { progress: 0.8, speed: 0.0022, length: 60, color: '#F59E0B' }
        ]
      },
      {
        points: [
          { x: 400, y: 1080 },
          { x: 400, y: 750 },
          { x: 550, y: 600 },
          { x: 1050, y: 600 },
          { x: 1200, y: 450 },
          { x: 1920, y: 450 }
        ],
        pulses: [
          { progress: 0.05, speed: 0.002, length: 100, color: 'rgba(255,255,255,0.7)' },
          { progress: 0.55, speed: 0.0016, length: 75, color: '#F59E0B' }
        ]
      }
    ];

    let isVisible = true;

    function renderCircuits() {
      if (!isVisible) return;

      ctx.clearRect(0, 0, width, height);

      traces.forEach((trace) => {
        if (trace.points.length < 2) return;

        ctx.beginPath();
        ctx.moveTo(trace.points[0].x, trace.points[0].y);
        for (let i = 1; i < trace.points.length; i++) {
          ctx.lineTo(trace.points[i].x, trace.points[i].y);
        }
        ctx.strokeStyle = 'rgba(217, 119, 6, 0.12)';
        ctx.lineWidth = 1.2;
        ctx.stroke();

        trace.points.forEach((pt) => {
          ctx.beginPath();
          ctx.arc(pt.x, pt.y, 2.5, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(245, 158, 11, 0.35)';
          ctx.fill();
        });

        let totalLen = 0;
        const segmentLengths: number[] = [];
        for (let i = 0; i < trace.points.length - 1; i++) {
          const dx = trace.points[i + 1].x - trace.points[i].x;
          const dy = trace.points[i + 1].y - trace.points[i].y;
          const len = Math.hypot(dx, dy);
          segmentLengths.push(len);
          totalLen += len;
        }

        trace.pulses.forEach((pulse) => {
          pulse.progress += pulse.speed;
          if (pulse.progress > 1) pulse.progress = 0;

          const headDist = pulse.progress * totalLen;
          const tailDist = Math.max(0, headDist - pulse.length);

          function getPointAt(dist: number): { x: number; y: number } {
            let cur = 0;
            for (let i = 0; i < segmentLengths.length; i++) {
              if (cur + segmentLengths[i] >= dist) {
                const ratio = (dist - cur) / segmentLengths[i];
                return {
                  x: trace.points[i].x + (trace.points[i + 1].x - trace.points[i].x) * ratio,
                  y: trace.points[i].y + (trace.points[i + 1].y - trace.points[i].y) * ratio
                };
              }
              cur += segmentLengths[i];
            }
            return trace.points[trace.points.length - 1];
          }

          const head = getPointAt(headDist);
          const tail = getPointAt(tailDist);

          const grad = ctx.createLinearGradient(tail.x, tail.y, head.x, head.y);
          grad.addColorStop(0, 'rgba(217, 119, 6, 0)');
          grad.addColorStop(1, pulse.color);

          ctx.beginPath();
          ctx.moveTo(tail.x, tail.y);
          ctx.lineTo(head.x, head.y);
          ctx.strokeStyle = grad;
          ctx.lineWidth = 2.2;
          ctx.stroke();

          ctx.beginPath();
          ctx.arc(head.x, head.y, 2, 0, Math.PI * 2);
          ctx.fillStyle = pulse.color;
          ctx.fill();
        });
      });

      circuitAnimationFrame = requestAnimationFrame(renderCircuits);
    }

    circuitAnimationFrame = requestAnimationFrame(renderCircuits);

    document.addEventListener('visibilitychange', () => {
      isVisible = !document.hidden;
      if (isVisible && !circuitAnimationFrame) {
        circuitAnimationFrame = requestAnimationFrame(renderCircuits);
      }
    });
  }

  // ============================================================
  // 3. CONTINUOUS VIEWPORT-AWARE PROJECT VIDEOS
  // ============================================================
  function initCollageVideos() {
    if (videoObserver) {
      videoObserver.disconnect();
      videoObserver = null;
    }

    const videos = document.querySelectorAll<HTMLVideoElement>('.collage-video-el');
    if (videos.length === 0) return;

    const reducedMotion = isReducedMotion();

    videos.forEach((v) => {
      v.muted = true;
    });

    if ('IntersectionObserver' in window) {
      videoObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting && !reducedMotion) {
            const playPromise = video.play();
            if (playPromise !== undefined) {
              playPromise.catch(() => {});
            }
          } else {
            video.pause();
          }
        });
      }, { rootMargin: '100px 0px 100px 0px', threshold: 0.15 });

      videos.forEach((v) => videoObserver!.observe(v));
    } else {
      videos.forEach((v) => {
        if (!reducedMotion) v.play().catch(() => {});
      });
    }
  }

  // ============================================================
  // 4. CLIENT-SIDE DOMAIN FILTERING & STAGGER TRANSITIONS
  // ============================================================
  function initCollageFiltering() {
    const filterPills = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
    const items = document.querySelectorAll<HTMLElement>('.collage-item');
    const emptyState = document.getElementById('emptyCollageState');

    if (!isReducedMotion()) {
      animate(items, {
        opacity: [0, 1],
        translateY: [16, 0],
        duration: 500,
        delay: stagger(35),
        ease: 'outExpo',
      });
    } else {
      items.forEach((t) => {
        t.style.opacity = '1';
        t.style.transform = 'none';
      });
    }

    function applyCategory(catId: string) {
      let count = 0;
      const itemsToReveal: HTMLElement[] = [];

      items.forEach((item) => {
        const cat = item.dataset.category || '';
        let matches = false;

        if (catId === 'all') {
          matches = true;
        } else if (catId === 'autonomous') {
          matches = cat === 'autonomous';
        } else if (catId === 'robotics') {
          matches = cat === 'robotics';
        } else if (catId === 'vision') {
          matches = cat === 'vision';
        } else if (catId === 'embedded') {
          matches = cat === 'embedded' || cat === 'hardware';
        }

        if (matches) {
          item.style.display = item.classList.contains('top-vehicle-card') ? 'block' : 'inline-block';
          count++;
          itemsToReveal.push(item);
        } else {
          item.style.display = 'none';
        }
      });

      const topVehicles = document.getElementById('topVehiclesShowcase');
      if (topVehicles) {
        topVehicles.style.display = (catId === 'all' || catId === 'autonomous') ? 'block' : 'none';
      }

      if (!isReducedMotion() && itemsToReveal.length > 0) {
        animate(itemsToReveal, {
          opacity: [0, 1],
          translateY: [12, 0],
          duration: 350,
          delay: stagger(25),
          ease: 'outExpo',
        });
      }

      if (emptyState) {
        emptyState.style.display = count === 0 ? 'flex' : 'none';
      }

      filterPills.forEach((p) => {
        const isActive = p.dataset.category === catId;
        p.classList.toggle('active', isActive);
        p.setAttribute('aria-selected', String(isActive));
      });
    }

    filterPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const cat = pill.dataset.category;
        if (cat) applyCategory(cat);
      });
    });

    const resetBtn = document.getElementById('resetCollageFilter');
    if (resetBtn) {
      resetBtn.addEventListener('click', () => applyCategory('all'));
    }
  }

  // ============================================================
  // LIFECYCLE MANAGEMENT
  // ============================================================
  function setupProjectsPage() {
    initScrollColorEvolution();
    initCollageCircuits();
    initCollageVideos();
    initCollageFiltering();
  }

  document.addEventListener('DOMContentLoaded', setupProjectsPage);
  document.addEventListener('astro:page-load', () => {
    window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
    setupProjectsPage();
  });

  document.addEventListener('astro:before-swap', () => {
    if (circuitAnimationFrame) {
      cancelAnimationFrame(circuitAnimationFrame);
      circuitAnimationFrame = null;
    }
    if (videoObserver) {
      videoObserver.disconnect();
      videoObserver = null;
    }
  });
</script>
