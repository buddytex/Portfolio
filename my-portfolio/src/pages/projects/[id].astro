---
// Dynamic Project Case Study Route: /projects/[id]
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import { projects, type Project } from '../../data/projects';
import { resolveMediaUrl } from '../../utils/media';

export function getStaticPaths() {
  const paths = projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
  // Backward-compatible route aliases for aBAJA 2025 & 2026
  const baja25 = projects.find((p) => p.id === 'baja-2025');
  if (baja25) paths.push({ params: { id: 'abaja-2025' }, props: { project: baja25 } });
  const baja26 = projects.find((p) => p.id === 'baja-2026');
  if (baja26) paths.push({ params: { id: 'abaja-2026' }, props: { project: baja26 } });
  return paths;
}

interface Props {
  project: Project;
}

const { project } = Astro.props;

// Calculate previous & next projects in sequence for seamless case study navigation
const currentIndex = projects.findIndex((p) => p.id === project.id);
const safeIndex = currentIndex >= 0 ? currentIndex : 0;
const prevProject = safeIndex > 0 ? projects[safeIndex - 1] : projects[projects.length - 1];
const nextProject = safeIndex < projects.length - 1 ? projects[safeIndex + 1] : projects[0];
---

<Layout
  title={`${project.title} — Architectural Case Study | Naveen Shaji George`}
  description={project.summary}
  showSpine={false}
>
  <Navigation />

  <main class="project-page">
    <div class="container project-container">
      <!-- Back button to dedicated Projects Experience -->
      <div class="project-nav-bar">
        <a href="/projects" class="back-link mono">
          <span class="back-arrow" aria-hidden="true">←</span>
          <span>Back to Projects Archive</span>
        </a>
        <div class="project-meta-pill mono">
          <span>{project.index}</span>
          <span>/</span>
          <span>{String(projects.filter(p => p.featured).length).padStart(2, '0')}</span>
        </div>
      </div>

      <!-- Header Block -->
      <header class="project-hero">
        <div class="project-domain mono">{project.domain}</div>
        <h1 class="project-title" transition:name={`project-title-${project.id}`}>{project.title}</h1>
        <p class="project-subtitle">{project.subtitle}</p>

        <div class="project-attributes mono">
          <div class="attr-item">
            <span class="attr-label">ROLE</span>
            <span class="attr-val">{project.role}</span>
          </div>
          <div class="attr-item">
            <span class="attr-label">TIMELINE</span>
            <span class="attr-val">{project.year}</span>
          </div>
          <div class="attr-item">
            <span class="attr-label">STATUS</span>
            <span class="attr-val status-val">{project.status}</span>
          </div>
        </div>
      </header>

      <!-- Primary Hardware/Architecture Hero Visual Stage -->
      <div 
        class="project-hero-visual" 
        transition:name={`project-visual-${project.id}`}
        data-lightbox={project.imagePath}
        data-title={project.title}
        data-badge="PROJECT HERO ARTIFACT"
        data-caption={project.subtitle}
        title={project.imagePath ? "Click to view full uncropped photograph" : undefined}
      >
        {project.imagePath ? (
          <img
            src={project.imagePath}
            alt={`${project.title} Architecture Schematic`}
            class="project-hero-img img-expandable"
            loading="eager"
          />
        ) : project.id === 'balancing-robot' ? (
          <div class="project-hardware-blueprint" aria-label="Two-Wheeled Inverted Pendulum Robot Dynamic Balance Schematic">
            <svg viewBox="0 0 380 220" fill="none" class="blueprint-svg" aria-hidden="true">
              <line x1="20" y1="180" x2="360" y2="180" stroke="#64748B" stroke-width="1.5" stroke-dasharray="4 4" />
              <circle cx="190" cy="170" r="24" stroke="#0EA5E9" stroke-width="2" fill="#0EA5E9" fill-opacity="0.15" />
              <circle cx="190" cy="170" r="4" fill="#0EA5E9" />
              <line x1="190" y1="170" x2="225" y2="60" stroke="#38BDF8" stroke-width="3" stroke-linecap="round" />
              <line x1="190" y1="170" x2="190" y2="50" stroke="#94A3B8" stroke-width="1.2" stroke-dasharray="3 3" />
              <path d="M 190 110 A 60 60 0 0 1 209 113" stroke="#F59E0B" stroke-width="1.5" fill="none" />
              <text x="216" y="112" fill="#F59E0B" font-size="9" font-family="monospace" font-weight="bold">θ (TILT)</text>
              <circle cx="212" cy="100" r="6" fill="#F59E0B" stroke="#D97706" stroke-width="1.5" />
              <text x="224" y="98" fill="#64748B" font-size="7.5" font-family="monospace">MPU6050 6-DoF</text>
              <rect x="215" y="45" width="24" height="26" rx="3" fill="#0EA5E9" fill-opacity="0.25" stroke="#0EA5E9" stroke-width="1.5" transform="rotate(18 227 58)" />
              <path d="M 160 178 Q 190 195 220 178" stroke="#10B981" stroke-width="2" fill="none" />
              <text x="190" y="208" fill="#10B981" font-size="8" font-family="monospace" text-anchor="middle">u(t) = Kp·θ + Ki·∫θ + Kd·θ̇ // 200 HZ PID</text>
              <text x="190" y="25" fill="#64748B" font-size="8" font-family="monospace" text-anchor="middle">INVERTED PENDULUM CLOSED-LOOP STATE STABILIZATION</text>
            </svg>
          </div>
        ) : project.id === 'agv-sensor-fusion' ? (
          <div class="project-hardware-blueprint" aria-label="AGV Industrial Odometry & Sensor Fusion Schematic">
            <svg viewBox="0 0 380 220" fill="none" class="blueprint-svg" aria-hidden="true">
              <rect x="70" y="70" width="80" height="90" rx="6" fill="#0EA5E9" fill-opacity="0.12" stroke="#0EA5E9" stroke-width="1.8" />
              <rect x="62" y="85" width="10" height="25" rx="2" fill="#0EA5E9" />
              <rect x="148" y="85" width="10" height="25" rx="2" fill="#0EA5E9" />
              <text x="110" y="118" fill="#0EA5E9" font-size="8" font-family="monospace" font-weight="bold" text-anchor="middle">AGV BASE</text>
              <path d="M 155 98 L 220 65" stroke="#64748B" stroke-width="1.2" stroke-dasharray="2 2" />
              <circle cx="110" cy="115" r="4" fill="#F59E0B" />
              <path d="M 110 115 L 220 115" stroke="#F59E0B" stroke-width="1.2" stroke-dasharray="2 2" />
              <circle cx="110" cy="80" r="5" stroke="#10B981" stroke-width="1.5" />
              <path d="M 110 80 L 220 160" stroke="#10B981" stroke-width="1.2" stroke-dasharray="2 2" />
              <rect x="220" y="45" width="125" height="135" rx="5" fill="#0EA5E9" fill-opacity="0.18" stroke="#0EA5E9" stroke-width="1.5" />
              <text x="282" y="65" fill="#0EA5E9" font-size="8" font-family="monospace" font-weight="bold" text-anchor="middle">robot_localization</text>
              <line x1="228" y1="72" x2="337" y2="72" stroke="#64748B" stroke-width="0.8" opacity="0.5" />
              <text x="232" y="90" fill="#64748B" font-size="7" font-family="monospace">▸ WHEEL ENCODERS [50 Hz]</text>
              <text x="232" y="110" fill="#F59E0B" font-size="7" font-family="monospace">▸ 6-AXIS IMU [100 Hz]</text>
              <text x="232" y="130" fill="#10B981" font-size="7" font-family="monospace">▸ LASER ODOM [20 Hz]</text>
              <text x="232" y="150" fill="#38BDF8" font-size="7" font-family="monospace">▸ ZUPT DRIFT REJECTION</text>
              <text x="232" y="168" fill="#10B981" font-size="7.5" font-family="monospace" font-weight="bold">ESTIMATED POSE [x, y, θ]</text>
              <text x="190" y="206" fill="#64748B" font-size="8" font-family="monospace" text-anchor="middle">DUAL-EKF MULTI-RATE NON-LINEAR STATE ESTIMATION</text>
            </svg>
          </div>
        ) : (
          <div class="project-hardware-blueprint" aria-label="Decentralized Swarm Robotics Mesh Schematic">
            <svg viewBox="0 0 380 220" fill="none" class="blueprint-svg" aria-hidden="true">
              <line x1="90" y1="70" x2="190" y2="50" stroke="#0EA5E9" stroke-width="1.2" stroke-dasharray="2 2" opacity="0.6" />
              <line x1="190" y1="50" x2="290" y2="80" stroke="#0EA5E9" stroke-width="1.2" stroke-dasharray="2 2" opacity="0.6" />
              <line x1="90" y1="70" x2="140" y2="150" stroke="#0EA5E9" stroke-width="1.2" stroke-dasharray="2 2" opacity="0.6" />
              <line x1="140" y1="150" x2="240" y2="160" stroke="#0EA5E9" stroke-width="1.2" stroke-dasharray="2 2" opacity="0.6" />
              <line x1="240" y1="160" x2="290" y2="80" stroke="#0EA5E9" stroke-width="1.2" stroke-dasharray="2 2" opacity="0.6" />
              <line x1="190" y1="50" x2="240" y2="160" stroke="#0EA5E9" stroke-width="1.2" stroke-dasharray="2 2" opacity="0.4" />
              <g fill="#10B981">
                <circle cx="90" cy="70" r="7" /><circle cx="190" cy="50" r="7" /><circle cx="290" cy="80" r="7" />
                <circle cx="140" cy="150" r="7" /><circle cx="240" cy="160" r="7" />
              </g>
              <g fill="#FFFFFF" font-size="7" font-family="monospace" text-anchor="middle" font-weight="bold">
                <text x="90" y="73">01</text><text x="190" y="53">02</text><text x="290" y="83">03</text>
                <text x="140" y="153">04</text><text x="240" y="163">05</text>
              </g>
              <circle cx="190" cy="105" r="4" fill="#F59E0B" />
              <circle cx="190" cy="105" r="16" stroke="#F59E0B" stroke-width="1" stroke-dasharray="2 2" opacity="0.7" />
              <text x="190" y="130" fill="#FBBF24" font-size="7" font-family="monospace" text-anchor="middle">VIRTUAL TARGET ATTRACTOR</text>
              <text x="190" y="195" fill="#94A3B8" font-size="8" font-family="monospace" text-anchor="middle">ESP32 AD-HOC TCP/IP MESH // CONSENSUS</text>
            </svg>
          </div>
        )}
      </div>

      <!-- Executive Summary -->
      <section class="case-section summary-section">
        <h2 class="section-kicker mono">EXECUTIVE ENGINEERING SUMMARY</h2>
        <p class="summary-lead">{project.summary}</p>
      </section>

      {project.attribution && (
        <aside class="project-attribution-panel" aria-label="Open-Source Attribution">
          <div class="attr-panel-header">
            <span class="attr-pip" aria-hidden="true"></span>
            <span class="attr-kicker mono">[ OPEN-SOURCE PLATFORM REFERENCE &amp; EXPERIMENTAL STUDY ]</span>
          </div>
          <div class="attr-panel-body">
            <p class="attr-details">
              <strong>Source Framework:</strong> {project.attribution.project} developed by <a href={project.attribution.website} target="_blank" rel="noopener noreferrer" class="attr-link">{project.attribution.source}</a>. 
              Repository: <a href={project.attribution.repository} target="_blank" rel="noopener noreferrer" class="attr-link mono">{project.attribution.repository.replace('https://github.com/', '')}</a> · License: <span class="mono attr-license">{project.attribution.license}</span>.
            </p>
            <p class="attr-disclaimer">
              <em>Note: This architectural study and simulation benchmarking was conducted utilizing the open-source HeRo Common platform. All platform hardware and simulation imagery are respectfully attributed to VeRLab / UFMG.</em>
            </p>
          </div>
        </aside>
      )}

      <!-- Continuous Ambient Video Feature Block (Where Verified Video Exists) -->
      {project.featuredVideo && (
        <section class="case-section video-feature-section" aria-label="Live System Video Demonstration">
          <div class="video-feature-box">
            <video
              poster={resolveMediaUrl(project.featuredVideo.poster)}
              autoplay
              loop
              muted
              playsinline
              preload="metadata"
              class="ambient-project-video"
              title={project.featuredVideo.title}
            >
              <source src={resolveMediaUrl(project.featuredVideo.path)} type="video/mp4" />
            </video>
            <div class="video-feature-overlay mono">
              <div class="video-overlay-left">
                <span class="video-live-pip">●</span>
                <span class="video-feature-badge">{project.featuredVideo.badge}</span>
              </div>
              <div class="video-overlay-right">
                <span class="video-feature-title">{project.featuredVideo.title}</span>
                <button type="button" class="video-sound-toggle mono" aria-label="Toggle video sound" data-muted="true">
                  <span class="sound-icon" aria-hidden="true">🔈</span>
                  <span class="sound-label">UNMUTE</span>
                </button>
              </div>
            </div>
          </div>
          {project.featuredVideo.caption && (
            <p class="video-feature-caption mono">
              <span class="caption-arrow">↳</span> {project.featuredVideo.caption}
            </p>
          )}
        </section>
      )}

      <!-- Two-Column Problem & Approach -->
      <div class="problem-approach-grid">
        <section class="case-section col-box">
          <h2 class="section-kicker mono">THE ENGINEERING CHALLENGE</h2>
          <p class="col-text">{project.challenge}</p>
        </section>

        <section class="case-section col-box">
          <h2 class="section-kicker mono">SYSTEM DESIGN & APPROACH</h2>
          <p class="col-text">{project.approach}</p>
        </section>
      </div>

      <!-- Overall Team Vehicle Platform (Team System vs Personal Contribution) -->
      {project.teamSystem && project.teamSystem.length > 0 && (
        <section class="case-section team-system-section">
          <div class="section-kicker mono">
            <span class="accent-glyph">⚙</span>
            <span>OVERALL TEAM VEHICLE PLATFORM // MULTIDISCIPLINARY SCOPE</span>
          </div>
          <div class="team-system-card">
            <div class="team-system-lead mono">
              <span>DEVELOPED BY COLLEGIATE ENGINEERING TEAM // OVERALL VEHICLE ARCHITECTURE</span>
            </div>
            <ul class="team-system-list">
              {project.teamSystem.map((item) => (
                <li class="team-system-item">
                  <span class="team-bullet mono">◽</span>
                  <span class="team-text">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )}

      <!-- My Role & Personal Engineering Contributions -->
      {project.personalContributions && project.personalContributions.length > 0 && (
        <section class="case-section contributions-section">
          <div class="section-kicker mono">
            <span class="accent-glyph">⚡</span>
            <span>MY ROLE &amp; DIRECT TECHNICAL CONTRIBUTIONS</span>
          </div>
          <div class="contributions-card">
            <div class="contributions-lead mono">
              <span>DESIGNED &amp; BUILT BY NAVEEN SHAJI GEORGE // {project.shortRole.toUpperCase()}</span>
            </div>
            <ul class="contributions-list">
              {project.personalContributions.map((contrib) => (
                <li class="contribution-item">
                  <span class="contrib-bullet mono">▸</span>
                  <span class="contrib-text">{contrib}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )}

      <!-- Personal Engineering Story: Built When It Had to Be Built / Taking Ownership -->
      {project.ownershipStory && (
        <section class="case-section ownership-section" aria-labelledby="ownershipHeading">
          <div class="section-kicker mono text-gold">
            <span class="accent-glyph">★</span>
            <span id="ownershipHeading">ENGINEERING ACCOUNTABILITY // CRITICAL PIVOT</span>
          </div>
          <div class="ownership-card">
            <h3 class="ownership-title">{project.ownershipStory.title}</h3>
            <p class="ownership-narrative">{project.ownershipStory.narrative}</p>
            <div class="ownership-takeaways">
              <span class="takeaway-label mono">CORE DEMONSTRATED CAPABILITIES:</span>
              <ul class="takeaways-list">
                {project.ownershipStory.takeaways.map((takeaway) => (
                  <li class="takeaway-item">
                    <span class="takeaway-bullet mono text-gold">▸</span>
                    <span>{takeaway}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </section>
      )}

      <!-- Architectural Decisions & Engineering Constraints -->
      {project.engineeringDecisions && project.engineeringDecisions.length > 0 && (
        <section class="case-section decisions-section">
          <div class="section-kicker mono">
            <span class="accent-glyph">⚖</span>
            <span>CRITICAL ARCHITECTURAL DECISIONS &amp; TRADE-OFFS</span>
          </div>
          <div class="decisions-grid">
            {project.engineeringDecisions.map((decision, dIdx) => (
              <div class="decision-card">
                <span class="decision-num mono">DECISION 0{dIdx + 1}</span>
                <p class="decision-text">{decision}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Skills & Disciplines Validated -->
      {project.skillsUsed && project.skillsUsed.length > 0 && (
        <section class="case-section skills-applied-section">
          <div class="section-kicker mono">COMPETENCIES APPLIED &amp; VALIDATED</div>
          <div class="skills-applied-chips mono">
            {project.skillsUsed.map((skillName) => (
              <a href="/#skills" class="skill-applied-chip" title="Inspect competency in Skills Network">
                <span class="chip-dot"></span>
                <span>{skillName}</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- System Architecture Breakdown -->
      <section class="case-section architecture-section">
        <h2 class="section-kicker mono">SYSTEM ARCHITECTURE & PIPELINE</h2>
        <div class="arch-flow">
          {project.systemArchitecture.map((stage, idx) => (
            <div class="arch-stage">
              <div class="stage-num mono">STAGE 0{idx + 1}</div>
              <div class="stage-name">{stage}</div>
              {idx < project.systemArchitecture.length - 1 && (
                <div class="stage-connector" aria-hidden="true">↓</div>
              )}
            </div>
          ))}
        </div>
      </section>

      <!-- Hardware & Software Grid -->
      <div class="stack-grid">
        <!-- Hardware -->
        <section class="case-section stack-box">
          <h2 class="section-kicker mono">HARDWARE ARCHITECTURE</h2>
          <ul class="stack-list">
            {project.hardwareStack.map((hw) => (
              <li class="stack-item">
                <span class="bullet mono">■</span>
                <span>{hw}</span>
              </li>
            ))}
          </ul>
        </section>

        <!-- Software -->
        <section class="case-section stack-box">
          <h2 class="section-kicker mono">SOFTWARE & CONTROLLER STACK</h2>
          <ul class="stack-list">
            {project.softwareStack.map((sw) => (
              <li class="stack-item">
                <span class="bullet mono text-cyan">●</span>
                <span>{sw}</span>
              </li>
            ))}
          </ul>
        </section>
      </div>

      <!-- Physical Engineering Artifacts & Live Testing Dossier -->
      {project.mediaGalleries && project.mediaGalleries.length > 0 && (
        <section class="case-section dossier-section" id="engineeringDossier">
          <div class="dossier-head">
            <div class="dossier-eyebrow-wrap">
              <span class="dossier-badge mono">[ EMPIRICAL PROOF ]</span>
              <span class="dossier-pip" aria-hidden="true"></span>
              <span class="dossier-count mono">{project.mediaGalleries.reduce((acc, g) => acc + g.items.length, 0)} ARTIFACTS VERIFIED</span>
            </div>
            <h2 class="dossier-title">Physical Hardware, Field Verification &amp; Testing Dossier</h2>
            <p class="dossier-subtitle">
              Authentic multi-discipline documentation, high-resolution hardware photography, and live execution videos from vehicle and lab testbeds.
            </p>

            <!-- Interactive Tab Selector -->
            <div class="dossier-tabs" role="tablist" aria-label="Engineering Artifact Categories">
              {project.mediaGalleries.map((gallery, gIdx) => (
                <button
                  type="button"
                  class:list={['dossier-tab-btn mono', { active: gIdx === 0 }]}
                  id={`tab-btn-${gallery.id}`}
                  data-gallery-id={gallery.id}
                  role="tab"
                  aria-selected={gIdx === 0 ? "true" : "false"}
                  aria-controls={`panel-${gallery.id}`}
                >
                  <span class="tab-idx">0{gIdx + 1}</span>
                  <span class="tab-title">{gallery.title}</span>
                  <span class="tab-count mono">({gallery.items.length})</span>
                </button>
              ))}
            </div>
          </div>

          <!-- Gallery Panels -->
          <div class="dossier-panels">
            {project.mediaGalleries.map((gallery, gIdx) => (
              <div
                class:list={['dossier-panel', { active: gIdx === 0 }]}
                id={`panel-${gallery.id}`}
                role="tabpanel"
                aria-labelledby={`tab-btn-${gallery.id}`}
                hidden={gIdx !== 0}
              >
                <div class="dossier-grid">
                  {gallery.items.map((item, itemIdx) => (
                    <article 
                      class="artifact-tile" 
                      data-item-type={item.type}
                      data-lightbox={item.type !== 'video' ? item.path : undefined}
                      data-title={item.title}
                      data-caption={item.caption}
                      data-badge={item.badge || `ARTIFACT 0${itemIdx + 1}`}
                      title={item.type !== 'video' ? "Click to view full uncropped photograph" : undefined}
                    >
                      <div class="tile-media-stage">
                        {item.type === 'video' ? (
                          <div class="video-container">
                            <video
                              poster={resolveMediaUrl(item.poster)}
                              controls
                              preload="metadata"
                              playsinline
                              muted
                              class="artifact-video"
                            >
                              <source src={resolveMediaUrl(item.path)} type="video/mp4" />
                            </video>
                            <span class="video-pill mono">
                              <span class="video-pulse">●</span>
                              <span>LIVE TEST VIDEO</span>
                            </span>
                          </div>
                        ) : (() => {
                          const isTechnicalDoc = (item.badge && /(CERT|DOC|SCHEMATIC|CAD|LAYER|DIAGRAM|PCB)/i.test(item.badge)) ||
                                                 (item.title && /(certificate|schematic|diagram|drawing|gerber)/i.test(item.title)) ||
                                                 (item.path && /(certificate|schematic|diagram|drawing)/i.test(item.path));
                          return (
                            <div class:list={["image-container", { "is-contain-box": isTechnicalDoc, "is-cover-box": !isTechnicalDoc }]}>
                              <img
                                src={item.path}
                                alt={item.title}
                                class:list={["artifact-img", isTechnicalDoc ? "img-contain" : "img-cover"]}
                                loading="lazy"
                              />
                              {item.badge && (
                                <span class="tile-badge mono">{item.badge}</span>
                              )}
                            </div>
                          );
                        })()}
                      </div>
                      <div class="tile-caption-block">
                        <div class="tile-meta-row">
                          <span class="tile-num mono">ARTIFACT 0{itemIdx + 1}</span>
                          <span class="tile-type mono">[{item.type.toUpperCase()}]</span>
                        </div>
                        <h4 class="tile-title">{item.title}</h4>
                        {item.caption && <p class="tile-caption">{item.caption}</p>}
                      </div>
                    </article>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Research Notebook: Failures, Physical Noise & Iterative Resolutions -->
      {project.failuresAndIterations && project.failuresAndIterations.length > 0 && (
        <section class="case-section notebook-section">
          <div class="notebook-head">
            <span class="notebook-badge mono">RESEARCH NOTEBOOK // EMPIRICAL ITERATION</span>
            <h2 class="section-kicker mono">FAILURES, PHYSICAL NOISE &amp; ENGINEERING RESOLUTIONS</h2>
          </div>
          <div class="notebook-grid">
            {project.failuresAndIterations.map((entry, idx) => (
              <div class="notebook-card">
                <div class="notebook-step mono">CYCLE 0{idx + 1}</div>
                <div class="notebook-body">
                  <div class="notebook-field">
                    <span class="field-label mono">ENCOUNTERED FAILURE / NOISE:</span>
                    <p class="field-value anomaly">{entry.issue}</p>
                  </div>
                  <div class="notebook-field">
                    <span class="field-label mono">PHYSICAL ROOT CAUSE:</span>
                    <p class="field-value cause">{entry.rootCause}</p>
                  </div>
                  <div class="notebook-field">
                    <span class="field-label mono">ENGINEERING RESOLUTION:</span>
                    <p class="field-value resolution">{entry.iteration}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Verified Outcomes & Results -->
      <section class="case-section results-section">
        <h2 class="section-kicker mono">VERIFIED RESULTS &amp; METRICS</h2>
        <div class="results-list">
          {project.keyResults.map((result) => (
            <div class="result-card">
              <span class="result-check mono">✓</span>
              <p class="result-text">{result}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Project Actions -->
      <div class="project-bottom-actions">
        {project.githubUrl && (
          <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
            <span>View Source on GitHub ↗</span>
          </a>
        )}
        <a href="/#contact" class="btn btn-secondary">
          <span>Discuss System Architecture</span>
        </a>
      </div>

      <!-- Sequential Case Study Pagination & Archive Navigator -->
      <nav class="project-pagination-footer" aria-label="Sequential Case Study Navigation">
        <a href={`/projects/${prevProject.id}`} class="pagination-card prev-card">
          <span class="pagination-sub mono">← PREVIOUS SYSTEM</span>
          <span class="pagination-title">{prevProject.title}</span>
          <span class="pagination-meta mono">{prevProject.domain}</span>
        </a>
        <a href="/projects" class="pagination-center-btn mono" aria-label="Return to full Projects Archive">
          <span class="center-icon" aria-hidden="true">▦</span>
          <span>ALL PROJECTS [ {String(projects.length).padStart(2, '0')} ]</span>
        </a>
        <a href={`/projects/${nextProject.id}`} class="pagination-card next-card">
          <span class="pagination-sub mono">NEXT SYSTEM →</span>
          <span class="pagination-title">{nextProject.title}</span>
          <span class="pagination-meta mono">{nextProject.domain}</span>
        </a>
      </nav>
    </div>
  </main>

  <Footer />
</Layout>

