---
// Dynamic Project Case Study Route: /projects/[id]
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import { projects, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<Layout
  title={`${project.title} — Architectural Case Study | Naveen Shaji George`}
  description={project.summary}
>
  <Navigation />

  <main class="project-page">
    <div class="container project-container">
      <!-- Back button -->
      <div class="project-nav-bar">
        <a href="/#work" class="back-link mono">
          <span class="back-arrow" aria-hidden="true">←</span>
          <span>Back to Projects</span>
        </a>
        <div class="project-meta-pill mono">
          <span>{project.index}</span>
          <span>/</span>
          <span>04</span>
        </div>
      </div>

      <!-- Header Block -->
      <header class="project-hero">
        <div class="project-domain mono">{project.domain}</div>
        <h1 class="project-title" transition:name={`project-title-${project.id}`}>{project.title}</h1>
        <p class="project-subtitle">{project.subtitle}</p>

        <div class="project-attributes mono">
          <div class="attr-item">
            <span class="attr-label">ROLE</span>
            <span class="attr-val">{project.role}</span>
          </div>
          <div class="attr-item">
            <span class="attr-label">TIMELINE</span>
            <span class="attr-val">{project.year}</span>
          </div>
          <div class="attr-item">
            <span class="attr-label">STATUS</span>
            <span class="attr-val status-val">{project.status}</span>
          </div>
        </div>
      </header>

      <!-- Primary Hardware/Architecture Hero Visual Stage -->
      <div class="project-hero-visual" transition:name={`project-visual-${project.id}`}>
        {project.imagePath ? (
          <img
            src={project.imagePath}
            alt={`${project.title} Architecture Schematic`}
            class="project-hero-img"
            loading="eager"
          />
        ) : project.id === 'hospital-amr' ? (
          <div class="project-hardware-blueprint" aria-label="LiDAR SLAM Navigation Testbed Schematic">
            <svg viewBox="0 0 380 220" fill="none" class="blueprint-svg" aria-hidden="true">
              <circle cx="190" cy="110" r="35" stroke="#0EA5E9" stroke-width="1" stroke-dasharray="3 3" opacity="0.4" />
              <circle cx="190" cy="110" r="75" stroke="#0EA5E9" stroke-width="1" stroke-dasharray="3 3" opacity="0.3" />
              <circle cx="190" cy="110" r="105" stroke="#0EA5E9" stroke-width="1" opacity="0.2" />
              <rect x="175" y="95" width="30" height="30" rx="4" fill="#0EA5E9" fill-opacity="0.25" stroke="#0EA5E9" stroke-width="1.5" />
              <circle cx="190" cy="110" r="4" fill="#38BDF8" />
              <path d="M190 110 L190 65" stroke="#38BDF8" stroke-width="2" stroke-linecap="round" />
              <polygon points="190,58 186,67 194,67" fill="#38BDF8" />
              <line x1="40" y1="30" x2="340" y2="30" stroke="#64748B" stroke-width="1.5" stroke-dasharray="4 4" />
              <line x1="40" y1="190" x2="340" y2="190" stroke="#64748B" stroke-width="1.5" stroke-dasharray="4 4" />
              <g fill="#38BDF8" opacity="0.8">
                <circle cx="80" cy="30" r="2" /><circle cx="130" cy="30" r="2" /><circle cx="240" cy="30" r="2" /><circle cx="300" cy="30" r="2" />
                <circle cx="90" cy="190" r="2" /><circle cx="150" cy="190" r="2" /><circle cx="230" cy="190" r="2" /><circle cx="290" cy="190" r="2" />
              </g>
              <path d="M190 110 L110 40 M190 110 L150 32 M190 110 L230 32 M190 110 L270 40" stroke="#0EA5E9" stroke-width="0.8" opacity="0.45" />
              <text x="190" y="145" fill="#94A3B8" font-size="8" font-family="monospace" text-anchor="middle">NAV2 COSTMAP // 360° PLANAR LIDAR</text>
            </svg>
          </div>
        ) : (
          <div class="project-hardware-blueprint" aria-label="Decentralized Swarm Robotics Mesh Schematic">
            <svg viewBox="0 0 380 220" fill="none" class="blueprint-svg" aria-hidden="true">
              <line x1="90" y1="70" x2="190" y2="50" stroke="#0EA5E9" stroke-width="1.2" stroke-dasharray="2 2" opacity="0.6" />
              <line x1="190" y1="50" x2="290" y2="80" stroke="#0EA5E9" stroke-width="1.2" stroke-dasharray="2 2" opacity="0.6" />
              <line x1="90" y1="70" x2="140" y2="150" stroke="#0EA5E9" stroke-width="1.2" stroke-dasharray="2 2" opacity="0.6" />
              <line x1="140" y1="150" x2="240" y2="160" stroke="#0EA5E9" stroke-width="1.2" stroke-dasharray="2 2" opacity="0.6" />
              <line x1="240" y1="160" x2="290" y2="80" stroke="#0EA5E9" stroke-width="1.2" stroke-dasharray="2 2" opacity="0.6" />
              <line x1="190" y1="50" x2="240" y2="160" stroke="#0EA5E9" stroke-width="1.2" stroke-dasharray="2 2" opacity="0.4" />
              <g fill="#10B981">
                <circle cx="90" cy="70" r="7" /><circle cx="190" cy="50" r="7" /><circle cx="290" cy="80" r="7" />
                <circle cx="140" cy="150" r="7" /><circle cx="240" cy="160" r="7" />
              </g>
              <g fill="#FFFFFF" font-size="7" font-family="monospace" text-anchor="middle" font-weight="bold">
                <text x="90" y="73">01</text><text x="190" y="53">02</text><text x="290" y="83">03</text>
                <text x="140" y="153">04</text><text x="240" y="163">05</text>
              </g>
              <circle cx="190" cy="105" r="4" fill="#F59E0B" />
              <circle cx="190" cy="105" r="16" stroke="#F59E0B" stroke-width="1" stroke-dasharray="2 2" opacity="0.7" />
              <text x="190" y="130" fill="#FBBF24" font-size="7" font-family="monospace" text-anchor="middle">VIRTUAL TARGET ATTRACTOR</text>
              <text x="190" y="195" fill="#94A3B8" font-size="8" font-family="monospace" text-anchor="middle">ESP32 AD-HOC TCP/IP MESH // CONSENSUS</text>
            </svg>
          </div>
        )}
      </div>

      <!-- Executive Summary -->
      <section class="case-section summary-section">
        <h2 class="section-kicker mono">EXECUTIVE ENGINEERING SUMMARY</h2>
        <p class="summary-lead">{project.summary}</p>
      </section>

      <!-- Two-Column Problem & Approach -->
      <div class="problem-approach-grid">
        <section class="case-section col-box">
          <h2 class="section-kicker mono">THE ENGINEERING CHALLENGE</h2>
          <p class="col-text">{project.challenge}</p>
        </section>

        <section class="case-section col-box">
          <h2 class="section-kicker mono">SYSTEM DESIGN & APPROACH</h2>
          <p class="col-text">{project.approach}</p>
        </section>
      </div>

      <!-- System Architecture Breakdown -->
      <section class="case-section architecture-section">
        <h2 class="section-kicker mono">SYSTEM ARCHITECTURE & PIPELINE</h2>
        <div class="arch-flow">
          {project.systemArchitecture.map((stage, idx) => (
            <div class="arch-stage">
              <div class="stage-num mono">STAGE 0{idx + 1}</div>
              <div class="stage-name">{stage}</div>
              {idx < project.systemArchitecture.length - 1 && (
                <div class="stage-connector" aria-hidden="true">↓</div>
              )}
            </div>
          ))}
        </div>
      </section>

      <!-- Hardware & Software Grid -->
      <div class="stack-grid">
        <!-- Hardware -->
        <section class="case-section stack-box">
          <h2 class="section-kicker mono">HARDWARE ARCHITECTURE</h2>
          <ul class="stack-list">
            {project.hardwareStack.map((hw) => (
              <li class="stack-item">
                <span class="bullet mono">■</span>
                <span>{hw}</span>
              </li>
            ))}
          </ul>
        </section>

        <!-- Software -->
        <section class="case-section stack-box">
          <h2 class="section-kicker mono">SOFTWARE & CONTROLLER STACK</h2>
          <ul class="stack-list">
            {project.softwareStack.map((sw) => (
              <li class="stack-item">
                <span class="bullet mono text-cyan">●</span>
                <span>{sw}</span>
              </li>
            ))}
          </ul>
        </section>
      </div>

      <!-- Research Notebook: Failures, Physical Noise & Iterative Resolutions -->
      {project.failuresAndIterations && project.failuresAndIterations.length > 0 && (
        <section class="case-section notebook-section">
          <div class="notebook-head">
            <span class="notebook-badge mono">RESEARCH NOTEBOOK // EMPIRICAL ITERATION</span>
            <h2 class="section-kicker mono">FAILURES, PHYSICAL NOISE &amp; ENGINEERING RESOLUTIONS</h2>
          </div>
          <div class="notebook-grid">
            {project.failuresAndIterations.map((entry, idx) => (
              <div class="notebook-card">
                <div class="notebook-step mono">CYCLE 0{idx + 1}</div>
                <div class="notebook-body">
                  <div class="notebook-field">
                    <span class="field-label mono">ENCOUNTERED FAILURE / NOISE:</span>
                    <p class="field-value anomaly">{entry.issue}</p>
                  </div>
                  <div class="notebook-field">
                    <span class="field-label mono">PHYSICAL ROOT CAUSE:</span>
                    <p class="field-value cause">{entry.rootCause}</p>
                  </div>
                  <div class="notebook-field">
                    <span class="field-label mono">ENGINEERING RESOLUTION:</span>
                    <p class="field-value resolution">{entry.iteration}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Verified Outcomes & Results -->
      <section class="case-section results-section">
        <h2 class="section-kicker mono">VERIFIED RESULTS &amp; METRICS</h2>
        <div class="results-list">
          {project.keyResults.map((result) => (
            <div class="result-card">
              <span class="result-check mono">✓</span>
              <p class="result-text">{result}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Project Actions -->
      <div class="project-bottom-actions">
        {project.githubUrl && (
          <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
            <span>View Source on GitHub ↗</span>
          </a>
        )}
        <a href="/#contact" class="btn btn-secondary">
          <span>Discuss System Architecture</span>
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .project-page {
    padding: clamp(2rem, 5vh, 4rem) 0 var(--space-20);
    background: var(--bg);
  }

  .project-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .project-nav-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-secondary);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .back-link:hover {
    color: var(--cyan-dark);
  }

  .back-arrow {
    font-size: var(--text-sm);
  }

  .project-meta-pill {
    font-size: var(--text-xs);
    color: var(--text-muted);
    letter-spacing: 0.08em;
  }

  /* Hero */
  .project-hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--border-subtle);
  }

  .project-domain {
    font-size: var(--text-xs);
    color: var(--cyan-dark);
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .project-title {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1.05;
    color: var(--text-primary);
  }

  .project-subtitle {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .project-attributes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    margin-top: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-subtle);
  }

  .attr-item {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .attr-label {
    font-size: var(--text-2xs);
    color: var(--text-muted);
    letter-spacing: 0.08em;
  }

  .attr-val {
    font-size: var(--text-xs);
    color: var(--text-primary);
    font-weight: 600;
  }

  .status-val {
    color: var(--cyan-dark);
  }

  /* Sections */
  .section-kicker {
    font-size: var(--text-2xs);
    color: var(--text-muted);
    letter-spacing: 0.1em;
    margin-bottom: var(--space-4);
    font-weight: 700;
  }

  .summary-lead {
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    color: var(--text-primary);
    line-height: 1.65;
    max-width: 900px;
  }

  /* 2-Col Grid */
  .problem-approach-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
  }

  .col-box {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    padding: var(--space-8);
  }

  .col-text {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.7;
  }

  /* Architecture Flow */
  .architecture-section {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    padding: var(--space-8);
  }

  .arch-flow {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .arch-stage {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-4);
    background: var(--surface-dim);
    border: 1px solid var(--border-subtle);
    border-radius: var(--r-sm);
    position: relative;
  }

  .stage-num {
    font-size: var(--text-2xs);
    color: var(--cyan-dark);
    font-weight: 700;
    flex-shrink: 0;
  }

  .stage-name {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-primary);
  }

  .stage-connector {
    margin-left: auto;
    color: var(--text-dim);
    font-family: var(--font-mono);
  }

  /* Stack Grid */
  .stack-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
  }

  .stack-box {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    padding: var(--space-8);
  }

  .stack-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .stack-item {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .bullet {
    font-size: var(--text-xs);
    color: var(--border-strong);
    flex-shrink: 0;
  }

  /* Results */
  .results-section {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    padding: var(--space-8);
  }

  .results-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .result-card {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--cyan-subtle);
    border: 1px solid rgba(14,165,233,0.2);
    border-radius: var(--r-sm);
  }

  .result-check {
    color: var(--cyan-dark);
    font-weight: 800;
    flex-shrink: 0;
  }

  .result-text {
    font-size: var(--text-sm);
    color: var(--text-primary);
    font-weight: 600;
    line-height: 1.5;
  }

  /* Actions */
  .project-bottom-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-subtle);
    flex-wrap: wrap;
  }

  /* Hero Hardware/Architecture Visual Stage (Shared Element Transition) */
  .project-hero-visual {
    width: 100%;
    min-height: 280px;
    max-height: 520px;
    background: #EEEAE3;
    border: 1px solid var(--border);
    border-radius: var(--r-card);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-resting);
    margin-top: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .project-hero-img {
    width: 100%;
    height: 100%;
    max-height: 520px;
    object-fit: cover;
    object-position: center;
    filter: brightness(0.96) contrast(1.04);
  }

  .project-hardware-blueprint {
    width: 100%;
    height: 100%;
    min-height: 280px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(circle at center, #E8E4DC 0%, #DDD8CE 80%);
    padding: var(--space-8);
  }

  .blueprint-svg {
    width: 100%;
    max-width: 620px;
    height: auto;
    display: block;
  }

  /* Research Notebook (Failures & Iterations) */
  .notebook-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .notebook-head {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .notebook-badge {
    font-size: 0.6875rem;
    color: var(--cyan-dark);
    letter-spacing: 0.08em;
    font-weight: 600;
  }

  .notebook-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .notebook-card {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: var(--space-6);
    padding: var(--space-6);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    box-shadow: var(--shadow-resting);
  }

  .notebook-step {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.08em;
    padding-top: 2px;
  }

  .notebook-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .notebook-field {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .field-label {
    font-size: 0.65rem;
    color: var(--text-muted);
    letter-spacing: 0.06em;
    font-weight: 600;
  }

  .field-value {
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--text-body);
  }

  .field-value.anomaly {
    color: #991B1B;
    font-weight: 500;
  }

  .field-value.cause {
    color: var(--text-secondary);
  }

  .field-value.resolution {
    color: var(--cyan-dark);
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .problem-approach-grid,
    .stack-grid {
      grid-template-columns: 1fr;
    }

    .notebook-card {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }
</style>
