<script>
  import { initProjectDetailAnimation, isReducedMotion } from '../../animations';

  let detailCleanup: (() => void) | null = null;
  let videoObserver: IntersectionObserver | null = null;

  function initDossierTabs() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.dossier-tab-btn');
    const panels = document.querySelectorAll<HTMLElement>('.dossier-panel');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const targetId = tab.dataset.galleryId;
        tabs.forEach((t) => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        panels.forEach((p) => {
          p.classList.remove('active');
          p.hidden = true;
        });

        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');
        const activePanel = document.getElementById(`panel-${targetId}`);
        if (activePanel) {
          activePanel.classList.add('active');
          activePanel.hidden = false;
        }
      });
    });
  }

  function setupProjectVideos() {
    if (videoObserver) {
      videoObserver.disconnect();
      videoObserver = null;
    }

    const allVideos = document.querySelectorAll<HTMLVideoElement>('.ambient-project-video, .artifact-video');
    if (allVideos.length === 0) return;

    const reducedMotion = isReducedMotion();

    allVideos.forEach((v) => {
      if (v.classList.contains('ambient-project-video')) {
        v.muted = true;
      }
    });

    // Sound toggle buttons for ambient video showcase
    document.querySelectorAll<HTMLButtonElement>('.video-sound-toggle').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const box = btn.closest('.video-feature-box');
        const video = box?.querySelector<HTMLVideoElement>('video');
        if (!video) return;
        video.muted = !video.muted;
        const isMuted = video.muted;
        btn.setAttribute('data-muted', String(isMuted));
        const icon = btn.querySelector('.sound-icon');
        const label = btn.querySelector('.sound-label');
        if (icon) icon.textContent = isMuted ? '🔈' : '🔊';
        if (label) label.textContent = isMuted ? 'UNMUTE' : 'MUTED';
      });
    });

    if ('IntersectionObserver' in window) {
      videoObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          const v = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            // Autoplay ambient loop only if not reduced motion
            if (v.classList.contains('ambient-project-video') && !reducedMotion) {
              const playPromise = v.play();
              if (playPromise !== undefined) {
                playPromise.catch(() => {
                  // Fallback: poster remains visible
                });
              }
            }
          } else {
            // Pause when offscreen to preserve CPU/GPU
            v.pause();
          }
        });
      }, { rootMargin: '120px 0px 120px 0px', threshold: 0.1 });

      allVideos.forEach((v) => videoObserver!.observe(v));
    } else {
      allVideos.forEach((v) => {
        if (v.classList.contains('ambient-project-video') && !reducedMotion) {
          v.play().catch(() => {});
        }
      });
    }
  }

  function setupPage() {
    if (detailCleanup) {
      detailCleanup();
      detailCleanup = null;
    }
    initDossierTabs();
    setupProjectVideos();
    detailCleanup = initProjectDetailAnimation();
  }

  document.addEventListener('DOMContentLoaded', setupPage);
  document.addEventListener('astro:page-load', () => {
    window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
    setupPage();
  });
</script>
