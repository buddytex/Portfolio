---
// Dynamic Project Case Study Route: /projects/[id]
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import { projects, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<Layout
  title={`${project.title} — Architectural Case Study | Naveen Shaji George`}
  description={project.summary}
>
  <Navigation />

  <main class="project-page">
    <div class="container project-container">
      <!-- Back button -->
      <div class="project-nav-bar">
        <a href="/#work" class="back-link mono">
          <span class="back-arrow" aria-hidden="true">←</span>
          <span>Back to Projects</span>
        </a>
        <div class="project-meta-pill mono">
          <span>{project.index}</span>
          <span>/</span>
          <span>04</span>
        </div>
      </div>

      <!-- Header Block -->
      <header class="project-hero">
        <div class="project-domain mono">{project.domain}</div>
        <h1 class="project-title">{project.title}</h1>
        <p class="project-subtitle">{project.subtitle}</p>

        <div class="project-attributes mono">
          <div class="attr-item">
            <span class="attr-label">ROLE</span>
            <span class="attr-val">{project.role}</span>
          </div>
          <div class="attr-item">
            <span class="attr-label">TIMELINE</span>
            <span class="attr-val">{project.year}</span>
          </div>
          <div class="attr-item">
            <span class="attr-label">STATUS</span>
            <span class="attr-val status-val">{project.status}</span>
          </div>
        </div>
      </header>

      <!-- Executive Summary -->
      <section class="case-section summary-section">
        <h2 class="section-kicker mono">EXECUTIVE ENGINEERING SUMMARY</h2>
        <p class="summary-lead">{project.summary}</p>
      </section>

      <!-- Two-Column Problem & Approach -->
      <div class="problem-approach-grid">
        <section class="case-section col-box">
          <h2 class="section-kicker mono">THE ENGINEERING CHALLENGE</h2>
          <p class="col-text">{project.challenge}</p>
        </section>

        <section class="case-section col-box">
          <h2 class="section-kicker mono">SYSTEM DESIGN & APPROACH</h2>
          <p class="col-text">{project.approach}</p>
        </section>
      </div>

      <!-- System Architecture Breakdown -->
      <section class="case-section architecture-section">
        <h2 class="section-kicker mono">SYSTEM ARCHITECTURE & PIPELINE</h2>
        <div class="arch-flow">
          {project.systemArchitecture.map((stage, idx) => (
            <div class="arch-stage">
              <div class="stage-num mono">STAGE 0{idx + 1}</div>
              <div class="stage-name">{stage}</div>
              {idx < project.systemArchitecture.length - 1 && (
                <div class="stage-connector" aria-hidden="true">↓</div>
              )}
            </div>
          ))}
        </div>
      </section>

      <!-- Hardware & Software Grid -->
      <div class="stack-grid">
        <!-- Hardware -->
        <section class="case-section stack-box">
          <h2 class="section-kicker mono">HARDWARE ARCHITECTURE</h2>
          <ul class="stack-list">
            {project.hardwareStack.map((hw) => (
              <li class="stack-item">
                <span class="bullet mono">■</span>
                <span>{hw}</span>
              </li>
            ))}
          </ul>
        </section>

        <!-- Software -->
        <section class="case-section stack-box">
          <h2 class="section-kicker mono">SOFTWARE & CONTROLLER STACK</h2>
          <ul class="stack-list">
            {project.softwareStack.map((sw) => (
              <li class="stack-item">
                <span class="bullet mono text-cyan">●</span>
                <span>{sw}</span>
              </li>
            ))}
          </ul>
        </section>
      </div>

      <!-- Primary Hardware/Architecture Schematic (if available) -->
      {project.imagePath && (
        <section class="case-section schematic-section">
          <div class="schematic-head">
            <h2 class="section-kicker mono">PRIMARY PHYSICAL SCHEMATIC &amp; ARCHITECTURE</h2>
            <span class="mono text-xs text-muted">VERIFIED ENGINEERING ARTIFACT</span>
          </div>
          <div class="schematic-frame">
            <img src={project.imagePath} alt={`${project.title} Schematic & Pipeline`} class="schematic-img" loading="eager" />
          </div>
        </section>
      )}

      <!-- Research Notebook: Failures, Physical Noise & Iterative Resolutions -->
      {project.failuresAndIterations && project.failuresAndIterations.length > 0 && (
        <section class="case-section notebook-section">
          <div class="notebook-head">
            <span class="notebook-badge mono">RESEARCH NOTEBOOK // EMPIRICAL ITERATION</span>
            <h2 class="section-kicker mono">FAILURES, PHYSICAL NOISE &amp; ENGINEERING RESOLUTIONS</h2>
          </div>
          <div class="notebook-grid">
            {project.failuresAndIterations.map((entry, idx) => (
              <div class="notebook-card">
                <div class="notebook-step mono">CYCLE 0{idx + 1}</div>
                <div class="notebook-body">
                  <div class="notebook-field">
                    <span class="field-label mono">ENCOUNTERED FAILURE / NOISE:</span>
                    <p class="field-value anomaly">{entry.issue}</p>
                  </div>
                  <div class="notebook-field">
                    <span class="field-label mono">PHYSICAL ROOT CAUSE:</span>
                    <p class="field-value cause">{entry.rootCause}</p>
                  </div>
                  <div class="notebook-field">
                    <span class="field-label mono">ENGINEERING RESOLUTION:</span>
                    <p class="field-value resolution">{entry.iteration}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Verified Outcomes & Results -->
      <section class="case-section results-section">
        <h2 class="section-kicker mono">VERIFIED RESULTS &amp; METRICS</h2>
        <div class="results-list">
          {project.keyResults.map((result) => (
            <div class="result-card">
              <span class="result-check mono">✓</span>
              <p class="result-text">{result}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Project Actions -->
      <div class="project-bottom-actions">
        {project.githubUrl && (
          <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
            <span>View Source on GitHub ↗</span>
          </a>
        )}
        <a href="/#contact" class="btn btn-secondary">
          <span>Discuss System Architecture</span>
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .project-page {
    padding: clamp(2rem, 5vh, 4rem) 0 var(--space-20);
    background: var(--bg);
  }

  .project-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .project-nav-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-secondary);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .back-link:hover {
    color: var(--cyan-dark);
  }

  .back-arrow {
    font-size: var(--text-sm);
  }

  .project-meta-pill {
    font-size: var(--text-xs);
    color: var(--text-muted);
    letter-spacing: 0.08em;
  }

  /* Hero */
  .project-hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--border-subtle);
  }

  .project-domain {
    font-size: var(--text-xs);
    color: var(--cyan-dark);
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .project-title {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1.05;
    color: var(--text-primary);
  }

  .project-subtitle {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .project-attributes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    margin-top: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-subtle);
  }

  .attr-item {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .attr-label {
    font-size: var(--text-2xs);
    color: var(--text-muted);
    letter-spacing: 0.08em;
  }

  .attr-val {
    font-size: var(--text-xs);
    color: var(--text-primary);
    font-weight: 600;
  }

  .status-val {
    color: var(--cyan-dark);
  }

  /* Sections */
  .section-kicker {
    font-size: var(--text-2xs);
    color: var(--text-muted);
    letter-spacing: 0.1em;
    margin-bottom: var(--space-4);
    font-weight: 700;
  }

  .summary-lead {
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    color: var(--text-primary);
    line-height: 1.65;
    max-width: 900px;
  }

  /* 2-Col Grid */
  .problem-approach-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
  }

  .col-box {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    padding: var(--space-8);
  }

  .col-text {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.7;
  }

  /* Architecture Flow */
  .architecture-section {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    padding: var(--space-8);
  }

  .arch-flow {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .arch-stage {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-4);
    background: var(--surface-dim);
    border: 1px solid var(--border-subtle);
    border-radius: var(--r-sm);
    position: relative;
  }

  .stage-num {
    font-size: var(--text-2xs);
    color: var(--cyan-dark);
    font-weight: 700;
    flex-shrink: 0;
  }

  .stage-name {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-primary);
  }

  .stage-connector {
    margin-left: auto;
    color: var(--text-dim);
    font-family: var(--font-mono);
  }

  /* Stack Grid */
  .stack-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
  }

  .stack-box {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    padding: var(--space-8);
  }

  .stack-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .stack-item {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .bullet {
    font-size: var(--text-xs);
    color: var(--border-strong);
    flex-shrink: 0;
  }

  /* Results */
  .results-section {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    padding: var(--space-8);
  }

  .results-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .result-card {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--cyan-subtle);
    border: 1px solid rgba(14,165,233,0.2);
    border-radius: var(--r-sm);
  }

  .result-check {
    color: var(--cyan-dark);
    font-weight: 800;
    flex-shrink: 0;
  }

  .result-text {
    font-size: var(--text-sm);
    color: var(--text-primary);
    font-weight: 600;
    line-height: 1.5;
  }

  /* Actions */
  .project-bottom-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-subtle);
    flex-wrap: wrap;
  }

  /* Schematic & Architecture Stage */
  .schematic-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .schematic-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .schematic-frame {
    width: 100%;
    background: #141416;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    overflow: hidden;
    box-shadow: var(--shadow-resting);
    display: flex;
    justify-content: center;
    align-items: center;
    padding: clamp(1rem, 2vw, 2rem);
  }

  .schematic-img {
    width: 100%;
    max-height: 520px;
    object-fit: contain;
    border-radius: var(--r-xs);
  }

  /* Research Notebook (Failures & Iterations) */
  .notebook-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .notebook-head {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .notebook-badge {
    font-size: 0.6875rem;
    color: var(--cyan-dark);
    letter-spacing: 0.08em;
    font-weight: 600;
  }

  .notebook-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .notebook-card {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: var(--space-6);
    padding: var(--space-6);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    box-shadow: var(--shadow-resting);
  }

  .notebook-step {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.08em;
    padding-top: 2px;
  }

  .notebook-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .notebook-field {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .field-label {
    font-size: 0.65rem;
    color: var(--text-muted);
    letter-spacing: 0.06em;
    font-weight: 600;
  }

  .field-value {
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--text-body);
  }

  .field-value.anomaly {
    color: #991B1B;
    font-weight: 500;
  }

  .field-value.cause {
    color: var(--text-secondary);
  }

  .field-value.resolution {
    color: var(--cyan-dark);
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .problem-approach-grid,
    .stack-grid {
      grid-template-columns: 1fr;
    }

    .notebook-card {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }
</style>
