---
// Home Page — Dark Maximalist Robotics Engineering Portfolio
// Naveen Shaji George · Autonomous Systems Engineer
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import EngineeringField from '../components/EngineeringField.astro';
import EngineeringBackground from '../components/EngineeringBackground.astro';
import ProjectIndex from '../components/ProjectIndex.astro';
import PCBShowcase from '../components/PCBShowcase.astro';
import SkillsEvidence from '../components/SkillsEvidence.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Naveen Shaji George — Robotics Engineer"
  description="Robotics engineer specializing in autonomous vehicles, 3D LiDAR perception, custom vehicle ECUs, isolated CAN bus networks, and ROS 2 software integration. AIR 7 and AIR 11 aBAJA team leader."
>
  <!-- Minimalist Editorial Navigation -->
  <Navigation />

  <!-- Ambient Engineering Field (non-hero sections) -->
  <EngineeringField />

  <main id="mainContent">
    <!-- Hero: Monumental Typography + Large Portrait + Dense Circuit Network -->
    <Hero />

    <!-- 02 // Engineering Background: Chronology + Philosophy -->
    <EngineeringBackground />

    <!-- 01 // Selected Work: Interactive Editorial Entry Cards -->
    <ProjectIndex />

    <!-- 03 // Skills & Evidence: Compact Skill Index -->
    <SkillsEvidence />

    <!-- 04 // Physical Hardware: Interactive 3D PCB Artifact Inspector -->
    <section id="hardware" class="section hardware-section" aria-label="Physical PCB Engineering Showcase">
      <div class="container">
        <PCBShowcase />
      </div>
    </section>

    <!-- 05 // Contact: Direct Communication & Verified Channels -->
    <Contact />
  </main>

  <!-- Clean Minimalist Footer Signature -->
  <Footer />
</Layout>

<style>
  main {
    position: relative;
    z-index: 1;
  }
</style>