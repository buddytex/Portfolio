---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Systems from '../components/Systems.astro';
import Skills from '../components/Skills.astro';
import Research from '../components/Research.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

// Project data — using real information from the repository
const projects = [
  {
    number: '01',
    title: 'Team Equinox — Autonomous aBAJA Vehicle',
    subtitle: 'Electrical & Electronics Head',
    description: 'Led the complete electrical and electronics development of an autonomous Baja vehicle across two national campaigns. Designed and integrated the vehicle\'s electrical architecture, custom PCBs, wiring harnesses, CAN network, embedded systems, and drive-by-wire.',
    problem: 'Design a complete electrical system for an autonomous off-road vehicle capable of navigating challenging terrain without human intervention.',
    approach: 'Built custom ECUs, designed CAN bus communication networks, created HV/LV wiring harnesses, developed drive-by-wire systems, and managed full vehicle electrical integration.',
    technologies: ['Embedded Systems', 'CAN Bus', 'PCB Design', 'Drive-by-Wire', 'Vehicle Integration'],
    hardware: ['Custom ECUs', 'CAN Transceivers', 'HV/LV Harnesses', 'Motor Controllers', 'Sensors'],
    software: ['Embedded C', 'CAN Protocol Stack', 'Vehicle Control'],
    featured: true,
  },
  {
    number: '02',
    title: 'Hospital Service Robot',
    description: 'Autonomous mobile robot designed for hospital service tasks, integrating ROS-based navigation with IoT connectivity for real-world healthcare environments.',
    technologies: ['ROS', 'IoT', 'Robotics', 'Navigation', 'Embedded'],
    hardware: ['Mobile Base', 'Sensors', 'Microcontrollers'],
    software: ['ROS', 'Python', 'IoT Protocols'],
  },
  {
    number: '03',
    title: 'Smart CCTV Surveillance System',
    description: 'Intelligent surveillance system using computer vision and AI for real-time object detection, anomaly recognition, and automated alert generation.',
    technologies: ['Computer Vision', 'OpenCV', 'Python', 'AI/ML', 'Image Processing'],
    software: ['OpenCV', 'Python', 'TensorFlow/PyTorch'],
  },
  {
    number: '04',
    title: 'Swarm Robot Platform',
    description: 'Multi-robot coordination platform implementing distributed communication protocols and cooperative behavior for swarm robotics research.',
    technologies: ['ROS', 'TCP/IP', 'Embedded', 'Swarm Intelligence', 'Multi-Robot'],
    hardware: ['Multiple Robot Units', 'ESP32', 'Communication Modules'],
    software: ['ROS', 'TCP/IP Stack', 'Python'],
  },
];
---

<Layout>
  <Navigation />
  <main>
    <Hero />
    <About />

    <!-- Projects Section -->
    <section id="projects" class="section projects-section">
      <div class="container">
        <div class="projects-header reveal">
          <div class="section-header-left">
            <span class="section-number mono">02</span>
            <span class="label">Selected Work</span>
          </div>
          <h2>Projects that<br/><span class="heading-accent">made it real</span></h2>
          <p class="section-intro">
            A selection of robotics, autonomous systems, and engineering
            projects — each representing real hardware-software integration
            challenges.
          </p>
        </div>

        <div class="projects-grid">
          {projects.map((project) => (
            <ProjectCard {...project} />
          ))}
        </div>
      </div>
    </section>

    <Systems />
    <Skills />
    <Research />
    <Contact />
  </main>
  <Footer />
</Layout>

<style>
  .projects-section {
    border-top: 1px solid var(--border);
  }

  .projects-header {
    margin-bottom: var(--space-16);
    max-width: 560px;
  }

  .section-header-left {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .heading-accent {
    color: var(--accent);
  }

  .section-intro {
    margin-top: var(--space-4);
    font-size: var(--text-base);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>