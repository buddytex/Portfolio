---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Systems from '../components/Systems.astro';
import Skills from '../components/Skills.astro';
import Research from '../components/Research.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

// Authentic engineering case studies
const caseStudies = [
  {
    index: '01',
    category: 'Autonomous Vehicle Architecture',
    title: 'Autonomous aBAJA Vehicle — Team Equinox',
    role: 'Electrical & Electronics Head · Systems Integration',
    badge: 'AIR 7 (2025) · AIR 11 (2026)',
    description: 'Spearheaded the complete electrical architecture, custom multi-layer ECUs, isolated wiring harnesses, CAN 2.0B network, and drive-by-wire integration for an autonomous off-road competition vehicle.',
    problem: 'Engineer a ruggedized, fully autonomous vehicle electrical system capable of navigating harsh, unmapped off-road terrain without human intervention, maintaining deterministic real-time control under extreme shock, dust, and vibration.',
    approach: 'Engineered custom multi-layer ECUs with integrated CAN transceivers, designed dual-rail isolated HV/LV wiring harnesses, integrated steer/brake-by-wire electro-mechanical actuators with dual-redundant E-Stop interlocks, and bridged high-level ROS 2 perception to low-level motor controllers.',
    pipeline: ['Stereo + LiDAR Perception', 'Central Navigation ECU', 'CAN 2.0B Network (500 kbps)', 'Drive-by-Wire Actuation'],
    hardware: ['Custom Multi-Layer ECUs', 'CAN 2.0B Transceivers', 'HV/LV Isolated Harnesses', 'Drive-by-Wire Actuators', 'Linear Encoders', 'Emergency Interlocks'],
    software: ['Embedded C/C++', 'CAN Protocol Stack', 'ROS 2 Humble', 'RTOS Motor Controllers', 'Telemetry Logging'],
    results: [
      'All India Rank AIR 7 (2025 National Campaign)',
      'All India Rank AIR 11 (2026 National Campaign)',
      '100% electrical reliability across national endurance trials',
    ],
    github: 'https://github.com/buddytex',
    featured: true,
  },
  {
    index: '02',
    category: 'Mobile Service Robotics',
    title: 'Hospital Service Autonomous Mobile Robot (AMR)',
    role: 'Autonomy & Embedded Systems Developer',
    badge: 'Healthcare Autonomy',
    description: 'Autonomous indoor service robot built to navigate hospital corridors and transport medical supplies reliably alongside human medical staff and patients.',
    problem: 'Safe, deterministic indoor navigation through crowded, dynamically changing healthcare corridors with strict collision-avoidance constraints and zero tolerance for localization loss.',
    approach: 'Implemented 2D LiDAR SLAM, configured Nav2 global and local costmap layers with recovery behaviors, tuned differential drive PID kinematics, and linked an IoT cloud telemetry bridge.',
    pipeline: ['Planar LiDAR Scan', 'SLAM Toolbox Mapping', 'Nav2 Dynamic Costmap', 'Differential Drive Controller', 'IoT Fleet Gateway'],
    hardware: ['Differential Mobile Base', 'Planar LiDAR', 'ESP32 Motor Controller', 'Ultrasonic Safety Rings', 'Power Distribution Board'],
    software: ['ROS 2 Humble', 'Nav2 Navigation Stack', 'SLAM Toolbox', 'Python', 'MQTT IoT Gateway'],
    results: [
      'Reliable point-to-point waypoint navigation in clinical trials',
      'Dynamic pedestrian obstacle avoidance in crowded indoor corridors',
    ],
    github: 'https://github.com/buddytex',
  },
  {
    index: '03',
    category: 'Edge Computer Vision & AI',
    title: 'Smart CCTV Edge Computer Vision & Tracking',
    role: 'Computer Vision & Edge AI Engineer',
    badge: 'Edge Perception',
    description: 'Intelligent multi-camera surveillance system executing real-time object detection and anomaly tracking on local edge compute hardware.',
    problem: 'Automated security surveillance with low latency and edge inference without relying on expensive cloud streaming bandwidth or external internet links.',
    approach: 'Optimized OpenCV video pipelines with YOLO neural network inference, multi-threaded RTSP frame acquisition, and spatial bounding-box anomaly alerts.',
    pipeline: ['RTSP Camera Stream', 'Frame Preprocessing', 'YOLO Edge Inference', 'Multi-Object Spatial Tracker', 'Incident Trigger'],
    hardware: ['Edge Compute Unit', 'High-Res IP Cameras', 'Hardware Video Decoders'],
    software: ['OpenCV', 'Python', 'YOLO / PyTorch', 'NumPy', 'Multi-Threaded Video Engine'],
    results: [
      'Real-time 30 FPS multi-target tracking on local edge compute',
      'Sub-150ms automated incident detection and alert dispatch',
    ],
    github: 'https://github.com/buddytex',
  },
  {
    index: '04',
    category: 'Distributed Multi-Agent Systems',
    title: 'Swarm Robotics Distributed Platform',
    role: 'Distributed Systems & Robotics Researcher',
    badge: 'Cooperative Autonomy',
    description: 'Multi-agent cooperative robotics testbed demonstrating peer-to-peer consensus, spatial dispersion, and target encirclement without centralized servers.',
    problem: 'Coordinated multi-robot movement and exploration in communication-constrained environments with no central coordinator or single point of failure.',
    approach: 'Developed peer-to-peer TCP/IP mesh protocols on ESP32 microcontrollers, implemented consensus algorithms for flocking, and integrated with ROS for centralized telemetry inspection.',
    pipeline: ['Local Pose Sensing', 'TCP/IP Peer Mesh Broadcast', 'Distributed Consensus Engine', 'Coordinated Movement'],
    hardware: ['Mobile Robot Swarm Nodes', 'ESP32 Wi-Fi Modules', 'Proximity Sensors', 'Differential Chassis'],
    software: ['ROS', 'Embedded C++', 'TCP/IP Sockets Protocol', 'Python Swarm Visualizer'],
    results: [
      'Decentralized formation maintenance across multi-node mobile testbed',
      'Automatic mesh self-healing upon node drop-out or link degradation',
    ],
    github: 'https://github.com/buddytex',
  },
];
---

<Layout
  title="Naveen Shaji George | Robotics & Autonomous Systems Engineer"
  description="Robotics Engineer specializing in autonomous systems, 3D LiDAR perception, custom vehicle ECUs, isolated CAN bus networks, and ROS 2 software integration. AIR 7 and AIR 11 aBAJA team leader."
>
  <!-- Navigation Header -->
  <Navigation />

  <main id="mainContent">
    <!-- Hero Section with Borderless Spatial Perception Field -->
    <Hero />

    <!-- Section: Selected Engineering Case Studies -->
    <section id="work" class="section work-section">
      <div class="container">
        <div class="section-header">
          <span class="editorial-tag section-tag">Selected Case Studies</span>
          <h2>Robotics Systems That<br/><span class="text-accent">Operate in Reality</span></h2>
          <p class="section-lead">
            In-depth engineering case studies spanning autonomous vehicle architecture, mobile service robotics,
            edge computer vision pipelines, and multi-agent coordination.
          </p>
        </div>

        <div class="case-studies-list">
          {caseStudies.map((study) => (
            <ProjectCard {...study} />
          ))}
        </div>
      </div>
    </section>

    <!-- Section: ROS 2 Systems Architecture -->
    <Systems />

    <!-- Section: Core Capabilities & Tooling -->
    <Skills />

    <!-- Section: Research & Exploration -->
    <Research />

    <!-- Section: About & Chronology -->
    <About />

    <!-- Section: Contact & Communication -->
    <Contact />
  </main>

  <!-- Clean Footer -->
  <Footer />
</Layout>

<style>
  .work-section {
    background: var(--bg);
  }

  .case-studies-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }
</style>