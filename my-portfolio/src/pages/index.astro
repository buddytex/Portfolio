---
import "../styles/global.css";

const skills = [
  "Electrical Systems",
  "Embedded Systems",
  "PCB Design",
  "CAN",
  "Robotics",
  "Vehicle Integration",
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Naveen Shaji George — Robotics & Autonomous Systems Engineer specializing in electronics, embedded systems, PCB design and robotic system integration."
    />
    <title>Naveen Shaji George | Robotics Engineer</title>
  </head>

  <body>

    <header class="navbar">
      <div class="container nav-inner">

        <a href="/" class="logo">
          NAVEEN<span>.</span>
        </a>

        <nav>
          <a href="#about">About</a>
          <a href="#projects">Projects</a>
          <a href="#contact">Contact</a>
        </nav>

        <a href="/Naveen_Shaji_George_CV.pdf" class="nav-cv">
          CV
        </a>

      </div>
    </header>


    <main>

      <!-- HERO -->
      <section class="hero">

        <div class="container hero-grid">

          <div class="hero-content">

            <p class="eyebrow">
              ROBOTICS & AUTONOMOUS SYSTEMS
            </p>

            <h1>
              Building systems
              <span>that move.</span>
            </h1>

            <p class="hero-description">
              I'm Naveen Shaji George, a Robotics & Automation Engineer
              focused on electronics, embedded systems, autonomous vehicles
              and real-world system integration.
            </p>

            <div class="hero-actions">
              <a href="#projects" class="button button-primary">
                View Projects
              </a>

              <a href="#about" class="button button-secondary">
                About Me
              </a>
            </div>

          </div>


          <div class="hero-visual">

            <div class="visual-grid"></div>

            <div class="visual-card">

              <div class="status">
                <span></span>
                ENGINEERING / ROBOTICS
              </div>

              <div class="visual-title">
                TEAM EQUINOX
              </div>

              <div class="visual-subtitle">
                Autonomous aBAJA Vehicle
              </div>

              <div class="visual-result">
                <div>
                  <strong>AIR 7</strong>
                  <small>2025</small>
                </div>

                <div>
                  <strong>AIR 11</strong>
                  <small>2026</small>
                </div>
              </div>

            </div>

          </div>

        </div>

      </section>


      <!-- SKILLS STRIP -->
      <section class="skills-strip">

        <div class="container skills-inner">

          {skills.map((skill) => (
            <span>{skill}</span>
          ))}

        </div>

      </section>


      <!-- ABOUT -->
      <section id="about" class="section">

        <div class="container about-grid">

          <div>
            <p class="section-label">01 / ABOUT</p>

            <h2>
              From schematic
              <span>to system.</span>
            </h2>
          </div>

          <div class="about-text">

            <p>
              I enjoy working at the intersection of electronics,
              embedded systems, robotics and mechanical integration.
            </p>

            <p>
              My most significant engineering experience comes from
              Team Equinox, where I led the Electrical & Electronics
              development of an autonomous Baja vehicle across two
              national campaigns.
            </p>

            <p>
              My work covered electrical architecture, HV/LV wiring
              harnesses, custom PCBs, CAN communication, embedded ECUs,
              drive-by-wire systems and physical vehicle integration.
            </p>

          </div>

        </div>

      </section>


      <!-- PROJECTS -->
      <section id="projects" class="section projects-section">

        <div class="container">

          <div class="section-heading">

            <div>
              <p class="section-label">02 / SELECTED WORK</p>

              <h2>
                Projects that
                <span>made it real.</span>
              </h2>
            </div>

            <p>
              A selection of robotics, autonomous systems and
              engineering projects I've worked on.
            </p>

          </div>


          <article class="featured-project">

            <div class="project-placeholder">

              <div>
                <span>FEATURED PROJECT</span>
                <strong>TEAM EQUINOX</strong>
              </div>

            </div>

            <div class="project-content">

              <p class="project-number">01</p>

              <h3>
                Autonomous aBAJA
                <span>Vehicle</span>
              </h3>

              <p>
                Electrical & Electronics Head responsible for the
                vehicle's electrical architecture, custom PCBs,
                wiring harnesses, CAN network, embedded systems,
                drive-by-wire and integration.
              </p>

              <div class="tags">
                <span>Electrical</span>
                <span>Embedded</span>
                <span>PCB</span>
                <span>CAN</span>
                <span>Robotics</span>
              </div>

              <a href="/projects/abaja" class="project-link">
                Explore case study →
              </a>

            </div>

          </article>


          <div class="project-grid">

            <article class="project-card">
              <p>02</p>
              <h3>Hospital Service Robot</h3>
              <span>ROS • IoT • Robotics</span>
            </article>

            <article class="project-card">
              <p>03</p>
              <h3>Smart CCTV</h3>
              <span>OpenCV • Python • AI</span>
            </article>

            <article class="project-card">
              <p>04</p>
              <h3>Swarm Robot</h3>
              <span>ROS • TCP/IP • Embedded</span>
            </article>

          </div>

        </div>

      </section>


      <!-- CONTACT -->
      <section id="contact" class="contact-section">

        <div class="container">

          <p class="section-label">03 / CONTACT</p>

          <h2>
            Let's build something
            <span>meaningful.</span>
          </h2>

          <p>
            I'm currently looking for opportunities in robotics,
            embedded systems, autonomous systems and robotics R&D.
          </p>

          <div class="contact-links">

            <a href="mailto:naveensg.rbb2226@saintgits.org">
              Email
            </a>

            <a
              href="https://www.linkedin.com/in/naveen-shaji-george-a55b55243"
              target="_blank"
              rel="noopener noreferrer"
            >
              LinkedIn
            </a>

            <a
              href="https://github.com/buddytex"
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHub
            </a>

          </div>

        </div>

      </section>

    </main>


    <footer>

      <div class="container footer-inner">

        <span>
          © {new Date().getFullYear()} Naveen Shaji George
        </span>

        <span>
          Robotics & Automation Engineer
        </span>

      </div>

    </footer>

  </body>
</html>


<style>
  /* NAVIGATION */

  .navbar {
    position: absolute;
    width: 100%;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--border);
  }

  .nav-inner {
    height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .logo span {
    color: var(--accent);
  }

  nav {
    display: flex;
    gap: 36px;
    margin-left: auto;
    margin-right: 32px;
  }

  nav a {
    color: var(--text-secondary);
    font-size: 0.85rem;
    transition: color 0.2s ease;
  }

  nav a:hover {
    color: var(--text);
  }

  .nav-cv {
    border: 1px solid var(--border);
    padding: 9px 18px;
    font-size: 0.8rem;
    transition: all 0.2s ease;
  }

  .nav-cv:hover {
    border-color: var(--accent);
    color: var(--accent);
  }


  /* HERO */

  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
    padding-top: 76px;
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        rgba(255,255,255,0.025) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(255,255,255,0.025) 1px,
        transparent 1px
      );
    background-size: 60px 60px;
    mask-image: linear-gradient(
      to bottom,
      black,
      transparent
    );
    pointer-events: none;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 70px;
    align-items: center;
  }

  .eyebrow,
  .section-label {
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    margin: 0 0 20px;
  }

  h1 {
    font-size: clamp(3.5rem, 7vw, 6.5rem);
    line-height: 0.92;
    letter-spacing: -0.055em;
    margin: 0;
    max-width: 800px;
  }

  h1 span,
  h2 span,
  h3 span {
    color: var(--accent);
  }

  .hero-description {
    color: var(--text-secondary);
    font-size: 1.05rem;
    max-width: 580px;
    margin: 30px 0;
  }

  .hero-actions {
    display: flex;
    gap: 12px;
  }

  .button {
    padding: 13px 22px;
    font-size: 0.85rem;
    font-weight: 700;
    transition: all 0.2s ease;
  }

  .button-primary {
    background: var(--accent);
    color: var(--bg);
  }

  .button-primary:hover {
    background: var(--accent-light);
    transform: translateY(-2px);
  }

  .button-secondary {
    border: 1px solid var(--border);
  }

  .button-secondary:hover {
    border-color: var(--accent);
    color: var(--accent);
  }


  /* HERO VISUAL */

  .hero-visual {
    position: relative;
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .visual-grid {
    position: absolute;
    width: 420px;
    height: 420px;
    border: 1px solid var(--border);
    transform: rotate(45deg);
  }

  .visual-grid::before,
  .visual-grid::after {
    content: "";
    position: absolute;
    inset: 50%;
    background: var(--border);
  }

  .visual-grid::before {
    width: 1px;
    height: 100%;
    transform: translate(-50%, -50%);
  }

  .visual-grid::after {
    height: 1px;
    width: 100%;
    transform: translate(-50%, -50%);
  }

  .visual-card {
    position: relative;
    width: 340px;
    min-height: 300px;
    background: rgba(17, 23, 34, 0.92);
    border: 1px solid var(--border);
    padding: 32px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-shadow: 0 30px 80px rgba(0,0,0,0.35);
  }

  .status {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-muted);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    margin-bottom: 50px;
  }

  .status span {
    width: 7px;
    height: 7px;
    background: var(--accent);
    border-radius: 50%;
  }

  .visual-title {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: 0.05em;
  }

  .visual-subtitle {
    color: var(--text-secondary);
    margin-top: 6px;
  }

  .visual-result {
    display: flex;
    gap: 50px;
    margin-top: 45px;
  }

  .visual-result div {
    display: flex;
    flex-direction: column;
  }

  .visual-result strong {
    font-size: 1.7rem;
  }

  .visual-result small {
    color: var(--text-muted);
    font-size: 0.7rem;
  }


  /* SKILLS */

  .skills-strip {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .skills-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 20px;
    padding: 18px 0;
  }

  .skills-inner span {
    color: var(--text-muted);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }


  /* GENERAL SECTIONS */

  .section {
    padding: 130px 0;
  }

  h2 {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
    margin: 0;
  }


  /* ABOUT */

  .about-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 100px;
  }

  .about-text {
    color: var(--text-secondary);
    font-size: 1.05rem;
    max-width: 680px;
  }

  .about-text p {
    margin: 0 0 24px;
  }


  /* PROJECTS */

  .projects-section {
    background: var(--bg-secondary);
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    gap: 60px;
    align-items: end;
    margin-bottom: 60px;
  }

  .section-heading > p {
    color: var(--text-secondary);
    max-width: 380px;
    margin: 0;
  }

  .featured-project {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    background: var(--surface);
    border: 1px solid var(--border);
  }

  .project-placeholder {
    min-height: 480px;
    background:
      linear-gradient(
        135deg,
        rgba(214,168,79,0.15),
        transparent 50%
      ),
      #0a0f17;
    display: flex;
    align-items: end;
    padding: 35px;
  }

  .project-placeholder div {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .project-placeholder span {
    color: var(--accent);
    font-size: 0.65rem;
    letter-spacing: 0.15em;
  }

  .project-placeholder strong {
    font-size: 1.4rem;
  }

  .project-content {
    padding: 55px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .project-number {
    color: var(--accent);
    font-size: 0.75rem;
    margin: 0 0 25px;
  }

  .project-content h3 {
    font-size: 2.8rem;
    line-height: 1;
    letter-spacing: -0.04em;
    margin: 0;
  }

  .project-content > p:not(.project-number) {
    color: var(--text-secondary);
    margin: 25px 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .tags span {
    border: 1px solid var(--border);
    padding: 6px 10px;
    color: var(--text-muted);
    font-size: 0.65rem;
  }

  .project-link {
    color: var(--accent);
    font-size: 0.8rem;
    margin-top: 30px;
    font-weight: 700;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
    margin-top: 15px;
  }

  .project-card {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 30px;
    min-height: 180px;
    transition: all 0.25s ease;
  }

  .project-card:hover {
    transform: translateY(-4px);
    border-color: rgba(214,168,79,0.4);
  }

  .project-card p {
    color: var(--accent);
    font-size: 0.7rem;
  }

  .project-card h3 {
    font-size: 1.3rem;
    margin: 25px 0 8px;
  }

  .project-card span {
    color: var(--text-muted);
    font-size: 0.7rem;
  }


  /* CONTACT */

  .contact-section {
    padding: 150px 0;
  }

  .contact-section h2 {
    max-width: 800px;
  }

  .contact-section > .container > p:not(.section-label) {
    color: var(--text-secondary);
    max-width: 520px;
    margin: 30px 0;
  }

  .contact-links {
    display: flex;
    gap: 30px;
  }

  .contact-links a {
    color: var(--accent);
    font-size: 0.85rem;
    border-bottom: 1px solid var(--accent);
    padding-bottom: 3px;
  }


  /* FOOTER */

  footer {
    border-top: 1px solid var(--border);
  }

  .footer-inner {
    min-height: 80px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--text-muted);
    font-size: 0.7rem;
  }


  /* MOBILE */

  @media (max-width: 800px) {

    .container {
      width: min(100% - 28px, var(--max-width));
    }

    nav {
      display: none;
    }

    .hero {
      padding-top: 120px;
      padding-bottom: 70px;
    }

    .hero-grid,
    .about-grid,
    .featured-project {
      grid-template-columns: 1fr;
    }

    .hero-grid {
      gap: 60px;
    }

    .hero-visual {
      min-height: 350px;
    }

    .visual-grid {
      width: 270px;
      height: 270px;
    }

    .visual-card {
      width: 290px;
      min-height: 260px;
    }

    .section {
      padding: 90px 0;
    }

    .about-grid {
      gap: 45px;
    }

    .section-heading {
      display: block;
    }

    .section-heading > p {
      margin-top: 25px;
    }

    .project-placeholder {
      min-height: 300px;
    }

    .project-content {
      padding: 35px 25px;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }

    .skills-inner {
      justify-content: flex-start;
      gap: 15px 25px;
    }

    .footer-inner {
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      padding: 20px 0;
    }

  }
</style>