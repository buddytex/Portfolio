import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import ProjectIndex from '../components/ProjectIndex.astro';
import SkillsEvidence from '../components/SkillsEvidence.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Naveen Shaji George — Robotics & Autonomous Systems Engineer"
  description="Robotics engineer specializing in autonomous vehicles, 3D LiDAR perception, custom vehicle ECUs, isolated CAN bus networks, and ROS 2 software integration. AIR 7 and AIR 11 aBAJA team leader."
>
  <!-- Minimalist Editorial Navigation -->
