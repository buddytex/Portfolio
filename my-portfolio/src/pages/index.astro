---
// Home Page — Precision Engineering Portfolio
// Naveen Shaji George · Robotics and Automation Engineer
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import RolesTaken from '../components/RolesTaken.astro';
import ProjectIndex from '../components/ProjectIndex.astro';
import PCBShowcase from '../components/PCBShowcase.astro';
import SkillsEvidence from '../components/SkillsEvidence.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Naveen Shaji George — Robotics Engineer"
  description="Robotics engineer specializing in autonomous vehicles, 3D LiDAR perception, custom vehicle ECUs, isolated CAN bus networks, and ROS 2 software integration. AIR 7 and AIR 11 aBAJA team leader."
>
  <!-- Minimalist Editorial Navigation -->
  <Navigation />

  <main id="mainContent">
    <!-- 01 HERO: Monumental Typography + Large Portrait + Dense Circuit Network -->
    <Hero />

    <!-- 02 ROLES I'VE TAKEN: Interactive Technical Progression Index -->
    <RolesTaken />

    <!-- 03 PROJECTS: Interactive Editorial Entry Cards -->
    <ProjectIndex />

    <!-- 04 SKILLS & EVIDENCE: Compact Skill Index -->
    <SkillsEvidence />

    <!-- 05 PCB LAB: Interactive 3D PCB Artifact Inspector -->
    <section id="hardware" class="section hardware-section" aria-label="Physical PCB Engineering Showcase">
      <div class="container-wide">
        <PCBShowcase />
      </div>
    </section>

    <!-- 06 CONTACT: Direct Communication & Verified Channels -->
    <Contact />
  </main>

  <!-- Clean Minimalist Footer Signature -->
  <Footer />
</Layout>

<style>
  main {
    position: relative;
    z-index: 1;
  }
</style>